package main

import "fmt"

type Light enum {
    Red
    Yellow
    Green
}

fn next(Light l) Light {
    switch (l) {
    case Light.Red:
        return Light.Green
    case Light.Green:
        return Light.Yellow
    }
}

fn main([]string args) error {
    fmt.println((next(Light.Red) == Light.Green).string())
    return null
}
