package main

import "fmt"

type Direction enum {
    North
    East
    South
    West
}

fn turnRight(Direction d) Direction {
    switch (d) {
    case Direction.North:
        return Direction.East
    case Direction.East:
        return Direction.South
    case Direction.South:
        return Direction.West
    case Direction.West:
        return Direction.North
    }
}

fn describe(Direction d) string {
    switch (d) {
    case Direction.North, Direction.South:
        return "vertical"
    case Direction.East, Direction.West:
        return "horizontal"
    }
}

fn countLetters(string text) string {
    int vowels = 0
    int spaces = 0
    int others = 0
    for (int i = 0; i < text.len(); i++) {
        switch (text[i]) {
        case 'a', 'e', 'i', 'o', 'u':
            vowels++
        case ' ':
            spaces++
        default:
            others++
        }
    }
    return vowels.string() + " vowels, " + spaces.string() + " spaces, " + others.string() + " others"
}

fn main([]string args) error {
    Direction d = Direction.North
    for (int i = 0; i < 4; i++) {
        fmt.println(describe(d))
        d = turnRight(d)
    }
    fmt.println(countLetters("hello seed world"))

    string command = "stop"
    switch (command) {
    case "go", "start":
        fmt.println("starting")
    case "stop":
        fmt.println("stopping")
    default:
        fmt.println("unknown command " + command)
    }
    return null
}
