// hello.sd — a small Seed program.

fn puts(s) {
  while (load8(s) != 0) { putchar(load8(s)); s = s + 1; }
  return 0;
}

fn putnum(n) {
  if (n < 0) { putchar('-'); n = -n; }
  if (n >= 10) { putnum(n / 10); }
  putchar('0' + n % 10);
  return 0;
}

fn fib(n) {
  if (n < 2) { return n; }
  return fib(n - 1) + fib(n - 2);
}

fn main() {
  puts("Hello from Seed!\n");
  var i = 0;
  while (i < 15) { putnum(fib(i)); putchar(' '); i = i + 1; }
  putchar('\n');
  return 0;
}
