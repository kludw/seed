// Fetches URLs concurrently with a small pool of workers and reports the
// status, size and time of each, in the order they were given.
//
//     seed run examples/fetch.sd http://example.com/ http://example.org/
package main

import "errors"
import "fmt"
import "http"
import "math"
import "time"

const int maxWorkers = 4

type Job struct {
    int index
    string url
}

type Result struct {
    int index
    string url
    string summary
}

// Takes jobs until the channel is closed. A failed fetch is reported as a
// result, not returned as an error, so one bad URL doesn't stop the others.
fn worker(chan Job jobs, chan Result results) error {
    for (;;) {
        Job? job = jobs.receive()
        if (job == null) {
            return null
        }
        int start = time.monotonic()
        http.Response resp, error err = http.get(job.url)
        int ms = (time.monotonic() - start) / time.millisecond
        string summary = ""
        if (err != null) {
            summary = "failed: " + err.message()
        } else {
            summary = resp.status.string() + " " + http.statusText(resp.status) + ", " + resp.body.len().string() + " bytes"
        }
        results.send(Result{index: job.index, url: job.url, summary: summary + ", " + ms.string() + " ms"})
    }
}

fn byIndex(Result a, Result b) bool {
    return a.index < b.index
}

fn main([]string args) error {
    []string urls = args.slice(1, args.len())
    if (urls.len() == 0) {
        return errors.new("usage: fetch URL...")
    }

    // Both channels hold every item, so nothing blocks: all jobs are queued
    // before the workers start, and results wait until main reads them.
    chan Job jobs = chan Job(urls.len())
    for (int i = 0; i < urls.len(); i++) {
        jobs.send(Job{index: i, url: urls[i]})
    }
    jobs.close()
    chan Result results = chan Result(urls.len())

    int start = time.monotonic()
    error err = group {
        for (int i = 0; i < math.minInt(maxWorkers, urls.len()); i++) {
            spawn worker(jobs, results)
        }
    }
    if (err != null) {
        return err
    }
    results.close()

    []Result done = []Result{}
    for (;;) {
        Result? r = results.receive()
        if (r == null) {
            break
        }
        done.push(r)
    }
    done.sortBy(byIndex)
    for (int i = 0; i < done.len(); i++) {
        fmt.println(done[i].url + ": " + done[i].summary)
    }
    int total = (time.monotonic() - start) / time.millisecond
    fmt.println(done.len().string() + " URLs in " + total.string() + " ms")
    return null
}
