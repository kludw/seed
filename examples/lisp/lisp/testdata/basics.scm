; Numbers grow without overflowing, strings, lists, conditionals.
(define (show . xs) (for-each display xs) (newline))
(show "1 + 2 * 3 = " (+ 1 (* 2 3)))
(show "2^100 = " (* 1024 1024 1024 1024 1024 1024 1024 1024 1024 1024 1))
(define (pow b e) (if (= e 0) 1 (* b (pow b (- e 1)))))
(show "2^200 = " (pow 2 200))
(show "quotient, remainder, modulo of -7 and 2: " (quotient -7 2) " " (remainder -7 2) " " (modulo -7 2))
(show (list 1 "two" 'three (list 4 5)))
(show (cons 0 '(1 2)) " " (car '(a b)) " " (cdr '(a b)) " " (length '(1 2 3)))
(show (append '(1) '(2 3) '() '(4)) " " (reverse '(1 2 3)) " " (list-ref '(a b c) 2))
(define (sign n) (cond ((< n 0) 'negative) ((= n 0) 'zero) (else 'positive)))
(show (map sign '(-5 0 5)))
(show (and 1 2) " " (and) " " (or #f 3) " " (or) " " (not 0))
(show (string-append "se" "ed") " " (string-length "seed") " " (number->string 42) " " (string->number "17") " " (string->number "x"))
(show (equal? '(1 (2 3)) (list 1 (list 2 3))) " " (eq? 'a 'b))
(let* ((x 2) (y (* x 10)))
  (show "let*: " (+ x y)))
(when (> 3 2) (show "when"))
(unless (> 3 2) (show "unless"))
(show (if #f 1))
