package bank

fn testBank() Bank {
    Bank b = newBank("test")
    _ = b.open("ann", standardChecking())
    _ = b.open("ann", Savings{basisPoints: 100})
    return b
}

fn balanceOf(Bank b, string id) int {
    Account? a = b.accounts[id]
    if (a == null) {
        return -1
    }
    return a.cents
}

test "formatCents groups thousands and keeps two decimals" {
    assert(formatCents(0) == "0.00")
    assert(formatCents(5) == "0.05")
    assert(formatCents(-5) == "-0.05")
    assert(formatCents(123456) == "1,234.56")
    assert(formatCents(100000000) == "1,000,000.00")
}

test "every transaction kind has a signed amount" {
    assert(Transaction.Deposit(100, "x").amount() == 100)
    assert(Transaction.Withdrawal(100, "x").amount() == -100)
    assert(Transaction.TransferIn("a", 100).amount() == 100)
    assert(Transaction.TransferOut("a", 100).amount() == -100)
    assert(Transaction.Fee(100, "x").amount() == -100)
    assert(Transaction.Interest(100).amount() == 100)
}

test "the balance is the sum of the history" {
    Account a = newAccount("A", "ann", standardChecking())
    try a.deposit(1000, "one")
    try a.withdraw(300, "two")
    try a.closeMonth()
    int sum = 0
    for (int i = 0; i < a.transactions.len(); i++) {
        sum = sum + a.transactions[i].amount()
    }
    assert(sum == a.cents)
    assert(a.cents == 1000 - 300 - 500)
}

test "checking allows an overdraft up to its limit" {
    Account a = newAccount("A", "ann", standardChecking())
    try a.withdraw(50000, "all of it")
    assert(a.cents == -50000)
    error err = a.withdraw(1, "one more cent")
    assert(err != null)
    assert(a.cents == -50000)
    assert(a.transactions.len() == 1)
}

test "savings has no overdraft and earns interest" {
    Account a = newAccount("S", "ann", Savings{basisPoints: 150})
    error err = a.withdraw(1, "x")
    assert(err != null)
    assert(err.message() == "S: withdrawal: x: insufficient funds (balance 0.00, savings overdraft limit 0.00)")
    try a.deposit(100000, "x")
    try a.closeMonth()
    assert(a.cents == 101500)
}

test "the checking fee is waived for a high balance" {
    Checking c = standardChecking()
    assert(c.monthEnd(100000).len() == 0)
    assert(c.monthEnd(99999) == []Transaction{Transaction.Fee(500, "monthly account fee")})
    assert(c.monthEnd(-1000).len() == 2)
}

test "the plan is used through the interface" {
    []Plan plans = []Plan{standardChecking(), Savings{basisPoints: 10}}
    assert(plans[0].name() == "checking")
    assert(plans[1].overdraftLimit() == 0)
}

test "a transfer moves money between accounts" {
    Bank b = testBank()
    try b.deposit("ACC-1", 1000, "x")
    try b.transfer("ACC-1", "ACC-2", 400)
    assert(balanceOf(b, "ACC-1") == 600)
    assert(balanceOf(b, "ACC-2") == 400)
    assert(b.deposits() == 1000)
}

test "a failed transfer changes neither account" {
    Bank b = testBank()
    try b.deposit("ACC-2", 1000, "x")
    error err = b.transfer("ACC-2", "ACC-1", 5000)
    assert(err != null)
    assert(balanceOf(b, "ACC-1") == 0)
    assert(balanceOf(b, "ACC-2") == 1000)
    err = b.transfer("ACC-1", "ACC-7", 10)
    assert(err != null)
    assert(err.message() == "no account ACC-7")
    err = b.transfer("ACC-1", "ACC-1", 10)
    assert(err != null)
}

test "a copy of an account is independent of the bank" {
    Bank b = testBank()
    Account copy = try b.account("ACC-1")
    try copy.deposit(999, "x")
    assert(balanceOf(b, "ACC-1") == 0)
}

test "month end reports an account that cannot pay and closes the rest" {
    Bank b = testBank()
    try b.withdraw("ACC-1", 49800, "nearly the whole overdraft")
    try b.deposit("ACC-2", 10000, "x")
    []error problems = b.closeMonth()
    assert(problems.len() == 1)
    error first = problems[0]
    assert(first != null)
    assert(first.message().startsWith("month end: ACC-1: fee: monthly account fee: insufficient funds"))
    assert(balanceOf(b, "ACC-1") == -49800)
    assert(balanceOf(b, "ACC-2") == 10100)
}
