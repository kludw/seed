// The C generator, continued: expressions.
//
// gexpr(e) returns a C expression for the value of e that is *borrowed*:
// valid until the end of the current statement. Work that must happen
// first (calls, allocations, early returns of try) is emitted as lines
// before the statement, in evaluation order. Every owned intermediate value
// is held in a temporary (_tN) registered as a slot, so that it is released
// at the end of the statement, or on any early exit. ownVal turns a value
// into an owned one for a store: a registered temporary is moved (its slot
// is no longer live), anything else is retained.
package main

fn (Gen g) typeOf(int e) int {
    return g.c.info[e].ty
}

// The type the expression itself produces, before conversion to an
// interface or wrapping into T?.
fn (Gen g) coreType(int e) int {
    ExprInfo i = g.c.info[e]
    if (i.ifaceFrom >= 0) {
        return i.ifaceFrom
    }
    if (i.wrap) {
        return i.inner
    }
    return i.ty
}

fn (Gen g) arg(int e, int i) int {
    return g.c.ast.at(g.c.ast.exprs[e].list, i)
}

fn (Gen g) argList(int e) []int {
    Expr x = g.c.ast.exprs[e]
    []int xs = []int{}
    for (int i = 0; i < x.count; i++) {
        xs.push(g.c.ast.at(x.list, i))
    }
    return xs
}

// ---- temporaries and slots ----

// Declares a temporary with the value of cexpr. When t is counted the
// temporary owns the value and is released at the end of the statement.
fn (Gen g) mut temp(int t, string cexpr) string {
    string n = g.newTmp()
    g.emit(g.ctype(t) + " " + n + " = " + cexpr + ";")
    if (g.counted(t)) {
        g.slots.push(Slot{name: n, ty: t, live: true, temp: true})
    }
    return n
}

// Declares a temporary that is never released (a borrowed copy, or an
// owned value that is consumed right away).
fn (Gen g) mut alias(int t, string cexpr) string {
    string n = g.newTmp()
    g.emit(g.ctype(t) + " " + n + " = " + cexpr + ";")
    return n
}

// The live temporary slot named v, or -1.
fn (Gen g) findTemp(string v) int {
    if (!v.startsWith("_t")) {
        return -1
    }
    for (int i = g.slots.len() - 1; i >= 0; i--) {
        if (g.slots[i].name == v) {
            if (g.slots[i].live && g.slots[i].temp) {
                return i
            }
            return -1
        }
    }
    return -1
}

// The value v (of type t) as an owned value: a live temporary is moved out
// of its slot, anything else is retained.
fn (Gen g) mut ownVal(string v, int t) string {
    if (!g.counted(t)) {
        return v
    }
    int s = g.findTemp(v)
    if (s >= 0) {
        g.slots[s].live = false
        return v
    }
    if (isImmortal(v)) {
        return v
    }
    return g.retainExpr(t, v)
}

// Whether the C value v needs no retain: a literal that is never counted
// (small ints, string literals, cached big literals, enum cases without
// data), a null, or a length (always a small int).
fn isImmortal(string v) bool {
    if (v == "NULL" || v == "SD_INT_NULL" || v == "SD_IFACE_NULL") {
        return true
    }
    return v.startsWith("SD_INT(") || v.startsWith("SD_STR_LIT(") || v.startsWith("SD_INT_BIGLIT(") || v.startsWith("SD_BOX_REF(") || v.startsWith("sd_str_len(") || v.startsWith("sd_list_len(") || v.startsWith("sd_map_len(")
}

// Marks the temporary v as moved (consumed by a store).
fn (Gen g) mut consume(string v) {
    int s = g.findTemp(v)
    if (s >= 0) {
        g.slots[s].live = false
    }
}

// The value of e in a registered temporary that owns it (or, for a type
// that is not counted, in a plain temporary), so that later work cannot
// change it.
fn (Gen g) mut ownedTemp(int e) string {
    int t = g.typeOf(e)
    string v = g.gexpr(e)
    if (g.findTemp(v) >= 0) {
        return v
    }
    return g.temp(t, g.retainExpr(t, v))
}

fn (Gen g) mut releaseSlot(int i) {
    Slot s = g.slots[i]
    if (!s.live) {
        return
    }
    string r = g.releaseCall(s.ty, s.name)
    if (r != "") {
        g.emit(r + ";")
    }
}

// Releases the slots above mark (newest first) and drops them.
fn (Gen g) mut releaseTo(int mark) {
    for (int i = g.slots.len() - 1; i >= mark; i--) {
        g.releaseSlot(i)
    }
    if (g.slots.len() > mark) {
        g.slots = g.slots.slice(0, mark)
    }
}

// Releases the slots above mark on a path that leaves them (break,
// continue, return), except the ones named in keep; the slots stay for the
// code after the jump.
fn (Gen g) mut releaseAbove(int mark, []string keep) {
    for (int i = g.slots.len() - 1; i >= mark; i--) {
        if (!keep.contains(g.slots[i].name)) {
            g.releaseSlot(i)
        }
    }
}

// Whether a path that leaves the slots above mark has anything to release.
fn (Gen g) mut needsRelease(int mark, []string keep) bool {
    for (int i = g.slots.len() - 1; i >= mark; i--) {
        Slot s = g.slots[i]
        if (s.live && !keep.contains(s.name) && g.counted(s.ty)) {
            return true
        }
    }
    return false
}

// Whether v is a plain C identifier (so &v is valid and cheap).
fn isIdent(string v) bool {
    if (v.len() == 0) {
        return false
    }
    for (int i = 0; i < v.len(); i++) {
        byte b = v[i]
        bool ok = (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || b == '_' || (i > 0 && b >= '0' && b <= '9')
        if (!ok) {
            return false
        }
    }
    return true
}

// A pointer to the (borrowed) value v of type t. A function value is
// copied first: v may be the name of a C function.
fn (Gen g) mut addr(int t, string v) string {
    if (isIdent(v) && g.kindOf(t) != Kind.Func) {
        return "&" + v
    }
    return "&" + g.alias(t, v)
}

// ---- evaluation order ----

fn isMutBuiltin(Builtin b) bool {
    return b == Builtin.Push || b == Builtin.Pop || b == Builtin.Insert || b == Builtin.Remove || b == Builtin.Reverse || b == Builtin.Sort || b == Builtin.SortBy || b == Builtin.Delete
}

// send, receive and close: not mut (a channel is a reference), but they
// block, crash or hand values to other goroutines, so they are effects.
fn isChanBuiltin(Builtin b) bool {
    return b == Builtin.Send || b == Builtin.Receive || b == Builtin.Close
}

// Whether evaluating e may have side effects (calls, mut built-ins, try),
// which forces the operands before it to be evaluated first.
fn (Gen g) hasEffects(int e) bool {
    if (e < 0) {
        return false
    }
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    if (x.kind == ExprKind.Try || x.kind == ExprKind.Group || x.kind == ExprKind.ChanMake) {
        return true
    }
    if (x.kind == ExprKind.Call) {
        if (i.res == Res.Func || i.res == Res.Method || i.res == Res.ValueCall || i.res == Res.IfaceMethod) {
            return true
        }
        if (i.res == Res.Builtin && (isMutBuiltin(i.builtin) || isChanBuiltin(i.builtin))) {
            return true
        }
        if (i.res == Res.Builtin && g.hasEffects(g.c.ast.exprs[x.a].a)) {
            return true
        }
    } else if (g.hasEffects(x.a) || g.hasEffects(x.b)) {
        return true
    }
    for (int j = 0; j < x.count; j++) {
        if (g.hasEffects(g.c.ast.at(x.list, j))) {
            return true
        }
    }
    return false
}

// Whether evaluating e may change a place (a mut method or mut built-in),
// which could change or free what an earlier operand reads.
fn (Gen g) hasMutEffects(int e) bool {
    if (e < 0) {
        return false
    }
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    if (x.kind == ExprKind.Group) {
        return true
    }
    if (x.kind == ExprKind.Call) {
        if (i.res == Res.Method && g.c.ast.fns[i.ref].recvMut) {
            return true
        }
        if (i.res == Res.IfaceMethod && g.c.ifaceMethod(i.ref, i.sub).isMut) {
            return true
        }
        if (i.res == Res.Builtin && isMutBuiltin(i.builtin)) {
            return true
        }
    }
    if (g.hasMutEffects(x.a) || g.hasMutEffects(x.b)) {
        return true
    }
    for (int j = 0; j < x.count; j++) {
        if (g.hasMutEffects(g.c.ast.at(x.list, j))) {
            return true
        }
    }
    return false
}

// Whether reading e may crash (an index or a conversion), so it must not
// move after a side effect.
fn (Gen g) mayCrash(int e) bool {
    if (e < 0) {
        return false
    }
    Expr x = g.c.ast.exprs[e]
    if (x.kind == ExprKind.Index || (x.kind == ExprKind.Call && g.c.info[e].res == Res.Conv)) {
        return true
    }
    if (x.kind == ExprKind.Call) {
        return false
    }
    if (g.mayCrash(x.a) || g.mayCrash(x.b)) {
        return true
    }
    for (int j = 0; j < x.count; j++) {
        if (g.mayCrash(g.c.ast.at(x.list, j))) {
            return true
        }
    }
    return false
}

// Whether e always has the same value (a literal, a constant, an enum case
// without data or a function), so it may be evaluated at any time.
fn (Gen g) isStable(int e) bool {
    Expr x = g.c.ast.exprs[e]
    Res r = g.c.info[e].res
    if (isLiteralKind(x.kind) || x.kind == ExprKind.NullLit) {
        return true
    }
    return (x.kind == ExprKind.Ident && (r == Res.Const || r == Res.Func)) || (x.kind == ExprKind.Field && (r == Res.EnumVal || r == Res.Const || r == Res.Func))
}

// Generates the operands of an operation, left to right. A borrowed operand
// is read when the operation runs, so it is first copied into a temporary
// when a later operand could change or free what it reads (a mut call), or
// when it could crash and a later operand has side effects (a call
// printing before the crash).
fn (Gen g) mut operands([]int es) []string {
    []bool laterMut = []bool{}
    []bool laterEffects = []bool{}
    for (int i = 0; i < es.len(); i++) {
        laterMut.push(false)
        laterEffects.push(false)
    }
    bool mutSeen = false
    bool effectSeen = false
    for (int j = es.len() - 1; j >= 0; j--) {
        laterMut[j] = mutSeen
        laterEffects[j] = effectSeen
        if (g.hasMutEffects(es[j])) {
            mutSeen = true
        }
        if (g.hasEffects(es[j])) {
            effectSeen = true
        }
    }
    []string vals = []string{}
    for (int k = 0; k < es.len(); k++) {
        string v = g.gexpr(es[k])
        bool snapshot = laterMut[k] || (laterEffects[k] && g.mayCrash(es[k]))
        if (snapshot && !g.isStable(es[k]) && g.findTemp(v) < 0) {
            int t = g.typeOf(es[k])
            v = g.temp(t, g.retainExpr(t, v))
        }
        vals.push(v)
    }
    return vals
}

// ---- expressions ----

// The C expression for e, including the conversion to an interface and to
// T? when the checker asked for them.
fn (Gen g) mut gexpr(int e) string {
    ExprInfo i = g.c.info[e]
    string v = g.gcore(e)
    if (i.ifaceFrom >= 0) {
        int it = i.ty
        if (i.wrap) {
            it = i.inner
        }
        v = g.toIface(i.ifaceFrom, it, v)
    }
    if (i.wrap) {
        v = g.wrapVal(i.ty, v)
    }
    return v
}

// Converts a value of the struct or enum type t to the interface iface.
fn (Gen g) mut toIface(int t, int iface, string v) string {
    string a = g.alias(t, g.ownVal(v, t))
    return g.temp(iface, "sd_iface_new(&" + g.vtableOf(t, iface) + ".hdr, " + g.desc(t) + ", &" + a + ")")
}

fn (Gen g) varValue(int e) string {
    ExprInfo i = g.c.info[e]
    if (i.res == Res.Const) {
        return g.constCName(i.ref) + "()"
    }
    if (i.res == Res.Func) {
        return g.c.fnCName[i.ref]
    }
    Var v = g.c.vars[i.ref]
    if (v.kind == VarKind.MutRecv) {
        return "(*l_" + v.name + ")"
    }
    return "l_" + v.name
}

// The smallest and largest ints that SD_INT can hold.
const int smallIntMin = -4611686018427387904
const int smallIntMax = 4611686018427387903

fn intLit(Expr x) string {
    if (x.intValue != minInt && x.intValue >= smallIntMin && x.intValue <= smallIntMax) {
        return "SD_INT(" + x.intValue.string() + ")"
    }
    string text = x.raw
    if (x.intValue != minInt) {
        text = x.intValue.string()
    } else if (x.neg) {
        text = "-" + text
    }
    return "SD_INT_BIGLIT(\"" + text + "\")"
}

// The C expression for e itself, of type coreType(e).
fn (Gen g) mut gcore(int e) string {
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    switch (x.kind) {
    case ExprKind.IntLit:
        return intLit(x)
    case ExprKind.FloatLit:
        return x.raw
    case ExprKind.ByteLit:
        return "((uint8_t)" + x.intValue.string() + ")"
    case ExprKind.StringLit:
        return "SD_STR_LIT(" + cString(x.text) + ")"
    case ExprKind.BoolLit:
        if (x.intValue != 0) {
            return "true"
        }
        return "false"
    case ExprKind.NullLit:
        if (g.c.types.isOpt(i.ty) || i.ty == tyError) {
            return g.nullOf(i.ty)
        }
        return g.zeroOf(i.ty)
    case ExprKind.Ident:
        string v = g.varValue(e)
        if (i.narrowed) {
            return g.unwrapVal(i.orig, v)
        }
        return v
    case ExprKind.Field:
        if (i.res == Res.EnumVal) {
            return "SD_BOX_REF(sd_k_" + g.c.declCName(i.ref) + "__" + g.c.enumCase(i.ref, i.sub).name + ")"
        }
        if (i.res == Res.Const || i.res == Res.Func) {
            return g.varValue(e)
        }
        string fv = "(" + g.gexpr(x.a) + ").f_" + x.text
        if (i.narrowed) {
            return g.unwrapVal(i.orig, fv)
        }
        return fv
    case ExprKind.Index:
        return g.gindex(e)
    case ExprKind.Call:
        return g.gcall(e)
    case ExprKind.Unary:
        string u = g.gexpr(x.a)
        if (x.op == Tok.Not) {
            return "(!" + u + ")"
        }
        if (g.coreType(e) == tyInt) {
            return g.temp(tyInt, "sd_int_neg(" + u + ")")
        }
        return "(-(" + u + "))"
    case ExprKind.Binary:
        return g.gbinary(e)
    case ExprKind.Try:
        return g.gtry(e)
    case ExprKind.ListLit:
        return g.glist(e)
    case ExprKind.MapLit:
        return g.gmap(e)
    case ExprKind.StructLit:
        return g.gstruct(e)
    case ExprKind.ChanMake:
        string size = g.gexpr(x.a)
        return g.temp(g.coreType(e), "sd_chan_new(" + g.desc(g.elemOf(g.coreType(e))) + ", " + size + ")")
    case ExprKind.Group:
        return g.ggroup(e)
    case ExprKind.Bad, ExprKind.Entry, ExprKind.FieldInit:
        return "/* internal error: expression */"
    }
}

fn (Gen g) mut glist(int e) string {
    int el = g.elemOf(g.coreType(e))
    string ct = g.ctype(el)
    []string vals = g.operands(g.argList(e))
    string l = g.newTmp()
    g.emit("sd_list *" + l + " = sd_list_new(" + g.desc(el) + ", " + vals.len().string() + ");")
    for (int i = 0; i < vals.len(); i++) {
        g.emit("SD_LIST_PUSH(&" + l + ", " + ct + ", " + g.ownVal(vals[i], el) + ");")
    }
    g.slots.push(Slot{name: l, ty: g.coreType(e), live: true, temp: true})
    return l
}

fn (Gen g) mut gmap(int e) string {
    int mt = g.coreType(e)
    int kt = g.c.types.key(mt)
    int vt = g.elemOf(mt)
    Expr x = g.c.ast.exprs[e]
    []int es = []int{}
    for (int i = 0; i < x.count; i++) {
        Expr en = g.c.ast.exprs[g.arg(e, i)]
        es.push(en.a)
        es.push(en.b)
    }
    []string vals = g.operands(es)
    string m = g.newTmp()
    g.emit("sd_map *" + m + " = sd_map_new(" + g.desc(kt) + ", " + g.desc(vt) + ");")
    for (int j = 0; j < x.count; j++) {
        string k = g.ownVal(vals[2 * j], kt)
        string v = g.ownVal(vals[2 * j + 1], vt)
        g.emit("{ " + g.ctype(kt) + " k = " + k + "; " + g.ctype(vt) + " v = " + v + "; sd_map_set(&" + m + ", &k, &v); }")
    }
    g.slots.push(Slot{name: m, ty: mt, live: true, temp: true})
    return m
}

fn (Gen g) mut gstruct(int e) string {
    int st = g.coreType(e)
    string sct = g.ctype(st)
    Expr x = g.c.ast.exprs[e]
    if (x.count == 0) {
        return "((" + sct + "){0})"
    }
    []int es = []int{}
    for (int i = 0; i < x.count; i++) {
        es.push(g.c.ast.exprs[g.arg(e, i)].a)
    }
    []string vals = g.operands(es)
    []string fields = []string{}
    for (int j = 0; j < x.count; j++) {
        Expr fi = g.c.ast.exprs[g.arg(e, j)]
        fields.push(".f_" + fi.text + " = " + g.ownVal(vals[j], g.typeOf(fi.a)))
    }
    return g.temp(st, "{" + fields.join(", ") + "}")
}

fn (Gen g) mut gindex(int e) string {
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    []string vals = g.operands([]int{x.a, x.b})
    if (i.res == Res.StringIndex) {
        return "sd_str_at(" + vals[0] + ", " + vals[1] + ")"
    }
    if (i.res == Res.ListIndex) {
        int el = i.ty
        if (i.narrowed) {
            el = i.orig
        }
        string v = "SD_LIST_GET(" + vals[0] + ", " + g.ctype(el) + ", " + vals[1] + ")"
        if (i.narrowed) {
            return g.unwrapVal(i.orig, v)
        }
        return v
    }
    int mt = g.typeOf(x.a)
    int vt = g.elemOf(mt)
    string ka = g.addr(g.c.types.key(mt), vals[1])
    string p = g.newTmp()
    g.emit(g.ctype(vt) + " *" + p + " = sd_map_get(" + vals[0] + ", " + ka + ");")
    return g.optFromPtr(g.coreType(e), p)
}

// A T? from a borrowed pointer to a T (NULL for null).
fn (Gen g) mut optFromPtr(int opt, string p) string {
    int el = g.elemOf(opt)
    if (g.isSmallOpt(opt)) {
        string ct = g.ctype(opt)
        return "(" + p + " ? (" + ct + "){true, *" + p + "} : (" + ct + "){false, 0})"
    }
    if (g.isBoxOpt(opt)) {
        string ect = g.ctype(el)
        return g.temp(opt, p + " ? ({ " + ect + " c_ = " + g.retainExpr(el, "*" + p) + "; sd_box_new(" + g.desc(el) + ", &c_); }) : NULL")
    }
    return "(" + p + " ? *" + p + " : " + g.nullOf(opt) + ")"
}

// ---- operators ----

fn (Gen g) mut gbinary(int e) string {
    Expr x = g.c.ast.exprs[e]
    Tok op = x.op
    if (op == Tok.AndAnd || op == Tok.OrOr) {
        return g.gshort(e)
    }
    bool aNull = g.c.ast.exprs[x.a].kind == ExprKind.NullLit
    bool bNull = g.c.ast.exprs[x.b].kind == ExprKind.NullLit
    if ((op == Tok.Eq || op == Tok.Ne) && (aNull || bNull)) {
        int other = x.a
        if (aNull) {
            other = x.b
        }
        string n = g.isNull(g.typeOf(other), g.gexpr(other))
        if (op == Tok.Eq) {
            return n
        }
        return "(!" + n + ")"
    }
    int t = g.typeOf(x.a)
    if (op == Tok.Plus && t == tyString) {
        return g.gconcat(e)
    }
    []string vals = g.operands([]int{x.a, x.b})
    return g.binaryOp(op, t, vals[0], vals[1])
}

// The operator op (not &&, || or string +) on two evaluated operands of
// type t.
fn (Gen g) mut binaryOp(Tok op, int t, string a, string b) string {
    string ops = op.text()
    if (op == Tok.Eq) {
        return g.eqExpr(t, a, b)
    }
    if (op == Tok.Ne) {
        return "(!" + g.eqExpr(t, a, b) + ")"
    }
    if (t == tyInt) {
        string f = intOpName(op)
        if (op == Tok.Lt || op == Tok.Le || op == Tok.Gt || op == Tok.Ge) {
            return "sd_int_" + f + "(" + a + ", " + b + ")"
        }
        return g.temp(tyInt, "sd_int_" + f + "(" + a + ", " + b + ")")
    }
    if (t == tyString) {
        return "(sd_str_cmp(" + a + ", " + b + ") " + ops + " 0)"
    }
    if (t == tyByte) {
        if (op == Tok.Shl) {
            return "sd_byte_shl(" + a + ", " + b + ")"
        }
        if (op == Tok.Shr) {
            return "sd_byte_shr(" + a + ", " + b + ")"
        }
        if (op == Tok.Amp || op == Tok.Pipe || op == Tok.Caret) {
            return "((uint8_t)((" + a + ") " + ops + " (" + b + ")))"
        }
    }
    return "((" + a + ") " + ops + " (" + b + "))"
}

fn intOpName(Tok op) string {
    if (op == Tok.Plus) {
        return "add"
    }
    if (op == Tok.Minus) {
        return "sub"
    }
    if (op == Tok.Star) {
        return "mul"
    }
    if (op == Tok.Slash) {
        return "div"
    }
    if (op == Tok.Percent) {
        return "mod"
    }
    if (op == Tok.Amp) {
        return "and"
    }
    if (op == Tok.Pipe) {
        return "or"
    }
    if (op == Tok.Caret) {
        return "xor"
    }
    if (op == Tok.Shl) {
        return "shl"
    }
    if (op == Tok.Shr) {
        return "shr"
    }
    if (op == Tok.Lt) {
        return "lt"
    }
    if (op == Tok.Le) {
        return "le"
    }
    if (op == Tok.Gt) {
        return "gt"
    }
    return "ge"
}

// a && b, a || b: b is evaluated only when needed, so its temporaries live
// in a block of their own.
fn (Gen g) mut gshort(int e) string {
    Expr x = g.c.ast.exprs[e]
    string a = g.gexpr(x.a)
    int mark = g.slots.len()
    []string saved = g.out
    g.out = []string{}
    string b = g.gexpr(x.b)
    []string lines = g.out
    g.out = saved
    string op = "&&"
    if (x.op == Tok.OrOr) {
        op = "||"
    }
    if (lines.len() == 0 && g.slots.len() == mark) {
        return "(" + a + " " + op + " " + b + ")"
    }
    string r = g.newTmp()
    g.emit("bool " + r + " = " + a + ";")
    if (x.op == Tok.OrOr) {
        g.emit("if (!" + r + ") {")
    } else {
        g.emit("if (" + r + ") {")
    }
    for (int i = 0; i < lines.len(); i++) {
        g.out.push("  " + lines[i])
    }
    g.indent++
    g.emit(r + " = " + b + ";")
    g.releaseTo(mark)
    g.indent--
    g.emit("}")
    return r
}

// The operands of a chain of string + (a + b + c is ((a + b) + c)).
fn (Gen g) concatLeaves(int e, []int acc) []int {
    []int out = acc
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    if (x.kind == ExprKind.Binary && x.op == Tok.Plus && i.ty == tyString && !i.wrap && !i.narrowed) {
        out = g.concatLeaves(x.a, out)
        return g.concatLeaves(x.b, out)
    }
    out.push(e)
    return out
}

// a + b + c on strings: one allocation for the whole chain.
fn (Gen g) mut gconcat(int e) string {
    Expr x = g.c.ast.exprs[e]
    []int leaves = g.concatLeaves(x.a, []int{})
    leaves = g.concatLeaves(x.b, leaves)
    []string vals = g.operands(leaves)
    return g.concatVals(vals)
}

fn (Gen g) mut concatVals([]string vals) string {
    if (vals.len() == 1) {
        return vals[0]
    }
    if (vals.len() == 2) {
        return g.temp(tyString, "sd_str_concat(" + vals[0] + ", " + vals[1] + ")")
    }
    string arr = g.newTmp()
    g.emit("sd_str " + arr + "[] = {" + vals.join(", ") + "};")
    return g.temp(tyString, "sd_str_concat_n(" + arr + ", " + vals.len().string() + ")")
}

// ---- try ----

// `return err` from the current function, with the other results empty.
fn (Gen g) errReturn(string err) string {
    int r = g.c.fnRet[g.curFn]
    if (r == tyError) {
        return err
    }
    return "(" + g.ctype(r) + "){.r" + (g.c.types.count(r) - 1).string() + " = " + err + "}"
}

fn (Gen g) mut gtry(int e) string {
    Expr x = g.c.ast.exprs[e]
    int ct = g.typeOf(x.a)
    string v = g.gexpr(x.a)
    if (ct == tyError) {
        g.emit("if (!sd_err_is_null(" + v + ")) {")
        g.indent++
        g.emitReturn(g.errReturn(v), []string{v})
        g.indent--
        g.emit("}")
        g.consume(v)
        return ""
    }
    int n = g.c.types.count(ct)
    string err = v + ".r" + (n - 1).string()
    g.emit("if (!sd_err_is_null(" + err + ")) {")
    g.indent++
    for (int i = 0; i < n - 1; i++) {
        string r = g.releaseCall(g.c.types.part(ct, i), v + ".r" + i.string())
        if (r != "") {
            g.emit(r + ";")
        }
    }
    g.emitReturn(g.errReturn(err), []string{v})
    g.indent--
    g.emit("}")
    g.consume(v)
    int rt = g.coreType(e)
    if (n == 2) {
        return g.temp(rt, v + ".r0")
    }
    []string parts = []string{}
    for (int j = 0; j < n - 1; j++) {
        parts.push(v + ".r" + j.string())
    }
    return g.temp(rt, "(" + g.ctype(rt) + "){" + parts.join(", ") + "}")
}

// ---- group ----

// error err = group { ... } becomes
//
//   sd_err _tR = SD_ERR_NULL;
//   { sd_group *_tG = sd_group_begin(); ...block...; _tR = sd_group_wait(_tG); }
//
// The block cannot leave early (the checker forbids return, try and
// break/continue out of it); a crash unwinds through the runtime, which
// stops and waits for the group. spawn uses the innermost group.
fn (Gen g) mut ggroup(int e) string {
    Expr x = g.c.ast.exprs[e]
    string r = g.newTmp()
    string gv = g.newTmp()
    g.emit("sd_err " + r + " = SD_ERR_NULL;")
    g.emit("{")
    g.indent++
    g.emit("sd_group *" + gv + " = sd_group_begin();")
    g.groups.push(gv)
    g.genBody(x.block)
    g.groups = g.groups.slice(0, g.groups.len() - 1)
    g.emit(r + " = sd_group_wait(" + gv + ");")
    g.indent--
    g.emit("}")
    g.slots.push(Slot{name: r, ty: tyError, live: true, temp: true})
    return r
}
