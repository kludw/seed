// The checker: resolves names and types and records the results in lists
// parallel to the Ast arenas (info for expressions, targetVar for targets,
// and so on). The tree itself is never changed.
//
// After an error, the offending expression gets the type `invalid`, and every
// check that sees an invalid operand stays quiet, so one mistake produces one
// message. Checking continues with the next statement and function.
//
// This file has the program-level passes, type resolution, scopes and
// narrowing. Expressions are in check_expr.sd and check_call.sd, statements
// in check_stmt.sd.
package main

import "fs"

type GlobalKind enum {
    Fn
    Type
    Const
}

// A package-level name: its kind, the index of its declaration, and its
// package (globals is keyed by "<package>:<name>").
type Global struct {
    GlobalKind kind
    int index
    Pos pos
    int pkg
    string name
}

type VarKind enum {
    Local
    Param
    Recv
    MutRecv
    LocalConst
    Capture
}

// A variable. lit is the function literal whose body declares it (-1 in a
// function's own body). A Capture is the copy that a function literal (lit)
// has of a variable of the code around it (src: a variable of the enclosing
// function, or a Capture of the enclosing literal): read-only, with the
// value src had when the literal was evaluated. Its pos is src's, so that
// the language server finds one declaration.
type Var struct {
    string name
    int ty
    VarKind kind
    Pos pos
    bool used
    int lit
    int src
}

// A narrowed path (see pathKey). dead marks a path that was assigned after
// it was narrowed. A key that starts with "!" is a path known to be null
// (used for errors, see Guard).
type Narrow struct {
    string key
    bool dead
}

// After `int n, error err = f()`, n may not be read until err is checked:
// the guard on n (key "v<n>", variable var, assigned at pos) lasts until
// err (errKey) is known to be null (the narrowing "!" + errKey), n is
// assigned again, or its scope ends. Checker.guards is the set of guards in
// effect at the current point; branches work on copies of it, which are
// joined where the branches meet (see checkIf, checkFor, checkSwitch).
type Guard struct {
    string key
    string errKey
    string errName
    int var
    Pos pos
    bool lost
}

// What an expression resolved to.
//
//   Local       ref = variable           Const     ref = const decl
//   Func        ref = fn decl            Method    ref = fn decl
//   Builtin     builtin
//   Conv        a conversion such as int(x)
//   EnumNew     ref = type decl, sub = case (Type.Case(args))
//   EnumVal     ref = type decl, sub = case (Type.Case)
//   Field       a struct field
//   ListIndex, StringIndex, MapIndex
//   ValueCall   a call of a function value (the callee is any expression)
//   IfaceMethod ref = interface decl, sub = method index (in its methods)
//
// A name from another package (cart.newCart, cart.maxItems) resolves like
// a name of the current package: Func, Const, EnumNew, ...
type Res enum {
    None
    Local
    Const
    Func
    Method
    Builtin
    Conv
    EnumNew
    EnumVal
    Field
    ListIndex
    StringIndex
    MapIndex
    ValueCall
    IfaceMethod
}

type Builtin enum {
    None
    Len
    String
    SSlice
    SContains
    SIndex
    SStarts
    SEnds
    Split
    Trim
    Replace
    Upper
    Lower
    ToInt
    ToFloat
    Bytes
    Push
    Pop
    Insert
    Remove
    LContains
    LIndex
    LSlice
    Reverse
    Sort
    Join
    Delete
    Keys
    Message
    Chars
    SortBy
    Send
    Receive
    Close
    GetOr
    EnumName
}

// The checker's result for one expression.
//
// type is the type the parent sees. When wrap is set, the expression itself
// produces `inner` (a T) and is converted to type (a T?). When narrowed is
// set, the expression is stored as `orig` (a T?) and read as type (a T).
// When ifaceFrom is not -1, the expression produces a value of the struct or
// enum type ifaceFrom, which is converted to the interface (type, or inner
// when wrap is set too).
type ExprInfo struct {
    int ty
    int inner
    int ifaceFrom
    bool wrap
    bool narrowed
    int orig
    Res res
    int ref
    int sub
    Builtin builtin
}

fn newInfo() ExprInfo {
    return ExprInfo{
        ty: tyInvalid,
        inner: -1,
        ifaceFrom: -1,
        wrap: false,
        narrowed: false,
        orig: -1,
        res: Res.None,
        ref: -1,
        sub: -1,
        builtin: Builtin.None,
    }
}

// A type that declares `implements iface` (iface is an interface type or
// error) and has the methods for it.
type Impl struct {
    int decl
    int iface
}

// A variable read by a deferred method call (its receiver or an argument),
// whose value the call keeps from when the defer ran: assigning the
// variable later in the function is an error (checkDeferredChange).
type DeferWatch struct {
    int var
    string call
    int line
    bool reported
}

type Checker struct {
    Ast ast
    Diags diags
    Types types
    map[string]int globals
    []Global globalList
    map[string]int imported
    map[string]bool usedImports
    map[string]int methods
    map[string]bool mutNames
    map[string]bool builtinNamed
    []Impl impls
    []int methodSigType
    []int declType
    []int teType
    []int fnRet
    []int fnRecv
    []string fnCName
    []int recvVar
    []int constType
    []int constState
    []ExprInfo info
    []int targetVar
    []int targetType
    []int stmtVar
    []bool stmtDiscard
    []int labelCase
    []int paramVar
    []Var vars
    []int scope
    []int scopeMarks
    []Narrow narrows
    []int narrowMarks
    []Guard guards
    []Guard breakGuards
    []int breakMarks
    []Guard contGuards
    []int contMarks
    []int loopScopes
    []Guard caseGuards
    []DeferWatch deferWatch
    // Function literals (checkFnLit): the literals whose bodies are being
    // checked, innermost last; the Capture of a variable in a literal, by
    // "<literal>:<variable>"; the captures of each literal, in order; the
    // function or literal each literal is in (-1 for none, parallel to
    // fns); the literals checked already.
    []int litStack
    map[string]int capIdx
    map[int][]int litCaps
    []int fnOuter
    map[int]bool litDone
    // The name a one-target declaration is declaring while its value is
    // checked (for the hint when a literal in it calls itself).
    string declaring
    int curFn
    int loopDepth
    int groupDepth
    int groupLoop
    int allowGroup
    // return v, err: the result expression v may be read although err
    // guards it, since it is returned beside that same error (checkReturn)
    int passExpr
    string passErrKey
    bool inDefault
    []int defaultState
    bool testMode
    string libDir
    string projectRoot
}

// In testMode the program is a test program (seed test): the test blocks
// of the root package's tests/ files are checked, and main is not needed.
fn newChecker(Ast ast, Diags diags, bool testMode) Checker {
    Checker c = Checker{
        ast: ast,
        diags: diags,
        types: newTypes(),
        globals: map[string]int{},
        globalList: []Global{},
        imported: map[string]int{},
        usedImports: map[string]bool{},
        methods: map[string]int{},
        mutNames: map[string]bool{},
        builtinNamed: map[string]bool{},
        impls: []Impl{},
        methodSigType: []int{},
        declType: []int{},
        teType: []int{},
        fnRet: []int{},
        fnRecv: []int{},
        fnCName: []string{},
        recvVar: []int{},
        constType: []int{},
        constState: []int{},
        info: []ExprInfo{},
        targetVar: []int{},
        targetType: []int{},
        stmtVar: []int{},
        stmtDiscard: []bool{},
        labelCase: []int{},
        paramVar: []int{},
        vars: []Var{},
        scope: []int{},
        scopeMarks: []int{},
        narrows: []Narrow{},
        narrowMarks: []int{},
        guards: []Guard{},
        breakGuards: []Guard{},
        breakMarks: []int{},
        contGuards: []Guard{},
        contMarks: []int{},
        loopScopes: []int{},
        caseGuards: []Guard{},
        deferWatch: []DeferWatch{},
        litStack: []int{},
        capIdx: map[string]int{},
        litCaps: map[int][]int{},
        fnOuter: []int{},
        litDone: map[int]bool{},
        declaring: "",
        curFn: -1,
        loopDepth: 0,
        groupDepth: 0,
        groupLoop: -1,
        allowGroup: -1,
        passExpr: -1,
        passErrKey: "",
        inDefault: false,
        defaultState: []int{},
        testMode: testMode,
        libDir: "",
        projectRoot: "",
    }
    for (int i = 0; i < ast.exprs.len(); i++) {
        c.info.push(newInfo())
    }
    for (int j = 0; j < ast.typeExprs.len(); j++) {
        c.teType.push(-1)
    }
    for (int k = 0; k < ast.targets.len(); k++) {
        c.targetVar.push(-1)
        c.targetType.push(tyInvalid)
    }
    for (int s = 0; s < ast.stmts.len(); s++) {
        c.stmtVar.push(-1)
        c.stmtDiscard.push(false)
    }
    for (int l = 0; l < ast.labels.len(); l++) {
        c.labelCase.push(-1)
    }
    for (int p = 0; p < ast.params.len(); p++) {
        c.paramVar.push(-1)
    }
    for (int m = 0; m < ast.methodSigs.len(); m++) {
        c.methodSigType.push(tyInvalid)
    }
    return c
}

// ---- reporting ----

fn (Checker c) mut error(Pos pos, string message) {
    c.diags.errorHint(pos, message, "")
}

fn (Checker c) mut errorHint(Pos pos, string message, string hint) {
    c.diags.errorHint(pos, message, hint)
}

// ---- small accessors ----

fn (Checker c) typeOf(int e) int {
    return c.info[e].ty
}

fn (Checker c) kindOf(int t) Kind {
    return c.types.kind(t)
}

fn (Checker c) typeName(int t) string {
    return c.types.name(t)
}

fn (Checker c) describe(int e) string {
    return c.ast.describe(e)
}

fn (Checker c) mut setType(int e, int t) {
    c.info[e].ty = t
}

// ---- program ----

// Checks the whole program in c.ast. Errors end up in c.diags.
fn (Checker c) mut checkProgram() {
    c.collectGlobals()
    c.checkDeclNames()
    c.checkImports()
    for (int i = 0; i < c.ast.typeDecls.len(); i++) {
        TypeDecl td = c.ast.typeDecls[i]
        Kind kind = Kind.Struct
        if (td.kind == DeclKind.Enum) {
            kind = Kind.Enum
        } else if (td.kind == DeclKind.Interface) {
            kind = Kind.Interface
        }
        c.declType.push(c.types.declared(kind, i, c.declDisplayName(i), c.declCName(i)))
    }
    for (int j = 0; j < c.ast.typeDecls.len(); j++) {
        c.resolveTypeDecl(j)
    }
    for (int k = 0; k < c.ast.typeDecls.len(); k++) {
        c.checkStructCycles(k, []int{})
    }
    for (int f = 0; f < c.ast.fns.len(); f++) {
        c.resolveSignature(f)
        c.recvVar.push(-1)
        c.fnOuter.push(-1)
    }
    c.checkImplements()
    c.checkMain()
    for (int n = 0; n < c.ast.consts.len(); n++) {
        c.constType.push(tyInvalid)
        c.constState.push(0)
    }
    for (int m = 0; m < c.ast.consts.len(); m++) {
        c.checkConst(m)
    }
    for (int sd = 0; sd < c.ast.typeDecls.len(); sd++) {
        c.checkFieldDefaults(sd)
    }
    for (int pd = 0; pd < c.ast.params.len(); pd++) {
        c.defaultState.push(0)
    }
    for (int dc = 0; dc < c.ast.typeDecls.len(); dc++) {
        c.checkDefaultCycles(dc)
    }
    for (int b = 0; b < c.ast.fns.len(); b++) {
        c.checkFnBody(b)
    }
    c.checkUnusedImports()
}

// ---- packages ----

// The package (index in ast.pkgs) of the file a position is in.
fn (Checker c) pkgOf(Pos pos) int {
    return c.ast.files[pos.file].pkgIndex
}

fn (Checker c) declPkg(int d) int {
    return c.ast.files[c.ast.typeDecls[d].file].pkgIndex
}

fn (Checker c) fnPkg(int f) int {
    return c.ast.files[c.ast.fns[f].file].pkgIndex
}

// The package-level name in a package, or null.
fn (Checker c) global(int pkg, string name) int? {
    return c.globals[pkg.string() + ":" + name]
}

// The name of a type for messages: Item in its own root package, cart.Item
// when it belongs to an imported package.
fn (Checker c) declDisplayName(int d) string {
    int pkg = c.declPkg(d)
    if (pkg == 0) {
        return c.ast.typeDecls[d].name
    }
    return c.ast.pkgs[pkg].name + "." + c.ast.typeDecls[d].name
}

// The name of a type in C names: the package's prefix and the type's name
// (cart_Item; just Item in package main).
fn (Checker c) declCName(int d) string {
    return c.ast.pkgs[c.declPkg(d)].cprefix + c.ast.typeDecls[d].name
}

// The package imported under name in a file, or -1.
fn (Checker c) importedPkg(int file, string name) int {
    int? p = c.imported[file.string() + ":" + name]
    if (p == null) {
        return -1
    }
    return p
}

// Whether e is the name of a package imported in its file (and not a local
// variable); marks the import as used.
fn (Checker c) mut pkgNamed(int e) int {
    Expr x = c.ast.exprs[e]
    if (x.kind != ExprKind.Ident || c.lookupVar(x.text) >= 0) {
        return -1
    }
    int p = c.importedPkg(x.pos.file, x.text)
    if (p >= 0) {
        c.usedImports[x.pos.file.string() + ":" + x.text] = true
    }
    return p
}

// A pub name of another package: pkg.name. Reports names that do not exist
// or are not pub, and returns null for them.
fn (Checker c) mut pkgMember(int pkg, string name, Pos pos) int? {
    int? g = c.global(pkg, name)
    Package pk = c.ast.pkgs[pkg]
    if (g == null) {
        Suggest s = newSuggest(name)
        for (int i = 0; i < c.globalList.len(); i++) {
            Global gl = c.globalList[i]
            if (gl.pkg == pkg && c.globalPub(i)) {
                s.consider(gl.name)
            }
        }
        string hint = s.hint()
        if (pk.isLib && pk.name == "fmt" && isFormatName(name)) {
            hint = "Seed has no format strings: join text with + and .string() (\"n=\" + n.string()), or use fmt.fixed(f, places) for a float"
        }
        c.errorHint(pos, "package " + pk.name + " has no " + name, hint)
        return null
    }
    if (!c.globalPub(g)) {
        c.errorHint(pos, name + " is not pub in package " + pk.name, "only names declared pub can be used outside their package")
        return null
    }
    return g
}

// Whether name is one of Go's or C's formatting functions (fmt.printf,
// fmt.Sprintf, ...), which Seed has no equivalent of.
fn isFormatName(string name) bool {
    string n = name.toLower()
    return n == "printf" || n == "sprintf" || n == "fprintf" || n == "eprintf" || n == "errorf" || n == "format" || n == "sprint" || n == "sprintln"
}

fn (Checker c) globalPub(int g) bool {
    Global gl = c.globalList[g]
    switch (gl.kind) {
    case GlobalKind.Fn:
        return c.ast.fns[gl.index].isPub
    case GlobalKind.Type:
        return c.ast.typeDecls[gl.index].isPub
    case GlobalKind.Const:
        return c.ast.consts[gl.index].isPub
    }
}

// Whether field i of the struct d can be used at pos: it is pub, or pos is
// in the struct's own package.
fn (Checker c) fieldVisible(int d, int i, Pos pos) bool {
    if (c.declPkg(d) == c.pkgOf(pos)) {
        return true
    }
    return c.ast.params[c.ast.at(c.ast.typeDecls[d].fields, i)].isPub
}

fn (Checker c) mut privateField(Pos pos, int d, string name) {
    c.errorHint(pos, "the field " + name + " of " + c.declDisplayName(d) + " is not pub", "only pub fields can be used outside package " + c.ast.pkgs[c.declPkg(d)].name)
}

// Whether name is a package that could be imported (in the standard library
// or the project), for the hint when it is used without an import.
fn (Checker c) isPackageDir(string name) bool {
    if (!isCamelCase(name)) {
        return false
    }
    return (c.libDir != "" && fs.isDir(c.libDir + "/" + name)) || (c.projectRoot != "" && fs.isDir(joinPath(c.projectRoot, name)))
}

// Whether the function f is os.exit or os.crash, which never return.
fn (Checker c) isNoReturn(int f) bool {
    FnDecl fd = c.ast.fns[f]
    Package pk = c.ast.pkgs[c.fnPkg(f)]
    return fd.body < 0 && pk.isLib && pk.path == "os" && (fd.name == "exit" || fd.name == "crash")
}

fn (Checker c) mut addGlobal(string name, GlobalKind kind, int index, Pos pos) {
    if (name == "") {
        return
    }
    int pkg = c.pkgOf(pos)
    if (isBuiltinTypeName(name)) {
        c.errorHint(pos, name + " is the name of a built-in type", "choose another name")
        c.builtinNamed[pkg.string() + ":" + name] = true
        return
    }
    int? old = c.global(pkg, name)
    if (old != null) {
        Pos op = c.globalList[old].pos
        string where = "at line " + op.line.string()
        if (op.file != pos.file) {
            where = "in " + c.diags.paths[op.file] + ":" + op.line.string()
        }
        c.errorHint(pos, name + " is already declared " + where, "rename one of them; a package has one declaration per name")
        return
    }
    c.globalList.push(Global{kind: kind, index: index, pos: pos, pkg: pkg, name: name})
    c.globals[pkg.string() + ":" + name] = c.globalList.len() - 1
}

fn (Checker c) mut collectGlobals() {
    for (int i = 0; i < c.ast.typeDecls.len(); i++) {
        TypeDecl td = c.ast.typeDecls[i]
        c.addGlobal(td.name, GlobalKind.Type, i, td.pos)
    }
    for (int j = 0; j < c.ast.fns.len(); j++) {
        FnDecl fd = c.ast.fns[j]
        if (!fd.isMethod && !fd.isTest && !fd.isLit) {
            c.addGlobal(fd.name, GlobalKind.Fn, j, fd.pos)
        }
    }
    for (int k = 0; k < c.ast.consts.len(); k++) {
        ConstDecl cd = c.ast.consts[k]
        c.addGlobal(cd.name, GlobalKind.Const, k, cd.pos)
    }
}

// Imports are per file: a package must be imported in the file that uses
// it, under the last element of its path. The loader resolved them (target).
fn (Checker c) mut checkImports() {
    for (int i = 0; i < c.ast.imports.len(); i++) {
        Import im = c.ast.imports[i]
        if (im.target < 0) {
            continue
        }
        string key = im.file.string() + ":" + im.name
        if (c.imported[key] != null) {
            c.errorHint(im.pos, "\"" + im.path + "\" is imported twice, or another import has the same last name " + im.name, "remove one of the imports")
            continue
        }
        int? g = c.global(c.ast.files[im.file].pkgIndex, im.name)
        if (g != null) {
            Pos gp = c.globalList[g].pos
            c.errorHint(im.pos, "the import \"" + im.path + "\" has the same name as " + im.name + " declared at " + c.diags.paths[gp.file] + ":" + gp.line.string(), "rename " + im.name + ", so that " + im.name + ". means the package")
        }
        c.imported[key] = im.target
    }
}

fn (Checker c) mut resolveTypeDecl(int d) {
    TypeDecl td = c.ast.typeDecls[d]
    if (td.kind == DeclKind.Interface) {
        c.resolveInterface(d)
        return
    }
    for (int i = 0; i < td.fieldCount; i++) {
        Param f = c.ast.params[c.ast.at(td.fields, i)]
        c.resolveType(f.typeExpr)
        for (int j = 0; j < i; j++) {
            if (c.ast.params[c.ast.at(td.fields, j)].name == f.name) {
                c.error(f.pos, "field " + f.name + " is declared twice")
            }
        }
    }
    for (int k = 0; k < td.caseCount; k++) {
        EnumCase ec = c.ast.enumCases[c.ast.at(td.cases, k)]
        for (int m = 0; m < k; m++) {
            if (c.ast.enumCases[c.ast.at(td.cases, m)].name == ec.name) {
                c.error(ec.pos, "case " + ec.name + " is declared twice")
            }
        }
        for (int n = 0; n < ec.paramCount; n++) {
            c.resolveType(c.ast.params[c.ast.at(ec.params, n)].typeExpr)
        }
    }
}

// A struct that contains itself by value (directly or through other
// structs) would be infinitely large.
fn (Checker c) mut checkStructCycles(int d, []int path) {
    TypeDecl td = c.ast.typeDecls[d]
    if (td.kind != DeclKind.Struct) {
        return
    }
    if (path.contains(d)) {
        if (path[0] == d) {
            c.errorHint(td.pos, "struct " + td.name + " contains itself", "use a nullable field (" + td.name + "?) or a list to break the cycle")
        }
        return
    }
    []int next = path.slice(0, path.len())
    next.push(d)
    for (int i = 0; i < td.fieldCount; i++) {
        int t = c.fieldType(d, i)
        if (c.kindOf(t) == Kind.Struct) {
            c.checkStructCycles(c.types.decl(t), next)
        }
    }
}

fn (Checker c) mut resolveSignature(int f) {
    FnDecl fd = c.ast.fns[f]
    for (int i = 0; i < fd.paramCount; i++) {
        c.resolveType(c.ast.params[c.ast.at(fd.params, i)].typeExpr)
    }
    []int rs = []int{}
    for (int j = 0; j < fd.resultCount; j++) {
        rs.push(c.resolve(c.ast.at(fd.results, j)))
    }
    c.fnRet.push(c.resultOf(rs))
    string prefix = c.ast.pkgs[c.fnPkg(f)].cprefix
    if (fd.isLit) {
        // Named after the function it is in when its body is checked
        // (checkFnLit).
        c.fnRecv.push(-1)
        c.fnCName.push("sd_cl_" + prefix + f.string())
        return
    }
    if (fd.isTest) {
        c.fnRecv.push(-1)
        c.fnCName.push("sd_test_" + f.string())
        return
    }
    if (!fd.isMethod) {
        c.fnRecv.push(-1)
        c.fnCName.push("sd_f_" + prefix + fd.name)
        return
    }
    TypeExpr rte = c.ast.typeExprs[fd.recvType]
    int? g = null
    if (rte.kind == TypeExprKind.Name && rte.pkg == "") {
        g = c.global(c.fnPkg(f), rte.name)
    }
    if (g == null || c.globalList[g].kind != GlobalKind.Type) {
        if (c.resolve(fd.recvType) != tyInvalid) {
            c.error(rte.pos, "methods can only be declared on struct and enum types of this package, not " + c.ast.typeExprText(fd.recvType))
        }
        c.fnRecv.push(-1)
        c.fnCName.push("sd_m_invalid__" + fd.name)
        return
    }
    int d = c.globalList[g].index
    TypeDecl td = c.ast.typeDecls[d]
    if (td.kind == DeclKind.Interface) {
        c.errorHint(rte.pos, "methods cannot be declared on the interface " + td.name, "declare them on the struct and enum types that implement it")
        c.fnRecv.push(-1)
        c.fnCName.push("sd_m_invalid__" + fd.name)
        return
    }
    c.teType[fd.recvType] = c.declType[d]
    c.fnRecv.push(d)
    c.fnCName.push("sd_m_" + prefix + td.name + "__" + fd.name)
    if (td.kind == DeclKind.Enum && fd.name == "name") {
        c.errorHint(fd.pos, "enum " + td.name + " cannot declare a method name: every enum has a built-in name() that returns the name of its case", "use the built-in name(), or give the method another name (such as label)")
        return
    }
    string key = methodKey(d, fd.name)
    if (c.methods[key] != null) {
        c.error(fd.pos, "method " + td.name + "." + fd.name + " is declared twice")
        return
    }
    c.methods[key] = f
    if (td.kind == DeclKind.Struct) {
        for (int i = 0; i < td.fieldCount; i++) {
            Param fp = c.ast.params[c.ast.at(td.fields, i)]
            if (fp.name == fd.name) {
                c.errorHint(fd.pos, "struct " + td.name + " has a field and a method both named " + fd.name, "rename the method or the field (" + td.name + "." + fd.name + " must name one thing)")
            }
        }
    }
    if (fd.recvMut) {
        c.mutNames[fd.name] = true
    }
}

// The key of a method in Checker.methods: the type declaration and the
// method's name.
fn methodKey(int d, string name) string {
    return d.string() + "." + name
}

// A program's root package must be package main with a main function (a
// test program runs its tests instead).
fn (Checker c) mut checkMain() {
    if (c.testMode) {
        return
    }
    if (c.ast.pkgs.len() > 0 && c.ast.pkgs[0].name != "main") {
        Pos pp = c.ast.files[0].pkgPos
        c.errorHint(pp, "a program must be package main, not package " + c.ast.pkgs[0].name, "build the program that imports this package, or run its tests with seed test")
        return
    }
    int? g = c.global(0, "main")
    if (g == null || c.globalList[g].kind != GlobalKind.Fn) {
        Pos p = Pos{file: 0, line: 1, col: 1}
        c.errorHint(p, "missing fn main([]string args) error", "every program starts at main")
        return
    }
    int f = c.globalList[g].index
    FnDecl fd = c.ast.fns[f]
    bool ok = fd.paramCount == 1 && c.fnRet[f] == tyError
    if (ok) {
        int pt = c.teType[c.ast.params[c.ast.at(fd.params, 0)].typeExpr]
        ok = pt == c.types.listOf(tyString)
    }
    if (!ok) {
        c.error(fd.pos, "main must be declared as fn main([]string args) error")
    }
}

// ---- declarations used by expressions ----

fn (Checker c) fieldType(int d, int i) int {
    TypeDecl td = c.ast.typeDecls[d]
    return c.teType[c.ast.params[c.ast.at(td.fields, i)].typeExpr]
}

fn (Checker c) fieldName(int d, int i) string {
    TypeDecl td = c.ast.typeDecls[d]
    return c.ast.params[c.ast.at(td.fields, i)].name
}

// The index of a field by name, or -1.
fn (Checker c) findField(int d, string name) int {
    TypeDecl td = c.ast.typeDecls[d]
    for (int i = 0; i < td.fieldCount; i++) {
        if (c.ast.params[c.ast.at(td.fields, i)].name == name) {
            return i
        }
    }
    return -1
}

fn (Checker c) findCase(int d, string name) int {
    TypeDecl td = c.ast.typeDecls[d]
    for (int i = 0; i < td.caseCount; i++) {
        if (c.ast.enumCases[c.ast.at(td.cases, i)].name == name) {
            return i
        }
    }
    return -1
}

fn (Checker c) enumCase(int d, int i) EnumCase {
    return c.ast.enumCases[c.ast.at(c.ast.typeDecls[d].cases, i)]
}

fn (Checker c) caseParamType(int d, int ci, int k) int {
    EnumCase ec = c.enumCase(d, ci)
    return c.teType[c.ast.params[c.ast.at(ec.params, k)].typeExpr]
}

fn (Checker c) paramType(int f, int i) int {
    FnDecl fd = c.ast.fns[f]
    return c.teType[c.ast.params[c.ast.at(fd.params, i)].typeExpr]
}

fn (Checker c) resultType(int f, int i) int {
    return c.teType[c.ast.at(c.ast.fns[f].results, i)]
}

// The result type for a list of result types: void, the one type, or a
// tuple.
fn (Checker c) mut resultOf([]int rs) int {
    if (rs.len() == 0) {
        return tyVoid
    }
    if (rs.len() == 1) {
        return rs[0]
    }
    return c.types.tupleOf(rs)
}

// The type of a function used as a value.
fn (Checker c) mut fnType(int f) int {
    FnDecl fd = c.ast.fns[f]
    []int ps = []int{}
    for (int i = 0; i < fd.paramCount; i++) {
        ps.push(c.paramType(f, i))
    }
    return c.types.funcOf(ps, c.fnRet[f])
}

fn (Checker c) mut unknownCase(Pos pos, int d, string name) {
    TypeDecl td = c.ast.typeDecls[d]
    Suggest s = newSuggest(name)
    for (int i = 0; i < td.caseCount; i++) {
        s.consider(c.enumCase(d, i).name)
    }
    c.errorHint(pos, "enum " + c.declDisplayName(d) + " has no case " + name, s.hint())
}

fn (Checker c) mut unknownField(Pos pos, int d, string name) {
    TypeDecl td = c.ast.typeDecls[d]
    Suggest s = newSuggest(name)
    for (int i = 0; i < td.fieldCount; i++) {
        s.consider(c.fieldName(d, i))
    }
    c.errorHint(pos, "struct " + c.declDisplayName(d) + " has no field " + name, s.hint())
}

// ---- type expressions ----

fn isBuiltinTypeName(string n) bool {
    return n == "int" || n == "float" || n == "bool" || n == "byte" || n == "string" || n == "error"
}

fn builtinType(string n) int {
    if (n == "int") {
        return tyInt
    }
    if (n == "float") {
        return tyFloat
    }
    if (n == "bool") {
        return tyBool
    }
    if (n == "byte") {
        return tyByte
    }
    if (n == "string") {
        return tyString
    }
    return tyError
}

// Resolves a type expression and caches the result in teType.
fn (Checker c) mut resolveType(int te) {
    if (te >= 0 && c.teType[te] < 0) {
        c.teType[te] = c.resolveUncached(te)
    }
}

// The type a type expression stands for (resolving it if needed).
fn (Checker c) mut resolve(int te) int {
    if (te < 0) {
        return tyInvalid
    }
    c.resolveType(te)
    return c.teType[te]
}

fn (Checker c) mut resolveUncached(int te) int {
    TypeExpr x = c.ast.typeExprs[te]
    switch (x.kind) {
    case TypeExprKind.Name:
        if (x.pkg != "") {
            return c.resolveQualified(x)
        }
        if (isBuiltinTypeName(x.name)) {
            return builtinType(x.name)
        }
        if (c.importedPkg(x.pos.file, x.name) >= 0) {
            c.errorHint(x.pos, x.name + " is a package, not a type", "write " + x.name + ".TypeName")
            return tyInvalid
        }
        int? g = c.global(c.pkgOf(x.pos), x.name)
        if (g != null) {
            Global gl = c.globalList[g]
            if (gl.kind == GlobalKind.Type) {
                return c.declType[gl.index]
            }
            c.error(x.pos, x.name + " is not a type")
            return tyInvalid
        }
        Suggest s = newSuggest(x.name)
        s.consider("int")
        s.consider("float")
        s.consider("bool")
        s.consider("byte")
        s.consider("string")
        s.consider("error")
        for (int i = 0; i < c.ast.typeDecls.len(); i++) {
            if (c.declPkg(i) == c.pkgOf(x.pos)) {
                s.consider(c.ast.typeDecls[i].name)
            }
        }
        c.errorHint(x.pos, "unknown type " + x.name, s.hint())
        return tyInvalid
    case TypeExprKind.List:
        return c.types.listOf(c.resolve(x.a))
    case TypeExprKind.Map:
        int k = c.resolve(x.a)
        int v = c.resolve(x.b)
        if (k != tyInvalid && k != tyInt && k != tyByte && k != tyBool && k != tyString) {
            c.error(c.ast.typeExprs[x.a].pos, "map keys must be int, byte, bool or string, not " + c.typeName(k))
            return tyInvalid
        }
        if (v != tyInvalid && c.types.isOpt(v)) {
            c.errorHint(c.ast.typeExprs[x.b].pos, "map values cannot be nullable", "m[k] already returns " + c.typeName(v) + " (null for a missing key), so a value could not be told apart from a missing one; store a struct with a nullable field instead")
            return tyInvalid
        }
        return c.types.mapOf(k, v)
    case TypeExprKind.Optional:
        int inner = c.resolve(x.a)
        if (inner == tyError) {
            c.error(x.pos, "error is already nullable; write error instead of error?")
            return tyInvalid
        }
        if (inner != tyInvalid && c.types.isOpt(inner)) {
            c.error(x.pos, "T?? is not a valid type")
            return tyInvalid
        }
        return c.types.optOf(inner)
    case TypeExprKind.Paren:
        return c.resolve(x.a)
    case TypeExprKind.Chan:
        int el = c.resolve(x.a)
        if (el != tyInvalid && c.types.isOpt(el)) {
            c.errorHint(c.ast.typeExprs[x.a].pos, "channel elements cannot be nullable", "receive() already returns " + c.typeName(el) + ", null once the channel is closed; send a struct with a nullable field instead")
            return tyInvalid
        }
        return c.types.chanOf(el)
    case TypeExprKind.Func:
        []int ps = []int{}
        for (int j = 0; j < x.count; j++) {
            ps.push(c.resolve(c.ast.at(x.list, j)))
        }
        []int rs = []int{}
        for (int r = 0; r < x.resultCount; r++) {
            rs.push(c.resolve(c.ast.at(x.results, r)))
        }
        int result = c.resultOf(rs)
        if (result == tyInvalid) {
            return tyInvalid
        }
        return c.types.funcOf(ps, result)
    }
}

// pkg.Type: a pub type of an imported package.
fn (Checker c) mut resolveQualified(TypeExpr x) int {
    int p = c.importedPkg(x.pos.file, x.pkg)
    if (p < 0) {
        c.errorHint(x.pos, "unknown package " + x.pkg + " in the type " + x.pkg + "." + x.name, "import it: import \"" + x.pkg + "\"")
        return tyInvalid
    }
    c.usedImports[x.pos.file.string() + ":" + x.pkg] = true
    int? g = c.pkgMember(p, x.name, x.pos)
    if (g == null) {
        return tyInvalid
    }
    Global gl = c.globalList[g]
    if (gl.kind != GlobalKind.Type) {
        c.error(x.pos, x.pkg + "." + x.name + " is not a type")
        return tyInvalid
    }
    return c.declType[gl.index]
}

// ---- constants and function bodies ----

fn (Checker c) mut checkConst(int i) {
    int state = c.constState[i]
    if (state == 2) {
        return
    }
    ConstDecl cd = c.ast.consts[i]
    if (state == 1) {
        c.error(cd.pos, "constant " + cd.name + " depends on itself")
        return
    }
    c.constState[i] = 1
    int t = c.resolve(cd.typeExpr)
    c.constType[i] = t
    if (t != tyInvalid && c.hasChan(t, []int{})) {
        c.errorHint(cd.pos, "the constant " + cd.name + " cannot hold a channel (type " + c.typeName(t) + ")", "every goroutine computes the constants it uses for itself, so it would get a channel of its own; make the channel in a function and pass it on")
    }
    int savedFn = c.curFn
    int savedGroups = c.groupDepth
    []int savedScope = c.scope
    c.curFn = -1
    c.groupDepth = 0
    c.scope = []int{}
    c.checkValue(cd.expr, t, "to initialize " + cd.name)
    c.requireConstant(cd.expr, cd.name)
    c.curFn = savedFn
    c.groupDepth = savedGroups
    c.scope = savedScope
    c.constState[i] = 2
}

// A constant's value must be computable when the program is compiled:
// literals, other constants, enum values, named functions, operators,
// conversions and built-in methods that change nothing.
fn (Checker c) mut requireConstant(int e, string name) {
    int bad = c.nonConstant(e)
    if (bad < 0) {
        return
    }
    Expr x = c.ast.exprs[bad]
    string what = "this value"
    if (x.kind == ExprKind.Call) {
        what = "the call " + c.describe(bad)
    } else if (x.kind == ExprKind.Ident) {
        what = "the variable " + x.text
    } else if (x.kind == ExprKind.Try) {
        what = "try"
    } else if (x.kind == ExprKind.Group) {
        what = "a group"
    } else if (x.kind == ExprKind.ChanMake) {
        what = "a new channel"
    } else if (x.kind == ExprKind.FnLit) {
        what = "a function literal"
    }
    c.errorHint(x.pos, "the value of the constant " + name + " must be computable when the program is compiled, but it uses " + what, "declare a variable instead, or compute the constant from literals and other constants")
}

// The first part of e that is not a constant, or -1.
fn (Checker c) nonConstant(int e) int {
    if (e < 0) {
        return -1
    }
    Expr x = c.ast.exprs[e]
    ExprInfo i = c.info[e]
    switch (x.kind) {
    case ExprKind.Bad, ExprKind.IntLit, ExprKind.FloatLit, ExprKind.ByteLit, ExprKind.StringLit, ExprKind.BoolLit, ExprKind.NullLit:
        return -1
    case ExprKind.Ident:
        if (i.res == Res.Local && c.vars[i.ref].kind != VarKind.LocalConst) {
            return e
        }
        return -1
    case ExprKind.Try, ExprKind.Group, ExprKind.ChanMake, ExprKind.FnLit:
        return e
    case ExprKind.Is:
        return c.nonConstant(x.a)
    case ExprKind.Call:
        if (i.res == Res.Func || i.res == Res.Method || i.res == Res.ValueCall || i.res == Res.IfaceMethod) {
            return e
        }
        if (i.res == Res.Builtin && (isBuiltinMutName(c.ast.exprs[x.a].text) || i.builtin == Builtin.Send || i.builtin == Builtin.Receive || i.builtin == Builtin.Close)) {
            return e
        }
    case ExprKind.Field, ExprKind.Index, ExprKind.Unary, ExprKind.Binary, ExprKind.ListLit, ExprKind.MapLit, ExprKind.Entry, ExprKind.StructLit, ExprKind.FieldInit:
    }
    int a = c.nonConstant(x.a)
    if (a >= 0) {
        return a
    }
    int b = c.nonConstant(x.b)
    if (b >= 0) {
        return b
    }
    for (int k = 0; k < x.count; k++) {
        int r = c.nonConstant(c.ast.at(x.list, k))
        if (r >= 0) {
            return r
        }
    }
    return -1
}

// ---- default values of struct fields ----

// Checks the default values of the fields of struct d. A default is
// checked like a constant's value: in the scope of the struct's package,
// with the field's type, and it must be computable without running code
// (requireDefault). It is evaluated again at every literal that leaves the
// field out (gstruct).
fn (Checker c) mut checkFieldDefaults(int d) {
    TypeDecl td = c.ast.typeDecls[d]
    if (td.kind != DeclKind.Struct) {
        return
    }
    for (int i = 0; i < td.fieldCount; i++) {
        Param f = c.ast.params[c.ast.at(td.fields, i)]
        if (f.defaultExpr < 0) {
            continue
        }
        int savedFn = c.curFn
        int savedGroups = c.groupDepth
        []int savedScope = c.scope
        []Narrow savedNarrows = c.narrows
        c.curFn = -1
        c.groupDepth = 0
        c.scope = []int{}
        c.narrows = []Narrow{}
        c.inDefault = true
        int before = c.diags.count()
        c.checkValue(f.defaultExpr, c.fieldType(d, i), "for the default of " + f.name)
        if (c.diags.count() == before) {
            c.requireDefault(f.defaultExpr, td.name + "." + f.name)
        }
        c.inDefault = false
        c.curFn = savedFn
        c.groupDepth = savedGroups
        c.scope = savedScope
        c.narrows = savedNarrows
    }
}

// A default value follows the rules of a constant's value: literals,
// constants, enum values, named functions, operators, conversions, list,
// map and struct literals, and built-in methods that change nothing. So it
// cannot fail, block, or change anything when a literal uses it.
fn (Checker c) mut requireDefault(int e, string field) {
    int bad = c.nonConstant(e)
    if (bad < 0) {
        return
    }
    Expr x = c.ast.exprs[bad]
    string what = "this value"
    if (x.kind == ExprKind.Call) {
        what = "the call " + c.describe(bad)
    } else if (x.kind == ExprKind.Try) {
        what = "try"
    } else if (x.kind == ExprKind.Group) {
        what = "a group"
    } else if (x.kind == ExprKind.ChanMake) {
        what = "a new channel"
    } else if (x.kind == ExprKind.FnLit) {
        what = "a function literal"
    }
    c.errorHint(x.pos, "the default value of " + field + " must be computable without running code, but it uses " + what, "a default may use literals, constants, operators, conversions and list, map and struct literals; set the field in each literal instead")
}

// Whether field i of struct d has a default value.
fn (Checker c) hasDefault(int d, int i) bool {
    return c.ast.params[c.ast.at(c.ast.typeDecls[d].fields, i)].defaultExpr >= 0
}

// A default that contains a literal of a struct leaving out a field uses
// that field's default too; a default that uses itself that way would never
// end (Node? next = Node{} when Node{} leaves next out).
fn (Checker c) mut checkDefaultCycles(int d) {
    TypeDecl td = c.ast.typeDecls[d]
    if (td.kind != DeclKind.Struct) {
        return
    }
    for (int i = 0; i < td.fieldCount; i++) {
        c.visitDefault(d, i, []string{})
    }
}

// Visits the default of field i of struct d (states in defaultState, by
// Param: 0 not seen, 1 being visited, 2 done). path names the defaults on
// the way, for the message.
fn (Checker c) mut visitDefault(int d, int i, []string path) {
    int pi = c.ast.at(c.ast.typeDecls[d].fields, i)
    Param f = c.ast.params[pi]
    if (f.defaultExpr < 0 || c.defaultState[pi] == 2) {
        return
    }
    string name = c.declDisplayName(d) + "." + f.name
    if (c.defaultState[pi] == 1) {
        []string loop = path.slice(0, path.len())
        loop.push(name)
        Param start = c.ast.params[pi]
        c.errorHint(c.ast.exprs[start.defaultExpr].pos, "the default value of " + name + " uses itself: " + loop.join(" -> "), "set " + f.name + " in the literal inside the default (null, or a value without the default)")
        c.defaultState[pi] = 2
        return
    }
    c.defaultState[pi] = 1
    []string next = path.slice(0, path.len())
    next.push(name)
    []int lits = c.structLitsIn(f.defaultExpr, []int{})
    for (int k = 0; k < lits.len(); k++) {
        ExprInfo li = c.info[lits[k]]
        int lt = li.ty
        if (li.ifaceFrom >= 0) {
            lt = li.ifaceFrom
        } else if (li.wrap) {
            lt = li.inner
        }
        if (lt == tyInvalid || c.kindOf(lt) != Kind.Struct) {
            continue
        }
        int ld = c.types.decl(lt)
        []bool set = c.litFieldsSet(lits[k], ld)
        for (int j = 0; j < set.len(); j++) {
            if (!set[j]) {
                c.visitDefault(ld, j, next)
            }
        }
    }
    c.defaultState[pi] = 2
}

// The struct literals in expression e (appended to out).
fn (Checker c) structLitsIn(int e, []int out) []int {
    if (e < 0) {
        return out
    }
    Expr x = c.ast.exprs[e]
    []int found = out
    if (x.kind == ExprKind.StructLit) {
        found.push(e)
    }
    if (x.kind == ExprKind.Group) {
        return found
    }
    found = c.structLitsIn(x.a, found)
    found = c.structLitsIn(x.b, found)
    for (int k = 0; k < x.count; k++) {
        found = c.structLitsIn(c.ast.at(x.list, k), found)
    }
    return found
}

// For each field of struct d, whether the struct literal e sets it.
fn (Checker c) litFieldsSet(int e, int d) []bool {
    Expr x = c.ast.exprs[e]
    TypeDecl td = c.ast.typeDecls[d]
    []bool set = []bool{}
    for (int i = 0; i < td.fieldCount; i++) {
        set.push(false)
    }
    for (int j = 0; j < x.count; j++) {
        int fi = c.findField(d, c.ast.exprs[c.ast.at(x.list, j)].text)
        if (fi >= 0) {
            set[fi] = true
        }
    }
    return set
}

fn (Checker c) mut checkFnBody(int f) {
    FnDecl fd = c.ast.fns[f]
    if (fd.isLit) {
        // Checked where it is written (checkFnLit).
        return
    }
    if (fd.body < 0) {
        Package pk = c.ast.pkgs[c.fnPkg(f)]
        if (!pk.isLib) {
            c.errorHint(fd.pos, "fn " + fd.name + " needs a body", "only the standard library declares native functions (functions without a body, written in C)")
        }
        return
    }
    if (fd.isTest) {
        SourceFile sf = c.ast.files[fd.file]
        if (!sf.isTest) {
            c.errorHint(fd.pos, "tests belong in the tests/ directory of their package", "move this test into a file in tests/; it is compiled by seed test only")
            return
        }
    }
    c.curFn = f
    c.scope = []int{}
    c.scopeMarks = []int{}
    c.narrows = []Narrow{}
    c.narrowMarks = []int{}
    c.guards = []Guard{}
    c.breakGuards = []Guard{}
    c.breakMarks = []int{}
    c.contGuards = []Guard{}
    c.contMarks = []int{}
    c.loopScopes = []int{}
    c.caseGuards = []Guard{}
    c.deferWatch = []DeferWatch{}
    c.loopDepth = 0
    c.groupDepth = 0
    c.groupLoop = -1
    c.allowGroup = -1
    int firstVar = c.vars.len()
    c.pushScope()
    if (fd.isMethod && c.fnRecv[f] >= 0) {
        VarKind rk = VarKind.Recv
        if (fd.recvMut) {
            rk = VarKind.MutRecv
        }
        c.recvVar[f] = c.declare(fd.recvName, c.declType[c.fnRecv[f]], rk, fd.recvPos)
    } else if (fd.isMethod) {
        // The receiver's type was rejected; declare it anyway (as invalid,
        // which keeps its uses quiet) so that they are not reported too.
        c.recvVar[f] = c.declare(fd.recvName, tyInvalid, VarKind.Recv, fd.recvPos)
    }
    for (int i = 0; i < fd.paramCount; i++) {
        int pi = c.ast.at(fd.params, i)
        Param p = c.ast.params[pi]
        c.paramVar[pi] = c.declare(p.name, c.teType[p.typeExpr], VarKind.Param, p.pos)
    }
    c.checkBlock(fd.body)
    if (fd.resultCount > 0 && !fd.isTest && !c.blockExits(fd.body)) {
        c.errorHint(c.ast.blocks[fd.body].end, "missing return at the end of " + fd.name, "every path through a function with results must end in return")
    }
    c.popScope()
    c.curFn = -1
    c.checkUnusedVars(firstVar)
}

// ---- scopes ----

fn (Checker c) mut pushScope() {
    c.scopeMarks.push(c.scope.len())
    c.narrowMarks.push(c.narrows.len())
}

fn (Checker c) mut popScope() {
    int? s = c.scopeMarks.pop()
    int? n = c.narrowMarks.pop()
    if (s != null && n != null) {
        c.truncateScope(s)
        c.truncateNarrows(n)
        c.dropGuardsOutOfScope()
    }
}

// The guards on variables that are no longer in scope end.
fn (Checker c) mut dropGuardsOutOfScope() {
    []Guard kept = []Guard{}
    for (int i = 0; i < c.guards.len(); i++) {
        if (c.scope.contains(c.guards[i].var)) {
            kept.push(c.guards[i])
        }
    }
    if (kept.len() != c.guards.len()) {
        c.guards = kept
    }
}

fn (Checker c) mut truncateScope(int n) {
    if (c.scope.len() > n) {
        c.scope = c.scope.slice(0, n)
    }
}

fn (Checker c) mut truncateNarrows(int n) {
    if (c.narrows.len() > n) {
        c.narrows = c.narrows.slice(0, n)
    }
}

// The innermost variable with this name, or -1.
fn (Checker c) lookupVar(string name) int {
    for (int i = c.scope.len() - 1; i >= 0; i--) {
        int v = c.scope[i]
        if (c.vars[v].name == name) {
            return v
        }
    }
    return -1
}

// Declares a variable in the current scope and returns it (-1 for `_`).
fn (Checker c) mut declare(string name, int t, VarKind kind, Pos pos) int {
    if (name == "_" || name == "") {
        return -1
    }
    if (kind == VarKind.Param) {
        c.checkCamel(name, pos, "the parameter")
    } else if (kind == VarKind.Recv || kind == VarKind.MutRecv) {
        c.checkCamel(name, pos, "the receiver")
    } else if (kind == VarKind.LocalConst) {
        c.checkCamel(name, pos, "the constant")
    } else {
        c.checkCamel(name, pos, "the variable")
    }
    if (c.global(c.pkgOf(pos), name) != null) {
        c.errorHint(pos, name + " is already declared at the package level; shadowing is not allowed", "choose another name")
    } else if (c.importedPkg(pos.file, name) >= 0) {
        c.errorHint(pos, name + " is the name of an imported package; shadowing is not allowed", "choose another name")
    }
    if (isBuiltinTypeName(name)) {
        c.errorHint(pos, name + " is the name of a built-in type; it cannot be used as a name", "choose another name")
    }
    int old = c.lookupVar(name)
    if (old >= 0) {
        string what = ""
        VarKind ok = c.vars[old].kind
        if (ok == VarKind.Param) {
            what = " (a parameter)"
        } else if (ok == VarKind.Recv || ok == VarKind.MutRecv) {
            what = " (the receiver)"
        }
        string hint = "assign with = instead, or choose another name"
        if (kind == VarKind.Param || kind == VarKind.Recv || kind == VarKind.MutRecv) {
            hint = "give the parameters and the receiver different names"
        }
        c.errorHint(pos, name + " is already declared at line " + c.vars[old].pos.line.string() + what + "; shadowing is not allowed", hint)
    }
    c.vars.push(Var{name: name, ty: t, kind: kind, pos: pos, used: false, lit: c.curLit(), src: -1})
    int v = c.vars.len() - 1
    c.scope.push(v)
    return v
}

// ---- function literals and their captures ----

// The function literal whose body is being checked, or -1.
fn (Checker c) curLit() int {
    if (c.litStack.len() == 0) {
        return -1
    }
    return c.litStack[c.litStack.len() - 1]
}

// The name of function f in messages: its name, or "the function literal".
fn (Checker c) fnLabel(int f) string {
    if (f >= 0 && c.ast.fns[f].isLit) {
        return "the function literal"
    }
    return c.ast.fns[f].name
}

// The variable that a name found in scope (v, from lookupVar) means at this
// point: v itself, or, inside a function literal that v is declared outside
// of, the literal's Capture of it.
fn (Checker c) mut useVar(int v, Pos pos) int {
    if (v < 0 || c.litStack.len() == 0) {
        return v
    }
    return c.captureIn(c.litStack.len() - 1, v, pos)
}

// The Capture of variable v in the literal at litStack[level] (v itself if
// the literal declares it), made when first needed: a literal inside
// another one captures from the enclosing literal's Capture. Narrowings of
// the captured value hold for the Capture too (it never changes), and the
// value must be readable where the literal is evaluated (an error guard).
fn (Checker c) mut captureIn(int level, int v, Pos pos) int {
    int lit = c.litStack[level]
    if (c.vars[v].lit == lit) {
        return v
    }
    string key = lit.string() + ":" + v.string()
    int? known = c.capIdx[key]
    if (known != null) {
        return known
    }
    int src = v
    if (level > 0) {
        src = c.captureIn(level - 1, v, pos)
    } else {
        int g = c.guardOf(v)
        if (g >= 0) {
            c.guardError(g, c.vars[v].name, pos)
        }
    }
    c.vars[v].used = true
    c.vars[src].used = true
    Var ov = c.vars[src]
    c.vars.push(Var{name: ov.name, ty: ov.ty, kind: VarKind.Capture, pos: ov.pos, used: true, lit: lit, src: src})
    int cv = c.vars.len() - 1
    c.capIdx[key] = cv
    []int? caps = c.litCaps[lit]
    if (caps == null) {
        c.litCaps[lit] = []int{cv}
    } else {
        []int more = caps
        more.push(cv)
        c.litCaps[lit] = more
    }
    string sk = "v" + src.string()
    string nk = "v" + cv.string()
    []string live = c.liveNarrows()
    for (int i = live.len() - 1; i >= 0; i--) {
        string k = live[i]
        string bang = ""
        if (k.startsWith("!")) {
            bang = "!"
            k = k.slice(1, k.len())
        }
        if (keyExtends(k, sk, false)) {
            c.addNarrow(bang + nk + k.slice(sk.len(), k.len()))
        }
    }
    return cv
}

// The captures of literal f (Capture variables, in the order they were
// made).
fn (Checker c) capturesOf(int f) []int {
    []int? caps = c.litCaps[f]
    if (caps == null) {
        return []int{}
    }
    return caps
}

// Whether the function literal f captures variable v (of the code around
// it), so that evaluating the literal reads v.
fn (Checker c) litReads(int f, int v) bool {
    []int caps = c.capturesOf(f)
    for (int i = 0; i < caps.len(); i++) {
        if (c.vars[caps[i]].src == v) {
            return true
        }
    }
    return false
}

// The names a function literal's body mentions (identifiers, also in the
// literals inside it), with the position of the first mention, so that its
// captures can be made where it starts (checkFnLit).
fn (Checker c) namesInBlock(int b, map[string]Pos out) map[string]Pos {
    if (b < 0) {
        return out
    }
    map[string]Pos m = out
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        m = c.namesInStmt(c.ast.at(bl.list, i), m)
    }
    return m
}

fn (Checker c) namesInStmt(int s, map[string]Pos out) map[string]Pos {
    if (s < 0) {
        return out
    }
    map[string]Pos m = out
    Stmt st = c.ast.stmts[s]
    m = c.namesInExpr(st.expr, m)
    switch (st.kind) {
    case StmtKind.Assign:
        for (int i = 0; i < st.count; i++) {
            Target tg = c.ast.targets[c.ast.at(st.list, i)]
            if (tg.kind == TargetKind.Place) {
                m = c.namesInExpr(tg.expr, m)
            }
        }
    case StmtKind.Return:
        for (int j = 0; j < st.count; j++) {
            m = c.namesInExpr(c.ast.at(st.list, j), m)
        }
    case StmtKind.If:
        m = c.namesInBlock(st.body, m)
        m = c.namesInStmt(st.elseIf, m)
        m = c.namesInBlock(st.els, m)
    case StmtKind.For:
        m = c.namesInStmt(st.init, m)
        m = c.namesInStmt(st.post, m)
        m = c.namesInBlock(st.body, m)
    case StmtKind.Switch, StmtKind.Select:
        for (int k = 0; k < st.count; k++) {
            Case cs = c.ast.cases[c.ast.at(st.list, k)]
            for (int l = 0; l < cs.labelCount; l++) {
                m = c.namesInExpr(c.ast.labels[c.ast.at(cs.labels, l)].expr, m)
            }
            m = c.namesInStmt(cs.comm, m)
            m = c.namesInExpr(cs.guard, m)
            m = c.namesInBlock(cs.body, m)
        }
    case StmtKind.Bad, StmtKind.ExprStmt, StmtKind.IncDec, StmtKind.Defer, StmtKind.Spawn, StmtKind.Break, StmtKind.Continue, StmtKind.Assert, StmtKind.Const:
    }
    return m
}

fn (Checker c) namesInExpr(int e, map[string]Pos out) map[string]Pos {
    if (e < 0) {
        return out
    }
    map[string]Pos m = out
    Expr x = c.ast.exprs[e]
    if (x.kind == ExprKind.Ident) {
        if (m[x.text] == null) {
            m[x.text] = x.pos
        }
        return m
    }
    if (x.kind == ExprKind.Group) {
        return c.namesInBlock(x.block, m)
    }
    if (x.kind == ExprKind.FnLit) {
        return c.namesInBlock(c.ast.fns[x.lit].body, m)
    }
    m = c.namesInExpr(x.a, m)
    m = c.namesInExpr(x.b, m)
    for (int i = 0; i < x.count; i++) {
        m = c.namesInExpr(c.ast.at(x.list, i), m)
    }
    return m
}

// ---- narrowing ----

// A key for a narrowable path: a variable followed by struct fields, such as
// "v12.email". "" for anything else.
fn (Checker c) pathKey(int e) string {
    Expr x = c.ast.exprs[e]
    if (x.kind == ExprKind.Ident) {
        int v = -1
        if (c.info[e].res == Res.Local) {
            v = c.info[e].ref
        } else {
            v = c.lookupVar(x.text)
            if (v >= 0 && c.litStack.len() > 0) {
                // A name inside a function literal that is declared outside
                // it means the literal's capture, if it has one.
                int? cv = c.capIdx[c.curLit().string() + ":" + v.string()]
                if (cv != null) {
                    v = cv
                }
            }
        }
        if (v < 0) {
            return ""
        }
        return "v" + v.string()
    }
    if (x.kind == ExprKind.Field && c.info[e].res != Res.EnumVal) {
        string base = c.pathKey(x.a)
        if (base == "") {
            return ""
        }
        return base + "." + x.text
    }
    return ""
}

// The hint for using the nullable e (of type t) before checking it: a null
// check narrows only a variable or a path of fields, so anything else (an
// element, a map entry, a call result) has to be stored in a variable first.
fn (Checker c) nullHint(int e, int t, string action) string {
    string d = c.describe(e)
    if (c.pathKey(e) != "") {
        return "check " + d + " != null before " + action
    }
    string src = c.ast.fullText(e)
    if (src == "") {
        src = "..."
    }
    return "a null check narrows only variables and their fields; store it first (" + c.typeName(t) + " v = " + src + "), then check v != null before " + action
}

fn (Checker c) isNarrowed(string key) bool {
    for (int i = c.narrows.len() - 1; i >= 0; i--) {
        if (c.narrows[i].key == key) {
            return !c.narrows[i].dead
        }
    }
    return false
}

fn (Checker c) mut addNarrow(string key) {
    c.narrows.push(Narrow{key: key, dead: false})
}

// The paths narrowed at this point (the latest entry of a key decides).
fn (Checker c) liveNarrows() []string {
    []string seen = []string{}
    []string live = []string{}
    for (int i = c.narrows.len() - 1; i >= 0; i--) {
        string k = c.narrows[i].key
        if (seen.contains(k)) {
            continue
        }
        seen.push(k)
        if (!c.narrows[i].dead) {
            live.push(k)
        }
    }
    return live
}

// Where two branches meet: an entry killed in either branch (other is the
// narrowings after the first one, c.narrows after the second) stays
// killed, and the paths narrowed at the end of every branch that falls
// through (after) are narrowed again.
fn (Checker c) mut joinNarrows([]Narrow other, []string after) {
    int n = c.narrows.len()
    if (other.len() < n) {
        n = other.len()
    }
    for (int i = 0; i < n; i++) {
        if (other[i].dead && !c.narrows[i].dead) {
            c.narrows[i].dead = true
        }
    }
    for (int j = after.len() - 1; j >= 0; j--) {
        if (!c.isNarrowed(after[j])) {
            c.addNarrow(after[j])
        }
    }
}

// Whether the checked expression e is a value that is never null (a T, not
// a T?, null or error, or an error known not to be null); assigning it to
// a T? or error path narrows the path.
fn (Checker c) isNonNullValue(int e) bool {
    int t = c.typeOf(e)
    if (t == tyError) {
        return c.errorKnownNonNull(e)
    }
    if (t == tyNull || t == tyInvalid || t == tyVoid) {
        return false
    }
    return !c.types.isOpt(t) && !c.types.isTuple(t)
}

// Whether the checked error e is known not to be null: a variable or a
// path of fields that a check (or an assignment of a value that is never
// null) narrowed, like a T?.
fn (Checker c) errorKnownNonNull(int e) bool {
    string key = c.pathKey(e)
    return key != "" && c.isNarrowed(key)
}

// Whether a path of type t can be narrowed (a T? or an error).
fn (Checker c) narrowable(int t) bool {
    return t == tyError || c.types.isOpt(t)
}

// Whether key is prefix or a path under it (or only under it, if strict).
fn keyExtends(string key, string prefix, bool strict) bool {
    if (!key.startsWith(prefix)) {
        return false
    }
    if (key.len() == prefix.len()) {
        return !strict
    }
    return key[prefix.len()] == '.'
}

// The path was assigned: it and everything under it may be null again (or
// no longer null). See assigned for the guards.
fn (Checker c) mut killAssign(string key) {
    if (key == "") {
        return
    }
    for (int i = 0; i < c.narrows.len(); i++) {
        string k = c.narrows[i].key
        if (k.startsWith("!")) {
            k = k.slice(1, k.len())
        }
        if (keyExtends(k, key, false)) {
            c.narrows[i].dead = true
        }
    }
}

// The path was assigned (here, not in a loop scan): narrowing ends, and so
// does a guard on it.
fn (Checker c) mut assigned(string key) {
    c.killAssign(key)
    c.endGuard(key)
    if (key == "") {
        return
    }
    // The error a guard waits for was replaced before it was checked: the
    // value beside it can no longer be shown to be valid.
    for (int i = 0; i < c.guards.len(); i++) {
        if (!c.guards[i].lost && keyExtends(c.guards[i].errKey, key, false)) {
            c.guards[i].lost = true
            c.guards[i].errKey = "#" + c.guards[i].errKey
        }
    }
}

// The guards on key end on the current path.
fn (Checker c) mut endGuard(string key) {
    if (key == "" || c.guards.len() == 0) {
        return
    }
    []Guard kept = []Guard{}
    for (int i = 0; i < c.guards.len(); i++) {
        if (c.guards[i].key != key) {
            kept.push(c.guards[i])
        }
    }
    if (kept.len() != c.guards.len()) {
        c.guards = kept
    }
}

// The guard on the variable v, if v was returned beside an error that is
// not known to be checked yet (or -1).
fn (Checker c) guardOf(int v) int {
    if (c.guards.len() == 0) {
        return -1
    }
    string key = "v" + v.string()
    for (int i = c.guards.len() - 1; i >= 0; i--) {
        Guard g = c.guards[i]
        if (g.key == key && !c.isNarrowed("!" + g.errKey)) {
            return i
        }
    }
    return -1
}

// After cond is known to be `when`, the errors it shows to be null are
// checked: the guards waiting for them end on this path.
fn (Checker c) mut latchGuards(int cond, bool when) {
    if (cond < 0 || c.guards.len() == 0) {
        return
    }
    []string keys = c.condKeys(cond, when, []string{})
    []Guard kept = []Guard{}
    for (int i = 0; i < c.guards.len(); i++) {
        if (!keys.contains("!" + c.guards[i].errKey)) {
            kept.push(c.guards[i])
        }
    }
    if (kept.len() != c.guards.len()) {
        c.guards = kept
    }
}

// The guards of two paths that meet: a guard of either holds after them.
fn joinGuards([]Guard a, []Guard b) []Guard {
    []Guard out = a
    for (int i = 0; i < b.len(); i++) {
        bool dup = false
        for (int j = 0; j < a.len(); j++) {
            if (a[j].key == b[i].key && a[j].errKey == b[i].errKey && a[j].pos.line == b[i].pos.line && a[j].pos.col == b[i].pos.col && a[j].pos.file == b[i].pos.file) {
                dup = true
                break
            }
        }
        if (!dup) {
            out.push(b[i])
        }
    }
    return out
}

// At break or continue: the guards in effect on variables declared outside
// the loop go with the jump (to the code after the loop, or around again).
fn (Checker c) loopGuards() []Guard {
    []Guard out = []Guard{}
    int n = c.loopScopes[c.loopScopes.len() - 1]
    for (int i = 0; i < c.guards.len(); i++) {
        int v = c.guards[i].var
        for (int j = 0; j < n; j++) {
            if (c.scope[j] == v) {
                out.push(c.guards[i])
                break
            }
        }
    }
    return out
}

// A mut method was called on the path: everything under it may change.
fn (Checker c) mut killMut(string key) {
    if (key == "") {
        return
    }
    for (int i = 0; i < c.narrows.len(); i++) {
        if (keyExtends(c.narrows[i].key, key, true)) {
            c.narrows[i].dead = true
        }
    }
}

// The paths that are known not to be null when cond is `when`, and (with
// a "!" in front) the paths known to be null.
fn (Checker c) condKeys(int cond, bool when, []string out) []string {
    []string keys = out
    Expr x = c.ast.exprs[cond]
    if (x.kind == ExprKind.Binary) {
        if (x.op == Tok.Ne || x.op == Tok.Eq) {
            int other = -1
            if (c.ast.exprs[x.a].kind == ExprKind.NullLit) {
                other = x.b
            } else if (c.ast.exprs[x.b].kind == ExprKind.NullLit) {
                other = x.a
            }
            if (other >= 0) {
                string k = c.pathKey(other)
                if (k != "" && (x.op == Tok.Ne) == when) {
                    keys.push(k)
                } else if (k != "") {
                    keys.push("!" + k)
                }
            }
        } else if ((x.op == Tok.AndAnd && when) || (x.op == Tok.OrOr && !when)) {
            keys = c.condKeys(x.a, when, keys)
            keys = c.condKeys(x.b, when, keys)
        }
    } else if (x.kind == ExprKind.Unary && x.op == Tok.Not) {
        keys = c.condKeys(x.a, !when, keys)
    } else if (x.kind == ExprKind.Is && when) {
        // v is E.Case is false when v is null.
        string ik = c.pathKey(x.a)
        if (ik != "") {
            keys.push(ik)
        }
    }
    return keys
}

fn (Checker c) mut narrowOn(int cond, bool when) {
    []string keys = c.condKeys(cond, when, []string{})
    for (int i = 0; i < keys.len(); i++) {
        c.addNarrow(keys[i])
    }
}

fn isBuiltinMutName(string n) bool {
    return n == "push" || n == "pop" || n == "insert" || n == "remove" || n == "reverse" || n == "sort" || n == "sortBy" || n == "delete"
}

// Before a loop: any path the loop assigns or mutates is not narrowed at its
// start, because the loop may come around again.
fn (Checker c) mut scanStmtKills(int s) {
    if (s < 0) {
        return
    }
    Stmt st = c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Assign:
        for (int i = 0; i < st.count; i++) {
            Target tg = c.ast.targets[c.ast.at(st.list, i)]
            if (tg.kind == TargetKind.Place) {
                c.killAssign(c.pathKey(tg.expr))
                c.scanExprKills(tg.expr)
            }
        }
        c.scanExprKills(st.expr)
    case StmtKind.IncDec:
        c.killAssign(c.pathKey(st.expr))
    case StmtKind.ExprStmt, StmtKind.Const, StmtKind.Defer, StmtKind.Spawn, StmtKind.Assert:
        c.scanExprKills(st.expr)
    case StmtKind.Return:
        for (int j = 0; j < st.count; j++) {
            c.scanExprKills(c.ast.at(st.list, j))
        }
    case StmtKind.If:
        c.scanExprKills(st.expr)
        c.scanBlockKills(st.body)
        c.scanBlockKills(st.els)
        c.scanStmtKills(st.elseIf)
    case StmtKind.For:
        c.scanStmtKills(st.init)
        c.scanExprKills(st.expr)
        c.scanStmtKills(st.post)
        c.scanBlockKills(st.body)
    case StmtKind.Switch, StmtKind.Select:
        c.scanExprKills(st.expr)
        for (int k = 0; k < st.count; k++) {
            Case cs = c.ast.cases[c.ast.at(st.list, k)]
            c.scanStmtKills(cs.comm)
            for (int m = 0; m < cs.labelCount; m++) {
                c.scanExprKills(c.ast.labels[c.ast.at(cs.labels, m)].expr)
            }
            c.scanBlockKills(cs.body)
        }
    case StmtKind.Bad, StmtKind.Break, StmtKind.Continue:
        return
    }
}

fn (Checker c) mut scanBlockKills(int b) {
    if (b < 0) {
        return
    }
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        c.scanStmtKills(c.ast.at(bl.list, i))
    }
}

fn (Checker c) mut scanExprKills(int e) {
    if (e < 0) {
        return
    }
    Expr x = c.ast.exprs[e]
    if (x.kind == ExprKind.Group) {
        c.scanBlockKills(x.block)
        return
    }
    if (x.kind == ExprKind.Call) {
        Expr callee = c.ast.exprs[x.a]
        if (callee.kind == ExprKind.Field && (isBuiltinMutName(callee.text) || c.mutNames[callee.text] != null)) {
            c.killMut(c.pathKey(callee.a))
        }
    }
    c.scanExprKills(x.a)
    c.scanExprKills(x.b)
    for (int i = 0; i < x.count; i++) {
        c.scanExprKills(c.ast.at(x.list, i))
    }
}
