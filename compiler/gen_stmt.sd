// The C generator, continued: statements, scopes and defer.
//
// Every statement starts with a mark on the slot stack; the temporaries it
// registers are released when it ends (releaseTo(mark)). A block pushes a
// scope, and the locals declared in it are released at its end unless the
// block always exits. return releases every slot, break and continue the
// slots of the loop body.
package main

fn (Gen g) mut pushScope() {
    g.scopes.push(g.slots.len())
}

fn (Gen g) mut popScope(bool release) {
    int? m = g.scopes.pop()
    if (m == null) {
        return
    }
    if (release) {
        g.releaseTo(m)
    } else if (g.slots.len() > m) {
        g.slots = g.slots.slice(0, m)
    }
}

fn (Gen g) mut genStmts(int b) {
    if (b < 0) {
        return
    }
    Block bl = g.c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        g.genStmt(g.c.ast.at(bl.list, i))
    }
}

// The statements of a block in a scope of their own.
fn (Gen g) mut genBody(int b) {
    g.pushScope()
    g.genStmts(b)
    g.popScope(!g.c.blockExits(b))
}

// Declares a local variable that owns value.
fn (Gen g) mut declareLocal(string name, int t, string value) {
    g.emit(g.ctype(t) + " l_" + name + " = " + value + ";")
    if (g.counted(t)) {
        g.slots.push(Slot{name: "l_" + name, ty: t, live: true, temp: false})
    }
}

// A condition as a C expression that needs no release: when computing it
// made temporaries, it is stored in a bool and they are released.
fn (Gen g) mut condVal(string c, int mark) string {
    if (g.slots.len() == mark) {
        return c
    }
    string r = g.newTmp()
    g.emit("bool " + r + " = " + c + ";")
    g.releaseTo(mark)
    return r
}

fn (Gen g) mut genStmt(int s) {
    Stmt st = g.c.ast.stmts[s]
    int mark = g.slots.len()
    switch (st.kind) {
    case StmtKind.ExprStmt:
        string v = g.gexpr(st.expr)
        if (v != "" && g.findTemp(v) < 0 && !isIdent(v)) {
            g.emit("(void)(" + v + ");")
        }
        g.releaseTo(mark)
    case StmtKind.Assign:
        g.genAssign(s)
    case StmtKind.IncDec:
        g.genIncDec(st)
        g.releaseTo(mark)
    case StmtKind.Const:
        int cv = g.c.stmtVar[s]
        if (cv >= 0) {
            int ct = g.c.vars[cv].ty
            string val = g.ownVal(g.gexpr(st.expr), ct)
            g.emit(g.ctype(ct) + " l_" + st.name + " = " + val + ";")
            g.releaseTo(mark)
            if (g.counted(ct)) {
                g.slots.push(Slot{name: "l_" + st.name, ty: ct, live: true, temp: false})
            }
        }
    case StmtKind.If:
        g.genIf(st)
    case StmtKind.For:
        g.genFor(st)
    case StmtKind.Switch:
        g.genSwitch(st)
    case StmtKind.Return:
        g.genReturn(st)
    case StmtKind.Break:
        g.releaseAbove(g.loops[g.loops.len() - 1].mark, []string{})
        g.emit("break;")
    case StmtKind.Continue:
        LoopCtx lc = g.loops[g.loops.len() - 1]
        g.releaseAbove(lc.mark, []string{})
        if (lc.label >= 0) {
            g.emit("goto _c" + lc.label.string() + ";")
        } else {
            g.emit("continue;")
        }
    case StmtKind.Defer:
        g.genDefer(st)
    case StmtKind.Select:
        g.genSelect(st)
    case StmtKind.Spawn:
        g.genSpawn(st)
    case StmtKind.Assert:
        g.genAssert(st)
        g.releaseTo(mark)
    case StmtKind.Bad:
        g.emit("/* internal error: statement */")
    }
}

// assert(cond) in a test: when cond is false, the test returns an assert
// error (runtime/seed_test.c) whose message has the position, the source
// of the condition and, for a comparison of printable values, both sides:
// tests/x_test.sd:12: assert failed: xs.len() == 3 (2 == 3).
fn (Gen g) mut genAssert(Stmt st) {
    int e = st.expr
    Expr x = g.c.ast.exprs[e]
    string cond = ""
    string lhs = ""
    string rhs = ""
    if (x.kind == ExprKind.Binary && isComparison(x.op) && !g.c.info[e].wrap) {
        bool aNull = g.c.ast.exprs[x.a].kind == ExprKind.NullLit
        bool bNull = g.c.ast.exprs[x.b].kind == ExprKind.NullLit
        if (aNull || bNull) {
            int other = x.a
            if (aNull) {
                other = x.b
            }
            int ot = g.typeOf(other)
            string v = g.gexpr(other)
            cond = g.isNull(ot, v)
            if (x.op == Tok.Ne) {
                cond = "(!" + cond + ")"
            }
            string shown = g.showVal(ot, v)
            if (shown != "") {
                lhs = shown
                rhs = "SD_STR_LIT(\"null\")"
                if (aNull) {
                    lhs = rhs
                    rhs = shown
                }
            }
        } else {
            int t = g.typeOf(x.a)
            []string vals = g.operands([]int{x.a, x.b})
            cond = g.binaryOp(x.op, t, vals[0], vals[1])
            lhs = g.showVal(t, vals[0])
            rhs = g.showVal(t, vals[1])
            if (lhs == "" || rhs == "") {
                lhs = ""
                rhs = ""
            }
        }
    } else {
        cond = g.gexpr(e)
    }
    int failMark = g.slots.len()
    g.emit("if (!(" + cond + ")) {")
    g.indent++
    string text = g.c.diags.paths[st.pos.file] + ":" + st.pos.line.string() + ": assert failed: " + st.name
    []string parts = []string{}
    if (lhs == "") {
        parts.push("SD_STR_LIT(" + cString(text) + ")")
    } else {
        parts.push("SD_STR_LIT(" + cString(text + " (") + ")")
        parts.push(g.temp(tyString, lhs))
        parts.push("SD_STR_LIT(" + cString(" " + x.op.text() + " ") + ")")
        parts.push(g.temp(tyString, rhs))
        parts.push("SD_STR_LIT(\")\")")
    }
    string msg = g.concatVals(parts)
    string err = g.temp(tyError, "sd_assert_error(" + msg + ")")
    g.emitReturn(g.errReturn(err), []string{err})
    g.indent--
    g.emit("}")
    if (g.slots.len() > failMark) {
        g.slots = g.slots.slice(0, failMark)
    }
}

// An owned string that shows the (borrowed) value v of type t in a failed
// assert, or "" when t has no text form: numbers, bools and bytes as
// .string() does, strings quoted, errors as their quoted message, and null.
fn (Gen g) showVal(int t, string v) string {
    switch (g.kindOf(t)) {
    case Kind.Int:
        return "sd_int_to_str(" + v + ")"
    case Kind.Float:
        return "sd_float_to_str(" + v + ")"
    case Kind.Bool:
        return "sd_bool_to_str(" + v + ")"
    case Kind.Byte:
        return "sd_byte_to_str(" + v + ")"
    case Kind.String:
        return "sd_str_quote(" + v + ")"
    case Kind.Error:
        return "sd_err_show(" + v + ")"
    case Kind.Opt:
        int el = g.elemOf(t)
        if (g.kindOf(el) == Kind.Struct) {
            return ""
        }
        string inner = g.showVal(el, g.unwrapVal(t, v))
        if (inner == "") {
            return ""
        }
        return "(" + g.isNull(t, v) + " ? SD_STR_LIT(\"null\") : " + inner + ")"
    case Kind.Void, Kind.Null, Kind.Invalid, Kind.List, Kind.Map, Kind.Struct, Kind.Enum, Kind.Interface:
        return ""
    case Kind.Tuple, Kind.Func, Kind.Chan:
        return ""
    }
}

// ---- assignment ----

fn (Gen g) mut genAssign(int s) {
    Stmt st = g.c.ast.stmts[s]
    int mark = g.slots.len()
    if (st.count != 1) {
        g.genMultiAssign(s)
        return
    }
    int ti = g.c.ast.at(st.list, 0)
    Target tg = g.c.ast.targets[ti]
    switch (tg.kind) {
    case TargetKind.Decl:
        int v = g.c.targetVar[ti]
        if (v < 0) {
            string ignored = g.gexpr(st.expr)
            if (ignored != "" && g.findTemp(ignored) < 0 && !isIdent(ignored)) {
                g.emit("(void)(" + ignored + ");")
            }
            g.releaseTo(mark)
            return
        }
        int t = g.c.targetType[ti]
        string val = g.ownVal(g.gexpr(st.expr), t)
        g.emit(g.ctype(t) + " l_" + tg.name + " = " + val + ";")
        g.releaseTo(mark)
        if (g.counted(t)) {
            g.slots.push(Slot{name: "l_" + tg.name, ty: t, live: true, temp: false})
        }
    case TargetKind.Discard:
        string d = g.gexpr(st.expr)
        if (d != "" && g.findTemp(d) < 0 && !isIdent(d)) {
            g.emit("(void)(" + d + ");")
        }
        g.releaseTo(mark)
    case TargetKind.Place:
        if (!g.genAppend(st, tg)) {
            g.gstore(tg.expr, g.ownedTemp(st.expr))
        }
        g.releaseTo(mark)
    }
}

// Stores the owned value v (an lvalue: a temporary or a part of one) into
// the place lv, releasing the old value.
fn (Gen g) mut gstore(int lv, string v) {
    Expr x = g.c.ast.exprs[lv]
    ExprInfo i = g.c.info[lv]
    int t = i.ty
    if (x.kind == ExprKind.Index && i.res == Res.MapIndex) {
        string k = g.ownedTemp(x.b)
        string pm = g.gplace(x.a)
        g.consume(k)
        g.consume(v)
        g.emit("sd_map_set(" + pm + ", &" + k + ", &" + v + ");")
        return
    }
    if (x.kind == ExprKind.Index && i.res == Res.ListIndex) {
        string pl = g.gplace(x.a)
        string idx = g.ownedTemp(x.b)
        g.consume(v)
        g.emit("sd_list_set(" + pl + ", " + idx + ", &" + v + ");")
        return
    }
    if (x.kind == ExprKind.Ident && g.c.vars[i.ref].kind != VarKind.MutRecv) {
        string name = "l_" + g.c.vars[i.ref].name
        g.consume(v)
        string r = g.releaseCall(t, name)
        if (r != "") {
            g.emit(r + ";")
        }
        g.emit(name + " = " + v + ";")
        return
    }
    string p = g.gplace(lv)
    g.consume(v)
    string pt = g.newTmp()
    g.emit(g.ctype(t) + " *" + pt + " = " + p + ";")
    string rel = g.releaseCall(t, "*" + pt)
    if (rel != "") {
        g.emit(rel + ";")
    }
    g.emit("*" + pt + " = " + v + ";")
}

fn (Gen g) mentionsVar(int e, int v) bool {
    if (e < 0) {
        return false
    }
    Expr x = g.c.ast.exprs[e]
    if (x.kind == ExprKind.Ident && g.c.info[e].res == Res.Local && g.c.info[e].ref == v) {
        return true
    }
    if (g.mentionsVar(x.a, v) || g.mentionsVar(x.b, v)) {
        return true
    }
    for (int i = 0; i < x.count; i++) {
        if (g.mentionsVar(g.c.ast.at(x.list, i), v)) {
            return true
        }
    }
    return false
}

// x = x + a + b on a local string x appends in place (amortised O(1) when
// the string is not shared), as long as the rest does not read x.
fn (Gen g) mut genAppend(Stmt st, Target tg) bool {
    Expr lx = g.c.ast.exprs[tg.expr]
    ExprInfo li = g.c.info[tg.expr]
    if (lx.kind != ExprKind.Ident || li.res != Res.Local || li.ty != tyString) {
        return false
    }
    int v = li.ref
    if (g.c.vars[v].kind != VarKind.Local) {
        return false
    }
    Expr rx = g.c.ast.exprs[st.expr]
    ExprInfo ri = g.c.info[st.expr]
    if (rx.kind != ExprKind.Binary || rx.op != Tok.Plus || ri.ty != tyString || ri.wrap) {
        return false
    }
    []int leaves = g.concatLeaves(rx.a, []int{})
    leaves = g.concatLeaves(rx.b, leaves)
    Expr first = g.c.ast.exprs[leaves[0]]
    ExprInfo fi = g.c.info[leaves[0]]
    if (first.kind != ExprKind.Ident || fi.res != Res.Local || fi.ref != v || fi.narrowed) {
        return false
    }
    []int rest = leaves.slice(1, leaves.len())
    for (int i = 0; i < rest.len(); i++) {
        if (g.mentionsVar(rest[i], v)) {
            return false
        }
    }
    string tail = g.concatVals(g.operands(rest))
    string name = "l_" + g.c.vars[v].name
    g.emit(name + " = sd_str_append(" + name + ", " + tail + ");")
    return true
}

// T a, U b = f(): the tuple's parts move into the targets; discarded parts
// are released.
fn (Gen g) mut genMultiAssign(int s) {
    Stmt st = g.c.ast.stmts[s]
    int n = st.count
    int mark = g.slots.len()
    int rt = g.typeOf(st.expr)
    string v = g.gexpr(st.expr)
    string err = v + ".r" + (n - 1).string()
    bool errLast = g.c.types.part(rt, n - 1) == tyError
    // T? x, error err = f() (or T? x, _ = f()): when f fails, x is null,
    // whatever f returned beside the error.
    []string rels = []string{}
    for (int i = 0; i < n - 1; i++) {
        if (errLast && g.nullOnError(st, i)) {
            string r = g.releaseCall(g.c.types.part(rt, i), v + ".r" + i.string())
            if (r != "") {
                rels.push(r + ";")
            }
        }
    }
    if (rels.len() > 0) {
        g.emit("if (!sd_err_is_null(" + err + ")) { " + rels.join(" ") + " }")
    }
    []string declared = []string{}
    []int declaredTypes = []int{}
    for (int j = 0; j < n; j++) {
        int ti = g.c.ast.at(st.list, j)
        Target tg = g.c.ast.targets[ti]
        int pt = g.c.types.part(rt, j)
        string part = v + ".r" + j.string()
        if (!g.takesPart(st, j)) {
            string rel = g.releaseCall(pt, part)
            if (rel != "") {
                g.emit(rel + ";")
            }
            continue
        }
        int tt = g.c.targetType[ti]
        string val = part
        if (tt != pt) {
            val = g.wrapOwned(tt, part)
        }
        if (errLast && j < n - 1 && g.nullOnError(st, j)) {
            val = "(sd_err_is_null(" + err + ") ? " + val + " : " + g.nullOf(tt) + ")"
        }
        if (tg.kind == TargetKind.Decl) {
            g.emit(g.ctype(tt) + " l_" + tg.name + " = " + val + ";")
            declared.push("l_" + tg.name)
            declaredTypes.push(tt)
        } else {
            g.gstore(tg.expr, g.alias(tt, val))
        }
    }
    g.consume(v)
    g.releaseTo(mark)
    for (int k = 0; k < declared.len(); k++) {
        if (g.counted(declaredTypes[k])) {
            g.slots.push(Slot{name: declared[k], ty: declaredTypes[k], live: true, temp: false})
        }
    }
}

// Whether target i of a multiple assignment is a T? that must be null when
// the error beside it is not.
fn (Gen g) nullOnError(Stmt st, int i) bool {
    if (!g.takesPart(st, i)) {
        return false
    }
    int tt = g.c.targetType[g.c.ast.at(st.list, i)]
    return g.c.types.isOpt(tt)
}

// Whether target i of a multiple assignment takes its value.
fn (Gen g) takesPart(Stmt st, int i) bool {
    int ti = g.c.ast.at(st.list, i)
    Target tg = g.c.ast.targets[ti]
    if (tg.kind == TargetKind.Decl) {
        return g.c.targetVar[ti] >= 0
    }
    return tg.kind == TargetKind.Place
}

// Converts an owned T (an lvalue) into an owned T?.
fn (Gen g) wrapOwned(int opt, string v) string {
    if (g.isSmallOpt(opt)) {
        return "((" + g.ctype(opt) + "){true, " + v + "})"
    }
    if (g.isBoxOpt(opt)) {
        return "sd_box_new(" + g.desc(g.elemOf(opt)) + ", &" + v + ")"
    }
    return v
}

fn (Gen g) mut genIncDec(Stmt st) {
    int lv = st.expr
    ExprInfo i = g.c.info[lv]
    Expr x = g.c.ast.exprs[lv]
    string target = ""
    if (x.kind == ExprKind.Ident && g.c.vars[i.ref].kind != VarKind.MutRecv) {
        target = "l_" + g.c.vars[i.ref].name
    } else {
        string pt = g.newTmp()
        g.emit(g.ctype(i.ty) + " *" + pt + " = " + g.gplace(lv) + ";")
        target = "*" + pt
    }
    if (i.ty == tyInt) {
        string f = "sd_int_sub"
        if (st.inc) {
            f = "sd_int_add"
        }
        string t = g.newTmp()
        g.emit("sd_int " + t + " = " + f + "(" + target + ", SD_INT(1)); sd_int_release(" + target + "); " + target + " = " + t + ";")
        return
    }
    string op = "-"
    if (st.inc) {
        op = "+"
    }
    g.emit(target + " = " + target + " " + op + " 1.0;")
}

// ---- control flow ----

fn (Gen g) mut genIf(Stmt st) {
    int mark = g.slots.len()
    string c = g.condVal(g.gexpr(st.expr), mark)
    g.emit("if (" + c + ") {")
    g.indent++
    g.genBody(st.body)
    g.indent--
    if (st.elseIf >= 0) {
        g.emit("} else {")
        g.indent++
        g.genStmt(st.elseIf)
        g.indent--
    } else if (st.els >= 0) {
        g.emit("} else {")
        g.indent++
        g.genBody(st.els)
        g.indent--
    }
    g.emit("}")
}

// for (init; cond; post) { body } becomes
//
//   { init; for (;;) { if (!cond) break; { body } _cN:; post } }
//
// so that the condition and the post statement can have temporaries, and
// continue jumps to the post statement.
fn (Gen g) mut genFor(Stmt st) {
    g.emit("{")
    g.indent++
    g.pushScope()
    if (st.init >= 0) {
        g.genStmt(st.init)
    }
    int label = -1
    if (st.post >= 0) {
        g.ntmp++
        label = g.ntmp
    }
    g.emit("for (;;) {")
    g.indent++
    if (st.expr >= 0) {
        int mark = g.slots.len()
        string c = g.condVal(g.gexpr(st.expr), mark)
        g.emit("if (!(" + c + ")) break;")
    }
    g.loops.push(LoopCtx{mark: g.slots.len(), label: label})
    g.emit("{")
    g.indent++
    g.genBody(st.body)
    g.indent--
    g.emit("}")
    g.loops = g.loops.slice(0, g.loops.len() - 1)
    if (st.post >= 0) {
        g.emit("_c" + label.string() + ":;")
        g.genStmt(st.post)
    }
    g.indent--
    g.emit("}")
    g.popScope(true)
    g.indent--
    g.emit("}")
}

// A switch becomes an if/else chain (so break and continue in a case reach
// the loop). The value is evaluated once; its temporaries live until the
// end of the switch.
fn (Gen g) mut genSwitch(Stmt st) {
    int t = g.typeOf(st.expr)
    bool isEnum = g.kindOf(t) == Kind.Enum
    int mark = g.slots.len()
    g.emit("{")
    g.indent++
    // A label that calls a mut method could change (and free) what the
    // value was read from, so then the switch keeps its own copy.
    bool labelMut = false
    for (int ci = 0; ci < st.count; ci++) {
        Case lc = g.c.ast.cases[g.c.ast.at(st.list, ci)]
        for (int li = 0; li < lc.labelCount && !isEnum; li++) {
            if (g.hasMutEffects(g.c.ast.labels[g.c.ast.at(lc.labels, li)].expr)) {
                labelMut = true
            }
        }
    }
    string sv = ""
    if (labelMut) {
        sv = g.ownedTemp(st.expr)
    } else {
        sv = g.gexpr(st.expr)
    }
    if (!isIdent(sv)) {
        sv = g.alias(t, sv)
    }
    string tag = ""
    string payload = ""
    if (isEnum) {
        payload = "SD_BOX_GET(" + sv + ", sd_E_" + g.declName(t) + ")"
        tag = g.newTmp()
        g.emit("int32_t " + tag + " = " + payload + ".tag;")
    }
    bool first = true
    int closes = 0
    int def = -1
    for (int i = 0; i < st.count; i++) {
        Case cs = g.c.ast.cases[g.c.ast.at(st.list, i)]
        if (cs.isDefault) {
            def = cs.body
            continue
        }
        if (isEnum) {
            []string conds = []string{}
            for (int j = 0; j < cs.labelCount; j++) {
                conds.push(tag + " == " + g.c.labelCase[g.c.ast.at(cs.labels, j)].string())
            }
            if (first) {
                g.emit("if (" + conds.join(" || ") + ") {")
            } else {
                g.emit("} else if (" + conds.join(" || ") + ") {")
            }
        } else {
            []string saved = g.out
            g.out = []string{}
            int lmark = g.slots.len()
            bool chain = false
            for (int h = 1; h < cs.labelCount; h++) {
                if (g.hasEffects(g.c.ast.labels[g.c.ast.at(cs.labels, h)].expr)) {
                    chain = true
                }
            }
            string cond = ""
            if (chain) {
                // The labels are tried in order: a later one is evaluated
                // only when the earlier ones did not match.
                cond = g.newTmp()
                g.emit("bool " + cond + " = false;")
                for (int k2 = 0; k2 < cs.labelCount; k2++) {
                    if (k2 > 0) {
                        g.emit("if (!" + cond + ") {")
                        g.indent++
                    }
                    int lm = g.slots.len()
                    int le2 = g.c.ast.labels[g.c.ast.at(cs.labels, k2)].expr
                    string lv = g.gexpr(le2)
                    g.emit(cond + " = " + g.eqExpr(t, sv, lv) + ";")
                    g.releaseTo(lm)
                    if (k2 > 0) {
                        g.indent--
                        g.emit("}")
                    }
                }
            } else {
                []string vconds = []string{}
                for (int k = 0; k < cs.labelCount; k++) {
                    int le = g.c.ast.labels[g.c.ast.at(cs.labels, k)].expr
                    vconds.push(g.eqExpr(t, sv, g.gexpr(le)))
                }
                cond = g.condVal(vconds.join(" || "), lmark)
            }
            []string lines = g.out
            g.out = saved
            if (first) {
                for (int m = 0; m < lines.len(); m++) {
                    g.out.push(lines[m])
                }
                g.emit("if (" + cond + ") {")
            } else if (lines.len() == 0) {
                g.emit("} else if (" + cond + ") {")
            } else {
                g.emit("} else {")
                closes++
                for (int q = 0; q < lines.len(); q++) {
                    g.out.push(lines[q])
                }
                g.emit("if (" + cond + ") {")
            }
        }
        first = false
        g.indent++
        g.pushScope()
        if (isEnum && cs.labelCount == 1) {
            g.genBindings(t, payload, g.c.ast.at(cs.labels, 0))
        }
        g.genStmts(cs.body)
        g.popScope(!g.c.blockExits(cs.body))
        g.indent--
    }
    if (def >= 0) {
        if (first) {
            g.emit("{")
        } else {
            g.emit("} else {")
        }
        g.indent++
        g.genBody(def)
        g.indent--
        g.emit("}")
    } else if (!first) {
        g.emit("}")
    }
    for (int c = 0; c < closes; c++) {
        g.emit("}")
    }
    g.releaseTo(mark)
    g.indent--
    g.emit("}")
}

// case Shape.Rect(float w, float h): the bindings are copies of the fields.
fn (Gen g) mut genBindings(int t, string payload, int li) {
    Label l = g.c.ast.labels[li]
    int d = g.c.types.decl(t)
    EnumCase ec = g.c.enumCase(d, g.c.labelCase[li])
    for (int k = 0; k < l.paramCount; k++) {
        int pi = g.c.ast.at(l.params, k)
        if (g.c.paramVar[pi] < 0) {
            continue
        }
        int pt = g.c.vars[g.c.paramVar[pi]].ty
        string v = payload + ".u.c_" + ec.name + ".f" + k.string()
        g.declareLocal(g.c.ast.params[pi].name, pt, g.retainExpr(pt, v))
    }
}

// ---- return ----

// Returns value (a C expression for an owned result, or "" in a function
// without results): the result is computed first, then every slot except
// the ones in keep is released, then the defers run.
fn (Gen g) mut emitReturn(string value, []string keep) {
    int r = tyVoid
    if (g.curFn >= 0) {
        r = g.c.fnRet[g.curFn]
    }
    bool rel = g.needsRelease(0, keep)
    if (!rel && !g.defers) {
        if (value == "") {
            g.emit("return;")
        } else {
            g.emit("return " + value + ";")
        }
        return
    }
    string rv = ""
    if (value != "") {
        rv = g.newTmp()
        g.emit(g.ctype(r) + " " + rv + " = " + value + ";")
    }
    g.releaseAbove(0, keep)
    if (g.defers) {
        g.emit("sd_defer_run(_dm);")
    }
    if (value == "") {
        g.emit("return;")
    } else {
        g.emit("return " + rv + ";")
    }
}

// A returned local variable can be moved out instead of retained.
fn (Gen g) isPlainMove(int e) bool {
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    if (x.kind != ExprKind.Ident || i.res != Res.Local || i.narrowed || i.ifaceFrom >= 0) {
        return false
    }
    VarKind k = g.c.vars[i.ref].kind
    if (k != VarKind.Local && k != VarKind.LocalConst) {
        return false
    }
    return !i.wrap || g.wrapIsIdentity(i.ty)
}

fn (Gen g) mut genReturn(Stmt st) {
    int n = g.c.ast.fns[g.curFn].resultCount
    if (n == 0 || st.count == 0) {
        g.emitReturn("", []string{})
        return
    }
    if (st.count == 1) {
        int e = g.c.ast.at(st.list, 0)
        if (g.isPlainMove(e)) {
            string name = "l_" + g.c.vars[g.c.info[e].ref].name
            g.emitReturn(name, []string{name})
            return
        }
        g.emitReturn(g.ownVal(g.gexpr(e), g.typeOf(e)), []string{})
        return
    }
    []int es = []int{}
    for (int i = 0; i < st.count; i++) {
        es.push(g.c.ast.at(st.list, i))
    }
    []string vals = g.operands(es)
    // return null, err for a plain result: err must not be null, or the
    // caller would read the null (the checker rejects a literal null).
    int rtype = g.c.fnRet[g.curFn]
    for (int r = 0; r < es.len() - 1; r++) {
        int pt = g.c.types.part(rtype, r)
        if (g.c.ast.exprs[es[r]].kind == ExprKind.NullLit && !g.c.types.isOpt(pt) && pt != tyError && g.c.types.part(rtype, es.len() - 1) == tyError) {
            string msg = g.c.ast.fns[g.curFn].name + " returned null as result " + (r + 1).string() + " without an error"
            g.emit("if (sd_err_is_null(" + vals[es.len() - 1] + ")) sd_crash(\"%s\", " + cString(msg) + ");")
            break
        }
    }
    []string keep = []string{}
    []string fields = []string{}
    for (int k = 0; k < es.len(); k++) {
        string v = vals[k]
        if (g.isPlainMove(es[k]) && v == "l_" + g.c.vars[g.c.info[es[k]].ref].name && !keep.contains(v)) {
            keep.push(v)
            fields.push(v)
        } else {
            fields.push(g.ownVal(v, g.typeOf(es[k])))
        }
    }
    g.emitReturn("(" + g.ctype(g.c.fnRet[g.curFn]) + "){" + fields.join(", ") + "}", keep)
}

// ---- defer ----

fn (Gen g) blockHasDefer(int b) bool {
    if (b < 0) {
        return false
    }
    Block bl = g.c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        if (g.stmtHasDefer(g.c.ast.at(bl.list, i))) {
            return true
        }
    }
    return false
}

fn (Gen g) stmtHasDefer(int s) bool {
    if (s < 0) {
        return false
    }
    Stmt st = g.c.ast.stmts[s]
    if (st.kind == StmtKind.Defer) {
        return true
    }
    if (st.kind == StmtKind.If) {
        return g.blockHasDefer(st.body) || g.blockHasDefer(st.els) || g.stmtHasDefer(st.elseIf)
    }
    if (st.kind == StmtKind.For) {
        return g.blockHasDefer(st.body)
    }
    if (st.kind == StmtKind.ExprStmt || st.kind == StmtKind.Assign) {
        return g.groupHasDefer(st.expr)
    }
    if (st.kind == StmtKind.Return && st.count == 1) {
        return g.groupHasDefer(g.c.ast.at(st.list, 0))
    }
    if (st.kind == StmtKind.Switch || st.kind == StmtKind.Select) {
        for (int i = 0; i < st.count; i++) {
            if (g.blockHasDefer(g.c.ast.cases[g.c.ast.at(st.list, i)].body)) {
                return true
            }
        }
    }
    return false
}

// defer f(args): the callee value, receiver and arguments are evaluated now
// into an environment that the runtime copies onto the goroutine's defer
// stack; a thunk sd_dN calls f with them and releases them (runtime/README.md,
// section 9).
fn (Gen g) mut genDefer(Stmt st) {
    int mark = g.slots.len()
    int e = st.expr
    []int ops = g.callOperands(e)
    []string vals = g.operands(ops)
    g.ndefer++
    string name = "sd_d" + g.ndefer.string()
    []string fields = []string{}
    []string inits = []string{}
    []string evals = []string{}
    for (int i = 0; i < ops.len(); i++) {
        int t = g.typeOf(ops[i])
        fields.push(" " + g.ctype(t) + " a" + i.string() + ";")
        inits.push(g.ownVal(vals[i], t))
        evals.push("e_->a" + i.string())
    }
    if (ops.len() == 0) {
        g.emit("sd_defer_push(" + name + ", NULL, 0);")
    } else {
        g.emit("{ " + name + "_env env_ = {" + inits.join(", ") + "}; sd_defer_push(" + name + ", &env_, sizeof env_); }")
    }
    g.releaseTo(mark)
    []string saved = g.out
    int savedIndent = g.indent
    g.out = []string{}
    g.indent = 1
    string call = g.callFrom(e, evals)
    int rt = g.coreType(e)
    if (rt == tyVoid) {
        g.emit(call + ";")
    } else {
        g.emit(g.ctype(rt) + " r_ = " + call + ";")
        string rr = g.releaseCall(rt, "r_")
        if (rr != "") {
            g.emit(rr + ";")
        }
    }
    for (int k = 0; k < ops.len(); k++) {
        string rel = g.releaseCall(g.typeOf(ops[k]), evals[k])
        if (rel != "") {
            g.emit(rel + ";")
        }
    }
    string body = g.out.join("")
    g.out = saved
    g.indent = savedIndent
    if (ops.len() == 0) {
        g.thunks.push("static void " + name + "(void *p) {\n  (void)p;\n" + body + "}\n")
        return
    }
    g.thunks.push("typedef struct {" + fields.join("") + " } " + name + "_env;\nstatic void " + name + "(void *p) {\n  " + name + "_env *e_ = p;\n" + body + "}\n")
}

// Whether e is a group (or try of a group) whose block has a defer.
fn (Gen g) groupHasDefer(int e) bool {
    if (e < 0) {
        return false
    }
    Expr x = g.c.ast.exprs[e]
    if (x.kind == ExprKind.Try) {
        return g.groupHasDefer(x.a)
    }
    return x.kind == ExprKind.Group && g.blockHasDefer(x.block)
}

// ---- concurrency ----

// spawn f(args) inside a group block: like defer, the callee value,
// receiver and arguments are evaluated now, into an argument struct with a
// descriptor; sd_spawn deep-copies it for the new goroutine (borrowing
// ours), and the trampoline sd_gN calls f with the copy and returns its
// error (runtime/README.md, section 10).
fn (Gen g) mut genSpawn(Stmt st) {
    int mark = g.slots.len()
    int e = st.expr
    string grp = g.groups[g.groups.len() - 1]
    []int ops = g.callOperands(e)
    []string vals = g.operands(ops)
    g.nspawn++
    string name = "sd_g" + g.nspawn.string()
    []string fields = []string{}
    []string descs = []string{}
    []string evals = []string{}
    bool anyCounted = false
    for (int i = 0; i < ops.len(); i++) {
        int t = g.typeOf(ops[i])
        fields.push(" " + g.ctype(t) + " a" + i.string() + ";")
        descs.push("SD_FIELD(" + name + "_args, a" + i.string() + ", " + g.desc(t) + ")")
        evals.push("a_->a" + i.string())
        if (g.counted(t)) {
            anyCounted = true
        }
    }
    if (ops.len() == 0) {
        g.emit("sd_spawn(" + grp + ", " + name + ", NULL, NULL);")
    } else {
        g.emit("{ " + name + "_args a_ = {" + vals.join(", ") + "}; sd_spawn(" + grp + ", " + name + ", &" + name + "_type, &a_); }")
    }
    g.releaseTo(mark)
    []string saved = g.out
    int savedIndent = g.indent
    g.out = []string{}
    g.indent = 1
    string call = g.callFrom(e, evals)
    if (g.coreType(e) == tyVoid) {
        g.emit(call + ";")
        g.emit("return SD_ERR_NULL;")
    } else {
        g.emit("return " + call + ";")
    }
    string body = g.out.join("")
    g.out = saved
    g.indent = savedIndent
    string head = "static sd_err " + name + "(void *p) {\n"
    if (ops.len() == 0) {
        g.thunks.push(head + "  (void)p;\n" + body + "}\n")
        return
    }
    string kind = "SD_STRUCT_TYPE_TRIVIAL"
    if (anyCounted) {
        kind = "SD_STRUCT_TYPE"
    }
    []string defs = []string{"typedef struct {" + fields.join("") + " } " + name + "_args;\n"}
    defs.push("static const sd_field " + name + "_fields[] = {" + descs.join(", ") + "};\n")
    defs.push("static const sd_type " + name + "_type = " + kind + "(" + cString("spawn " + g.c.describe(e)) + ", " + name + "_args, " + name + "_fields);\n")
    defs.push(head + "  " + name + "_args *a_ = p;\n" + body + "}\n")
    g.thunks.push(defs.join(""))
}

// The send or receive call of a select case.
fn (Gen g) commExpr(int comm) int {
    return g.c.ast.stmts[comm].expr
}

// select { case ... } becomes an array of sd_select_case (the channels and
// the values to send are evaluated first, in order), sd_select, and an
// if/else chain on the chosen index (not a C switch, so that break and
// continue in a case reach the loop):
//
//   T _tR; sd_select_case _tC[] = {{ch, SD_RECV, &_tR, false}, {ch2, SD_SEND, &v, false}};
//   int _tK = sd_select(_tC, 2);
//   if (_tK == 0) { T? l_x = _tC[0].ok ? _tR : null; ... } else if (_tK == 1) { ... }
fn (Gen g) mut genSelect(Stmt st) {
    int mark = g.slots.len()
    g.emit("{")
    g.indent++
    []int es = []int{}
    []int first = []int{}
    for (int i = 0; i < st.count; i++) {
        Case cs = g.c.ast.cases[g.c.ast.at(st.list, i)]
        int e = g.commExpr(cs.comm)
        first.push(es.len())
        es.push(g.recvOf(e))
        if (g.c.info[e].builtin == Builtin.Send) {
            es.push(g.arg(e, 0))
        }
    }
    []string vals = g.operands(es)
    []string inits = []string{}
    []string dests = []string{}
    for (int j = 0; j < st.count; j++) {
        Case cj = g.c.ast.cases[g.c.ast.at(st.list, j)]
        int ej = g.commExpr(cj.comm)
        string ch = vals[first[j]]
        if (g.c.info[ej].builtin == Builtin.Send) {
            string p = g.addr(g.typeOf(g.arg(ej, 0)), vals[first[j] + 1])
            inits.push("{" + ch + ", SD_SEND, (void *)" + p + ", false}")
            dests.push("")
        } else {
            string d = g.newTmp()
            g.emit(g.ctype(g.elemOf(g.typeOf(g.recvOf(ej)))) + " " + d + ";")
            inits.push("{" + ch + ", SD_RECV, &" + d + ", false}")
            dests.push(d)
        }
    }
    string cases = g.newTmp()
    string k = g.newTmp()
    g.emit("sd_select_case " + cases + "[] = {" + inits.join(", ") + "};")
    g.emit("int " + k + " = sd_select(" + cases + ", " + st.count.string() + ");")
    for (int m = 0; m < st.count; m++) {
        Case cm = g.c.ast.cases[g.c.ast.at(st.list, m)]
        if (m == 0) {
            g.emit("if (" + k + " == 0) {")
        } else {
            g.emit("} else if (" + k + " == " + m.string() + ") {")
        }
        g.indent++
        g.pushScope()
        if (dests[m] != "") {
            g.genReceived(cm.comm, cases + "[" + m.string() + "].ok", dests[m])
        }
        g.genStmts(cm.body)
        g.popScope(!g.c.blockExits(cm.body))
        g.indent--
    }
    if (st.count > 0) {
        g.emit("}")
    }
    g.releaseTo(mark)
    g.indent--
    g.emit("}")
}

// The value received by a select case: declared as the case's variable,
// or released when the case has none.
fn (Gen g) mut genReceived(int comm, string ok, string d) {
    Stmt st = g.c.ast.stmts[comm]
    int e = st.expr
    int opt = g.typeOf(e)
    int v = -1
    if (st.kind == StmtKind.Assign) {
        v = g.c.targetVar[g.c.ast.at(st.list, 0)]
    }
    if (v >= 0) {
        g.declareLocal(g.c.vars[v].name, opt, g.okOpt(opt, ok, d))
        return
    }
    string rel = g.releaseCall(g.elemOf(g.typeOf(g.recvOf(e))), d)
    if (rel != "") {
        g.emit("if (" + ok + ") " + rel + ";")
    }
}
