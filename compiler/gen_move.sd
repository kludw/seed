// The C generator, continued: moving a local's value on its last use.
//
// A store copies the value it is given: reading a local x into a struct
// literal, a list, a container, another variable or an argument kept by a
// mut call retains x's value, and x's block releases it at its end. When
// the store is x's last use the pair is wasted, and worse, the store's copy
// shares x's container (count 2), so changing it later copies the whole
// list. Moving instead hands x's own count over to the store.
//
// The rule is syntactic, so that it is right without a flow analysis: a
// local x declared by a statement directly in a block B may be moved by a
// later statement s directly in B when
//
//   - s is an expression statement, an assignment, a declaration, a return,
//     a local const or a defer (a statement with no blocks of its own),
//   - s mentions x exactly once, and not on the right of && or || nor in a
//     group block (where the move would happen on some paths only),
//   - no later statement of B mentions x (not even in a nested block).
//
// Then every path through s moves x (or leaves s early, by try or a crash,
// before the move, with x still live), and nothing reads, assigns or
// releases x afterwards. ownVal does the move: the local's slot stops being
// live (moveOut), so the end of the block, return, break and continue do not
// release it, and a frame field is set to null after the line that took the
// value. A loop body is a block of its own, so a local declared outside a
// loop is never moved inside it.
package main

// Computes g.moveAt (statement -> the locals it may move out of) for the
// function whose body is b.
fn (Gen g) mut analyzeMoves(int b) {
    g.moveAt = map[int][]int{}
    g.mvStmtAt = []int{}
    g.mvLevel = map[int]int{}
    g.mvDecl = map[int]int{}
    g.mvLast = map[int]int{}
    g.mvCount = map[int]int{}
    g.mvCond = map[int]bool{}
    g.mvBlock(b)
    []int vs = g.mvLast.keys()
    for (int i = 0; i < vs.len(); i++) {
        int v = vs[i]
        int? last = g.mvLast[v]
        int? decl = g.mvDecl[v]
        int? n = g.mvCount[v]
        bool? cond = g.mvCond[v]
        if (last == null || decl == null || n == null || last < 0 || last == decl || n != 1 || (cond != null && cond)) {
            continue
        }
        StmtKind k = g.c.ast.stmts[last].kind
        if (k != StmtKind.ExprStmt && k != StmtKind.Assign && k != StmtKind.Return && k != StmtKind.Const && k != StmtKind.Defer) {
            continue
        }
        VarKind vk = g.c.vars[v].kind
        if ((vk != VarKind.Local && vk != VarKind.LocalConst) || g.isUnboxed(v) || !g.counted(g.c.vars[v].ty) || g.isBorrowed(v) || g.borrowRoots[v] != null) {
            continue
        }
        []int? at = g.moveAt[last]
        if (at == null) {
            g.moveAt[last] = []int{v}
        } else {
            []int more = at
            more.push(v)
            g.moveAt[last] = more
        }
    }
}

// The C names of the locals statement s may move out of (for ownVal).
fn (Gen g) movesAt(int s) map[string]bool {
    map[string]bool out = map[string]bool{}
    []int? vs = g.moveAt[s]
    if (vs == null) {
        return out
    }
    for (int i = 0; i < vs.len(); i++) {
        out[g.lname(vs[i])] = true
    }
    return out
}

// The walk keeps a stack with the statement being visited in each
// enclosing block (mvStmtAt; -1 for a level that is not a block: the init
// and post of a for, an else if, a select case's comm). For each local
// declared directly in a block it records the level and statement of the
// declaration, the last statement of that block that mentions it, how many
// times that statement mentions it, and whether a mention there is
// conditional (in a nested level, or on the right of && or ||).
fn (Gen g) mut mvBlock(int b) {
    if (b < 0) {
        return
    }
    Block bl = g.c.ast.blocks[b]
    int d = g.mvStmtAt.len()
    g.mvStmtAt.push(-1)
    for (int i = 0; i < bl.count; i++) {
        int s = g.c.ast.at(bl.list, i)
        g.mvStmtAt[d] = s
        g.mvStmt(s)
    }
    g.mvStmtAt = g.mvStmtAt.slice(0, d)
}

// A statement that is not directly in a block.
fn (Gen g) mut mvNested(int s) {
    if (s < 0) {
        return
    }
    int d = g.mvStmtAt.len()
    g.mvStmtAt.push(-1)
    g.mvStmt(s)
    g.mvStmtAt = g.mvStmtAt.slice(0, d)
}

fn (Gen g) mut mvDeclare(int v, int s) {
    int d = g.mvStmtAt.len() - 1
    if (v >= 0 && g.mvStmtAt[d] >= 0) {
        g.mvLevel[v] = d
        g.mvDecl[v] = s
    }
}

fn (Gen g) mut mvStmt(int s) {
    Stmt st = g.c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Const:
        g.mvDeclare(g.c.stmtVar[s], s)
        g.mvExpr(st.expr, false)
    case StmtKind.Assign:
        g.mvExpr(st.expr, false)
        for (int i = 0; i < st.count; i++) {
            int ti = g.c.ast.at(st.list, i)
            Target tg = g.c.ast.targets[ti]
            if (tg.kind == TargetKind.Place) {
                g.mvExpr(tg.expr, false)
            } else if (tg.kind == TargetKind.Decl) {
                g.mvDeclare(g.c.targetVar[ti], s)
            }
        }
    case StmtKind.Return:
        for (int j = 0; j < st.count; j++) {
            g.mvExpr(g.c.ast.at(st.list, j), false)
        }
    case StmtKind.If:
        g.mvExpr(st.expr, false)
        g.mvBlock(st.body)
        g.mvNested(st.elseIf)
        g.mvBlock(st.els)
    case StmtKind.For:
        // The init's locals live in the loop's own scope, which is not a
        // block: they are never moved.
        int d = g.mvStmtAt.len()
        g.mvStmtAt.push(-1)
        if (st.init >= 0) {
            g.mvStmt(st.init)
        }
        g.mvExpr(st.expr, true)
        if (st.post >= 0) {
            g.mvStmt(st.post)
        }
        g.mvBlock(st.body)
        g.mvStmtAt = g.mvStmtAt.slice(0, d)
    case StmtKind.Switch, StmtKind.Select:
        g.mvExpr(st.expr, false)
        for (int k = 0; k < st.count; k++) {
            Case cs = g.c.ast.cases[g.c.ast.at(st.list, k)]
            for (int l = 0; l < cs.labelCount; l++) {
                g.mvExpr(g.c.ast.labels[g.c.ast.at(cs.labels, l)].expr, true)
            }
            g.mvNested(cs.comm)
            g.mvBlock(cs.body)
        }
    case StmtKind.ExprStmt, StmtKind.IncDec, StmtKind.Defer, StmtKind.Spawn, StmtKind.Assert:
        g.mvExpr(st.expr, false)
    case StmtKind.Break, StmtKind.Continue, StmtKind.Bad:
        return
    }
}

fn (Gen g) mut mvExpr(int e, bool cond) {
    if (e < 0) {
        return
    }
    Expr x = g.c.ast.exprs[e]
    if (x.kind == ExprKind.Ident) {
        ExprInfo i = g.c.info[e]
        if (i.res == Res.Local) {
            g.mvMention(i.ref, cond)
        }
        return
    }
    if (x.kind == ExprKind.Group) {
        g.mvBlock(x.block)
        return
    }
    if (x.kind == ExprKind.FnLit) {
        // Evaluating a function literal reads the variables it captures.
        []int caps = g.c.capturesOf(x.lit)
        for (int c = 0; c < caps.len(); c++) {
            g.mvMention(g.c.vars[caps[c]].src, cond)
        }
        return
    }
    g.mvExpr(x.a, cond)
    bool short = x.kind == ExprKind.Binary && (x.op == Tok.AndAnd || x.op == Tok.OrOr)
    g.mvExpr(x.b, cond || short)
    for (int k = 0; k < x.count; k++) {
        g.mvExpr(g.c.ast.at(x.list, k), cond)
    }
}

// A mention of local v: counted for the statement of v's block it is in.
fn (Gen g) mut mvMention(int v, bool cond) {
    int? level = g.mvLevel[v]
    if (level == null) {
        return
    }
    int s = g.mvStmtAt[level]
    int? last = g.mvLast[v]
    int n = 0
    if (last != null && last == s) {
        int? c = g.mvCount[v]
        if (c != null) {
            n = c
        }
    } else {
        g.mvLast[v] = s
        g.mvCond[v] = false
    }
    g.mvCount[v] = n + 1
    if (cond || g.mvStmtAt.len() - 1 > level) {
        g.mvCond[v] = true
    }
}

// ---- borrowed locals ----
//
// T x = place (a variable, a field path of one, an element of a list
// reached through one: Expr x = g.c.ast.exprs[e]) copies the value, which
// retains every counted part (a struct's strings and lists) and releases
// them all at the end of the block. When x is never changed, and nothing
// changes the place's variable where x could see it while x is in scope,
// x can hold the value without owning it: it is declared as a plain C local
// with the place's bits, never retained, released, moved or put in the
// cleanup frame (it owns nothing to release on a crash). A copy that must
// own the value (a store, a return) retains it, as for a parameter.
//
// "Changes" are the mutations of the function: assignments and ++/-- of a
// place, mut built-ins, mut interface methods, and mut methods called on a
// place. A mutation of root.p (p the field path from the variable, cut at
// the first index) can only change what x reads at root.q when one of p and
// q is a prefix of the other. A mut method called on root.p changes only
// root.p.f for the first-level fields f of its receiver in its mod set
// (modSets: computed for every mut method from its body, through the mut
// methods it calls on its own receiver), so Expr x = g.c.ast.exprs[e] stays
// borrowed across g.emit(...), which changes g.out and other fields but not
// g.c. A move of the root would hand its container to another owner, which
// could then change it in place, so roots of borrowed locals are never
// moved.

// A mutation found by the walk: the place's variable and field path, and
// the mut method called on it (-1 for any other mutation of the whole
// place).
type MutEvent struct {
    int root
    string path
    int method
}

// A candidate borrowed local: declared from root.path, in scope while the
// events start..end of the walk happen.
type BorrowCand struct {
    int var
    int root
    string path
    int start
    int end
}

fn joinField(string a, string b) string {
    if (a == "") {
        return b
    }
    return a + "." + b
}

// The field path of the place e below its variable: "c.ast.exprs" for
// g.c.ast.exprs[e].a (cut at the first index), "" for the variable itself.
fn (Gen g) fieldPath(int e) string {
    string p = g.rawPath(e)
    for (int i = 0; i < p.len(); i++) {
        if (p[i] == '[') {
            if (i == 0) {
                return ""
            }
            return p.slice(0, i - 1)
        }
    }
    return p
}

fn (Gen g) rawPath(int e) string {
    Expr x = g.c.ast.exprs[e]
    if (x.kind == ExprKind.Field) {
        return joinField(g.rawPath(x.a), x.text)
    }
    if (x.kind == ExprKind.Index) {
        return joinField(g.rawPath(x.a), "[")
    }
    return ""
}

// Whether a mutation of path a can change what is read at path b (or the
// other way round).
fn pathsOverlap(string a, string b) bool {
    return a == "" || b == "" || a == b || a.startsWith(b + ".") || b.startsWith(a + ".")
}

// Whether event ev can change what is read at path p of its variable.
fn (Gen g) eventHits(MutEvent ev, string p) bool {
    if (ev.method < 0) {
        return pathsOverlap(ev.path, p)
    }
    []string? fields = g.modSets[ev.method]
    if (fields == null || fields.contains("")) {
        return pathsOverlap(ev.path, p)
    }
    for (int i = 0; i < fields.len(); i++) {
        if (pathsOverlap(joinField(ev.path, fields[i]), p)) {
            return true
        }
    }
    return false
}

// Whether e reads a place: a variable, a field of a place, an element of a
// list place (the index is evaluated when x is declared).
fn (Gen g) isPlaceRead(int e) bool {
    Expr x = g.c.ast.exprs[e]
    ExprInfo i = g.c.info[e]
    if (i.ifaceFrom >= 0 || (i.wrap && !g.wrapIsIdentity(i.ty))) {
        return false
    }
    if (x.kind == ExprKind.Ident) {
        return i.res == Res.Local
    }
    if (x.kind == ExprKind.Field) {
        return i.res == Res.Field && g.isPlaceRead(x.a)
    }
    if (x.kind == ExprKind.Index) {
        return i.res == Res.ListIndex && g.isPlaceRead(x.a)
    }
    return false
}

// Computes g.modSets: for every mut method, the first-level fields of its
// receiver it may change ("" for any: the whole receiver, or a native).
fn (Gen g) mut computeModSets() {
    g.modSets = map[int][]string{}
    map[int][]int deps = map[int][]int{}
    for (int f = 0; f < g.c.ast.fns.len(); f++) {
        FnDecl fd = g.c.ast.fns[f]
        if (!fd.isMethod || !fd.recvMut) {
            continue
        }
        if (fd.body < 0 || g.c.recvVar[f] < 0) {
            g.modSets[f] = []string{""}
            continue
        }
        g.bwEvents = []MutEvent{}
        g.bwCands = []BorrowCand{}
        g.bwOn = false
        g.bwBlock(fd.body)
        []string set = []string{}
        []int calls = []int{}
        int rv = g.c.recvVar[f]
        for (int i = 0; i < g.bwEvents.len(); i++) {
            MutEvent ev = g.bwEvents[i]
            if (ev.root != rv) {
                continue
            }
            string field = ev.path
            for (int j = 0; j < field.len(); j++) {
                if (field[j] == '.') {
                    field = field.slice(0, j)
                    break
                }
            }
            if (field == "" && ev.method >= 0) {
                if (!calls.contains(ev.method)) {
                    calls.push(ev.method)
                }
            } else if (!set.contains(field)) {
                set.push(field)
            }
        }
        g.modSets[f] = set
        deps[f] = calls
    }
    bool changed = true
    for (; changed; ) {
        changed = false
        []int fs = deps.keys()
        for (int k = 0; k < fs.len(); k++) {
            []int? cs = deps[fs[k]]
            []string? own = g.modSets[fs[k]]
            if (cs == null || own == null || own.contains("")) {
                continue
            }
            []string set2 = own
            bool grew = false
            for (int m = 0; m < cs.len(); m++) {
                []string? theirs = g.modSets[cs[m]]
                if (theirs == null) {
                    continue
                }
                for (int n = 0; n < theirs.len(); n++) {
                    if (!set2.contains(theirs[n])) {
                        set2.push(theirs[n])
                        grew = true
                    }
                }
            }
            if (grew) {
                g.modSets[fs[k]] = set2
                changed = true
            }
        }
    }
}

// Computes g.borrowed (the borrowed locals of the function whose body is
// b) and g.borrowRoots (their places' variables).
fn (Gen g) mut analyzeBorrows(int b) {
    g.borrowed = map[int]bool{}
    g.borrowRoots = map[int]bool{}
    g.bwEvents = []MutEvent{}
    g.bwCands = []BorrowCand{}
    g.bwOn = true
    g.bwBlock(b)
    g.bwOn = false
    map[int]bool changed = map[int]bool{}
    for (int i = 0; i < g.bwEvents.len(); i++) {
        changed[g.bwEvents[i].root] = true
    }
    for (int k = 0; k < g.bwCands.len(); k++) {
        BorrowCand bc = g.bwCands[k]
        if (changed[bc.var] != null) {
            continue
        }
        bool ok = true
        for (int j = bc.start; j < bc.end && ok; j++) {
            MutEvent ev = g.bwEvents[j]
            if (ev.root == bc.root && g.eventHits(ev, bc.path)) {
                ok = false
            }
        }
        if (ok) {
            g.borrowed[bc.var] = true
            g.borrowRoots[bc.root] = true
        }
    }
}

// Whether local v holds a borrowed value (see analyzeBorrows).
fn (Gen g) isBorrowed(int v) bool {
    return g.borrowed[v] != null
}

// The walk: the mutations in order (bwEvents) and, when bwOn, the
// candidate borrowed locals with the events of their scope.
fn (Gen g) mut bwBlock(int b) {
    if (b < 0) {
        return
    }
    int first = g.bwCands.len()
    Block bl = g.c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        int s = g.c.ast.at(bl.list, i)
        g.bwStmt(s)
        if (g.bwOn) {
            g.bwCandidate(s)
        }
    }
    for (int k = first; k < g.bwCands.len(); k++) {
        if (g.bwCands[k].end < 0) {
            g.bwCands[k].end = g.bwEvents.len()
        }
    }
}

// T x = place, directly in a block: a candidate whose scope starts after
// the statement.
fn (Gen g) mut bwCandidate(int s) {
    Stmt st = g.c.ast.stmts[s]
    if (st.kind != StmtKind.Assign || st.count != 1) {
        return
    }
    int ti = g.c.ast.at(st.list, 0)
    if (g.c.ast.targets[ti].kind != TargetKind.Decl) {
        return
    }
    int v = g.c.targetVar[ti]
    if (v < 0 || g.c.vars[v].kind != VarKind.Local || g.isUnboxed(v) || !g.counted(g.c.targetType[ti])) {
        return
    }
    if (!g.isPlaceRead(st.expr)) {
        return
    }
    int root = g.rootVar(st.expr)
    if (root < 0 || root == v) {
        return
    }
    g.bwCands.push(BorrowCand{var: v, root: root, path: g.fieldPath(st.expr), start: g.bwEvents.len(), end: -1})
}

fn (Gen g) mut bwEvent(int place, int method) {
    int root = g.rootVar(place)
    if (root >= 0) {
        g.bwEvents.push(MutEvent{root: root, path: g.fieldPath(place), method: method})
    }
}

fn (Gen g) mut bwStmt(int s) {
    if (s < 0) {
        return
    }
    Stmt st = g.c.ast.stmts[s]
    g.bwExpr(st.expr)
    switch (st.kind) {
    case StmtKind.Assign:
        for (int i = 0; i < st.count; i++) {
            Target tg = g.c.ast.targets[g.c.ast.at(st.list, i)]
            if (tg.kind == TargetKind.Place) {
                g.bwExpr(tg.expr)
                g.bwEvent(tg.expr, -1)
            }
        }
    case StmtKind.IncDec:
        g.bwEvent(st.expr, -1)
    case StmtKind.Return:
        for (int j = 0; j < st.count; j++) {
            g.bwExpr(g.c.ast.at(st.list, j))
        }
    case StmtKind.If:
        g.bwBlock(st.body)
        g.bwStmt(st.elseIf)
        g.bwBlock(st.els)
    case StmtKind.For:
        g.bwStmt(st.init)
        g.bwBlock(st.body)
        g.bwStmt(st.post)
    case StmtKind.Switch, StmtKind.Select:
        for (int k = 0; k < st.count; k++) {
            Case cs = g.c.ast.cases[g.c.ast.at(st.list, k)]
            for (int l = 0; l < cs.labelCount; l++) {
                g.bwExpr(g.c.ast.labels[g.c.ast.at(cs.labels, l)].expr)
            }
            g.bwStmt(cs.comm)
            g.bwBlock(cs.body)
        }
    case StmtKind.ExprStmt, StmtKind.Defer, StmtKind.Spawn, StmtKind.Assert, StmtKind.Const:
        return
    case StmtKind.Break, StmtKind.Continue, StmtKind.Bad:
        return
    }
}

fn (Gen g) mut bwExpr(int e) {
    if (e < 0) {
        return
    }
    Expr x = g.c.ast.exprs[e]
    if (x.kind == ExprKind.Group) {
        g.bwBlock(x.block)
        return
    }
    g.bwExpr(x.a)
    g.bwExpr(x.b)
    for (int k = 0; k < x.count; k++) {
        g.bwExpr(g.c.ast.at(x.list, k))
    }
    if (x.kind != ExprKind.Call) {
        return
    }
    ExprInfo i = g.c.info[e]
    if (i.res == Res.Method && g.c.ast.fns[i.ref].recvMut) {
        g.bwEvent(g.recvOf(e), i.ref)
    } else if (i.res == Res.IfaceMethod && g.c.ifaceMethod(i.ref, i.sub).isMut) {
        g.bwEvent(g.recvOf(e), -1)
    } else if (i.res == Res.Builtin && isMutBuiltin(i.builtin)) {
        g.bwEvent(g.recvOf(e), -1)
    }
}
