// The `seed` command line.
//
//   seed build [-o out] <dir | file.sd>   compile a program to an executable
//   seed run <dir | file.sd> [args...]    compile and run, passing the exit code
//   seed test [-v] [--run text] [dir...]  run the tests of the packages under the dirs
//   seed fmt [--check] <file.sd | dir>... format the files in place (see fmt.sd)
//   seed c <dir | file.sd...>             write the C program to stdout (for tests)
//   seed ast <file.sd>...                 print the syntax tree (for debugging)
//   seed lsp                              a language server on stdin/stdout (lsp.sd)
//
// A program is the package main in a directory (all its .sd files), or a
// single .sd file. The packages it imports are loaded by load.sd.
package main

import "crypto"
import "encoding"
import "errors"
import "fmt"
import "fs"
import "os"

// The C compiler and its flags, used by build, run and test. seed build
// optimises fully (buildOpt); seed run and seed test compile faster
// (quickOpt), which takes about half the C compiler's time. The runtime is
// compiled once into the cache, always with buildOpt.
const string cCompiler = "cc"
const []string cFlags = []string{"-std=c11", "-w"}
const string buildOpt = "-O2"
const string quickOpt = "-O1"
const []string cLibs = []string{"-lm", "-lpthread"}

const string usage = "usage:\n  seed build [-o out] <dir | file.sd>\n  seed run <dir | file.sd> [args...]\n  seed test [-v] [--run text] [dir...]\n  seed fmt [--check] <file.sd | dir>...\n  seed c <dir | file.sd...>\n  seed ast <file.sd>...\n  seed lsp\n"

fn main([]string args) error {
    if (args.len() < 2) {
        fmt.eprint(usage)
        os.exit(2)
    }
    string cmd = args[1]
    []string rest = args.slice(2, args.len())
    string root = rootDir(args[0])
    if (cmd == "c") {
        if (rest.len() == 0) {
            fmt.eprint(usage)
            os.exit(2)
        }
        Build t = try targetOf(rest)
        string? program = try compileProgram(root, t, false)
        if (program == null) {
            os.exit(1)
        }
        string runtime = try readRuntime(root)
        fmt.print(runtime + program)
        return null
    }
    if (cmd == "ast") {
        Parser p = try parseFiles(rest)
        fmt.print(p.ast.dump())
        return null
    }
    if (cmd == "fmt") {
        int code = try fmtCommand(rest)
        os.exit(code)
    }
    if (cmd == "build") {
        string out = ""
        int o = -1
        int? found = rest.index("-o")
        if (found != null) {
            o = found
        }
        if (o >= 0 && o + 1 < rest.len()) {
            out = rest[o + 1]
            rest.remove(o + 1)
            rest.remove(o)
        }
        if (rest.len() != 1 || rest[0] == "-o") {
            fmt.eprint(usage)
            os.exit(2)
        }
        Build bt = try targetOf(rest)
        if (out == "") {
            out = bt.name
        }
        bool ok = try build(root, bt, out)
        if (!ok) {
            os.exit(1)
        }
        return null
    }
    if (cmd == "run") {
        if (rest.len() == 0) {
            fmt.eprint(usage)
            os.exit(2)
        }
        []string progArgs = rest.slice(1, rest.len())
        if (progArgs.len() > 0 && progArgs[0] == "--") {
            progArgs.remove(0)
        }
        Build rt = try targetOf(rest.slice(0, 1))
        int code = try run(root, rt, progArgs)
        os.exit(code)
    }
    if (cmd == "test") {
        int code = try testCommand(root, rest)
        os.exit(code)
    }
    if (cmd == "lsp") {
        return lspCommand(root)
    }
    fmt.eprint("seed: unknown command " + cmd + "\n" + usage)
    os.exit(2)
}

// The directory that contains runtime/ and lib/: $SEED_ROOT, or the parent
// of the directory of the binary (which is <root>/build/seedN). The binary
// is found through os.executable(), which resolves symbolic links, so seed
// works when it is called through $PATH or a link.
fn rootDir(string argv0) string {
    string? env = os.env("SEED_ROOT")
    if (env != null && env != "") {
        if (env.endsWith("/") && env.len() > 1) {
            return env.slice(0, env.len() - 1)
        }
        return env
    }
    string exe = os.executable()
    if (exe == "") {
        exe = argv0
    }
    return dirName(dirName(exe))
}

fn dirName(string path) string {
    int slash = -1
    for (int i = 0; i < path.len(); i++) {
        if (path[i] == '/') {
            slash = i
        }
    }
    if (slash < 0) {
        return "."
    }
    if (slash == 0) {
        return "/"
    }
    return path.slice(0, slash)
}

fn baseName(string path) string {
    string p = path
    if (p.endsWith("/") && p.len() > 1) {
        p = p.slice(0, p.len() - 1)
    }
    int slash = -1
    for (int i = 0; i < p.len(); i++) {
        if (p[i] == '/') {
            slash = i
        }
    }
    string base = p.slice(slash + 1, p.len())
    if (base.endsWith(".sd")) {
        return base.slice(0, base.len() - 3)
    }
    if (base == "." || base == ".." || base == "") {
        return lastElement(absPath(p))
    }
    return base
}

// What to compile: the files of the root package and its directory, the
// project root (which imports are relative to: the root package's
// directory, or the directory given to seed test) and a name for the
// program (for seed test, the package's import path).
type Build struct {
    []string files
    string dir
    string projectRoot
    string name
}

// A directory, or one or more .sd files (which must be in one directory).
fn targetOf([]string args) (Build, error) {
    if (args.len() == 1 && !args[0].endsWith(".sd")) {
        string dir = args[0]
        if (dir.endsWith("/") && dir.len() > 1) {
            dir = dir.slice(0, dir.len() - 1)
        }
        if (!fs.isDir(dir)) {
            return null, errors.new(dir + " is neither a directory nor a .sd file")
        }
        []string files = try sourceFiles(dir)
        if (files.len() == 0) {
            return null, errors.new(dir + " has no .sd files")
        }
        return Build{files: files, dir: dir, projectRoot: dir, name: baseName(dir)}, null
    }
    for (int i = 0; i < args.len(); i++) {
        if (!args[i].endsWith(".sd")) {
            return null, errors.new(args[i] + ": expected a .sd file")
        }
        if (dirName(args[i]) != dirName(args[0])) {
            return null, errors.new(args[i] + " and " + args[0] + " are in different directories; a package is one directory")
        }
    }
    string fdir = dirName(args[0])
    return Build{files: args, dir: fdir, projectRoot: fdir, name: baseName(args[0])}, null
}

// Loads, checks and translates a program to C, without the runtime (seed c
// pastes the whole runtime above it; build, run and test only seed.h, see
// writeC). Compile errors are printed to stderr, and the result is then
// null. In test mode, the root package's tests/ files are compiled too, and
// the program runs the tests instead of main.
fn compileProgram(string root, Build t, bool testMode) (string?, error) {
    Checker? c = try checkedProgram(root, t, testMode)
    if (c == null) {
        return null, null
    }
    string natives = try readNatives(c.ast)
    Gen g = newGen(c)
    return g.genProgram(natives), null
}

// Loads and checks a program (see compileProgram); null, after printing
// the errors, when it has compile errors.
fn checkedProgram(string root, Build t, bool testMode) (Checker?, error) {
    Loader l = newLoader(root, t.projectRoot)
    string path = ""
    if (testMode) {
        path = t.name
    }
    int pkg = l.addPackage(path, t.dir, absPath(t.dir).startsWith(l.libDir + "/"))
    try l.addFiles(pkg, t.files, false)
    if (testMode) {
        []string testFiles = try sourceFiles(joinPath(t.dir, "tests"))
        try l.addFiles(pkg, testFiles, true)
    }
    try l.loadImports()
    if (l.p.diags.count() > 0) {
        l.p.diags.print()
        printUnformatted(l.p.diags, l.unformatted)
        return null, null
    }
    // An unformatted file is an error, but the program is still checked,
    // so that the real errors are not hidden behind it; they come first.
    Checker c = newChecker(l.p.ast, l.p.diags, testMode)
    c.libDir = l.libDir
    c.projectRoot = t.projectRoot
    c.checkProgram()
    if (c.diags.count() > 0 || l.unformatted.len() > 0) {
        c.diags.print()
        printUnformatted(c.diags, l.unformatted)
        return null, null
    }
    return c, null
}

// Prints the "not formatted" errors (Loader.unformatted) after the others.
fn printUnformatted(Diags d, []Diag list) {
    for (int i = 0; i < list.len(); i++) {
        fmt.eprint(d.render(list[i]))
    }
}

// Parses the files into one tree (for seed ast). Syntax errors are printed
// to stderr and end the process with exit code 1.
fn parseFiles([]string files) (Parser, error) {
    Parser p = newParser(newDiags())
    for (int i = 0; i < files.len(); i++) {
        string src = try fs.read(files[i])
        int file = p.diags.addFile(files[i], src)
        p.parseFile(file)
    }
    if (p.diags.count() > 0) {
        p.diags.print()
        os.exit(1)
    }
    return p, null
}

fn tempDir() string {
    string? t = os.env("TMPDIR")
    if (t != null && t != "") {
        if (t.endsWith("/")) {
            return t.slice(0, t.len() - 1)
        }
        return t
    }
    return "/tmp"
}

// Runs the C compiler with optimisation opt on the inputs (C files and
// objects) into the executable out, or into an object with -c (args holds
// the extra arguments).
fn runCC(string opt, []string args, []string inputs, string out, bool link) error {
    []string argv = []string{cCompiler}
    for (int i = 0; i < cFlags.len(); i++) {
        argv.push(cFlags[i])
    }
    argv.push(opt)
    for (int a = 0; a < args.len(); a++) {
        argv.push(args[a])
    }
    argv.push("-o")
    argv.push(out)
    for (int k = 0; k < inputs.len(); k++) {
        argv.push(inputs[k])
    }
    if (link) {
        for (int j = 0; j < cLibs.len(); j++) {
            argv.push(cLibs[j])
        }
    }
    int code = try os.run(argv)
    if (code != 0) {
        return errors.new("the C compiler failed (exit code " + code.string() + "); seed c prints the C program")
    }
    return null
}

// Compiles a program into the executable out, through C files in dir:
// build, run and test (opt is buildOpt or quickOpt). The program is made
// of one C unit per package (gen_unit.sd); the object of every package but
// the root one is kept in the cache (next to the runtime's object, see
// runtimeObject) under a hash of its C text, the C compiler and its flags,
// so a package is compiled once for every program that uses it, until it
// (or the compiler, or the runtime's header) changes. The missing objects
// and the root package's are compiled in parallel, then linked with the
// runtime. Without a cache the program is one self-contained C file, as
// for seed c. Returns false when there were compile errors.
fn buildProgram(string root, Build t, bool testMode, string dir, string name, string out, string opt) (bool, error) {
    Checker? c = try checkedProgram(root, t, testMode)
    if (c == null) {
        return false, null
    }
    string cfile = dir + "/" + name + ".c"
    string? rt = try runtimeObject(root)
    if (rt == null) {
        string natives = try readNatives(c.ast)
        Gen whole = newGen(c)
        string program = whole.genProgram(natives)
        string runtime = try readRuntime(root)
        try fs.write(cfile, runtime + program)
        try runCC(opt, []string{}, []string{cfile}, out, true)
        return true, null
    }
    string cache = dirName(rt)
    []string natives2 = try readPackageNatives(c.ast)
    Gen g = newGen(c)
    []Unit units = g.genUnits(natives2)
    string header = try readRuntimeHeader(root)
    []string objs = []string{}
    []Unit missing = []Unit{}
    for (int i = 0; i < units.len(); i++) {
        string text = header + units[i].text
        if (units[i].root) {
            try fs.write(cfile, text)
            continue
        }
        string key = encoding.hexEncode(crypto.sha256(cCompiler + "\n" + cFlags.join(" ") + " " + opt + "\n" + text)).slice(0, 20)
        string obj = cache + "/pkg-" + units[i].path.replace("/", "_") + "-" + key + ".o"
        objs.push(obj)
        if (!fs.exists(obj)) {
            missing.push(Unit{path: obj, root: false, text: text})
        }
    }
    objs.push(rt)
    if (missing.len() == 0) {
        []string inputs = []string{cfile}
        for (int j = 0; j < objs.len(); j++) {
            inputs.push(objs[j])
        }
        try runCC(opt, []string{}, inputs, out, true)
        return true, null
    }
    string rootObj = dir + "/" + name + ".o"
    error err = group {
        for (int k = 0; k < missing.len(); k++) {
            spawn compileObject(cache, missing[k].text, missing[k].path, opt)
        }
        spawn runCC(opt, []string{"-c"}, []string{cfile}, rootObj, false)
    }
    if (err != null) {
        return false, err
    }
    []string linked = []string{rootObj}
    for (int m = 0; m < objs.len(); m++) {
        linked.push(objs[m])
    }
    try runCC(opt, []string{}, linked, out, true)
    return true, null
}

// The compiled runtime, runtime-<key>.o in the cache directory
// ($SEED_ROOT/build/cache, or $TMPDIR/seed-cache-$USER when that cannot be
// written), where key is a hash of the runtime's text, the C compiler and
// its flags; it is compiled on first use, always with buildOpt. Null when
// neither directory can be used.
fn runtimeObject(string root) (string?, error) {
    string text = try readRuntime(root)
    string key = encoding.hexEncode(crypto.sha256(cCompiler + "\n" + cFlags.join(" ") + " " + buildOpt + "\n" + text)).slice(0, 20)
    string user = "seed"
    string? u = os.env("USER")
    if (u != null && u != "") {
        user = u
    }
    []string dirs = []string{root + "/build/cache", tempDir() + "/seed-cache-" + user}
    for (int i = 0; i < dirs.len(); i++) {
        string obj = dirs[i] + "/runtime-" + key + ".o"
        if (fs.exists(obj)) {
            return obj, null
        }
        error err = compileObject(dirs[i], text, obj, buildOpt)
        if (err == null) {
            return obj, null
        }
    }
    return null, null
}

// Compiles the C text into the object obj in the cache directory dir,
// through files with a random name and a rename, so that concurrent
// compilers never see a half-written object.
fn compileObject(string dir, string text, string obj, string opt) error {
    try fs.mkdir(dir)
    string tmp = dir + "/tmp-" + encoding.hexEncode(crypto.randomBytes(8))
    defer _ = fs.remove(tmp + ".c")
    try fs.write(tmp + ".c", text)
    error err = runCC(opt, []string{"-c"}, []string{tmp + ".c"}, tmp + ".o", false)
    if (err != null) {
        _ = fs.remove(tmp + ".o")
        return err
    }
    return fs.rename(tmp + ".o", obj)
}

// Compiles a program into the executable out, through C files in a new
// temporary directory (removed afterwards). Returns false when there were
// compile errors.
fn build(string root, Build t, string out) (bool, error) {
    string dir = try fs.makeTemp("seed-build-")
    defer _ = fs.removeAll(dir)
    return buildProgram(root, t, false, dir, baseName(out), out, buildOpt)
}

// Builds a program into a new temporary directory, runs it with args,
// removes the directory and returns the program's exit code.
fn run(string root, Build t, []string args) (int, error) {
    string dir = try fs.makeTemp("seed-run-")
    defer _ = fs.removeAll(dir)
    string exe = dir + "/" + t.name
    bool ok = try buildProgram(root, t, false, dir, t.name, exe, quickOpt)
    if (!ok) {
        return 1, null
    }
    []string argv = []string{exe}
    for (int i = 0; i < args.len(); i++) {
        argv.push(args[i])
    }
    return os.run(argv)
}

// ---- seed test ----

// `seed test [-v] [--run text] [dir...]`: finds every package under the
// directories (default: the current one) that has a tests/ directory,
// builds a test program for it and runs it. Each test program prints one
// line per failed test (and with -v one per passed test) and writes its
// counts to a file; the summary adds them up. --run runs only the tests
// whose description contains the text; the options are passed on to the
// test programs. Returns the exit code: 1 if a test failed, a package did
// not compile or --run matched no test, 2 for a bad option.
fn testCommand(string root, []string args) (int, error) {
    []string dirs = []string{}
    []string opts = []string{}
    bool verbose = false
    string? filter = null
    for (int a = 0; a < args.len(); a++) {
        string arg = args[a]
        if (arg == "-v") {
            verbose = true
            opts.push(arg)
        } else if (arg == "--run") {
            if (a + 1 >= args.len()) {
                fmt.eprint("seed test: --run needs the text to look for in test descriptions\n" + usage)
                return 2, null
            }
            a++
            filter = args[a]
            opts.push(arg)
            opts.push(args[a])
        } else if (arg.startsWith("-")) {
            string hint = ""
            if (arg == "-run" || arg.startsWith("--run=") || arg.startsWith("-run=")) {
                hint = "; write --run <text>"
            }
            fmt.eprint("seed test: unknown option " + arg + hint + "\n" + usage)
            return 2, null
        } else {
            dirs.push(arg)
        }
    }
    if (dirs.len() == 0) {
        dirs = []string{"."}
    }
    int passed = 0
    int failed = 0
    string tmp = try fs.makeTemp("seed-test-")
    defer _ = fs.removeAll(tmp)
    int built = 0
    for (int i = 0; i < dirs.len(); i++) {
        string base = dirs[i]
        if (base.endsWith("/...")) {
            base = base.slice(0, base.len() - 4)
        }
        if (base.endsWith("/") && base.len() > 1) {
            base = base.slice(0, base.len() - 1)
        }
        if (!fs.isDir(base)) {
            return 2, errors.new("seed test: " + base + " is not a directory")
        }
        []string pkgs = try testPackages(base, []string{})
        if (pkgs.len() == 0 && baseName(base) == "tests") {
            return 2, errors.new("seed test: " + base + " holds the tests of a package; name the package's directory instead: seed test " + dirName(base))
        }
        for (int j = 0; j < pkgs.len(); j++) {
            built++
            string work = tmp + "/" + built.string()
            try fs.mkdir(work)
            if (verbose) {
                fmt.println("testing " + pkgs[j])
            }
            []int counts = try testPackage(root, base, pkgs[j], work, opts)
            passed = passed + counts[0]
            failed = failed + counts[1]
        }
    }
    fmt.println(passed.string() + " passed, " + failed.string() + " failed")
    if (failed > 0) {
        return 1, null
    }
    if (filter != null && passed == 0) {
        fmt.eprintln("seed test: no test description contains \"" + filter + "\"")
        return 1, null
    }
    return 0, null
}

// The package directories under dir (dir included) that have tests.
fn testPackages(string dir, []string found) ([]string, error) {
    []string out = found
    []string names = try fs.list(dir)
    bool hasSource = false
    for (int i = 0; i < names.len(); i++) {
        string path = joinPath(dir, names[i])
        if (fs.isDir(path)) {
            continue
        }
        if (names[i].endsWith(".sd")) {
            hasSource = true
        }
    }
    string tests = joinPath(dir, "tests")
    if (hasSource && fs.isDir(tests)) {
        []string testFiles = try sourceFiles(tests)
        if (testFiles.len() > 0) {
            out.push(dir)
        }
    }
    for (int j = 0; j < names.len(); j++) {
        string sub = joinPath(dir, names[j])
        if (names[j] != "tests" && !names[j].startsWith(".") && fs.isDir(sub)) {
            out = try testPackages(sub, out)
        }
    }
    return out, null
}

// Builds and runs the tests of the package in dir (base is the project
// root) in the directory work, passing the options opts (-v, --run text)
// to the test program. Returns the numbers of passed and failed tests.
fn testPackage(string root, string base, string dir, string work, []string opts) ([]int, error) {
    []string files = try sourceFiles(dir)
    string name = baseName(dir)
    if (dir != base && base == ".") {
        name = dir
    } else if (dir != base) {
        name = dir.slice(base.len() + 1, dir.len())
    }
    Build t = Build{files: files, dir: dir, projectRoot: base, name: name}
    string exe = work + "/test"
    string results = work + "/results"
    bool ok = try buildProgram(root, t, true, work, "test", exe, quickOpt)
    if (!ok) {
        fmt.println("FAIL " + dir + ": the package or its tests do not compile")
        return []int{0, 1}, null
    }
    []string argv = []string{exe, results}
    for (int i = 0; i < opts.len(); i++) {
        argv.push(opts[i])
    }
    int code = try os.run(argv)
    string? text, _ = fs.read(results)
    if (text == null) {
        fmt.println("FAIL " + dir + ": the test program ended with exit code " + code.string())
        return []int{0, 1}, null
    }
    []string parts = text.trim().split(" ")
    if (parts.len() != 2) {
        return null, errors.new("seed test: unexpected results file " + results)
    }
    int p = try parts[0].toInt()
    int f = try parts[1].toInt()
    return []int{p, f}, null
}
