// The checker, continued: calls of functions, methods, built-in methods,
// core package functions, conversions and enum cases.
package main

fn (Checker c) mut checkCall(int e) {
    Expr x = c.ast.exprs[e]
    Expr callee = c.ast.exprs[x.a]
    if (callee.kind == ExprKind.Ident) {
        c.checkNamedCall(e, callee.text)
        return
    }
    if (callee.kind == ExprKind.Field) {
        c.checkSelectorCall(e)
        return
    }
    c.checkExpr(x.a)
    c.checkValueCall(e)
}

// Whether t is a function type or a nullable one.
fn (Checker c) isFuncType(int t) bool {
    if (c.types.isOpt(t)) {
        return c.kindOf(c.types.elem(t)) == Kind.Func
    }
    return c.kindOf(t) == Kind.Func
}

// A call of a function value: the callee (already checked) has a function
// type.
fn (Checker c) mut checkValueCall(int e) {
    Expr x = c.ast.exprs[e]
    int ft = c.typeOf(x.a)
    if (ft == tyInvalid) {
        c.checkArgsLoosely(e)
        return
    }
    if (c.kindOf(ft) != Kind.Func) {
        Pos cpos = c.ast.exprs[x.a].pos
        if (c.types.isOpt(ft) && c.kindOf(c.types.elem(ft)) == Kind.Func) {
            c.errorHint(cpos, c.describe(x.a) + " is nullable (" + c.typeName(ft) + ")", "check " + c.describe(x.a) + " != null before calling it")
        } else {
            c.error(cpos, c.describe(x.a) + " has type " + c.typeName(ft) + ", which cannot be called")
        }
        c.checkArgsLoosely(e)
        return
    }
    []int ps = []int{}
    for (int i = 0; i < c.types.count(ft); i++) {
        ps.push(c.types.part(ft, i))
    }
    c.info[e].res = Res.ValueCall
    c.setType(e, c.types.elem(ft))
    c.checkArgs(e, ps, c.describe(x.a))
}

// f(args) or a conversion such as int(x).
fn (Checker c) mut checkNamedCall(int e, string n) {
    Expr x = c.ast.exprs[e]
    Pos cpos = c.ast.exprs[x.a].pos
    int v = c.lookupVar(n)
    if (v >= 0) {
        int vt = c.vars[v].ty
        if (c.isFuncType(vt)) {
            c.checkExpr(x.a)
            c.checkValueCall(e)
            return
        }
        c.error(cpos, n + " is a variable of type " + c.typeName(vt) + ", not a function")
        c.checkArgsLoosely(e)
        return
    }
    int? g = c.global(c.pkgOf(cpos), n)
    if (g != null) {
        c.checkGlobalCall(e, g, n)
        return
    }
    if (n == "int" || n == "float" || n == "byte" || n == "string" || n == "bool") {
        c.checkConversion(e, n)
        return
    }
    Suggest s = newSuggest(n)
    for (int j = 0; j < c.ast.fns.len(); j++) {
        FnDecl cand = c.ast.fns[j]
        if (!cand.isMethod && !cand.isTest && c.fnPkg(j) == c.pkgOf(cpos)) {
            s.consider(cand.name)
        }
    }
    for (int k = c.scope.len() - 1; k >= 0; k--) {
        s.consider(c.vars[c.scope[k]].name)
    }
    c.errorHint(cpos, "undefined function " + n, s.hint())
    for (int m = 0; m < x.count; m++) {
        c.checkExpr(c.ast.at(x.list, m))
    }
    c.setType(e, tyInvalid)
}

// A call of a package-level name (what is "f" or "pkg.f" for messages).
fn (Checker c) mut checkGlobalCall(int e, int g, string what) {
    Pos cpos = c.ast.exprs[c.ast.exprs[e].a].pos
    Global gl = c.globalList[g]
    switch (gl.kind) {
    case GlobalKind.Fn:
        int f = gl.index
        FnDecl fd = c.ast.fns[f]
        []int ps = []int{}
        for (int i = 0; i < fd.paramCount; i++) {
            ps.push(c.paramType(f, i))
        }
        c.info[e].res = Res.Func
        c.info[e].ref = f
        c.setType(e, c.fnRet[f])
        c.checkArgs(e, ps, what + "()")
        return
    case GlobalKind.Type:
        c.errorHint(cpos, what + " is a type", "a struct value is written " + what + "{field: value, ...}")
    case GlobalKind.Const:
        c.error(cpos, what + " is a constant, not a function")
    }
    c.checkArgsLoosely(e)
}

fn (Checker c) mut checkConversion(int e, string n) {
    Expr x = c.ast.exprs[e]
    c.setType(e, tyInvalid)
    if (x.count != 1) {
        c.error(x.pos, "the conversion " + n + "() takes exactly one argument")
        return
    }
    int arg = c.ast.at(x.list, 0)
    c.checkExpr(arg)
    if (!c.isValue(arg)) {
        return
    }
    int from = c.typeOf(arg)
    int to = tyInvalid
    if (n == "int" && (from == tyInt || from == tyFloat || from == tyByte)) {
        to = tyInt
    } else if (n == "float" && (from == tyInt || from == tyFloat)) {
        to = tyFloat
    } else if (n == "byte" && (from == tyInt || from == tyByte)) {
        to = tyByte
    } else if (n == "string" && (from == tyString || from == c.types.listOf(tyByte))) {
        to = tyString
    } else if (n == "bool" && from == tyBool) {
        to = tyBool
    }
    if (to == tyInvalid) {
        Pos apos = c.ast.exprs[arg].pos
        if (c.types.isOpt(from)) {
            c.errorHint(apos, c.describe(arg) + " is nullable (" + c.typeName(from) + ")", "check " + c.describe(arg) + " != null first")
        } else if (n == "string") {
            c.errorHint(x.pos, "cannot convert " + c.typeName(from) + " to string", "use .string() to get text, or string(bytes) for a []byte")
        } else {
            c.error(x.pos, "cannot convert " + c.typeName(from) + " to " + n)
        }
        return
    }
    c.info[e].res = Res.Conv
    c.setType(e, to)
}

// base.name(args): a package function, an enum case with data, a method or
// a built-in method.
fn (Checker c) mut checkSelectorCall(int e) {
    Expr x = c.ast.exprs[e]
    int fe = x.a
    Expr callee = c.ast.exprs[fe]
    int base = callee.a
    string name = callee.text
    int pkg = c.pkgNamed(base)
    if (pkg >= 0) {
        int? g = c.pkgMember(pkg, name, callee.pos)
        if (g == null) {
            c.checkArgsLoosely(e)
            return
        }
        c.checkGlobalCall(e, g, c.ast.exprs[base].text + "." + name)
        return
    }
    int d = c.typeNamed(base)
    if (d >= 0) {
        c.checkEnumNew(e, d, name)
        return
    }
    c.checkExpr(base)
    if (!c.isValue(base)) {
        c.checkArgsLoosely(e)
        return
    }
    int bt = c.typeOf(base)
    Kind k = c.kindOf(bt)
    if (k == Kind.Struct || k == Kind.Enum) {
        int rd = c.types.decl(bt)
        string tname = c.declDisplayName(rd)
        int? m = c.methods[methodKey(rd, name)]
        int fi = -1
        if (k == Kind.Struct) {
            fi = c.findField(rd, name)
        }
        if (m == null && fi >= 0 && c.isFuncType(c.fieldType(rd, fi))) {
            // s.f(args) calls the function value in the field f.
            if (!c.fieldVisible(rd, fi, callee.pos)) {
                c.privateField(callee.pos, rd, name)
                c.checkArgsLoosely(e)
                return
            }
            c.info[fe].res = Res.Field
            c.info[fe].sub = fi
            c.setType(fe, c.fieldType(rd, fi))
            c.applyNarrowing(fe)
            c.checkValueCall(e)
            return
        }
        if (m == null) {
            if (fi >= 0) {
                c.error(callee.pos, name + " is a field of " + tname + ", not a method")
            } else {
                Suggest s = newSuggest(name)
                for (int i = 0; i < c.ast.fns.len(); i++) {
                    if (c.fnRecv.len() > i && c.fnRecv[i] == rd) {
                        s.consider(c.ast.fns[i].name)
                    }
                }
                c.errorHint(callee.pos, tname + " has no method " + name, s.hint())
            }
            c.checkArgsLoosely(e)
            return
        }
        FnDecl md = c.ast.fns[m]
        if (!md.isPub && c.fnPkg(m) != c.pkgOf(callee.pos)) {
            c.errorHint(callee.pos, "the method " + name + " of " + tname + " is not pub", "only pub methods can be called outside package " + c.ast.pkgs[c.fnPkg(m)].name)
            c.checkArgsLoosely(e)
            return
        }
        if (md.recvMut) {
            c.requireMutable(base, "call the mut method " + name + "() on")
            c.killMut(c.pathKey(base))
        }
        []int ps = []int{}
        for (int j = 0; j < md.paramCount; j++) {
            ps.push(c.paramType(m, j))
        }
        c.info[e].res = Res.Method
        c.info[e].ref = m
        c.setType(e, c.fnRet[m])
        c.checkArgs(e, ps, tname + "." + name + "()")
        return
    }
    if (k == Kind.Interface) {
        c.checkIfaceCall(e, base, bt, name)
        return
    }
    c.checkBuiltin(e, base, name)
}

// v.name(args) on a value of an interface type.
fn (Checker c) mut checkIfaceCall(int e, int base, int it, string name) {
    Expr x = c.ast.exprs[e]
    Pos cpos = c.ast.exprs[x.a].pos
    int d = c.types.decl(it)
    int mi = c.findIfaceMethod(d, name)
    if (mi < 0) {
        Suggest s = newSuggest(name)
        TypeDecl td = c.ast.typeDecls[d]
        for (int i = 0; i < td.methodCount; i++) {
            s.consider(c.ifaceMethod(d, i).name)
        }
        c.errorHint(cpos, "interface " + c.declDisplayName(d) + " has no method " + name, s.hint())
        c.checkArgsLoosely(e)
        return
    }
    if (c.ifaceMethod(d, mi).isMut) {
        c.requireMutable(base, "call the mut method " + name + "() on")
        c.killMut(c.pathKey(base))
    }
    int ft = c.ifaceMethodType(d, mi)
    if (ft == tyInvalid) {
        c.checkArgsLoosely(e)
        return
    }
    []int ps = []int{}
    for (int j = 0; j < c.types.count(ft); j++) {
        ps.push(c.types.part(ft, j))
    }
    c.info[e].res = Res.IfaceMethod
    c.info[e].ref = d
    c.info[e].sub = mi
    c.setType(e, c.types.elem(ft))
    c.checkArgs(e, ps, c.typeName(it) + "." + name + "()")
}

// Checks the arguments of a call that could not be resolved, so that errors
// inside them are still reported.
fn (Checker c) mut checkArgsLoosely(int e) {
    Expr x = c.ast.exprs[e]
    for (int i = 0; i < x.count; i++) {
        c.checkExpr(c.ast.at(x.list, i))
    }
    c.setType(e, tyInvalid)
}

fn (Checker c) mut checkEnumNew(int e, int d, string name) {
    Expr x = c.ast.exprs[e]
    TypeDecl td = c.ast.typeDecls[d]
    string tname = c.declDisplayName(d)
    Pos cpos = c.ast.exprs[x.a].pos
    if (td.kind != DeclKind.Enum) {
        c.error(cpos, tname + " is a struct type; it has no case " + name)
        c.checkArgsLoosely(e)
        return
    }
    int ci = c.findCase(d, name)
    if (ci < 0) {
        c.unknownCase(cpos, d, name)
        c.checkArgsLoosely(e)
        return
    }
    EnumCase ec = c.enumCase(d, ci)
    if (ec.paramCount == 0) {
        c.errorHint(x.pos, tname + "." + name + " carries no data", "write it without parentheses: " + tname + "." + name)
        c.checkArgsLoosely(e)
        return
    }
    []int ps = []int{}
    for (int i = 0; i < ec.paramCount; i++) {
        ps.push(c.caseParamType(d, ci, i))
    }
    c.info[e].res = Res.EnumNew
    c.info[e].ref = d
    c.info[e].sub = ci
    c.setType(e, c.declType[d])
    c.checkArgs(e, ps, tname + "." + name)
}

// A built-in method such as xs.push(x) or s.split(sep).
fn (Checker c) mut checkBuiltin(int e, int recv, string name) {
    Expr x = c.ast.exprs[e]
    Pos cpos = c.ast.exprs[x.a].pos
    int rt = c.typeOf(recv)
    Kind k = c.kindOf(rt)
    Builtin b = Builtin.None
    []int ps = []int{}
    int res = tyVoid
    bool isMut = false
    if (k == Kind.Int || k == Kind.Float || k == Kind.Bool || k == Kind.Byte) {
        if (name == "string") {
            b = Builtin.String
            res = tyString
        }
    } else if (k == Kind.String) {
        if (name == "len") {
            b = Builtin.Len
            res = tyInt
        } else if (name == "string") {
            b = Builtin.String
            res = tyString
        } else if (name == "slice") {
            b = Builtin.SSlice
            ps = []int{tyInt, tyInt}
            res = tyString
        } else if (name == "contains") {
            b = Builtin.SContains
            ps = []int{tyString}
            res = tyBool
        } else if (name == "index") {
            b = Builtin.SIndex
            ps = []int{tyString}
            res = c.types.optOf(tyInt)
        } else if (name == "startsWith") {
            b = Builtin.SStarts
            ps = []int{tyString}
            res = tyBool
        } else if (name == "endsWith") {
            b = Builtin.SEnds
            ps = []int{tyString}
            res = tyBool
        } else if (name == "split") {
            b = Builtin.Split
            ps = []int{tyString}
            res = c.types.listOf(tyString)
        } else if (name == "trim") {
            b = Builtin.Trim
            res = tyString
        } else if (name == "replace") {
            b = Builtin.Replace
            ps = []int{tyString, tyString}
            res = tyString
        } else if (name == "toUpper") {
            b = Builtin.Upper
            res = tyString
        } else if (name == "toLower") {
            b = Builtin.Lower
            res = tyString
        } else if (name == "toInt") {
            b = Builtin.ToInt
            res = c.types.tuple2(tyInt, tyError)
        } else if (name == "toFloat") {
            b = Builtin.ToFloat
            res = c.types.tuple2(tyFloat, tyError)
        } else if (name == "bytes") {
            b = Builtin.Bytes
            res = c.types.listOf(tyByte)
        } else if (name == "chars") {
            b = Builtin.Chars
            res = c.types.listOf(tyString)
        }
    } else if (k == Kind.List) {
        int el = c.types.elem(rt)
        if (name == "len") {
            b = Builtin.Len
            res = tyInt
        } else if (name == "push") {
            b = Builtin.Push
            ps = []int{el}
            isMut = true
        } else if (name == "pop") {
            if (c.types.isOpt(el)) {
                c.errorHint(cpos, "pop() is not available on a list of nullable values", c.typeName(el) + "? is not a valid type")
                c.checkArgsLoosely(e)
                return
            }
            b = Builtin.Pop
            res = c.types.optOf(el)
            isMut = true
        } else if (name == "insert") {
            b = Builtin.Insert
            ps = []int{tyInt, el}
            isMut = true
        } else if (name == "remove") {
            b = Builtin.Remove
            ps = []int{tyInt}
            isMut = true
        } else if (name == "contains") {
            b = Builtin.LContains
            ps = []int{el}
            res = tyBool
        } else if (name == "index") {
            b = Builtin.LIndex
            ps = []int{el}
            res = c.types.optOf(tyInt)
        } else if (name == "slice") {
            b = Builtin.LSlice
            ps = []int{tyInt, tyInt}
            res = rt
        } else if (name == "reverse") {
            b = Builtin.Reverse
            isMut = true
        } else if (name == "sort") {
            if (el != tyInt && el != tyFloat && el != tyString && el != tyByte) {
                c.error(cpos, "sort() only works on []int, []float, []string and []byte, not " + c.typeName(rt))
                c.checkArgsLoosely(e)
                return
            }
            b = Builtin.Sort
            isMut = true
        } else if (name == "join") {
            if (el != tyString) {
                c.error(cpos, "join() only works on []string, not " + c.typeName(rt))
                c.checkArgsLoosely(e)
                return
            }
            b = Builtin.Join
            ps = []int{tyString}
            res = tyString
        } else if (name == "sortBy") {
            b = Builtin.SortBy
            ps = []int{c.types.funcOf([]int{el, el}, tyBool)}
            isMut = true
        }
    } else if (k == Kind.Map) {
        if (name == "len") {
            b = Builtin.Len
            res = tyInt
        } else if (name == "delete") {
            b = Builtin.Delete
            ps = []int{c.types.key(rt)}
            isMut = true
        } else if (name == "keys") {
            b = Builtin.Keys
            res = c.types.listOf(c.types.key(rt))
        }
    } else if (k == Kind.Error) {
        if (name == "message") {
            b = Builtin.Message
            res = tyString
        }
    } else if (k == Kind.Chan) {
        int ce = c.types.elem(rt)
        if (name == "send") {
            b = Builtin.Send
            ps = []int{ce}
        } else if (name == "receive") {
            b = Builtin.Receive
            res = ce
            if (ce != tyError) {
                res = c.types.optOf(ce)
            }
        } else if (name == "close") {
            b = Builtin.Close
        }
    } else if (k == Kind.Opt) {
        c.errorHint(c.ast.exprs[recv].pos, c.describe(recv) + " is nullable (" + c.typeName(rt) + ")", "check " + c.describe(recv) + " != null before calling " + name + "()")
        c.checkArgsLoosely(e)
        return
    }
    if (b == Builtin.None) {
        c.error(cpos, c.typeName(rt) + " has no method " + name)
        c.checkArgsLoosely(e)
        return
    }
    if (isMut) {
        c.requireMutable(recv, "call the mut method " + name + "() on")
        c.killMut(c.pathKey(recv))
    }
    c.info[e].res = Res.Builtin
    c.info[e].builtin = b
    c.setType(e, res)
    c.checkArgs(e, ps, name + "()")
}
