// The checker, continued: statements.
//
// Whether a statement always exits (return, break, continue, os.exit, or a
// compound statement whose every branch does) is computed by stmtExits over
// the checked tree. It drives the "missing return" error, unreachable code
// and narrowing after `if (x == null) { return ... }`.
package main

fn (Checker c) mut checkBlock(int b) {
    if (b < 0) {
        return
    }
    Block bl = c.ast.blocks[b]
    bool exited = false
    bool reported = false
    c.pushScope()
    for (int i = 0; i < bl.count; i++) {
        int s = c.ast.at(bl.list, i)
        if (exited && !reported) {
            c.reportUnreachable(s)
            reported = true
        }
        c.checkStmt(s)
        if (c.stmtExits(s)) {
            exited = true
        }
    }
    c.popScope()
}

// Whether some statement of the (checked) block always exits.
fn (Checker c) blockExits(int b) bool {
    if (b < 0) {
        return false
    }
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        if (c.stmtExits(c.ast.at(bl.list, i))) {
            return true
        }
    }
    return false
}

// Whether the (checked) statement always exits: control never reaches the
// statement after it.
fn (Checker c) stmtExits(int s) bool {
    if (s < 0) {
        return false
    }
    Stmt st = c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Return, StmtKind.Break, StmtKind.Continue:
        return true
    case StmtKind.ExprStmt:
        return c.isExitCall(st.expr)
    case StmtKind.If:
        if (st.elseIf >= 0) {
            return c.blockExits(st.body) && c.stmtExits(st.elseIf)
        }
        return st.els >= 0 && c.blockExits(st.body) && c.blockExits(st.els)
    case StmtKind.For:
        return st.expr < 0 && !c.hasBreak(st.body)
    case StmtKind.Switch:
        if (st.count == 0) {
            return false
        }
        bool hasDefault = false
        for (int i = 0; i < st.count; i++) {
            Case cs = c.ast.cases[c.ast.at(st.list, i)]
            if (!c.blockExits(cs.body)) {
                return false
            }
            if (cs.isDefault) {
                hasDefault = true
            }
        }
        return hasDefault || c.kindOf(c.typeOf(st.expr)) == Kind.Enum
    case StmtKind.Select:
        // select always runs one of its cases.
        for (int j = 0; j < st.count; j++) {
            if (!c.blockExits(c.ast.cases[c.ast.at(st.list, j)].body)) {
                return false
            }
        }
        return st.count > 0
    case StmtKind.Bad, StmtKind.Assign, StmtKind.IncDec, StmtKind.Defer, StmtKind.Spawn:
        return false
    case StmtKind.Assert, StmtKind.Const:
        return false
    }
}

fn (Checker c) isExitCall(int e) bool {
    return c.ast.exprs[e].kind == ExprKind.Call && c.info[e].res == Res.Pkg && c.info[e].pkgFn == PkgFn.Exit
}

// Whether a loop body contains a break for that loop.
fn (Checker c) hasBreak(int b) bool {
    if (b < 0) {
        return false
    }
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        Stmt s = c.ast.stmts[c.ast.at(bl.list, i)]
        if (s.kind == StmtKind.Break) {
            return true
        }
        if (s.kind == StmtKind.If && (c.hasBreak(s.body) || c.hasBreak(s.els) || c.stmtHasBreak(s.elseIf))) {
            return true
        }
        if (s.kind == StmtKind.Switch || s.kind == StmtKind.Select) {
            for (int j = 0; j < s.count; j++) {
                if (c.hasBreak(c.ast.cases[c.ast.at(s.list, j)].body)) {
                    return true
                }
            }
        }
    }
    return false
}

fn (Checker c) stmtHasBreak(int s) bool {
    if (s < 0) {
        return false
    }
    Stmt st = c.ast.stmts[s]
    return c.hasBreak(st.body) || c.hasBreak(st.els) || c.stmtHasBreak(st.elseIf)
}

fn (Checker c) mut checkStmt(int s) {
    Stmt st = c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Bad:
        return
    case StmtKind.ExprStmt:
        c.checkExprStmt(st)
    case StmtKind.Assign:
        c.checkAssign(s)
    case StmtKind.IncDec:
        c.checkIncDec(st)
    case StmtKind.Const:
        int ct = c.resolve(st.typeExpr)
        c.checkValue(st.expr, ct, "to initialize " + st.name)
        c.stmtVar[s] = c.declare(st.name, ct, VarKind.LocalConst, st.namePos)
    case StmtKind.If:
        c.checkIf(st)
    case StmtKind.For:
        c.checkFor(st)
    case StmtKind.Switch:
        c.checkSwitch(st)
    case StmtKind.Return:
        if (c.groupDepth > 0) {
            c.errorHint(st.pos, "return is not allowed inside a group block", "the group must wait for its goroutines first; set a variable in the block and return after it")
        }
        c.checkReturn(st)
    case StmtKind.Break, StmtKind.Continue:
        string what = "continue"
        if (st.kind == StmtKind.Break) {
            what = "break"
        }
        if (c.loopDepth == 0) {
            c.error(st.pos, what + " outside of a loop")
        } else if (c.groupDepth > 0 && c.loopDepth == c.groupLoop) {
            c.errorHint(st.pos, what + " cannot leave a group block", "the group must wait for its goroutines first; set a variable in the block and " + what + " after it")
        }
    case StmtKind.Select:
        c.checkSelect(st)
    case StmtKind.Defer:
        c.checkDefer(st)
    case StmtKind.Spawn:
        c.checkSpawn(st)
    case StmtKind.Assert:
        c.unsupported(st.pos, "assert")
    }
}

fn (Checker c) mut checkIncDec(Stmt st) {
    c.checkLvalue(st.expr)
    int t = c.typeOf(st.expr)
    if (t != tyInvalid && t != tyInt && t != tyFloat) {
        string op = "--"
        if (st.inc) {
            op = "++"
        }
        c.error(st.pos, op + " needs an int or float, not " + c.typeName(t))
    }
    c.killAssign(c.pathKey(st.expr))
}

fn (Checker c) mut checkExprStmt(Stmt st) {
    int e = st.expr
    Expr x = c.ast.exprs[e]
    if (x.kind == ExprKind.Group) {
        c.allowGroup = e
        c.checkExpr(e)
        c.errorHint(x.pos, "the error returned by the group is not handled", "use  error err = group {...},  try group {...}  or  _ = group {...}")
        return
    }
    c.checkExpr(e)
    if (x.kind != ExprKind.Call && x.kind != ExprKind.Try) {
        if (x.kind != ExprKind.Bad) {
            c.errorHint(x.pos, "this expression is not used", "only calls can be statements")
        }
        return
    }
    int t = c.typeOf(e)
    if (x.kind == ExprKind.Call && t != tyInvalid && c.types.endsWithError(t)) {
        c.errorHint(x.pos, "the error returned by " + c.describe(e) + " is not handled", "use try, assign it (error err = ...), or discard it with  _ = ...")
    } else {
        c.checkUnusedResult(e)
    }
}

fn (Checker c) mut checkIf(Stmt st) {
    c.checkValue(st.expr, tyBool, "as the if condition")
    c.pushScope()
    c.narrowOn(st.expr, true)
    c.checkBlock(st.body)
    c.popScope()
    if (st.els >= 0 || st.elseIf >= 0) {
        c.pushScope()
        c.narrowOn(st.expr, false)
        if (st.elseIf >= 0) {
            c.pushScope()
            c.checkStmt(st.elseIf)
            c.popScope()
        } else {
            c.checkBlock(st.els)
        }
        c.popScope()
    }
    bool thenExits = c.blockExits(st.body)
    bool elseExits = c.blockExits(st.els) || c.stmtExits(st.elseIf)
    if (thenExits && !elseExits) {
        c.narrowOn(st.expr, false)
    }
    if (elseExits && !thenExits) {
        c.narrowOn(st.expr, true)
    }
}

fn (Checker c) mut checkFor(Stmt st) {
    c.pushScope()
    if (st.init >= 0 && c.ast.stmts[st.init].kind == StmtKind.Assign) {
        c.checkAssign(st.init)
    }
    c.scanBlockKills(st.body)
    c.scanStmtKills(st.post)
    c.scanExprKills(st.expr)
    if (st.expr >= 0) {
        c.checkValue(st.expr, tyBool, "as the loop condition")
    }
    c.pushScope()
    if (st.expr >= 0) {
        c.narrowOn(st.expr, true)
    }
    c.loopDepth++
    c.checkBlock(st.body)
    c.loopDepth--
    c.popScope()
    if (st.post >= 0) {
        Stmt post = c.ast.stmts[st.post]
        if (post.kind == StmtKind.Assign) {
            for (int i = 0; i < post.count; i++) {
                if (c.ast.targets[c.ast.at(post.list, i)].kind == TargetKind.Decl) {
                    c.error(post.pos, "the loop post statement cannot declare a variable")
                }
            }
            c.checkAssign(st.post)
        } else if (post.kind == StmtKind.IncDec) {
            c.checkIncDec(post)
        }
    }
    c.popScope()
}

fn (Checker c) mut checkReturn(Stmt st) {
    if (c.curFn < 0) {
        return
    }
    FnDecl fd = c.ast.fns[c.curFn]
    int n = fd.resultCount
    int ret = c.fnRet[c.curFn]
    bool hasErr = n > 0 && c.resultType(c.curFn, n - 1) == tyError
    if (st.count == 0) {
        if (n > 0) {
            c.error(st.pos, "missing return value: " + fd.name + " returns " + c.typeName(ret))
        }
        return
    }
    if (n == 0) {
        c.errorHint(st.pos, fd.name + " does not return a value", "write  return  on its own, or declare a result type")
        for (int i = 0; i < st.count; i++) {
            c.checkExpr(c.ast.at(st.list, i))
        }
        return
    }
    if (st.count == 1) {
        c.allowGroup = c.ast.at(st.list, 0)
    }
    if (st.count == 1 && n > 1) {
        int only = c.ast.at(st.list, 0)
        c.checkExpr(only)
        int ot = c.typeOf(only)
        if (ot != tyInvalid && ot != ret) {
            c.error(st.pos, fd.name + " returns " + n.string() + " values " + c.typeName(ret) + ", but this returns " + c.typeName(ot))
        }
        return
    }
    if (st.count != n) {
        string s = "s"
        if (n == 1) {
            s = ""
        }
        c.error(st.pos, fd.name + " returns " + n.string() + " value" + s + " but this returns " + st.count.string())
        for (int j = 0; j < st.count; j++) {
            c.checkExpr(c.ast.at(st.list, j))
        }
        return
    }
    for (int k = 0; k < n; k++) {
        int e = c.ast.at(st.list, k)
        int rt = c.resultType(c.curFn, k)
        c.checkExpr(e)
        if (c.ast.exprs[e].kind == ExprKind.NullLit && n > 1 && hasErr && !c.types.isOpt(rt) && rt != tyError) {
            // null in a plain slot next to an error: the value is never read.
            c.setType(e, rt)
            continue
        }
        string context = "as the return value"
        if (n > 1) {
            context = "as return value " + (k + 1).string()
        }
        c.coerce(e, rt, context)
    }
}

fn (Checker c) assignable(int from, int to) bool {
    return from == to || (c.types.isOpt(to) && c.types.elem(to) == from)
}

fn (Checker c) mut checkAssign(int s) {
    Stmt st = c.ast.stmts[s]
    int n = st.count
    if (n == 1) {
        int ti = c.ast.at(st.list, 0)
        Target tg = c.ast.targets[ti]
        c.allowGroup = st.expr
        switch (tg.kind) {
        case TargetKind.Decl:
            int t = c.resolve(tg.typeExpr)
            c.targetType[ti] = t
            c.checkValue(st.expr, t, "to initialize " + tg.name)
            c.targetVar[ti] = c.declare(tg.name, t, VarKind.Local, tg.pos)
        case TargetKind.Discard:
            c.checkExpr(st.expr)
            int dt = c.typeOf(st.expr)
            if (dt == tyVoid) {
                c.notValue(st.expr)
            } else if (dt != tyInvalid && c.types.isTuple(dt)) {
                c.errorHint(st.pos, c.describe(st.expr) + " returns " + c.types.count(dt).string() + " values", "write one target per value, using _ for the ones you discard")
            }
        case TargetKind.Place:
            c.checkLvalue(tg.expr)
            int lt = c.typeOf(tg.expr)
            c.targetType[ti] = lt
            c.checkValue(st.expr, lt, "in the assignment to " + c.describe(tg.expr))
            c.killAssign(c.pathKey(tg.expr))
        }
        return
    }
    c.checkExpr(st.expr)
    int rt = c.typeOf(st.expr)
    if (rt == tyInvalid) {
        c.declareTargetsAnyway(s)
        return
    }
    if (!c.types.isTuple(rt) || c.types.count(rt) != n) {
        if (c.types.isTuple(rt)) {
            c.error(st.pos, n.string() + " targets but " + c.describe(st.expr) + " returns " + c.types.count(rt).string() + " values")
        } else {
            c.error(st.pos, n.string() + " targets but the right side is a single value of type " + c.typeName(rt))
        }
        c.declareTargetsAnyway(s)
        return
    }
    Target last = c.ast.targets[c.ast.at(st.list, n - 1)]
    bool errSlot = c.ast.exprs[st.expr].kind == ExprKind.Call && c.types.part(rt, n - 1) == tyError && last.kind == TargetKind.Discard
    c.stmtDiscard[s] = errSlot
    for (int i = 0; i < n; i++) {
        int ti2 = c.ast.at(st.list, i)
        Target tg2 = c.ast.targets[ti2]
        int slot = c.types.part(rt, i)
        int tt = tyInvalid
        string what = tg2.name
        if (tg2.kind == TargetKind.Discard) {
            continue
        }
        if (tg2.kind == TargetKind.Decl) {
            tt = c.resolve(tg2.typeExpr)
        } else {
            c.checkLvalue(tg2.expr)
            tt = c.typeOf(tg2.expr)
            what = c.describe(tg2.expr)
        }
        c.targetType[ti2] = tt
        if (tt == tyInvalid) {
            continue
        }
        if (!c.assignable(slot, tt)) {
            c.error(tg2.pos, "value " + (i + 1).string() + " has type " + c.typeName(slot) + ", which cannot be assigned to " + what + " (type " + c.typeName(tt) + ")")
            continue
        }
        if (errSlot && i < n - 1 && !c.types.isOpt(tt) && tt != tyError) {
            c.errorHint(tg2.pos, "the error is discarded with _, so " + what + " may be null and must be declared as " + c.typeName(tt) + "?", "and checked against null before use")
        }
    }
    for (int j = 0; j < n; j++) {
        int ti3 = c.ast.at(st.list, j)
        Target tg3 = c.ast.targets[ti3]
        if (tg3.kind == TargetKind.Decl) {
            for (int k = 0; k < j; k++) {
                Target prev = c.ast.targets[c.ast.at(st.list, k)]
                if (prev.kind == TargetKind.Decl && prev.name == tg3.name) {
                    c.error(tg3.pos, tg3.name + " is declared twice")
                }
            }
            c.targetVar[ti3] = c.declare(tg3.name, c.targetType[ti3], VarKind.Local, tg3.pos)
        } else if (tg3.kind == TargetKind.Place) {
            c.killAssign(c.pathKey(tg3.expr))
        }
    }
    c.addGuards(s, rt)
}

// int n, error err = f(): n may not be read until err is checked (see
// Guard). The guards apply to local variables.
fn (Checker c) mut addGuards(int s, int rt) {
    Stmt st = c.ast.stmts[s]
    int n = st.count
    if (c.types.part(rt, n - 1) != tyError) {
        return
    }
    int et = c.ast.at(st.list, n - 1)
    Target last = c.ast.targets[et]
    string errKey = ""
    string errName = ""
    if (last.kind == TargetKind.Decl && c.targetVar[et] >= 0) {
        errKey = "v" + c.targetVar[et].string()
        errName = last.name
    } else if (last.kind == TargetKind.Place) {
        errKey = c.pathKey(last.expr)
        errName = c.describe(last.expr)
    }
    if (errKey == "") {
        return
    }
    for (int i = 0; i < n - 1; i++) {
        int ti = c.ast.at(st.list, i)
        Target tg = c.ast.targets[ti]
        int v = -1
        if (tg.kind == TargetKind.Decl) {
            v = c.targetVar[ti]
        } else if (tg.kind == TargetKind.Place && c.ast.exprs[tg.expr].kind == ExprKind.Ident && c.info[tg.expr].res == Res.Local) {
            v = c.info[tg.expr].ref
        }
        if (v >= 0) {
            c.guards.push(Guard{key: "v" + v.string(), errKey: errKey, errName: errName, dead: false})
        }
    }
}

// After an error on the right side, still declare the typed targets so that
// later uses do not report them as undefined.
fn (Checker c) mut declareTargetsAnyway(int s) {
    Stmt st = c.ast.stmts[s]
    for (int i = 0; i < st.count; i++) {
        int ti = c.ast.at(st.list, i)
        Target tg = c.ast.targets[ti]
        if (tg.kind == TargetKind.Decl) {
            int t = c.resolve(tg.typeExpr)
            c.targetType[ti] = t
            c.targetVar[ti] = c.declare(tg.name, t, VarKind.Local, tg.pos)
        }
    }
}

fn (Checker c) mut checkSwitch(Stmt st) {
    c.checkExpr(st.expr)
    if (!c.isValue(st.expr)) {
        for (int i = 0; i < st.count; i++) {
            c.pushScope()
            c.checkBlock(c.ast.cases[c.ast.at(st.list, i)].body)
            c.popScope()
        }
        return
    }
    int t = c.typeOf(st.expr)
    if (c.kindOf(t) == Kind.Enum) {
        c.checkEnumSwitch(st, t)
        return
    }
    Pos vpos = c.ast.exprs[st.expr].pos
    if (t != tyInt && t != tyByte && t != tyString && t != tyBool) {
        if (c.types.isOpt(t)) {
            c.errorHint(vpos, c.describe(st.expr) + " is nullable (" + c.typeName(t) + ")", "check " + c.describe(st.expr) + " != null first")
        } else {
            c.error(vpos, "cannot switch on " + c.typeName(t) + "; switch works on enums, int, byte, string and bool")
        }
        return
    }
    bool hasDefault = false
    for (int j = 0; j < st.count; j++) {
        Case cs = c.ast.cases[c.ast.at(st.list, j)]
        if (cs.isDefault) {
            if (hasDefault) {
                c.error(cs.pos, "switch has two default cases")
            }
            hasDefault = true
        }
        for (int k = 0; k < cs.labelCount; k++) {
            Label l = c.ast.labels[c.ast.at(cs.labels, k)]
            if (l.parens) {
                c.error(l.pos, c.typeName(t) + " is not an enum, so case patterns with bindings cannot be used")
                continue
            }
            c.checkValue(l.expr, t, "as a case value")
        }
        c.pushScope()
        c.checkBlock(cs.body)
        c.popScope()
    }
    if (!hasDefault) {
        c.errorHint(st.pos, "a switch over " + c.typeName(t) + " must end with a default case", "add  default:  for the values not listed")
    }
}

fn (Checker c) mut checkEnumSwitch(Stmt st, int t) {
    int d = c.types.decl(t)
    TypeDecl td = c.ast.typeDecls[d]
    []bool seen = []bool{}
    for (int i = 0; i < td.caseCount; i++) {
        seen.push(false)
    }
    for (int j = 0; j < st.count; j++) {
        Case cs = c.ast.cases[c.ast.at(st.list, j)]
        if (cs.isDefault) {
            c.errorHint(cs.pos, "a switch over the enum " + td.name + " cannot have default", "list every case, so that adding a case later shows every switch to update")
        }
        c.pushScope()
        for (int k = 0; k < cs.labelCount; k++) {
            int li = c.ast.at(cs.labels, k)
            Label l = c.ast.labels[li]
            if (!l.isPattern) {
                string first = ""
                if (td.caseCount > 0) {
                    first = c.enumCase(d, 0).name
                }
                c.error(l.pos, "expected a case of " + td.name + ", like  case " + td.name + "." + first + ":")
                continue
            }
            if (l.typeName != td.name || l.pkg != "") {
                c.error(l.pos, l.typeName + "." + l.caseName + " is not a case of " + td.name)
                continue
            }
            int ci = c.findCase(d, l.caseName)
            if (ci < 0) {
                c.unknownCase(l.pos, d, l.caseName)
                continue
            }
            if (seen[ci]) {
                c.error(l.pos, "case " + td.name + "." + l.caseName + " is listed twice")
            }
            seen[ci] = true
            c.labelCase[li] = ci
            EnumCase ec = c.enumCase(d, ci)
            if (!l.parens) {
                continue
            }
            if (cs.labelCount > 1 && l.paramCount > 0) {
                c.error(l.pos, "a case with bindings must be the only label in its case")
            }
            if (l.paramCount != ec.paramCount) {
                string s = "s"
                if (ec.paramCount == 1) {
                    s = ""
                }
                c.error(l.pos, td.name + "." + ec.name + " carries " + ec.paramCount.string() + " value" + s + " but the pattern binds " + l.paramCount.string())
                continue
            }
            for (int m = 0; m < l.paramCount; m++) {
                int pi = c.ast.at(l.params, m)
                Param p = c.ast.params[pi]
                int pt = c.resolve(p.typeExpr)
                int want = c.caseParamType(d, ci, m)
                if (pt != tyInvalid && want != tyInvalid && pt != want) {
                    c.error(p.pos, td.name + "." + ec.name + " field " + (m + 1).string() + " has type " + c.typeName(want) + ", not " + c.typeName(pt))
                }
                c.paramVar[pi] = c.declare(p.name, pt, VarKind.Local, p.pos)
            }
        }
        c.checkBlock(cs.body)
        c.popScope()
    }
    for (int n = 0; n < td.caseCount; n++) {
        if (!seen[n]) {
            c.errorHint(st.pos, "switch over " + td.name + " does not handle case " + td.name + "." + c.enumCase(d, n).name, "add a case for it; a switch over an enum must list every case")
        }
    }
}

// defer f(args): the arguments are evaluated now and the call runs when the
// function returns (or crashes). An error result must be discarded
// explicitly with  defer _ = f(args).
fn (Checker c) mut checkDefer(Stmt st) {
    int e = st.expr
    c.checkExpr(e)
    Expr x = c.ast.exprs[e]
    if (x.kind != ExprKind.Call) {
        if (x.kind != ExprKind.Bad) {
            c.errorHint(x.pos, "defer needs a function call", "write  defer f(args)")
        }
        return
    }
    if (c.curFn < 0) {
        return
    }
    ExprInfo i = c.info[e]
    bool isMut = false
    if (i.res == Res.Method) {
        isMut = c.ast.fns[i.ref].recvMut
    } else if (i.res == Res.IfaceMethod) {
        isMut = c.ifaceMethod(i.ref, i.sub).isMut
    } else if (i.res == Res.Builtin) {
        isMut = isBuiltinMutName(c.ast.exprs[x.a].text)
    }
    if (isMut) {
        c.errorHint(x.pos, "defer cannot call the mut method " + c.describe(e), "the deferred call runs after the function's variables are gone; call it before returning instead")
        return
    }
    if (i.res == Res.Builtin && i.builtin == Builtin.Close) {
        return
    }
    if (i.res != Res.Func && i.res != Res.Method && i.res != Res.ValueCall && i.res != Res.IfaceMethod && i.res != Res.Pkg) {
        if (c.typeOf(e) != tyInvalid) {
            c.errorHint(x.pos, "defer needs a call of a function or method, not " + c.describe(e), "write a function that does the work and defer a call of it")
        }
        return
    }
    int t = c.typeOf(e)
    if (t == tyInvalid || st.discard) {
        return
    }
    if (c.types.endsWithError(t)) {
        c.errorHint(x.pos, "the error returned by " + c.describe(e) + " is not handled", "discard it explicitly:  defer _ = " + c.describe(e))
    } else {
        c.checkUnusedResult(e)
    }
}

// ---- concurrency ----

// Whether the checked expression e is ch.receive() (or, when sendOk,
// ch.send(v)).
fn (Checker c) isChanOp(int e, bool sendOk) bool {
    if (c.ast.exprs[e].kind != ExprKind.Call || c.info[e].res != Res.Builtin) {
        return false
    }
    Builtin b = c.info[e].builtin
    return b == Builtin.Receive || (sendOk && b == Builtin.Send)
}

// select: every case is a channel operation, ch.send(v), ch.receive() or
// T? v = ch.receive(), whose operands are evaluated before select waits.
fn (Checker c) mut checkSelect(Stmt st) {
    if (st.count == 0) {
        c.errorHint(st.pos, "select has no cases and would wait forever", "add a case such as  case int? v = ch.receive():")
    }
    for (int i = 0; i < st.count; i++) {
        Case cs = c.ast.cases[c.ast.at(st.list, i)]
        c.pushScope()
        c.checkSelectComm(cs.comm)
        c.checkBlock(cs.body)
        c.popScope()
    }
}

fn (Checker c) mut checkSelectComm(int s) {
    if (s < 0) {
        return
    }
    Stmt st = c.ast.stmts[s]
    string hint = "a case is  ch.send(v),  ch.receive()  or  T? v = ch.receive()"
    if (st.kind == StmtKind.ExprStmt) {
        c.checkExpr(st.expr)
        if (c.typeOf(st.expr) != tyInvalid && !c.isChanOp(st.expr, true)) {
            c.errorHint(c.ast.exprs[st.expr].pos, "a select case must send or receive on a channel", hint)
        }
        return
    }
    if (st.kind != StmtKind.Assign || st.count != 1) {
        c.errorHint(st.pos, "a select case must send or receive on a channel", hint)
        return
    }
    int ti = c.ast.at(st.list, 0)
    Target tg = c.ast.targets[ti]
    c.checkExpr(st.expr)
    int rt = c.typeOf(st.expr)
    if (rt != tyInvalid && !c.isChanOp(st.expr, false)) {
        c.errorHint(c.ast.exprs[st.expr].pos, "a select case with a variable must receive from a channel", hint)
        rt = tyInvalid
    }
    if (tg.kind == TargetKind.Place) {
        c.errorHint(tg.pos, "a select case cannot assign to an existing variable", "declare a new one (T? v = ch.receive()) and assign it in the case body")
        return
    }
    if (tg.kind == TargetKind.Discard) {
        return
    }
    int t = c.resolve(tg.typeExpr)
    c.targetType[ti] = t
    if (t != tyInvalid && rt != tyInvalid && t != rt) {
        c.errorHint(tg.pos, "the received value has type " + c.typeName(rt) + ", not " + c.typeName(t), "declare it as  " + c.typeName(rt) + " " + tg.name)
    }
    c.targetVar[ti] = c.declare(tg.name, t, VarKind.Local, tg.pos)
}

// The block of a group expression: ordinary code in which spawn starts
// goroutines. It may not leave early (return, try, or break/continue of a
// loop outside it), because the group must wait for its goroutines.
fn (Checker c) mut checkGroup(int e) {
    Expr x = c.ast.exprs[e]
    bool allowed = c.allowGroup == e && c.curFn >= 0
    c.allowGroup = -1
    int savedDepth = c.groupDepth
    int savedLoop = c.groupLoop
    c.groupDepth++
    c.groupLoop = c.loopDepth
    c.checkBlock(x.block)
    c.groupDepth = savedDepth
    c.groupLoop = savedLoop
    if (!allowed) {
        c.errorHint(x.pos, "a group can only be assigned to an error variable, returned, discarded or used with try", "write  error err = group {...},  err = group {...},  return group {...},  _ = group {...}  or  try group {...}")
        c.setType(e, tyInvalid)
        return
    }
    c.setType(e, tyError)
}

// spawn f(args): only inside a group block. The callee and the arguments
// are evaluated now and deep-copied for the new goroutine, which shares
// nothing with the one that started it.
fn (Checker c) mut checkSpawn(Stmt st) {
    int e = st.expr
    if (c.groupDepth == 0) {
        c.errorHint(st.pos, "spawn is only allowed inside a group block", "the group waits for its goroutines:  error err = group { spawn f(...) }")
    }
    c.checkExpr(e)
    Expr x = c.ast.exprs[e]
    if (x.kind != ExprKind.Call) {
        if (x.kind != ExprKind.Bad) {
            c.errorHint(x.pos, "spawn needs a function call", "write  spawn f(args)")
        }
        return
    }
    int t = c.typeOf(e)
    if (t == tyInvalid) {
        return
    }
    ExprInfo i = c.info[e]
    bool isMut = false
    if (i.res == Res.Method) {
        isMut = c.ast.fns[i.ref].recvMut
    } else if (i.res == Res.IfaceMethod) {
        isMut = c.ifaceMethod(i.ref, i.sub).isMut
    }
    if (isMut) {
        c.errorHint(x.pos, "spawn cannot call the mut method " + c.describe(e), "goroutines share nothing: the goroutine would change its own copy of " + c.describe(c.ast.exprs[x.a].a) + "; send the result back on a channel instead")
        return
    }
    if (i.res != Res.Func && i.res != Res.Method && i.res != Res.ValueCall && i.res != Res.IfaceMethod && i.res != Res.Pkg) {
        c.errorHint(x.pos, "spawn needs a call of a function or method, not " + c.describe(e), "write a function that does the work and spawn a call of it")
        return
    }
    if (t != tyVoid && t != tyError) {
        c.errorHint(x.pos, "a spawned function must return error or nothing, but " + c.describe(e) + " returns " + c.typeName(t), "send results back on a channel")
    }
}
