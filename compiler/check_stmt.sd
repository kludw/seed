// The checker, continued: statements.
//
// Whether a statement always exits (return, break, continue, os.exit, or a
// compound statement whose every branch does) is computed by stmtExits over
// the checked tree. It drives the "missing return" error, unreachable code
// and narrowing after `if (x == null) { return ... }`.
package main

fn (Checker c) mut checkBlock(int b) {
    _ = c.checkBlockLive(b)
}

// Checks the block and returns the paths narrowed at its end (for checkIf).
fn (Checker c) mut checkBlockLive(int b) []string {
    if (b < 0) {
        return c.liveNarrows()
    }
    Block bl = c.ast.blocks[b]
    bool exited = false
    bool reported = false
    c.pushScope()
    for (int i = 0; i < bl.count; i++) {
        int s = c.ast.at(bl.list, i)
        if (exited && !reported) {
            c.reportUnreachable(s)
            reported = true
        }
        c.checkStmt(s)
        if (c.stmtExits(s)) {
            exited = true
        }
    }
    []string live = c.liveNarrows()
    c.popScope()
    return live
}

// Whether some statement of the (checked) block always exits.
fn (Checker c) blockExits(int b) bool {
    if (b < 0) {
        return false
    }
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        if (c.stmtExits(c.ast.at(bl.list, i))) {
            return true
        }
    }
    return false
}

// Whether the (checked) statement always exits: control never reaches the
// statement after it.
fn (Checker c) stmtExits(int s) bool {
    if (s < 0) {
        return false
    }
    Stmt st = c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Return, StmtKind.Break, StmtKind.Continue:
        return true
    case StmtKind.ExprStmt:
        return c.isExitCall(st.expr)
    case StmtKind.If:
        if (st.elseIf >= 0) {
            return c.blockExits(st.body) && c.stmtExits(st.elseIf)
        }
        return st.els >= 0 && c.blockExits(st.body) && c.blockExits(st.els)
    case StmtKind.For:
        return st.expr < 0 && !c.hasBreak(st.body)
    case StmtKind.Switch:
        if (st.count == 0) {
            return false
        }
        bool hasDefault = false
        for (int i = 0; i < st.count; i++) {
            Case cs = c.ast.cases[c.ast.at(st.list, i)]
            if (!c.blockExits(cs.body)) {
                return false
            }
            if (cs.isDefault) {
                hasDefault = true
            }
        }
        return hasDefault || c.kindOf(c.typeOf(st.expr)) == Kind.Enum
    case StmtKind.Select:
        // select always runs one of its cases.
        for (int j = 0; j < st.count; j++) {
            if (!c.blockExits(c.ast.cases[c.ast.at(st.list, j)].body)) {
                return false
            }
        }
        return st.count > 0
    case StmtKind.Bad, StmtKind.Assign, StmtKind.IncDec, StmtKind.Defer, StmtKind.Spawn:
        return false
    case StmtKind.Assert, StmtKind.Const:
        return false
    }
}

// Whether e is a call of os.exit or os.crash, which never return.
fn (Checker c) isExitCall(int e) bool {
    return c.ast.exprs[e].kind == ExprKind.Call && c.info[e].res == Res.Func && c.isNoReturn(c.info[e].ref)
}

// Whether a loop body contains a break for that loop.
fn (Checker c) hasBreak(int b) bool {
    if (b < 0) {
        return false
    }
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        Stmt s = c.ast.stmts[c.ast.at(bl.list, i)]
        if (s.kind == StmtKind.Break) {
            return true
        }
        if (s.kind == StmtKind.If && (c.hasBreak(s.body) || c.hasBreak(s.els) || c.stmtHasBreak(s.elseIf))) {
            return true
        }
        if (s.kind == StmtKind.Switch || s.kind == StmtKind.Select) {
            for (int j = 0; j < s.count; j++) {
                if (c.hasBreak(c.ast.cases[c.ast.at(s.list, j)].body)) {
                    return true
                }
            }
        }
    }
    return false
}

fn (Checker c) stmtHasBreak(int s) bool {
    if (s < 0) {
        return false
    }
    Stmt st = c.ast.stmts[s]
    return c.hasBreak(st.body) || c.hasBreak(st.els) || c.stmtHasBreak(st.elseIf)
}

fn (Checker c) mut checkStmt(int s) {
    Stmt st = c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Bad:
        return
    case StmtKind.ExprStmt:
        c.checkExprStmt(st)
    case StmtKind.Assign:
        c.checkAssign(s)
    case StmtKind.IncDec:
        c.checkIncDec(st)
    case StmtKind.Const:
        int ct = c.resolve(st.typeExpr)
        c.checkValue(st.expr, ct, "to initialize " + st.name)
        c.requireConstant(st.expr, st.name)
        c.stmtVar[s] = c.declare(st.name, ct, VarKind.LocalConst, st.namePos)
    case StmtKind.If:
        c.checkIf(st)
    case StmtKind.For:
        c.checkFor(st)
    case StmtKind.Switch:
        c.checkSwitch(st)
    case StmtKind.Return:
        if (c.curFn >= 0 && c.ast.fns[c.curFn].isTest) {
            c.errorHint(st.pos, "return is not allowed in a test", "a test ends at its closing brace; use if and else to skip the rest")
            return
        }
        if (c.groupDepth > 0) {
            c.errorHint(st.pos, "return is not allowed inside a group block", "the group must wait for its goroutines first; set a variable in the block and return after it")
        }
        c.checkReturn(st)
    case StmtKind.Break, StmtKind.Continue:
        string what = "continue"
        if (st.kind == StmtKind.Break) {
            what = "break"
        }
        if (c.loopDepth == 0) {
            c.error(st.pos, what + " outside of a loop")
        } else if (c.groupDepth > 0 && c.loopDepth == c.groupLoop) {
            c.errorHint(st.pos, what + " cannot leave a group block", "the group must wait for its goroutines first; set a variable in the block and " + what + " after it")
        } else if (c.loopScopes.len() > 0 && st.kind == StmtKind.Break) {
            c.breakGuards = joinGuards(c.breakGuards, c.loopGuards())
        } else if (c.loopScopes.len() > 0) {
            c.contGuards = joinGuards(c.contGuards, c.loopGuards())
        }
    case StmtKind.Select:
        c.checkSelect(st)
    case StmtKind.Defer:
        c.checkDefer(st)
    case StmtKind.Spawn:
        c.checkSpawn(st)
    case StmtKind.Assert:
        c.checkAssert(st)
    }
}

// assert(cond): only in a test (outside group blocks, like try, because a
// failed assert ends the test).
fn (Checker c) mut checkAssert(Stmt st) {
    c.checkValue(st.expr, tyBool, "as the condition of assert")
    if (c.curFn < 0 || !c.ast.fns[c.curFn].isTest) {
        c.errorHint(st.pos, "assert can only be used in a test", "return an error, or crash with os.crash(message) when a caller broke a rule")
        return
    }
    if (c.groupDepth > 0) {
        c.errorHint(st.pos, "assert is not allowed inside a group block", "the group must wait for its goroutines first; check the result after the group")
    }
    // A failed assert ends the test, so after assert(x != null) x is not
    // null, and after assert(err == null) the values returned with err can
    // be read.
    c.narrowOn(st.expr, true)
    c.latchGuards(st.expr, true)
}

fn (Checker c) mut checkIncDec(Stmt st) {
    c.checkLvalue(st.expr)
    Expr x = c.ast.exprs[st.expr]
    if (x.kind == ExprKind.Index && c.info[st.expr].res == Res.MapIndex) {
        string op = "--"
        if (st.inc) {
            op = "++"
        }
        string m = c.describe(x.a)
        int vt = c.types.optOf(c.typeOf(st.expr))
        c.errorHint(st.pos, op + " cannot change a map entry: the key may be missing", "read it first: " + c.typeName(vt) + " v = " + m + "[key], then check v != null and assign " + m + "[key] = v " + op.slice(0, 1) + " 1")
        return
    }
    if (x.kind == ExprKind.Ident && c.info[st.expr].res == Res.Local) {
        int g = c.guardOf(c.info[st.expr].ref)
        if (g >= 0) {
            c.guardError(g, x.text, x.pos)
        }
    }
    int t = c.typeOf(st.expr)
    if (t != tyInvalid && t != tyInt && t != tyFloat) {
        string op = "--"
        if (st.inc) {
            op = "++"
        }
        c.error(st.pos, op + " needs an int or float, not " + c.typeName(t))
    }
    c.assigned(c.pathKey(st.expr))
}

fn (Checker c) mut checkExprStmt(Stmt st) {
    int e = st.expr
    Expr x = c.ast.exprs[e]
    if (x.kind == ExprKind.Group) {
        c.allowGroup = e
        c.checkExpr(e)
        c.errorHint(x.pos, "the error returned by the group is not handled", "assign it (error err = group {...}), use try group {...}, or discard it with _ = group {...}")
        return
    }
    c.checkExpr(e)
    if (x.kind != ExprKind.Call && x.kind != ExprKind.Try) {
        if (x.kind != ExprKind.Bad) {
            c.errorHint(x.pos, "this expression is not used", "only calls can be statements")
        }
        return
    }
    int t = c.typeOf(e)
    if (x.kind == ExprKind.Call && t != tyInvalid && c.types.endsWithError(t)) {
        c.errorHint(x.pos, "the error returned by " + c.describe(e) + " is not handled", "use try, assign it (error err = ...), or discard it with _ = ...")
    } else {
        c.checkUnusedResult(e)
    }
}

fn (Checker c) mut checkIf(Stmt st) {
    c.checkValue(st.expr, tyBool, "as the if condition")
    []Guard before = c.guards
    // Each branch starts from the narrowings before the if; what either
    // one kills stays killed after it (see joinNarrows).
    []Narrow outer = c.narrows
    c.pushScope()
    c.narrowOn(st.expr, true)
    c.latchGuards(st.expr, true)
    []string thenLive = c.checkBlockLive(st.body)
    c.popScope()
    []Narrow thenNarrows = c.narrows
    c.narrows = outer
    []Guard thenGuards = c.guards
    c.guards = before
    c.latchGuards(st.expr, false)
    c.pushScope()
    c.narrowOn(st.expr, false)
    []string elseLive = []string{}
    if (st.elseIf >= 0) {
        c.pushScope()
        c.checkStmt(st.elseIf)
        elseLive = c.liveNarrows()
        c.popScope()
    } else {
        elseLive = c.checkBlockLive(st.els)
    }
    c.popScope()
    bool thenExits = c.blockExits(st.body)
    bool elseExits = c.blockExits(st.els) || c.stmtExits(st.elseIf)
    if (elseExits) {
        c.guards = thenGuards
    } else if (!thenExits) {
        c.guards = joinGuards(c.guards, thenGuards)
    }
    // After the if, a path is narrowed when it is narrowed at the end of
    // every branch that falls through (the condition itself narrows the
    // branch it leads to, and an assignment of a T narrows too).
    []string after = []string{}
    if (thenExits && !elseExits) {
        after = elseLive
    } else if (elseExits && !thenExits) {
        after = thenLive
    } else if (!thenExits && !elseExits) {
        for (int i = 0; i < thenLive.len(); i++) {
            if (elseLive.contains(thenLive[i])) {
                after.push(thenLive[i])
            }
        }
    }
    c.joinNarrows(thenNarrows, after)
}

fn (Checker c) mut checkFor(Stmt st) {
    c.pushScope()
    if (st.init >= 0 && c.ast.stmts[st.init].kind == StmtKind.Assign) {
        c.checkAssign(st.init)
    }
    c.scanBlockKills(st.body)
    c.scanStmtKills(st.post)
    c.scanExprKills(st.expr)
    if (st.expr >= 0) {
        c.checkValue(st.expr, tyBool, "as the loop condition")
    }
    []Guard before = c.guards
    c.loopScopes.push(c.scope.len())
    c.breakMarks.push(c.breakGuards.len())
    c.contMarks.push(c.contGuards.len())
    c.pushScope()
    if (st.expr >= 0) {
        c.narrowOn(st.expr, true)
        c.latchGuards(st.expr, true)
    }
    c.loopDepth++
    c.checkBlock(st.body)
    c.loopDepth--
    // The post statement runs after the body and after continue, so the
    // condition still holds unless the body assigned what it narrowed
    // (for (Node? n = head; n != null; n = n.next)).
    if (c.blockExits(st.body)) {
        c.guards = []Guard{}
    }
    int? cm = c.contMarks.pop()
    if (cm != null) {
        c.guards = joinGuards(c.guards, c.contGuards.slice(cm, c.contGuards.len()))
        c.contGuards = c.contGuards.slice(0, cm)
    }
    if (st.post >= 0) {
        Stmt post = c.ast.stmts[st.post]
        if (post.kind == StmtKind.Assign) {
            for (int i = 0; i < post.count; i++) {
                if (c.ast.targets[c.ast.at(post.list, i)].kind == TargetKind.Decl) {
                    c.error(post.pos, "the loop post statement cannot declare a variable")
                }
            }
            c.checkAssign(st.post)
        } else if (post.kind == StmtKind.IncDec) {
            c.checkIncDec(post)
        }
    }
    c.popScope()
    // The guards that come around again were not in effect when the
    // condition and the start of the body were checked.
    c.checkLoopGuards(st, before)
    // The loop ends when its condition is false (coming from before the
    // loop or around again), or at a break.
    c.guards = joinGuards(before, c.guards)
    if (st.expr < 0) {
        c.guards = []Guard{}
    } else {
        c.latchGuards(st.expr, false)
    }
    int? bm = c.breakMarks.pop()
    if (bm != null) {
        c.guards = joinGuards(c.guards, c.breakGuards.slice(bm, c.breakGuards.len()))
        c.breakGuards = c.breakGuards.slice(0, bm)
    }
    c.loopScopes = c.loopScopes.slice(0, c.loopScopes.len() - 1)
    c.popScope()
}

// A guard that comes around a loop again (it was made in the loop and its
// error is not checked by the end of the body): the variable may be null
// where the next iteration reads it, before assigning it again.
fn (Checker c) mut checkLoopGuards(Stmt st, []Guard before) {
    for (int i = 0; i < c.guards.len(); i++) {
        Guard gd = c.guards[i]
        if (joinGuards(before, []Guard{gd}).len() == before.len()) {
            continue
        }
        if (c.readsBeforeAssign(st, gd.var)) {
            Var v = c.vars[gd.var]
            c.errorHint(gd.pos, v.name + " may be null when the loop comes around again: it is assigned beside " + gd.errName + ", which is not always checked before the next iteration reads " + v.name, "check " + gd.errName + " before the end of the loop body (if (" + gd.errName + " != null) { return " + gd.errName + " }), or declare " + v.name + " inside the loop")
        }
    }
}

// Whether a loop iteration may read the variable v before assigning it: the
// condition reads it, or a statement of the body reads it before the first
// statement of the body that assigns it as a whole.
fn (Checker c) readsBeforeAssign(Stmt loop, int v) bool {
    if (c.exprReads(loop.expr, v)) {
        return true
    }
    if (loop.body < 0) {
        return false
    }
    Block bl = c.ast.blocks[loop.body]
    for (int i = 0; i < bl.count; i++) {
        int s = c.ast.at(bl.list, i)
        if (c.stmtReads(s, v)) {
            return true
        }
        Stmt st = c.ast.stmts[s]
        if (st.kind == StmtKind.Assign) {
            for (int j = 0; j < st.count; j++) {
                Target tg = c.ast.targets[c.ast.at(st.list, j)]
                if (tg.kind == TargetKind.Place && c.isVarRef(tg.expr, v)) {
                    return false
                }
            }
        }
    }
    return false
}

fn (Checker c) isVarRef(int e, int v) bool {
    return e >= 0 && c.ast.exprs[e].kind == ExprKind.Ident && c.info[e].res == Res.Local && c.info[e].ref == v
}

// Whether the expression mentions the variable v.
fn (Checker c) exprReads(int e, int v) bool {
    if (e < 0) {
        return false
    }
    if (c.isVarRef(e, v)) {
        return true
    }
    Expr x = c.ast.exprs[e]
    if (x.kind == ExprKind.Group) {
        return c.blockReads(x.block, v)
    }
    if (c.exprReads(x.a, v) || c.exprReads(x.b, v)) {
        return true
    }
    for (int i = 0; i < x.count; i++) {
        if (c.exprReads(c.ast.at(x.list, i), v)) {
            return true
        }
    }
    return false
}

fn (Checker c) blockReads(int b, int v) bool {
    if (b < 0) {
        return false
    }
    Block bl = c.ast.blocks[b]
    for (int i = 0; i < bl.count; i++) {
        if (c.stmtReads(c.ast.at(bl.list, i), v)) {
            return true
        }
    }
    return false
}

// Whether the statement reads the variable v (assigning v as a whole is
// not a read).
fn (Checker c) stmtReads(int s, int v) bool {
    if (s < 0) {
        return false
    }
    Stmt st = c.ast.stmts[s]
    switch (st.kind) {
    case StmtKind.Assign:
        for (int i = 0; i < st.count; i++) {
            Target tg = c.ast.targets[c.ast.at(st.list, i)]
            if (tg.kind == TargetKind.Place && !c.isVarRef(tg.expr, v) && c.exprReads(tg.expr, v)) {
                return true
            }
        }
        return c.exprReads(st.expr, v)
    case StmtKind.Return:
        for (int j = 0; j < st.count; j++) {
            if (c.exprReads(c.ast.at(st.list, j), v)) {
                return true
            }
        }
        return false
    case StmtKind.If:
        return c.exprReads(st.expr, v) || c.blockReads(st.body, v) || c.blockReads(st.els, v) || c.stmtReads(st.elseIf, v)
    case StmtKind.For:
        return c.stmtReads(st.init, v) || c.exprReads(st.expr, v) || c.stmtReads(st.post, v) || c.blockReads(st.body, v)
    case StmtKind.Switch, StmtKind.Select:
        if (c.exprReads(st.expr, v)) {
            return true
        }
        for (int k = 0; k < st.count; k++) {
            Case cs = c.ast.cases[c.ast.at(st.list, k)]
            if (c.stmtReads(cs.comm, v) || c.blockReads(cs.body, v)) {
                return true
            }
            for (int m = 0; m < cs.labelCount; m++) {
                if (c.exprReads(c.ast.labels[c.ast.at(cs.labels, m)].expr, v)) {
                    return true
                }
            }
        }
        return false
    case StmtKind.ExprStmt, StmtKind.Const, StmtKind.Defer, StmtKind.Spawn, StmtKind.Assert, StmtKind.IncDec:
        return c.exprReads(st.expr, v)
    case StmtKind.Bad, StmtKind.Break, StmtKind.Continue:
        return false
    }
}

fn (Checker c) mut checkReturn(Stmt st) {
    if (c.curFn < 0) {
        return
    }
    FnDecl fd = c.ast.fns[c.curFn]
    int n = fd.resultCount
    int ret = c.fnRet[c.curFn]
    bool hasErr = n > 0 && c.resultType(c.curFn, n - 1) == tyError
    if (st.count == 0) {
        if (n > 0) {
            c.error(st.pos, "missing return value: " + fd.name + " returns " + c.typeName(ret))
        }
        return
    }
    if (n == 0) {
        c.errorHint(st.pos, fd.name + " does not return a value", "write return on its own, or declare a result type")
        for (int i = 0; i < st.count; i++) {
            c.checkExpr(c.ast.at(st.list, i))
        }
        return
    }
    if (st.count == 1) {
        c.allowGroup = c.ast.at(st.list, 0)
    }
    if (st.count == 1 && n > 1) {
        int only = c.ast.at(st.list, 0)
        c.checkExpr(only)
        int ot = c.typeOf(only)
        if (ot != tyInvalid && ot != ret) {
            c.error(st.pos, fd.name + " returns " + n.string() + " values " + c.typeName(ret) + ", but this returns " + c.typeName(ot))
        }
        return
    }
    if (st.count != n) {
        string s = "s"
        if (n == 1) {
            s = ""
        }
        c.error(st.pos, fd.name + " returns " + n.string() + " value" + s + " but this returns " + st.count.string())
        for (int j = 0; j < st.count; j++) {
            c.checkExpr(c.ast.at(st.list, j))
        }
        return
    }
    int last = c.ast.at(st.list, n - 1)
    bool errIsNull = c.ast.exprs[last].kind == ExprKind.NullLit
    string lastKey = c.pathKey(last)
    if (lastKey != "" && c.isNarrowed("!" + lastKey)) {
        errIsNull = true
    }
    for (int k = 0; k < n; k++) {
        int e = c.ast.at(st.list, k)
        int rt = c.resultType(c.curFn, k)
        if (hasErr && k < n - 1 && lastKey != "" && c.ast.exprs[e].kind == ExprKind.Ident) {
            // return v, err with v guarded by err passes the pair on as it
            // came: when err is not null, v is null and so is the result.
            // Only into a slot of v's own type: widened to a T?, a null v
            // would become a value the caller can read.
            int pv = c.lookupVar(c.ast.exprs[e].text)
            if (pv >= 0 && c.vars[pv].ty == rt) {
                c.passExpr = e
                c.passErrKey = lastKey
            }
        }
        c.checkExpr(e)
        c.passExpr = -1
        if (c.ast.exprs[e].kind == ExprKind.NullLit && n > 1 && hasErr && !c.types.isOpt(rt) && rt != tyError) {
            // null in a plain slot next to an error: the value is never
            // read, because the error is not null (checked when the
            // function returns; see genReturn).
            c.setType(e, rt)
            if (errIsNull) {
                c.errorHint(c.ast.exprs[e].pos, fd.name + " returns null as its " + c.typeName(rt) + " result beside an error that is null, so the caller would read a null " + c.typeName(rt), "return " + withArticle(c.typeName(rt)) + " value, or return an error such as errors.new(...)")
            }
            continue
        }
        string context = "as the return value"
        if (n > 1) {
            context = "as return value " + (k + 1).string()
        }
        c.coerce(e, rt, context)
    }
}

fn (Checker c) assignable(int from, int to) bool {
    return from == to || (c.types.isOpt(to) && c.types.elem(to) == from)
}

fn (Checker c) mut checkAssign(int s) {
    Stmt st = c.ast.stmts[s]
    int n = st.count
    if (n == 1) {
        int ti = c.ast.at(st.list, 0)
        Target tg = c.ast.targets[ti]
        c.allowGroup = st.expr
        switch (tg.kind) {
        case TargetKind.Decl:
            int t = c.resolve(tg.typeExpr)
            c.targetType[ti] = t
            c.checkExpr(st.expr)
            bool declNonNull = c.isNonNullValue(st.expr)
            c.coerce(st.expr, t, "to initialize " + tg.name)
            int v = c.declare(tg.name, t, VarKind.Local, tg.pos)
            c.targetVar[ti] = v
            if (declNonNull && c.narrowable(t)) {
                c.addNarrow("v" + v.string())
            }
        case TargetKind.Discard:
            c.checkExpr(st.expr)
            int dt = c.typeOf(st.expr)
            if (dt == tyVoid) {
                c.notValue(st.expr)
            } else if (dt != tyInvalid && c.types.isTuple(dt)) {
                c.errorHint(st.pos, c.describe(st.expr) + " returns " + c.types.count(dt).string() + " values", "write one target per value, using _ for the ones you discard")
            }
        case TargetKind.Place:
            c.checkLvalue(tg.expr)
            int lt = c.typeOf(tg.expr)
            c.targetType[ti] = lt
            c.checkExpr(st.expr)
            bool nonNull = c.isNonNullValue(st.expr)
            c.coerce(st.expr, lt, "in the assignment to " + c.describe(tg.expr))
            string key = c.pathKey(tg.expr)
            c.assigned(key)
            // A T? path that was just given a T is not null until it may
            // become null again (assigned, a mut call, a loop).
            if (nonNull && key != "" && c.narrowable(lt)) {
                c.addNarrow(key)
            }
        }
        return
    }
    c.checkExpr(st.expr)
    int rt = c.typeOf(st.expr)
    if (rt == tyInvalid) {
        c.declareTargetsAnyway(s)
        return
    }
    if (!c.types.isTuple(rt) || c.types.count(rt) != n) {
        if (c.types.isTuple(rt)) {
            c.error(st.pos, n.string() + " targets but " + c.describe(st.expr) + " returns " + c.types.count(rt).string() + " values")
        } else {
            c.error(st.pos, n.string() + " targets but the right side is a single value of type " + c.typeName(rt))
        }
        c.declareTargetsAnyway(s)
        return
    }
    Target last = c.ast.targets[c.ast.at(st.list, n - 1)]
    // `_` and a typed `error _` both discard the error.
    bool lastDiscarded = last.kind == TargetKind.Discard || (last.kind == TargetKind.Decl && last.name == "_")
    bool errSlot = c.ast.exprs[st.expr].kind == ExprKind.Call && c.types.part(rt, n - 1) == tyError && lastDiscarded
    c.stmtDiscard[s] = errSlot
    for (int i = 0; i < n; i++) {
        int ti2 = c.ast.at(st.list, i)
        Target tg2 = c.ast.targets[ti2]
        int slot = c.types.part(rt, i)
        int tt = tyInvalid
        string what = tg2.name
        if (tg2.kind == TargetKind.Discard) {
            continue
        }
        if (tg2.kind == TargetKind.Decl) {
            tt = c.resolve(tg2.typeExpr)
        } else {
            c.checkLvalue(tg2.expr)
            tt = c.typeOf(tg2.expr)
            what = c.describe(tg2.expr)
        }
        c.targetType[ti2] = tt
        if (tt == tyInvalid) {
            continue
        }
        if (!c.assignable(slot, tt)) {
            c.error(tg2.pos, "value " + (i + 1).string() + " has type " + c.typeName(slot) + ", which cannot be assigned to " + what + " (type " + c.typeName(tt) + ")")
            continue
        }
        bool discarded = tg2.kind == TargetKind.Decl && tg2.name == "_"
        if (errSlot && i < n - 1 && !discarded && !c.types.isOpt(tt) && tt != tyError) {
            c.errorHint(tg2.pos, "the error is discarded with _, so " + what + " may be null and must be declared as " + c.types.optName(tt), "declare it as " + c.types.optName(tt) + " and check it against null before using it")
            if (tg2.kind == TargetKind.Decl) {
                // Its type is in doubt: no more errors about its uses (a
                // null check of it would say "int is never null").
                c.targetType[ti2] = tyInvalid
            }
        }
    }
    for (int j = 0; j < n; j++) {
        int ti3 = c.ast.at(st.list, j)
        Target tg3 = c.ast.targets[ti3]
        if (tg3.kind == TargetKind.Decl) {
            for (int k = 0; k < j; k++) {
                Target prev = c.ast.targets[c.ast.at(st.list, k)]
                if (prev.kind == TargetKind.Decl && prev.name == tg3.name && tg3.name != "_") {
                    c.error(tg3.pos, tg3.name + " is declared twice")
                }
            }
            c.targetVar[ti3] = c.declare(tg3.name, c.targetType[ti3], VarKind.Local, tg3.pos)
        } else if (tg3.kind == TargetKind.Place) {
            c.assigned(c.pathKey(tg3.expr))
        }
    }
    c.addGuards(s, rt)
}

// int n, error err = f(): n may not be read until err is checked (see
// Guard). The guards apply to local variables.
fn (Checker c) mut addGuards(int s, int rt) {
    Stmt st = c.ast.stmts[s]
    int n = st.count
    if (c.types.part(rt, n - 1) != tyError) {
        return
    }
    int et = c.ast.at(st.list, n - 1)
    Target last = c.ast.targets[et]
    string errKey = ""
    string errName = ""
    if (last.kind == TargetKind.Decl && c.targetVar[et] >= 0) {
        errKey = "v" + c.targetVar[et].string()
        errName = last.name
    } else if (last.kind == TargetKind.Place) {
        errKey = c.pathKey(last.expr)
        errName = c.describe(last.expr)
    }
    for (int i = 0; i < n - 1; i++) {
        int ti = c.ast.at(st.list, i)
        Target tg = c.ast.targets[ti]
        int tt = c.targetType[ti]
        if (tg.kind == TargetKind.Discard || tt == tyInvalid || tt == tyError || c.types.isOpt(tt)) {
            // A T? can always be read (and compared with null); only a
            // plain T may hold the null that comes with an error.
            continue
        }
        int v = -1
        if (tg.kind == TargetKind.Decl) {
            v = c.targetVar[ti]
        } else if (c.ast.exprs[tg.expr].kind == ExprKind.Ident && c.info[tg.expr].res == Res.Local && (c.vars[c.info[tg.expr].ref].kind == VarKind.Local || c.vars[c.info[tg.expr].ref].kind == VarKind.Param)) {
            v = c.info[tg.expr].ref
        } else {
            // A field, an element or a mut receiver cannot be guarded: it
            // would hold the null whenever the error is not null.
            string what = c.describe(tg.expr)
            if (what == "the value") {
                what = "the element"
            }
            c.errorHint(tg.pos, what + " cannot be assigned beside an error: when the error is not null, " + what + " would be null", "assign to a new local variable, check the error, and then store the value (or use try)")
            continue
        }
        if (v >= 0 && errKey == "" && last.kind == TargetKind.Place) {
            c.errorHint(last.pos, "the error must be assigned to a variable or a field, so that it can be checked before " + c.vars[v].name + " is read", "declare it: error err = ...")
        } else if (v >= 0 && errKey != "") {
            c.guards.push(Guard{key: "v" + v.string(), errKey: errKey, errName: errName, var: v, pos: tg.pos, lost: false})
        }
    }
}

// After an error on the right side, still declare the typed targets so that
// later uses do not report them as undefined.
fn (Checker c) mut declareTargetsAnyway(int s) {
    Stmt st = c.ast.stmts[s]
    for (int i = 0; i < st.count; i++) {
        int ti = c.ast.at(st.list, i)
        Target tg = c.ast.targets[ti]
        if (tg.kind == TargetKind.Decl) {
            int t = c.resolve(tg.typeExpr)
            c.targetType[ti] = t
            c.targetVar[ti] = c.declare(tg.name, t, VarKind.Local, tg.pos)
        }
    }
}

fn (Checker c) mut checkSwitch(Stmt st) {
    c.checkExpr(st.expr)
    []Guard saved = c.caseGuards
    c.caseGuards = []Guard{}
    c.checkSwitchCases(st)
    // Every switch covers every value (an enum switch lists every case,
    // another switch has default), so the cases are the only paths.
    if (st.count > 0) {
        c.guards = c.caseGuards
    }
    c.caseGuards = saved
}

// The guards at the end of a case (when it can end) join the ones after
// the switch or select; the next case starts from before.
fn (Checker c) mut endCase(int body, []Guard before) {
    if (!c.blockExits(body)) {
        c.caseGuards = joinGuards(c.caseGuards, c.guards)
    }
    c.guards = before
}

fn (Checker c) mut checkSwitchCases(Stmt st) {
    []Guard before = c.guards
    if (!c.isValue(st.expr)) {
        for (int i = 0; i < st.count; i++) {
            c.pushScope()
            c.checkBlock(c.ast.cases[c.ast.at(st.list, i)].body)
            c.popScope()
            c.endCase(c.ast.cases[c.ast.at(st.list, i)].body, before)
        }
        return
    }
    int t = c.typeOf(st.expr)
    if (c.kindOf(t) == Kind.Enum) {
        c.checkEnumSwitch(st, t)
        return
    }
    Pos vpos = c.ast.exprs[st.expr].pos
    if (t != tyInt && t != tyByte && t != tyString && t != tyBool) {
        if (c.types.isOpt(t)) {
            c.errorHint(vpos, c.describe(st.expr) + " is nullable (" + c.typeName(t) + ")", "check " + c.describe(st.expr) + " != null first")
        } else {
            c.error(vpos, "cannot switch on " + c.typeName(t) + "; switch works on enums, int, byte, string and bool")
        }
        return
    }
    bool hasDefault = false
    for (int j = 0; j < st.count; j++) {
        Case cs = c.ast.cases[c.ast.at(st.list, j)]
        if (cs.isDefault) {
            if (hasDefault) {
                c.error(cs.pos, "switch has two default cases")
            }
            hasDefault = true
        } else if (hasDefault) {
            c.errorHint(cs.pos, "default must be the last case of a switch, but a case follows it", "move default: and its statements to the end of the switch")
        }
        for (int k = 0; k < cs.labelCount; k++) {
            Label l = c.ast.labels[c.ast.at(cs.labels, k)]
            if (l.parens && (l.paramCount > 0 || l.expr < 0)) {
                c.error(l.pos, c.typeName(t) + " is not an enum, so case patterns with bindings cannot be used")
                continue
            }
            c.checkValue(l.expr, t, "as a case value")
        }
        c.pushScope()
        c.checkBlock(cs.body)
        c.popScope()
        c.endCase(cs.body, before)
    }
    if (!hasDefault) {
        c.errorHint(st.pos, "a switch over " + c.typeName(t) + " must end with a default case", "add default: for the values not listed")
    }
}

fn (Checker c) mut checkEnumSwitch(Stmt st, int t) {
    []Guard before = c.guards
    int d = c.types.decl(t)
    TypeDecl td = c.ast.typeDecls[d]
    string tname = c.declDisplayName(d)
    []bool seen = []bool{}
    for (int i = 0; i < td.caseCount; i++) {
        seen.push(false)
    }
    for (int j = 0; j < st.count; j++) {
        Case cs = c.ast.cases[c.ast.at(st.list, j)]
        if (cs.isDefault) {
            c.errorHint(cs.pos, "a switch over the enum " + tname + " cannot have default", "list every case, so that adding a case later shows every switch to update")
        }
        c.pushScope()
        for (int k = 0; k < cs.labelCount; k++) {
            int li = c.ast.at(cs.labels, k)
            Label l = c.ast.labels[li]
            if (!l.isPattern) {
                string first = ""
                if (td.caseCount > 0) {
                    first = c.casePattern(d, 0)
                }
                c.errorHint(l.pos, "expected a case of " + tname, "write it as case " + first + ":")
                continue
            }
            if (!c.labelNamesDecl(l, d)) {
                c.error(l.pos, labelText(l) + " is not a case of " + tname)
                continue
            }
            int ci = c.findCase(d, l.caseName)
            if (ci < 0) {
                c.unknownCase(l.pos, d, l.caseName)
                continue
            }
            if (seen[ci]) {
                c.error(l.pos, "case " + tname + "." + l.caseName + " is listed twice")
            }
            seen[ci] = true
            c.labelCase[li] = ci
            c.checkPattern(li, d, ci, cs.labelCount > 1)
        }
        c.checkBlock(cs.body)
        c.popScope()
        c.endCase(cs.body, before)
    }
    for (int n = 0; n < td.caseCount; n++) {
        if (!seen[n]) {
            c.errorHint(st.pos, "switch over " + tname + " does not handle case " + tname + "." + c.enumCase(d, n).name, "add a case for it; a switch over an enum must list every case")
        }
    }
}

// Whether a pattern's type name (Shape or pkg.Shape) names the enum d.
fn (Checker c) mut labelNamesDecl(Label l, int d) bool {
    int pkg = c.pkgOf(l.pos)
    if (l.pkg != "") {
        pkg = c.importedPkg(l.pos.file, l.pkg)
        if (pkg < 0) {
            return false
        }
        c.usedImports[l.pos.file.string() + ":" + l.pkg] = true
    }
    int? g = c.global(pkg, l.typeName)
    if (g == null || c.globalList[g].kind != GlobalKind.Type || c.globalList[g].index != d) {
        return false
    }
    if (l.pkg != "" && !c.globalPub(g)) {
        c.errorHint(l.pos, l.typeName + " is not pub in package " + c.ast.pkgs[pkg].name, "only names declared pub can be used outside their package")
    }
    return true
}

fn labelText(Label l) string {
    if (l.pkg != "") {
        return l.pkg + "." + l.typeName + "." + l.caseName
    }
    return l.typeName + "." + l.caseName
}

// The pattern for case ci of the enum d, for hints: Shape.Circle(float r)
// or Shape.Empty.
fn (Checker c) casePattern(int d, int ci) string {
    EnumCase ec = c.enumCase(d, ci)
    string head = c.declDisplayName(d) + "." + ec.name
    if (ec.paramCount == 0) {
        return head
    }
    []string ps = []string{}
    for (int i = 0; i < ec.paramCount; i++) {
        Param p = c.ast.params[c.ast.at(ec.params, i)]
        ps.push(c.typeName(c.caseParamType(d, ci, i)) + " " + p.name)
    }
    return head + "(" + ps.join(", ") + ")"
}

// A case pattern must match its enum case exactly: a case with data binds
// every field with its type (_ as the name ignores one), a case without
// data has no parentheses. In a case with several labels, every binding
// must be _.
fn (Checker c) mut checkPattern(int li, int d, int ci, bool shared) {
    Label l = c.ast.labels[li]
    EnumCase ec = c.enumCase(d, ci)
    string cname = c.declDisplayName(d) + "." + ec.name
    if (ec.paramCount == 0) {
        if (l.parens) {
            c.errorHint(l.pos, cname + " carries no data, so its pattern has no parentheses", "write case " + cname + ":")
        }
        return
    }
    if (!l.parens) {
        c.errorHint(l.pos, cname + " carries data, so its pattern must bind every field", "write case " + c.casePattern(d, ci) + ": and use _ as the name of a field you do not need")
        return
    }
    if (l.paramCount != ec.paramCount) {
        string s = "s"
        if (ec.paramCount == 1) {
            s = ""
        }
        c.errorHint(l.pos, cname + " carries " + ec.paramCount.string() + " value" + s + " but the pattern binds " + l.paramCount.string(), "write case " + c.casePattern(d, ci) + ": and use _ as the name of a field you do not need")
        // Declare the bindings anyway, so that their uses are not reported.
        for (int b = 0; b < l.paramCount; b++) {
            int bi = c.ast.at(l.params, b)
            Param bp = c.ast.params[bi]
            c.paramVar[bi] = c.declare(bp.name, c.resolve(bp.typeExpr), VarKind.Local, bp.pos)
            if (c.paramVar[bi] >= 0) {
                c.vars[c.paramVar[bi]].used = true
            }
        }
        return
    }
    for (int m = 0; m < l.paramCount; m++) {
        int pi = c.ast.at(l.params, m)
        Param p = c.ast.params[pi]
        int pt = c.resolve(p.typeExpr)
        int want = c.caseParamType(d, ci, m)
        if (pt != tyInvalid && want != tyInvalid && pt != want) {
            c.error(p.pos, cname + " field " + (m + 1).string() + " has type " + c.typeName(want) + ", not " + c.typeName(pt))
        }
        if (shared && p.name != "_") {
            c.errorHint(p.pos, "a case with several labels cannot bind names", "use _ for every field, or give " + cname + " a case of its own")
        }
        c.paramVar[pi] = c.declare(p.name, pt, VarKind.Local, p.pos)
    }
}

// defer f(args): the arguments are evaluated now and the call runs when the
// function returns (or crashes). An error result must be discarded
// explicitly with  defer _ = f(args).
fn (Checker c) mut checkDefer(Stmt st) {
    int e = st.expr
    c.checkExpr(e)
    Expr x = c.ast.exprs[e]
    if (x.kind != ExprKind.Call) {
        if (x.kind != ExprKind.Bad) {
            c.errorHint(x.pos, "defer needs a function call", "write defer f(args)")
        }
        return
    }
    if (c.curFn < 0) {
        return
    }
    ExprInfo i = c.info[e]
    bool isMut = false
    if (i.res == Res.Method) {
        isMut = c.ast.fns[i.ref].recvMut
    } else if (i.res == Res.IfaceMethod) {
        isMut = c.ifaceMethod(i.ref, i.sub).isMut
    } else if (i.res == Res.Builtin) {
        isMut = isBuiltinMutName(c.ast.exprs[x.a].text)
    }
    if (isMut) {
        c.errorHint(x.pos, "defer cannot call the mut method " + c.describe(e), "the deferred call runs after the function's variables are gone; call it before returning instead")
        return
    }
    if (i.res == Res.Builtin && i.builtin == Builtin.Close) {
        return
    }
    if (i.res != Res.Func && i.res != Res.Method && i.res != Res.ValueCall && i.res != Res.IfaceMethod) {
        if (c.typeOf(e) != tyInvalid) {
            c.errorHint(x.pos, "defer needs a call of a function or method, not " + c.describe(e), "write a function that does the work and defer a call of it")
        }
        return
    }
    int t = c.typeOf(e)
    if (t == tyInvalid || st.discard) {
        return
    }
    if (c.types.endsWithError(t)) {
        c.errorHint(x.pos, "the error returned by " + c.describe(e) + " is not handled", "discard it explicitly: defer _ = " + c.describe(e))
    } else {
        c.checkUnusedResult(e)
    }
}

// ---- concurrency ----

// Whether the checked expression e is ch.receive() (or, when sendOk,
// ch.send(v)).
fn (Checker c) isChanOp(int e, bool sendOk) bool {
    if (c.ast.exprs[e].kind != ExprKind.Call || c.info[e].res != Res.Builtin) {
        return false
    }
    Builtin b = c.info[e].builtin
    return b == Builtin.Receive || (sendOk && b == Builtin.Send)
}

// select: every case is a channel operation, ch.send(v), ch.receive(),
// T? v = ch.receive() or v = ch.receive() (an existing variable), whose
// operands are evaluated before select waits.
fn (Checker c) mut checkSelect(Stmt st) {
    if (st.count == 0) {
        c.errorHint(st.pos, "select has no cases and would wait forever", "add a case such as case int? v = ch.receive():")
    }
    []Guard before = c.guards
    []Guard saved = c.caseGuards
    c.caseGuards = []Guard{}
    for (int i = 0; i < st.count; i++) {
        Case cs = c.ast.cases[c.ast.at(st.list, i)]
        c.pushScope()
        c.checkSelectComm(cs.comm)
        c.checkBlock(cs.body)
        c.popScope()
        c.endCase(cs.body, before)
    }
    if (st.count > 0) {
        c.guards = c.caseGuards
    }
    c.caseGuards = saved
}

fn (Checker c) mut checkSelectComm(int s) {
    if (s < 0) {
        return
    }
    Stmt st = c.ast.stmts[s]
    string hint = "a case is ch.send(v), ch.receive(), T? v = ch.receive() or v = ch.receive()"
    if (st.kind == StmtKind.ExprStmt) {
        c.checkExpr(st.expr)
        int et = c.typeOf(st.expr)
        if (et != tyInvalid && !c.isChanOp(st.expr, true)) {
            c.errorHint(c.ast.exprs[st.expr].pos, "a select case must send or receive on a channel", hint)
        } else if (et != tyInvalid && c.isChanOp(st.expr, false) && c.types.endsWithError(et)) {
            // A chan error receives an error, which must be handled like
            // any other: declared, or discarded explicitly.
            string d = c.describe(st.expr)
            c.errorHint(c.ast.exprs[st.expr].pos, "the error received by " + d + " is not handled", "declare it (case error e = " + d + ":) or discard it explicitly (case _ = " + d + ":)")
        }
        return
    }
    if (st.kind != StmtKind.Assign || st.count != 1) {
        c.errorHint(st.pos, "a select case must send or receive on a channel", hint)
        return
    }
    int ti = c.ast.at(st.list, 0)
    Target tg = c.ast.targets[ti]
    c.checkExpr(st.expr)
    int rt = c.typeOf(st.expr)
    if (rt != tyInvalid && !c.isChanOp(st.expr, false)) {
        c.errorHint(c.ast.exprs[st.expr].pos, "a select case with a variable must receive from a channel", hint)
        rt = tyInvalid
    }
    if (tg.kind == TargetKind.Place) {
        // case v = ch.receive(): an existing variable of the received type.
        if (c.ast.exprs[tg.expr].kind != ExprKind.Ident) {
            c.checkExpr(tg.expr)
            c.errorHint(tg.pos, "a select case can only receive into a variable, not into " + c.describe(tg.expr), "receive into a variable (T? v = ch.receive()) and store it in the case body")
            return
        }
        c.checkLvalue(tg.expr)
        int lt = c.typeOf(tg.expr)
        c.targetType[ti] = lt
        if (lt != tyInvalid && rt != tyInvalid && lt != rt) {
            c.errorHint(tg.pos, "the received value has type " + c.typeName(rt) + ", which cannot be assigned to " + c.describe(tg.expr) + " (type " + c.typeName(lt) + ")", "receive into a variable of type " + c.typeName(rt) + ", such as a new one: case " + c.typeName(rt) + " v = ...:")
        }
        c.assigned(c.pathKey(tg.expr))
        return
    }
    if (tg.kind == TargetKind.Discard) {
        return
    }
    int t = c.resolve(tg.typeExpr)
    c.targetType[ti] = t
    if (t != tyInvalid && rt != tyInvalid && t != rt) {
        c.errorHint(tg.pos, "the received value has type " + c.typeName(rt) + ", not " + c.typeName(t), "declare it as " + c.typeName(rt) + " " + tg.name)
    }
    c.targetVar[ti] = c.declare(tg.name, t, VarKind.Local, tg.pos)
}

// The block of a group expression: ordinary code in which spawn starts
// goroutines. It may not leave early (return, try, or break/continue of a
// loop outside it), because the group must wait for its goroutines.
fn (Checker c) mut checkGroup(int e) {
    Expr x = c.ast.exprs[e]
    bool allowed = c.allowGroup == e && c.curFn >= 0
    c.allowGroup = -1
    int savedDepth = c.groupDepth
    int savedLoop = c.groupLoop
    c.groupDepth++
    c.groupLoop = c.loopDepth
    c.checkBlock(x.block)
    c.groupDepth = savedDepth
    c.groupLoop = savedLoop
    if (!allowed) {
        c.errorHint(x.pos, "a group can only be assigned to an error variable, returned, discarded or used with try", "write error err = group {...}, err = group {...}, return group {...}, _ = group {...} or try group {...}")
        c.setType(e, tyInvalid)
        return
    }
    c.setType(e, tyError)
}

// spawn f(args): only inside a group block. The callee and the arguments
// are evaluated now and deep-copied for the new goroutine, which shares
// nothing with the one that started it.
fn (Checker c) mut checkSpawn(Stmt st) {
    int e = st.expr
    if (c.groupDepth == 0) {
        c.errorHint(st.pos, "spawn is only allowed inside a group block", "the group waits for its goroutines: error err = group { spawn f(...) }")
    }
    c.checkExpr(e)
    Expr x = c.ast.exprs[e]
    if (x.kind != ExprKind.Call) {
        if (x.kind != ExprKind.Bad) {
            c.errorHint(x.pos, "spawn needs a function call", "write spawn f(args)")
        }
        return
    }
    int t = c.typeOf(e)
    if (t == tyInvalid) {
        return
    }
    ExprInfo i = c.info[e]
    bool isMut = false
    if (i.res == Res.Method) {
        isMut = c.ast.fns[i.ref].recvMut
    } else if (i.res == Res.IfaceMethod) {
        isMut = c.ifaceMethod(i.ref, i.sub).isMut
    }
    if (isMut) {
        c.errorHint(x.pos, "spawn cannot call the mut method " + c.describe(e), "goroutines share nothing: the goroutine would change its own copy of " + c.describe(c.ast.exprs[x.a].a) + "; send the result back on a channel instead")
        return
    }
    if (i.res != Res.Func && i.res != Res.Method && i.res != Res.ValueCall && i.res != Res.IfaceMethod) {
        c.errorHint(x.pos, "spawn needs a call of a function or method, not " + c.describe(e), "write a function that does the work and spawn a call of it")
        return
    }
    if (t != tyVoid && t != tyError) {
        c.errorHint(x.pos, "a spawned function must return error or nothing, but " + c.describe(e) + " returns " + c.typeName(t), "send results back on a channel")
    }
}
