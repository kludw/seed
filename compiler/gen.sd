// The C generator: turns the checked program into one self-contained C file
// that contains the runtime of runtime/ (see runtime/README.md for the
// representation of every type and the ownership rules):
//
//   int sd_int (tagged, grows), float double, bool bool, byte uint8_t,
//   string sd_str, []T sd_list*, map sd_map*, struct sd_S_Name (by value),
//   enum sd_box* (a box holding sd_E_Name), interface sd_iface, error
//   sd_err, fn(...) R a C function pointer sd_fn_<mangle>, int? sd_int
//   (SD_INT_NULL), float?/bool?/byte? sd_opt_*, Struct? sd_box*, other T?
//   the same C type with NULL (or a null vt) for null, several results
//   sd_T_<mangle> with fields r0, r1, ...
//
// Memory is managed by reference counting. Parameters are borrowed, results
// owned, and stores consume. The generator keeps a stack of the counted
// values the current function owns (Gen.slots): local variables and the
// temporaries of the statement being generated. A temporary is released at
// the end of its statement unless it was moved into a store; locals are
// released at the end of their block; return, break, continue and try
// release everything they leave. See compiler/README.md.
//
// This file has the program layout, C types, per-type helpers, type
// definitions, vtables and the runtime. Expressions are in gen_expr.sd,
// calls in gen_call.sd, statements in gen_stmt.sd.
package main

import "errors"
import "fs"

// Helper kinds, used as bits in Type.helpers.
const int helperRetain = 1
const int helperRelease = 2
const int helperEq = 4
const int helperLess = 8

type HelperReq struct {
    int ty
    int kind
}

// A counted value owned by the function being generated: a local variable
// or a temporary (temp). A slot that was moved out is not live. seq is the
// number of possible crash points emitted before it began to own its value
// (see genFn), id identifies it.
type Slot struct {
    string name
    int ty
    bool live
    bool temp
    int seq
    int id
}

// The innermost loop: break and continue release the slots above mark.
// label is the number of the continue label (_cN) when the loop has one,
// or -1 when C's continue does the job. In the fast copy of a loop with
// accumulators (gen_acc.sd), acc are the accumulators, raw in this copy,
// and accTo is the number of the general copy's continue label; bounded
// are the accumulators whose updates cannot overflow int64_t there.
type LoopCtx struct {
    int mark
    int label
    []int acc
    []int bounded
    int accTo
}

type Gen struct {
    Checker c
    []string out
    []string fnText
    []CDecl decls
    []CDecl gprotos
    []string protos
    []string helpers
    []string thunks
    []string consts
    []HelperReq queue
    []Slot slots
    []int scopes
    []LoopCtx loops
    []string groups
    int indent
    int ntmp
    int ndefer
    int nspawn
    int curFn
    bool defers
    // Cleanup frames (see genFn): whether counted locals and temporaries of
    // the current function live in its frame struct L, the fields of L, the
    // C names of the locals that live there, the temporaries moved out of
    // L whose fields are to be set to null after the line that consumed
    // them, and whether the frame was left (a return is being emitted).
    bool frameOn
    []Slot frame
    map[string]int frameIdx
    map[int]string varC
    []Slot moved
    bool popped
    map[int]bool fcCache
    int crashSeq
    int nslot
    map[string]bool fieldNeeded
    map[int]bool slotDone
    []Slot frameSlots
    map[string]bool safeCalls
    // Small ints (gen_int.sd): the intervals of the unboxed locals of the
    // current function, and the analysis's state.
    map[int]IntRange varRange
    []IntEvent intEvents
    map[int]bool intDeclared
    // Move on last use (gen_move.sd): the C names of the locals the
    // current statement may move out of, the locals each statement of the
    // current function may move, and the analysis's state.
    map[string]bool movable
    map[int][]int moveAt
    []int mvStmtAt
    map[int]int mvLevel
    map[int]int mvDecl
    map[int]int mvLast
    map[int]int mvCount
    map[int]bool mvCond
    // Borrowed locals (gen_move.sd): the mod sets of the mut methods, the
    // borrowed locals of the current function and their places' variables,
    // and the walk's state.
    map[int][]string modSets
    map[int]bool borrowed
    map[int]bool borrowRoots
    []MutEvent bwEvents
    []BorrowCand bwCands
    bool bwOn
    // Parameters that the current function assigns: they own a copy of
    // their value (see ownParams).
    map[int]bool ownedParams
    // Fast versions of pure int functions (gen_fast.sd): the functions
    // that have one, and the state of the search and of the generator.
    map[int]bool fastFns
    []int fastCalls
    []int fastLoops
    // Preemption checks (gen_preempt.sd): the functions that check on
    // entry, the components of the direct call graph, and the walk's state.
    map[int]bool preemptFns
    []int pcComp
    []bool pcCyclic
    []int pcCallees
    int pcBody
    bool pcSeen
    bool pcTop
    int pcCond
    // Units (gen_unit.sd): whether the program is generated as one C file
    // per package, and the identifiers the unit being assembled refers to.
    bool split
    map[string]bool refs
    // Crash traces (see emit and siteRef): the position in the source of
    // the code being generated, the Seed name of the current function,
    // whether its lines are marked, the C name of the unit's table of
    // sites, the table's entries and their indexes by text. With debug
    // (seed build -g), the lines of Seed functions carry #line directives;
    // lastLine is the last one emitted.
    Pos pos
    string fnLabel
    bool siteOn
    string siteTab
    []string sites
    map[string]int siteIdx
    bool debug
    string lastLine
    map[string]bool siteSafe
    bool noMarks
}

fn newGen(Checker c) Gen {
    return Gen{
        c: c,
        out: []string{},
        fnText: []string{},
        decls: []CDecl{},
        gprotos: []CDecl{},
        protos: []string{},
        helpers: []string{},
        thunks: []string{},
        consts: []string{},
        queue: []HelperReq{},
        slots: []Slot{},
        scopes: []int{},
        loops: []LoopCtx{},
        groups: []string{},
        indent: 0,
        ntmp: 0,
        ndefer: 0,
        nspawn: 0,
        curFn: -1,
        defers: false,
        frameOn: false,
        frame: []Slot{},
        frameIdx: map[string]int{},
        varC: map[int]string{},
        moved: []Slot{},
        popped: false,
        fcCache: map[int]bool{},
        crashSeq: 0,
        nslot: 0,
        fieldNeeded: map[string]bool{},
        slotDone: map[int]bool{},
        frameSlots: []Slot{},
        safeCalls: safeCallSet(),
        varRange: map[int]IntRange{},
        intEvents: []IntEvent{},
        intDeclared: map[int]bool{},
        movable: map[string]bool{},
        moveAt: map[int][]int{},
        mvStmtAt: []int{},
        mvLevel: map[int]int{},
        mvDecl: map[int]int{},
        mvLast: map[int]int{},
        mvCount: map[int]int{},
        mvCond: map[int]bool{},
        modSets: map[int][]string{},
        borrowed: map[int]bool{},
        borrowRoots: map[int]bool{},
        bwEvents: []MutEvent{},
        bwCands: []BorrowCand{},
        bwOn: false,
        ownedParams: map[int]bool{},
        fastFns: map[int]bool{},
        fastCalls: []int{},
        fastLoops: []int{},
        preemptFns: map[int]bool{},
        pcComp: []int{},
        pcCyclic: []bool{},
        pcCallees: []int{},
        pcBody: -1,
        pcSeen: false,
        pcTop: false,
        pcCond: 0,
        split: false,
        refs: map[string]bool{},
        pos: Pos{file: -1, line: 0, col: 0},
        fnLabel: "",
        siteOn: false,
        siteTab: "sd_sites_prog",
        sites: []string{},
        siteIdx: map[string]int{},
        debug: false,
        lastLine: "",
        siteSafe: siteSafeSet(),
        noMarks: false,
    }
}

// Generates the program and returns the C text (without the runtime).
// natives is the C code of the native functions of the standard library
// packages in the program; it goes after the type definitions and
// prototypes, so that it can use them.
fn (Gen g) mut genProgram(string natives) string {
    g.genTypes()
    g.computeModSets()
    g.findFastFns()
    g.findPreemptFns()
    g.genProtos()
    g.markLiteralConsts()
    g.genConsts(-1)
    g.genFns(-1)
    g.curFn = -1
    g.genVtables(-1)
    for (int i = 0; i < g.queue.len(); i++) {
        g.genHelper(g.queue[i].ty, g.queue[i].kind)
    }
    []string parts = []string{"\n/* ---- program ---- */\n"}
    for (int d = 0; d < g.decls.len(); d++) {
        parts.push(g.decls[d].text)
    }
    for (int p = 0; p < g.gprotos.len(); p++) {
        parts.push(g.gprotos[p].text)
    }
    parts.push(g.protos.join(""))
    parts.push(g.siteDecl())
    parts.push(natives)
    parts.push(g.helpers.join(""))
    parts.push(g.thunks.join(""))
    parts.push(g.consts.join(""))
    parts.push(g.fnText.join(""))
    parts.push(g.mainText())
    parts.push(g.siteTable())
    return parts.join("")
}

// Generates the functions of the program, or with a unit (a package,
// >= 0) those of the package.
fn (Gen g) mut genFns(int unit) {
    for (int f = 0; f < g.c.ast.fns.len(); f++) {
        if (unit >= 0 && g.c.fnPkg(f) != unit) {
            continue
        }
        if (g.c.ast.fns[f].body < 0) {
            g.genNative(f)
        } else if (!g.c.ast.fns[f].isTest || g.c.testMode) {
            g.genFn(f)
            if (g.isFast(f)) {
                g.genFast(f)
            }
        }
    }
}

// The C function main: the runtime's entry with the program's main, or the
// test runner with the table of tests.
fn (Gen g) mainText() string {
    if (g.c.testMode) {
        return g.testMain()
    }
    return "int main(int argc, char **argv) { return sd_main(argc, argv, sd_f_main); }\n"
}

// The table of tests and a main that runs them (runtime/seed_test.c): each
// test runs in a goroutine of its own group.
fn (Gen g) testMain() string {
    []string rows = []string{}
    for (int f = 0; f < g.c.ast.fns.len(); f++) {
        FnDecl fd = g.c.ast.fns[f]
        if (fd.isTest && g.c.ast.files[fd.file].isTest) {
            rows.push("  {" + cString(fd.name) + ", " + cString(g.c.diags.paths[fd.file]) + ", " + fd.pos.line.string() + ", " + g.c.fnCName[f] + "},\n")
        }
    }
    if (rows.len() == 0) {
        rows.push("  {NULL, NULL, 0, NULL},\n")
    }
    string n = rows.len().string()
    if (rows[0].startsWith("  {NULL")) {
        n = "0"
    }
    return "static const sd_test sd_tests[] = {\n" + rows.join("") + "};\nint main(int argc, char **argv) { return sd_test_main(argc, argv, sd_tests, " + n + "); }\n"
}

// ---- output ----

// Emits a line, and counts it when it may crash (see genFn). The fields of
// the temporaries that the line moved out of the frame (ownVal, consume)
// are set to null right after it, so that a crash later on does not
// release them a second time.
fn (Gen g) mut emit(string raw) {
    string line = g.resolveTake(raw)
    string pad = ""
    if (g.indent > 0) {
        pad = spaces(g.indent * 2)
    }
    string text = line
    if (g.siteOn) {
        string lm = g.lineMark()
        if (lm != "") {
            g.out.push(lm)
        }
        if (g.pos.line > 0 && !g.noMarks && g.markable(line)) {
            text = g.marked(line)
        }
    }
    g.out.push(pad + text + "\n")
    if (g.frameOn && g.lineMayCrash(line)) {
        g.crashSeq++
    }
    if (g.moved.len() > 0) {
        for (int i = 0; i < g.moved.len(); i++) {
            if (g.siteOn) {
                string nm = g.lineMark()
                if (nm != "") {
                    g.out.push(nm)
                }
            }
            g.out.push(pad + nullMark(g.moved[i].name) + "\n")
            g.slotEnd(g.moved[i])
        }
        g.moved = []Slot{}
    }
}

// ---- indexes that take their temporary ----
//
// An index into a list or a string that is an owned int temporary (xs[i +
// 1], xs[f()]) is generated with a mark (takeMark) that emit resolves when
// the line is complete. When nothing on the line can crash before the
// index is checked (every other call that may crash encloses the check, so
// it runs after it) and nothing could crash since the temporary got its
// value, the check *takes* the temporary (SD_LIST_TAKE_AT, sd_str_at_take):
// out of range, it releases the index before crashing; in range, the index
// is small and owns nothing. The temporary's ownership ends there, so it
// needs no field in the cleanup frame for a crash (a big int would
// otherwise have to be kept in the frame across the check). Otherwise the
// mark is dropped: the usual check, and the temporary is released as
// before.

// The mark after the name of an index check whose index is v: a mark when v
// is an owned int temporary.
fn (Gen g) takeMark(string v) string {
    if (!g.frameOn) {
        return ""
    }
    int s = g.findTemp(v)
    if (s < 0 || g.kindOf(g.slots[s].ty) != Kind.Int) {
        return ""
    }
    return "\x03"
}

// The position after the parenthesis that closes the one at open, skipping
// string and character literals; -1 if there is none.
fn closeParen(string line, int open) int {
    int depth = 0
    for (int i = open; i < line.len(); i++) {
        byte c = line[i]
        if (c == '"' || c == '\'') {
            i++
            for (; i < line.len() && line[i] != c; i++) {
                if (line[i] == '\\') {
                    i++
                }
            }
            continue
        }
        if (c == '(') {
            depth++
        } else if (c == ')') {
            depth--
            if (depth == 0) {
                return i + 1
            }
        }
    }
    return -1
}

// The arguments of the call whose parenthesis is at open, trimmed.
fn callArgs(string line, int open, int close) []string {
    []string args = []string{}
    int depth = 0
    int from = open + 1
    for (int i = open + 1; i < close - 1; i++) {
        byte c = line[i]
        if (c == '"' || c == '\'') {
            i++
            for (; i < close - 1 && line[i] != c; i++) {
                if (line[i] == '\\') {
                    i++
                }
            }
            continue
        }
        if (c == '(' || c == '[' || c == '{') {
            depth++
        } else if (c == ')' || c == ']' || c == '}') {
            depth--
        } else if (c == ',' && depth == 0) {
            args.push(line.slice(from, i).trim())
            from = i + 1
        }
    }
    args.push(line.slice(from, close - 1).trim())
    return args
}

// Whether every call on the line that may crash, other than the one from
// `from` to `to`, encloses it (so that it runs after it). Calls through an
// expression count as crashing; string literals are skipped.
fn (Gen g) crashesEnclose(string line, int from, int to) bool {
    for (int i = 0; i < line.len(); i++) {
        byte c = line[i]
        if (c == '"' || c == '\'') {
            i++
            for (; i < line.len() && line[i] != c; i++) {
                if (line[i] == '\\') {
                    i++
                }
            }
            continue
        }
        if (c != '(') {
            continue
        }
        int j = i
        for (; j > 0 && isIdentByte(line[j - 1]); ) {
            j--
        }
        if (j == from) {
            continue
        }
        bool crashes = false
        if (j == i) {
            crashes = i > 0 && line[i - 1] == ')'
        } else {
            string id = line.slice(j, i)
            crashes = !id.startsWith("sd_rt_") && !id.startsWith("sd_rl_") && g.safeCalls[id] == null
        }
        if (crashes) {
            int end = closeParen(line, i)
            if (end < 0 || j > from || end < to) {
                return false
            }
        }
    }
    return true
}

// Whether everything on the C line runs whenever the line does: one
// statement without a condition (&&, ||, ?:, if, a loop, a block).
fn unconditional(string line) bool {
    string t = line.trim()
    if (t.contains("&&") || t.contains("||") || t.contains("?") || t.contains("{") || t.contains("}")) {
        return false
    }
    []string heads = []string{"if", "else", "for", "while", "do", "switch", "case", "default", "goto", "break", "continue"}
    for (int i = 0; i < heads.len(); i++) {
        if (t.startsWith(heads[i] + " ") || t.startsWith(heads[i] + "(") || t == heads[i] + ";") {
            return false
        }
    }
    return t.endsWith(";")
}

// The line with its index marks resolved (see takeMark).
fn (Gen g) mut resolveTake(string line) string {
    if (!line.contains("\x03")) {
        return line
    }
    int at = -1
    int marks = 0
    for (int i = 0; i < line.len(); i++) {
        if (line[i] == byte(3)) {
            at = i
            marks++
        }
    }
    string plain = line.replace("\x03", "")
    if (!g.frameOn || marks != 1 || at + 1 >= line.len() || line[at + 1] != '(' || !unconditional(line)) {
        return plain
    }
    int start = at
    for (; start > 0 && isIdentByte(line[start - 1]); ) {
        start--
    }
    string name = line.slice(start, at)
    int close = closeParen(line, at + 1)
    if (close < 0 || (name != "SD_LIST_GET_AT" && name != "sd_str_at_s")) {
        return plain
    }
    []string args = callArgs(line, at + 1, close)
    string index = ""
    if (name == "sd_str_at_s" && args.len() == 3) {
        index = args[1]
    } else if (name == "SD_LIST_GET_AT" && args.len() == 4) {
        index = args[2]
    }
    int s = g.findTemp(index)
    if (s < 0 || g.slots[s].seq != g.crashSeq || !g.crashesEnclose(line, start, close)) {
        return plain
    }
    g.slotEnd(g.slots[s])
    g.slots[s].live = false
    string take = "SD_LIST_TAKE_AT"
    if (name == "sd_str_at_s") {
        take = "sd_str_at_take"
    }
    return line.slice(0, start) + take + line.slice(at + 1, line.len())
}

// The C functions and macros that never crash nor stop the goroutine (nor
// run Seed code): a value held only by a C local across them cannot be
// leaked by a crash. Everything else that is called may crash.
fn safeCallSet() map[string]bool {
    map[string]bool m = map[string]bool{}
    []string names = []string{"sd_int_retain", "sd_int_release", "sd_str_retain", "sd_str_release", "sd_list_retain", "sd_list_release", "sd_map_retain", "sd_map_release", "sd_box_retain", "sd_box_release", "sd_iface_retain", "sd_iface_release", "sd_chan_retain", "sd_chan_release", "sd_list_new", "sd_map_new", "sd_box_new", "sd_iface_new", "SD_LIST_PUSH", "sd_str_concat", "sd_str_concat_n", "sd_str_concat_parts", "sd_str_append", "sd_str_append_parts", "sd_int_to_str", "sd_float_to_str", "sd_bool_to_str", "sd_byte_to_str", "sd_str_from_bytes", "SD_INT", "SD_INT_S", "SD_SMALL", "SD_STR_LIT", "SD_BOX_REF", "SD_BOX_GET", "sd_err_is_null", "sd_iface_is_null", "sd_int_is_null", "sd_str_len", "sd_list_len", "sd_map_len", "sd_str_eq", "sd_str_cmp", "sd_int_eq", "sd_int_lt", "sd_int_le", "sd_int_gt", "sd_int_ge", "sd_int_add", "sd_int_sub", "sd_int_mul", "sd_int_neg", "sd_int_and", "sd_int_or", "sd_int_xor", "sd_byte_to_int", "sd_int_to_float", "sd_iface_self", "sd_str_contains", "sd_str_starts_with", "sd_str_ends_with", "sd_defer_mark", "sd_group_begin", "sd_int_add_slow", "sd_int_sub_slow", "SD_LIKELY", "__builtin_add_overflow", "__builtin_sub_overflow", "SD_PREEMPT", "__volatile__", "SD_LF_LEAVE"}
    for (int i = 0; i < names.len(); i++) {
        m[names[i]] = true
    }
    return m
}

fn isIdentByte(byte b) bool {
    return (b >= 'a' && b <= 'z') || (b >= 'A' && b <= 'Z') || (b >= '0' && b <= '9') || b == '_'
}

// Whether the C line may crash or stop the goroutine: it calls something
// other than the safe calls (safeCallSet, and the retain and release
// helpers sd_rt_ and sd_rl_), or calls through an expression (a function
// value). Lines with string literals are judged by their calls too; a false
// "may crash" only costs a field in the frame.
fn (Gen g) lineMayCrash(string line) bool {
    for (int i = 0; i < line.len(); i++) {
        if (line[i] != '(') {
            continue
        }
        int j = i
        for (; j > 0 && isIdentByte(line[j - 1]); ) {
            j--
        }
        if (j == i) {
            if (i > 0 && line[i - 1] == ')') {
                return true
            }
            continue
        }
        string id = line.slice(j, i)
        if (id.startsWith("sd_rt_") || id.startsWith("sd_rl_")) {
            continue
        }
        bool? safe = g.safeCalls[id]
        if (safe == null) {
            return true
        }
    }
    return false
}

fn (Gen g) mut newTmp() string {
    g.ntmp++
    return "_t" + g.ntmp.string()
}

// ---- types ----

fn (Gen g) kindOf(int t) Kind {
    return g.c.types.kind(t)
}

fn (Gen g) elemOf(int t) int {
    return g.c.types.elem(t)
}

// The C name of a struct, enum or interface type (with its package's
// prefix).
fn (Gen g) declName(int t) string {
    return g.c.declCName(g.c.types.decl(t))
}

// The C function that returns the value of a constant.
fn (Gen g) constCName(int i) string {
    ConstDecl cd = g.c.ast.consts[i]
    return "sd_c_" + g.c.ast.pkgs[g.c.ast.files[cd.file].pkgIndex].cprefix + cd.name
}

fn (Gen g) ctype(int t) string {
    switch (g.kindOf(t)) {
    case Kind.Void:
        return "void"
    case Kind.Int:
        return "sd_int"
    case Kind.Float:
        return "double"
    case Kind.Bool:
        return "bool"
    case Kind.Byte:
        return "uint8_t"
    case Kind.String:
        return "sd_str"
    case Kind.Error:
        return "sd_err"
    case Kind.Null, Kind.Invalid:
        return "void *"
    case Kind.List:
        return "sd_list *"
    case Kind.Map:
        return "sd_map *"
    case Kind.Chan:
        return "sd_chan *"
    case Kind.Struct:
        return "sd_S_" + g.declName(t)
    case Kind.Enum:
        return "sd_box *"
    case Kind.Interface:
        return "sd_iface"
    case Kind.Tuple:
        return "sd_T_" + g.c.types.mangle(t)
    case Kind.Func:
        return "sd_fn_" + g.c.types.mangle(t)
    case Kind.Opt:
        int el = g.elemOf(t)
        Kind k = g.kindOf(el)
        if (k == Kind.Float) {
            return "sd_opt_float"
        }
        if (k == Kind.Bool) {
            return "sd_opt_bool"
        }
        if (k == Kind.Byte) {
            return "sd_opt_byte"
        }
        if (k == Kind.Struct) {
            return "sd_box *"
        }
        return g.ctype(el)
    }
}

// float?, bool? and byte?: a {has, v} struct.
fn (Gen g) isSmallOpt(int t) bool {
    if (!g.c.types.isOpt(t)) {
        return false
    }
    Kind k = g.kindOf(g.elemOf(t))
    return k == Kind.Float || k == Kind.Bool || k == Kind.Byte
}

// Struct?: a box holding the struct.
fn (Gen g) isBoxOpt(int t) bool {
    return g.c.types.isOpt(t) && g.kindOf(g.elemOf(t)) == Kind.Struct
}

// Whether values of type t hold reference counts (so copies are retained
// and drops released). Cached in Type.rt for structs and tuples.
fn (Gen g) mut counted(int t) bool {
    switch (g.kindOf(t)) {
    case Kind.Int, Kind.String, Kind.Error, Kind.List, Kind.Map, Kind.Chan, Kind.Enum, Kind.Interface:
        return true
    case Kind.Void, Kind.Float, Kind.Bool, Kind.Byte, Kind.Null, Kind.Invalid, Kind.Func:
        return false
    case Kind.Opt:
        if (g.isBoxOpt(t)) {
            return true
        }
        return g.counted(g.elemOf(t))
    case Kind.Struct, Kind.Tuple:
        int cached = g.c.types.list[t].rt
        if (cached == 0 || cached == 1) {
            return cached == 1
        }
        bool r = false
        if (g.kindOf(t) == Kind.Tuple) {
            for (int i = 0; i < g.c.types.count(t); i++) {
                if (g.counted(g.c.types.part(t, i))) {
                    r = true
                }
            }
        } else {
            int d = g.c.types.decl(t)
            for (int j = 0; j < g.c.ast.typeDecls[d].fieldCount; j++) {
                if (g.counted(g.c.fieldType(d, j))) {
                    r = true
                }
            }
        }
        if (r) {
            g.c.types.list[t].rt = 1
        } else {
            g.c.types.list[t].rt = 0
        }
        return r
    }
}

// Whether values of type t live in the cleanup frame of a function (see
// genFn): counted types, int included (a big integer owns memory; a small
// one owns nothing, so a field holding it costs only its stores and
// loads), except enums whose cases have no data (every value is an
// immortal static box). Unboxed int locals (gen_int.sd) are not slots.
fn (Gen g) mut frameCounted(int t) bool {
    switch (g.kindOf(t)) {
    case Kind.Enum:
        int d = g.c.types.decl(t)
        for (int i = 0; i < g.c.ast.typeDecls[d].caseCount; i++) {
            if (g.c.enumCase(d, i).paramCount > 0) {
                return true
            }
        }
        return false
    case Kind.String, Kind.Error, Kind.List, Kind.Map, Kind.Chan, Kind.Interface, Kind.Int:
        return true
    case Kind.Void, Kind.Float, Kind.Bool, Kind.Byte, Kind.Null, Kind.Invalid, Kind.Func:
        return false
    case Kind.Opt:
        if (g.isBoxOpt(t)) {
            return true
        }
        return g.frameCounted(g.elemOf(t))
    case Kind.Struct, Kind.Tuple:
        bool? cached = g.fcCache[t]
        if (cached != null) {
            return cached
        }
        bool r = false
        []int parts = g.partTypes(t)
        for (int i = 0; i < parts.len(); i++) {
            if (g.frameCounted(parts[i])) {
                r = true
            }
        }
        g.fcCache[t] = r
        return r
    }
}

// Whether a slot of type t in the current function lives in its frame.
fn (Gen g) mut inFrame(int t) bool {
    return g.frameOn && g.frameCounted(t)
}

// The field of the frame for a slot named base of type t. Locals of the
// same name and type (in sibling blocks: there is no shadowing) share a
// field; one of another type gets base_2, ... The name is a placeholder
// (\x01base\x01) until genFn decides whether the field is needed: it
// becomes L.base, or a C local base when no slot of the field owns a value
// across a possible crash point.
fn (Gen g) mut frameField(string base, int t) string {
    string name = base
    int n = 1
    for (;;) {
        int? at = g.frameIdx[name]
        if (at == null) {
            g.frameIdx[name] = g.frame.len()
            g.frame.push(Slot{name: name, ty: t, live: true, temp: false, seq: 0, id: -1})
            return "\x01" + name + "\x01"
        }
        if (g.frame[at].ty == t) {
            return "\x01" + name + "\x01"
        }
        n++
        name = base + "_" + n.string()
    }
}

// Whether the C name v is a field of the frame (a placeholder).
fn isFrameName(string v) bool {
    return v.len() > 2 && v.startsWith("\x01") && v.endsWith("\x01") && isIdent(v.slice(1, v.len() - 1))
}

// The statement that sets the frame field v (a placeholder) to null;
// nothing when the field is a C local.
fn nullMark(string v) string {
    return "\x01N" + v.slice(1, v.len())
}

// Registers a slot that owns its value from now on.
fn (Gen g) mut pushSlot(string name, int t, bool temp) {
    g.nslot++
    Slot s = Slot{name: name, ty: t, live: true, temp: temp, seq: g.crashSeq, id: g.nslot}
    g.slots.push(s)
    if (isFrameName(name)) {
        g.frameSlots.push(s)
    }
}

// Slot s stops owning its value here (it is released, or moved by the
// line just emitted): its field is needed in the frame when a possible
// crash point was emitted since the slot began to own its value. (Lines are
// emitted in source order, so every crash point on any path between the
// two was counted.)
fn (Gen g) mut slotEnd(Slot s) {
    if (!isFrameName(s.name)) {
        return
    }
    g.slotDone[s.id] = true
    if (s.seq != g.crashSeq) {
        g.fieldNeeded[s.name.slice(1, s.name.len() - 1)] = true
    }
}

// Requests a helper for t and returns its name.
fn (Gen g) mut helper(int t, int kind, string prefix) string {
    if ((g.c.types.list[t].helpers & kind) == 0) {
        g.c.types.list[t].helpers = g.c.types.list[t].helpers | kind
        g.queue.push(HelperReq{ty: t, kind: kind})
    }
    return prefix + g.c.types.mangle(t)
}

// An expression that retains v (of type t) and has its value.
fn (Gen g) mut retainExpr(int t, string v) string {
    if (!g.counted(t)) {
        return v
    }
    switch (g.kindOf(t)) {
    case Kind.Int:
        return "sd_int_retain(" + v + ")"
    case Kind.String:
        return "sd_str_retain(" + v + ")"
    case Kind.List:
        return "sd_list_retain(" + v + ")"
    case Kind.Map:
        return "sd_map_retain(" + v + ")"
    case Kind.Chan:
        return "sd_chan_retain(" + v + ")"
    case Kind.Enum:
        return "sd_box_retain(" + v + ")"
    case Kind.Interface, Kind.Error:
        return "sd_iface_retain(" + v + ")"
    case Kind.Struct, Kind.Tuple:
        return g.helper(t, helperRetain, "sd_rt_") + "(" + v + ")"
    case Kind.Opt:
        if (g.isBoxOpt(t)) {
            return "sd_box_retain(" + v + ")"
        }
        return g.retainExpr(g.elemOf(t), v)
    case Kind.Void, Kind.Float, Kind.Bool, Kind.Byte, Kind.Null, Kind.Invalid, Kind.Func:
        return v
    }
}

// A statement (without ;) that releases v, or "" when t is not counted.
fn (Gen g) mut releaseCall(int t, string v) string {
    if (!g.counted(t)) {
        return ""
    }
    switch (g.kindOf(t)) {
    case Kind.Int:
        return "sd_int_release(" + v + ")"
    case Kind.String:
        return "sd_str_release(" + v + ")"
    case Kind.List:
        return "sd_list_release(" + v + ")"
    case Kind.Map:
        return "sd_map_release(" + v + ")"
    case Kind.Chan:
        return "sd_chan_release(" + v + ")"
    case Kind.Enum:
        return "sd_box_release(" + v + ")"
    case Kind.Interface, Kind.Error:
        return "sd_iface_release(" + v + ")"
    case Kind.Struct, Kind.Tuple:
        return g.helper(t, helperRelease, "sd_rl_") + "(" + v + ")"
    case Kind.Opt:
        if (g.isBoxOpt(t)) {
            return "sd_box_release(" + v + ")"
        }
        return g.releaseCall(g.elemOf(t), v)
    case Kind.Void, Kind.Float, Kind.Bool, Kind.Byte, Kind.Null, Kind.Invalid, Kind.Func:
        return ""
    }
}

// The runtime type descriptor of t (for list elements, map keys and values,
// boxes and interface payloads).
fn (Gen g) desc(int t) string {
    switch (g.kindOf(t)) {
    case Kind.Int:
        return "&sd_type_int"
    case Kind.Float:
        return "&sd_type_float"
    case Kind.Bool:
        return "&sd_type_bool"
    case Kind.Byte:
        return "&sd_type_byte"
    case Kind.String:
        return "&sd_type_str"
    case Kind.Error:
        return "&sd_type_err"
    case Kind.List:
        return "&sd_type_list"
    case Kind.Map:
        return "&sd_type_map"
    case Kind.Chan:
        return "&sd_type_chan"
    case Kind.Struct:
        return "&sd_D_" + g.declName(t)
    case Kind.Enum:
        return "&sd_type_box"
    case Kind.Interface:
        return "&sd_type_iface"
    case Kind.Func:
        return "&sd_type_fn"
    case Kind.Opt:
        int el = g.elemOf(t)
        Kind k = g.kindOf(el)
        if (k == Kind.Float) {
            return "&sd_type_opt_float"
        }
        if (k == Kind.Bool) {
            return "&sd_type_opt_bool"
        }
        if (k == Kind.Byte) {
            return "&sd_type_opt_byte"
        }
        if (k == Kind.Struct) {
            return "&sd_type_box"
        }
        return g.desc(el)
    case Kind.Void, Kind.Null, Kind.Invalid, Kind.Tuple:
        return "NULL"
    }
}

// The null of a T? (or error).
fn (Gen g) nullOf(int t) string {
    if (g.isSmallOpt(t)) {
        return "((" + g.ctype(t) + "){false, 0})"
    }
    Kind k = g.kindOf(t)
    if (g.c.types.isOpt(t)) {
        k = g.kindOf(g.elemOf(t))
    }
    if (k == Kind.Int) {
        return "SD_INT_NULL"
    }
    if (k == Kind.Interface || k == Kind.Error) {
        return "SD_IFACE_NULL"
    }
    return "NULL"
}

// A placeholder value of a plain type, for `return null, err` (never read).
fn (Gen g) zeroOf(int t) string {
    switch (g.kindOf(t)) {
    case Kind.Int:
        return "SD_INT(0)"
    case Kind.Float:
        return "0.0"
    case Kind.Bool:
        return "false"
    case Kind.Byte:
        return "((uint8_t)0)"
    case Kind.Struct, Kind.Tuple:
        return "((" + g.ctype(t) + "){0})"
    case Kind.Opt, Kind.Error, Kind.Interface:
        return g.nullOf(t)
    case Kind.Void, Kind.String, Kind.Null, Kind.Invalid, Kind.List, Kind.Map, Kind.Enum, Kind.Func, Kind.Chan:
        return "NULL"
    }
}

fn (Gen g) isNull(int t, string v) string {
    if (g.isSmallOpt(t)) {
        return "(!(" + v + ").has)"
    }
    Kind k = g.kindOf(t)
    if (g.c.types.isOpt(t)) {
        k = g.kindOf(g.elemOf(t))
    }
    if (k == Kind.Int) {
        return "sd_int_is_null(" + v + ")"
    }
    if (k == Kind.Interface || k == Kind.Error) {
        return "sd_iface_is_null(" + v + ")"
    }
    return "((" + v + ") == NULL)"
}

// Seed == on two (borrowed, side-effect free) values of type t.
fn (Gen g) mut eqExpr(int t, string a, string b) string {
    switch (g.kindOf(t)) {
    case Kind.Int:
        return "sd_int_eq(" + a + ", " + b + ")"
    case Kind.Float, Kind.Bool, Kind.Byte, Kind.Func, Kind.Chan:
        return "((" + a + ") == (" + b + "))"
    case Kind.String:
        return "sd_str_eq(" + a + ", " + b + ")"
    case Kind.Error:
        return "sd_err_equal(" + a + ", " + b + ")"
    case Kind.Interface:
        return "sd_iface_equal(" + a + ", " + b + ")"
    case Kind.List:
        return "sd_list_equal(" + a + ", " + b + ")"
    case Kind.Map:
        return "sd_map_equal(" + a + ", " + b + ")"
    case Kind.Enum:
        return "sd_box_equal(" + a + ", " + b + ")"
    case Kind.Struct:
        return g.helper(t, helperEq, "sd_eq_") + "(" + a + ", " + b + ")"
    case Kind.Opt:
        if (g.isSmallOpt(t)) {
            return "((" + a + ").has == (" + b + ").has && (!(" + a + ").has || (" + a + ").v == (" + b + ").v))"
        }
        if (g.isBoxOpt(t)) {
            return "sd_box_equal(" + a + ", " + b + ")"
        }
        return g.eqExpr(g.elemOf(t), a, b)
    case Kind.Void, Kind.Null, Kind.Invalid, Kind.Tuple:
        return "false"
    }
}

// Converts a borrowed T into a T? (creating a box for a struct).
fn (Gen g) mut wrapVal(int opt, string v) string {
    int el = g.elemOf(opt)
    if (g.isSmallOpt(opt)) {
        return "((" + g.ctype(opt) + "){true, " + v + "})"
    }
    if (g.isBoxOpt(opt)) {
        string a = g.alias(el, g.ownVal(v, el))
        return g.temp(opt, "sd_box_new(" + g.desc(el) + ", &" + a + ")")
    }
    return v
}

// Whether converting T to T? leaves the C value as it is.
fn (Gen g) wrapIsIdentity(int opt) bool {
    return !g.isSmallOpt(opt) && !g.isBoxOpt(opt)
}

// Reads a T? that is known not to be null as a T (borrowed).
fn (Gen g) unwrapVal(int opt, string v) string {
    if (g.isSmallOpt(opt)) {
        return "(" + v + ").v"
    }
    if (g.isBoxOpt(opt)) {
        return "SD_BOX_GET(" + v + ", " + g.ctype(g.elemOf(opt)) + ")"
    }
    return v
}

// A pointer to the T inside a T? place that is known not to be null.
fn (Gen g) unwrapPlace(int opt, string p) string {
    if (g.isSmallOpt(opt)) {
        return "(&(" + p + ")->v)"
    }
    if (g.isBoxOpt(opt)) {
        return "((" + g.ctype(g.elemOf(opt)) + " *)sd_box_mut(" + p + "))"
    }
    return p
}

const string octalDigits = "01234567"

// A C string literal for the given bytes.
fn cString(string s) string {
    []byte b = []byte{'"'}
    for (int i = 0; i < s.len(); i++) {
        byte c = s[i]
        if (c == '"' || c == '\\') {
            b.push('\\')
            b.push(c)
        } else if (c == '?') {
            b.push('\\')
            b.push('?')
        } else if (c >= byte(32) && c < byte(127)) {
            b.push(c)
        } else {
            int v = int(c)
            b.push('\\')
            b.push(octalDigits[v / 64])
            b.push(octalDigits[v / 8 % 8])
            b.push(octalDigits[v % 8])
        }
    }
    b.push('"')
    return string(b)
}

// ---- helpers ----

fn (Gen g) mut genHelper(int t, int kind) {
    string ct = g.ctype(t)
    string m = g.c.types.mangle(t)
    string attr = "static inline __attribute__((unused))"
    if (kind == helperLess) {
        string et = g.ctype(g.c.types.part(t, 0))
        g.protos.push(attr + " bool sd_less_" + m + "(void *ctx, const void *a, const void *b);\n")
        g.helpers.push(attr + " bool sd_less_" + m + "(void *ctx, const void *a, const void *b) {\n  return ((" + ct + ")ctx)(*(" + et + " const *)a, *(" + et + " const *)b);\n}\n")
        return
    }
    []string parts = g.partExprs(t, "v")
    []int partTypes = g.partTypes(t)
    if (kind == helperRetain) {
        g.protos.push(attr + " " + ct + " sd_rt_" + m + "(" + ct + " v);\n")
        []string body = []string{attr + " " + ct + " sd_rt_" + m + "(" + ct + " v) {\n"}
        for (int i = 0; i < parts.len(); i++) {
            if (g.counted(partTypes[i])) {
                body.push("  " + parts[i] + " = " + g.retainExpr(partTypes[i], parts[i]) + ";\n")
            }
        }
        body.push("  return v;\n}\n")
        g.helpers.push(body.join(""))
    } else if (kind == helperRelease) {
        g.protos.push(attr + " void sd_rl_" + m + "(" + ct + " v);\n")
        []string rbody = []string{attr + " void sd_rl_" + m + "(" + ct + " v) {\n"}
        for (int j = 0; j < parts.len(); j++) {
            string r = g.releaseCall(partTypes[j], parts[j])
            if (r != "") {
                rbody.push("  " + r + ";\n")
            }
        }
        rbody.push("}\n")
        g.helpers.push(rbody.join(""))
    } else if (kind == helperEq) {
        g.protos.push(attr + " bool sd_eq_" + m + "(" + ct + " a, " + ct + " b);\n")
        []string a = g.partExprs(t, "a")
        []string b = g.partExprs(t, "b")
        []string conds = []string{"true"}
        for (int k = 0; k < a.len(); k++) {
            conds.push(g.eqExpr(partTypes[k], a[k], b[k]))
        }
        g.helpers.push(attr + " bool sd_eq_" + m + "(" + ct + " a, " + ct + " b) {\n  return " + conds.join(" && ") + ";\n}\n")
    }
}

// The fields of a struct or the parts of a tuple, as C expressions on v.
fn (Gen g) partExprs(int t, string v) []string {
    []string xs = []string{}
    if (g.kindOf(t) == Kind.Tuple) {
        for (int i = 0; i < g.c.types.count(t); i++) {
            xs.push(v + ".r" + i.string())
        }
        return xs
    }
    int d = g.c.types.decl(t)
    for (int j = 0; j < g.c.ast.typeDecls[d].fieldCount; j++) {
        xs.push(v + ".f_" + g.c.fieldName(d, j))
    }
    return xs
}

fn (Gen g) partTypes(int t) []int {
    []int xs = []int{}
    if (g.kindOf(t) == Kind.Tuple) {
        for (int i = 0; i < g.c.types.count(t); i++) {
            xs.push(g.c.types.part(t, i))
        }
        return xs
    }
    int d = g.c.types.decl(t)
    for (int j = 0; j < g.c.ast.typeDecls[d].fieldCount; j++) {
        xs.push(g.c.fieldType(d, j))
    }
    return xs
}

// The comparison adapter for xs.sortBy(f), for the function type
// fn(T, T) bool (helpers are keyed by type, so the request is made on the
// function type).
fn (Gen g) mut lessFn(int fnType) string {
    return g.helper(fnType, helperLess, "sd_less_")
}

// ---- type definitions ----

// One C declaration of the type definitions or prototypes (genTypes,
// genProtos): its text, the identifiers it declares (separated by spaces),
// and, for a definition that only one package's unit contains when the
// program is compiled in units (gen_unit.sd: a descriptor), that package;
// -1 for a declaration that any unit using it contains.
type CDecl struct {
    string text
    string names
    int pkg
}

// The storage class of the program's functions, constants, descriptors and
// vtables: static in one C file, external when the program is compiled in
// units (a unit calls the functions of the packages it imports).
fn (Gen g) linkage() string {
    if (g.split) {
        return ""
    }
    return "static "
}

// r as a sort key: four digits.
fn padRank(int r) string {
    string s = r.string()
    for (; s.len() < 4; ) {
        s = "0" + s
    }
    return s
}

// Appends declarations of one kind to g.decls in the order of their keys,
// so that the text does not depend on the order in which the program met
// its types (a unit's text is then the same in every program).
fn (Gen g) mut addDecls(map[string]CDecl byKey) {
    []string keys = byKey.keys()
    keys.sort()
    for (int i = 0; i < keys.len(); i++) {
        CDecl? d = byKey[keys[i]]
        if (d != null) {
            g.decls.push(d)
        }
    }
}

// The type definitions (g.decls), in dependency order: typedefs of the
// structs, enums and tuples, function pointer types (one used in another's
// signature first), structs (one contained by value first), enums, tuples,
// descriptor declarations, descriptors and the boxes of enum cases without
// data, vtable types.
fn (Gen g) mut genTypes() {
    g.decls = []CDecl{}
    int n = g.c.ast.typeDecls.len()
    int nt = g.c.types.list.len()
    map[string]CDecl fwd = map[string]CDecl{}
    for (int i = 0; i < n; i++) {
        TypeDecl td = g.c.ast.typeDecls[i]
        string tn = ""
        if (td.kind == DeclKind.Enum) {
            tn = "sd_E_" + g.c.declCName(i)
        } else if (td.kind == DeclKind.Struct) {
            tn = "sd_S_" + g.c.declCName(i)
        } else {
            continue
        }
        fwd[tn] = CDecl{text: "typedef struct " + tn + " " + tn + ";\n", names: tn, pkg: -1}
    }
    for (int t = 0; t < nt; t++) {
        if (g.kindOf(t) == Kind.Tuple) {
            string un = g.ctype(t)
            fwd[un] = CDecl{text: "typedef struct " + un + " " + un + ";\n", names: un, pkg: -1}
        }
    }
    g.addDecls(fwd)
    map[string]CDecl fns = map[string]CDecl{}
    for (int f = 0; f < nt; f++) {
        if (g.kindOf(f) == Kind.Func) {
            []string ps = []string{}
            for (int p = 0; p < g.c.types.count(f); p++) {
                ps.push(g.ctype(g.c.types.part(f, p)))
            }
            if (ps.len() == 0) {
                ps.push("void")
            }
            string fname = g.ctype(f)
            fns[padRank(g.funcRank(f)) + " " + fname] = CDecl{text: "typedef " + g.ctype(g.elemOf(f)) + " (*" + fname + ")(" + ps.join(", ") + ");\n", names: fname, pkg: -1}
        }
    }
    g.addDecls(fns)
    map[string]CDecl structs = map[string]CDecl{}
    map[string]CDecl enums = map[string]CDecl{}
    for (int k = 0; k < n; k++) {
        DeclKind dk = g.c.ast.typeDecls[k].kind
        if (dk == DeclKind.Struct) {
            string sn = "sd_S_" + g.c.declCName(k)
            structs[padRank(g.structRank(k)) + " " + sn] = CDecl{text: g.structDefText(k), names: sn, pkg: -1}
        } else if (dk == DeclKind.Enum) {
            string en = "sd_E_" + g.c.declCName(k)
            enums[en] = CDecl{text: g.enumDefText(k), names: en, pkg: -1}
        }
    }
    g.addDecls(structs)
    g.addDecls(enums)
    map[string]CDecl tuples = map[string]CDecl{}
    for (int u = 0; u < nt; u++) {
        if (g.kindOf(u) == Kind.Tuple) {
            []string fields = []string{}
            for (int q = 0; q < g.c.types.count(u); q++) {
                fields.push(" " + g.ctype(g.c.types.part(u, q)) + " r" + q.string() + ";")
            }
            string un2 = g.ctype(u)
            tuples[un2] = CDecl{text: "struct " + un2 + " {" + fields.join("") + " };\n", names: un2, pkg: -1}
        }
    }
    g.addDecls(tuples)
    // Descriptors are compared by address (the dynamic type of a box), so
    // in units each is defined once, by its package's unit, and declared
    // extern by the others.
    string storage = "static const sd_type "
    if (g.split) {
        storage = "extern const sd_type "
    }
    map[string]CDecl descDecls = map[string]CDecl{}
    map[string]CDecl descs = map[string]CDecl{}
    map[string]CDecl boxes = map[string]CDecl{}
    for (int d = 0; d < n; d++) {
        TypeDecl dd = g.c.ast.typeDecls[d]
        if (dd.kind == DeclKind.Interface) {
            continue
        }
        string dn = "sd_D_" + g.c.declCName(d)
        descDecls[dn] = CDecl{text: storage + dn + ";\n", names: dn, pkg: -1}
        int owner = -1
        if (g.split) {
            owner = g.c.declPkg(d)
        }
        descs[dn] = CDecl{text: g.descriptorText(d), names: dn, pkg: owner}
        for (int m = 0; m < dd.caseCount; m++) {
            EnumCase c = g.c.enumCase(d, m)
            if (c.paramCount == 0) {
                string cn = g.c.declCName(d)
                string kn = "sd_k_" + cn + "__" + c.name
                boxes[kn] = CDecl{text: "SD_BOX_STATIC(" + kn + ", &sd_D_" + cn + ", sd_E_" + cn + ", {.tag = " + m.string() + "});\n", names: kn, pkg: -1}
            }
        }
    }
    g.addDecls(descDecls)
    g.addDecls(descs)
    g.addDecls(boxes)
    map[string]CDecl vtypes = map[string]CDecl{}
    for (int v = 0; v < n; v++) {
        if (g.c.ast.typeDecls[v].kind == DeclKind.Interface) {
            string vn = "sd_V_" + g.c.declCName(v)
            vtypes[vn] = CDecl{text: g.vtableTypeText(v), names: vn, pkg: -1}
        }
    }
    g.addDecls(vtypes)
}

// How deep function pointer types nest in the function type f: its typedef
// needs those of the function types in its signature first.
fn (Gen g) funcRank(int f) int {
    int r = g.funcDepth(g.elemOf(f))
    for (int i = 0; i < g.c.types.count(f); i++) {
        r = maxOf(r, g.funcDepth(g.c.types.part(f, i)))
    }
    return r + 1
}

// The rank of t when its C type is a function pointer typedef, else 0.
fn (Gen g) funcDepth(int t) int {
    Kind k = g.kindOf(t)
    if (k == Kind.Func) {
        return g.funcRank(t)
    }
    if (k == Kind.Opt && g.kindOf(g.elemOf(t)) == Kind.Func) {
        return g.funcRank(g.elemOf(t))
    }
    return 0
}

// How deep structs nest by value in struct d: its definition needs those
// of the structs it contains first.
fn (Gen g) structRank(int d) int {
    int r = 0
    TypeDecl td = g.c.ast.typeDecls[d]
    for (int i = 0; i < td.fieldCount; i++) {
        int ft = g.c.fieldType(d, i)
        if (g.kindOf(ft) == Kind.Struct) {
            r = maxOf(r, g.structRank(g.c.types.decl(ft)))
        }
    }
    return r + 1
}

// The C struct of a struct type.
fn (Gen g) structDefText(int d) string {
    TypeDecl td = g.c.ast.typeDecls[d]
    []string s = []string{"struct sd_S_" + g.c.declCName(d) + " {"}
    for (int j = 0; j < td.fieldCount; j++) {
        s.push(" " + g.ctype(g.c.fieldType(d, j)) + " f_" + g.c.fieldName(d, j) + ";")
    }
    if (td.fieldCount == 0) {
        s.push(" char unused_;")
    }
    s.push(" };\n")
    return s.join("")
}

// An enum value is a box holding sd_E_Name: a tag followed by a union of
// the cases' fields.
fn (Gen g) enumDefText(int d) string {
    TypeDecl td = g.c.ast.typeDecls[d]
    []string s = []string{"struct sd_E_" + g.c.declCName(d) + " { int32_t tag;"}
    bool any = false
    for (int i = 0; i < td.caseCount; i++) {
        if (g.c.enumCase(d, i).paramCount > 0) {
            any = true
        }
    }
    if (any) {
        s.push(" union {")
        for (int j = 0; j < td.caseCount; j++) {
            EnumCase ec = g.c.enumCase(d, j)
            if (ec.paramCount == 0) {
                continue
            }
            s.push(" struct {")
            for (int k = 0; k < ec.paramCount; k++) {
                s.push(" " + g.ctype(g.c.caseParamType(d, j, k)) + " f" + k.string() + ";")
            }
            s.push(" } c_" + ec.name + ";")
        }
        s.push(" } u;")
    }
    s.push(" };\n")
    return s.join("")
}

// The runtime descriptor of a struct or enum, with its field tables.
fn (Gen g) mut descriptorText(int d) string {
    TypeDecl td = g.c.ast.typeDecls[d]
    string n = g.c.declCName(d)
    string def = g.linkage() + "const sd_type sd_D_" + n + " = "
    if (td.kind == DeclKind.Struct) {
        []string fields = []string{}
        for (int i = 0; i < td.fieldCount; i++) {
            fields.push("SD_FIELD(sd_S_" + n + ", f_" + g.c.fieldName(d, i) + ", " + g.desc(g.c.fieldType(d, i)) + ")")
        }
        if (td.fieldCount == 0) {
            fields.push("SD_FIELD(sd_S_" + n + ", unused_, &sd_type_byte)")
        }
        string kind = "SD_STRUCT_TYPE_TRIVIAL"
        if (g.counted(g.c.declType[d])) {
            kind = "SD_STRUCT_TYPE"
        }
        return "static const sd_field sd_F_" + n + "[] = {" + fields.join(", ") + "};\n" + def + kind + "(\"" + n + "\", sd_S_" + n + ", sd_F_" + n + ");\n"
    }
    []string out = []string{}
    []string vs = []string{}
    for (int j = 0; j < td.caseCount; j++) {
        EnumCase ec = g.c.enumCase(d, j)
        if (ec.paramCount == 0) {
            vs.push("{\"" + ec.name + "\", NULL, 0}")
            continue
        }
        []string cf = []string{}
        for (int k = 0; k < ec.paramCount; k++) {
            cf.push("SD_FIELD(sd_E_" + n + ", u.c_" + ec.name + ".f" + k.string() + ", " + g.desc(g.c.caseParamType(d, j, k)) + ")")
        }
        out.push("static const sd_field sd_F_" + n + "__" + ec.name + "[] = {" + cf.join(", ") + "};\n")
        vs.push("{\"" + ec.name + "\", sd_F_" + n + "__" + ec.name + ", " + ec.paramCount.string() + "}")
    }
    if (td.caseCount == 0) {
        vs.push("{\"\", NULL, 0}")
    }
    out.push("static const sd_variant sd_V_" + n + "[] = {" + vs.join(", ") + "};\n")
    out.push(def + "SD_ENUM_TYPE(\"" + n + "\", sd_E_" + n + ", sd_V_" + n + ");\n")
    return out.join("")
}

// ---- interfaces ----

// The C name of an interface type in vtable names.
fn (Gen g) ifaceName(int iface) string {
    if (iface == tyError) {
        return "error"
    }
    return g.declName(iface)
}

// The parameter list of a vtable entry: self, then the method's parameters.
fn (Gen g) vtParams(int sig, bool isMut, bool named) string {
    string self = "const void *"
    if (isMut) {
        self = "void *"
    }
    if (named) {
        self = self + "self"
    }
    []string ps = []string{self}
    for (int i = 0; i < g.c.types.count(sig); i++) {
        string p = g.ctype(g.c.types.part(sig, i))
        if (named) {
            p = p + " a" + i.string()
        }
        ps.push(p)
    }
    return ps.join(", ")
}

// struct sd_V_Name { sd_vtable hdr; R (*m_name)(const void *self, ...); }
fn (Gen g) vtableTypeText(int d) string {
    TypeDecl td = g.c.ast.typeDecls[d]
    []string s = []string{"typedef struct { sd_vtable hdr;"}
    for (int i = 0; i < td.methodCount; i++) {
        MethodSig ms = g.c.ifaceMethod(d, i)
        int sig = g.c.ifaceMethodType(d, i)
        s.push(" " + g.ctype(g.elemOf(sig)) + " (*m_" + ms.name + ")(" + g.vtParams(sig, ms.isMut, false) + ");")
    }
    s.push(" } sd_V_" + g.c.declCName(d) + ";\n")
    return s.join("")
}

// One vtable per (type, interface) pair, with a thunk per method that
// calls the type's method on the payload of the interface's box. With a
// unit (a package, >= 0), only the vtables of the package's types.
fn (Gen g) mut genVtables(int unit) {
    for (int i = 0; i < g.c.impls.len(); i++) {
        Impl im = g.c.impls[i]
        if (unit >= 0 && g.c.declPkg(im.decl) != unit) {
            continue
        }
        int t = g.c.declType[im.decl]
        string tname = g.c.declCName(im.decl)
        string vt = "sd_vt_" + tname + "__" + g.ifaceName(im.iface)
        []string entries = []string{"{\"" + tname + "\"}"}
        for (int j = 0; j < g.c.ifaceMethodCount(im.iface); j++) {
            string name = g.c.ifaceMethodName(im.iface, j)
            int sig = g.c.ifaceMethodSig(im.iface, j)
            bool isMut = g.c.ifaceMethodMut(im.iface, j)
            int? m = g.c.methods[methodKey(im.decl, name)]
            string thunk = vt + "__" + name
            if (m == null && g.kindOf(t) == Kind.Enum && name == "name") {
                // The built-in name() (the checker checked the signature).
                string tag = "SD_BOX_GET(*(sd_box * const *)self, sd_E_" + g.declName(t) + ").tag"
                g.thunks.push("static sd_str " + thunk + "(const void *self) { int32_t tag_ = " + tag + "; return " + g.enumNameChain(t, "tag_") + "; }\n")
                entries.push(thunk)
                continue
            }
            if (m == null) {
                continue
            }
            string self = "*(" + g.ctype(t) + " const *)self"
            if (isMut) {
                self = "(" + g.ctype(t) + " *)self"
            }
            []string args = []string{self}
            for (int k = 0; k < g.c.types.count(sig); k++) {
                args.push("a" + k.string())
            }
            string call = g.c.fnCName[m] + "(" + args.join(", ") + ")"
            string ret = g.ctype(g.elemOf(sig))
            if (g.elemOf(sig) != tyVoid) {
                call = "return " + call
            }
            g.thunks.push("static " + ret + " " + thunk + "(" + g.vtParams(sig, isMut, true) + ") { " + call + "; }\n")
            entries.push(thunk)
        }
        g.thunks.push(g.linkage() + "const " + g.vtableTypeOf(im.iface) + " " + vt + " = {" + entries.join(", ") + "};\n")
    }
}

// The C type of the vtables of interface iface.
fn (Gen g) vtableTypeOf(int iface) string {
    if (iface == tyError) {
        return "sd_error_vtable"
    }
    return "sd_V_" + g.declName(iface)
}

// The vtable that converts a value of type t to the interface iface.
fn (Gen g) vtableOf(int t, int iface) string {
    return "sd_vt_" + g.declName(t) + "__" + g.ifaceName(iface)
}

// ---- constants and functions ----

fn isLiteralKind(ExprKind k) bool {
    return k == ExprKind.IntLit || k == ExprKind.FloatLit || k == ExprKind.ByteLit || k == ExprKind.StringLit || k == ExprKind.BoolLit
}

// A constant whose value is a literal is a function that returns it
// (genConsts): calling it cannot crash, so it is a safe call
// (lineMayCrash).
fn (Gen g) mut markLiteralConsts() {
    for (int i = 0; i < g.c.ast.consts.len(); i++) {
        if (isLiteralKind(g.c.ast.exprs[g.c.ast.consts[i].expr].kind)) {
            g.safeCalls[g.constCName(i)] = true
        }
    }
}

// Constants are functions that return a borrowed value. A literal is
// returned directly; anything else is computed on first use (per thread)
// and kept for the rest of the program. With a unit (a package, >= 0),
// only the package's constants.
fn (Gen g) mut genConsts(int unit) {
    for (int i = 0; i < g.c.ast.consts.len(); i++) {
        ConstDecl cd = g.c.ast.consts[i]
        if (unit >= 0 && g.c.ast.files[cd.file].pkgIndex != unit) {
            continue
        }
        int t = g.c.constType[i]
        string ct = g.ctype(t)
        string cn = g.constCName(i)
        string head = g.linkage() + ct + " " + cn + "(void)"
        g.out = []string{}
        g.slots = []Slot{}
        g.ntmp = 0
        g.frameOn = false
        g.varRange = map[int]IntRange{}
        g.pcStart(-1)
        if (isLiteralKind(g.c.ast.exprs[cd.expr].kind)) {
            g.emit(head + " { return " + g.gexpr(cd.expr) + "; }")
            g.consts.push(g.out.join(""))
            continue
        }
        // The value and its state (0 not computed, 1 being computed, 2
        // done) are kept per goroutine, in goroutine-local storage (a
        // goroutine may move between threads: runtime/README.md,
        // "Thread-local storage"). A counted value is released when a
        // goroutine that computed it ends (the main goroutine keeps its
        // values until the program exits).
        string base = cn.slice(5, cn.len())
        string ty = "sd_ct_" + base
        string get = ty + " *sd_cc_ = sd_goroutine_local(&sd_ck_" + base + ", sizeof(" + ty + "));"
        string v = "sd_cc_->v"
        string st = "sd_cc_->s"
        g.emit("typedef struct { " + ct + " v; int s; } " + ty + ";")
        g.emit("static int sd_ck_" + base + ";")
        string rel = g.releaseCall(t, v)
        if (rel != "") {
            g.emit("static void sd_cf_" + base + "(void) { " + get + " " + rel + "; " + st + " = 0; }")
        }
        g.emit(head + " {")
        g.indent++
        g.emit(get)
        g.emit("if (" + st + " == 2) return " + v + ";")
        g.emit("if (" + st + " == 1) sd_crash(\"constant " + cd.name + " depends on itself\");")
        g.emit(st + " = 1;")
        string val = g.gexpr(cd.expr)
        g.emit(v + " = " + g.ownVal(val, t) + ";")
        g.releaseTo(0)
        g.emit(st + " = 2;")
        if (rel != "") {
            g.emit("sd_goroutine_atexit(sd_cf_" + base + ");")
        }
        g.emit("return " + v + ";")
        g.indent--
        g.emit("}")
        g.consts.push(g.out.join(""))
    }
}

fn (Gen g) mut fnSig(int f) string {
    FnDecl fd = g.c.ast.fns[f]
    []string ps = []string{}
    if (fd.isMethod) {
        string star = ""
        if (fd.recvMut) {
            star = " *"
        }
        ps.push(g.ctype(g.c.declType[g.c.fnRecv[f]]) + star + " l_" + fd.recvName)
    }
    for (int i = 0; i < fd.paramCount; i++) {
        Param p = g.c.ast.params[g.c.ast.at(fd.params, i)]
        string pt = g.ctype(g.c.teType[p.typeExpr])
        if (p.name == "_") {
            ps.push(pt + " _p" + i.string())
        } else {
            ps.push(pt + " l_" + p.name)
        }
    }
    if (ps.len() == 0) {
        ps.push("void")
    }
    return g.noTailCalls(f) + g.linkage() + g.ctype(g.c.fnRet[f]) + " " + g.c.fnCName[f] + "(" + ps.join(", ") + ")"
}

// The prototypes of the program's functions (with the fast and general
// versions of those that have both, gen_fast.sd) and constants, and, in
// units, extern declarations of the vtables (g.gprotos, ordered by name).
fn (Gen g) mut genProtos() {
    map[string]CDecl ps = map[string]CDecl{}
    for (int i = 0; i < g.c.ast.consts.len(); i++) {
        string cn = g.constCName(i)
        ps[cn] = CDecl{text: g.linkage() + g.ctype(g.c.constType[i]) + " " + cn + "(void);\n", names: cn, pkg: -1}
    }
    for (int f = 0; f < g.c.ast.fns.len(); f++) {
        FnDecl fd = g.c.ast.fns[f]
        if (fd.body >= 0 && fd.isTest && !g.c.testMode) {
            continue
        }
        string sig = g.fnSig(f)
        string name = g.c.fnCName[f]
        ps[name] = CDecl{text: sig + ";\n", names: name, pkg: -1}
        if (fd.body >= 0 && g.isFast(f)) {
            string gn = g.generalName(f)
            ps[gn] = CDecl{text: sig.replace(" " + name + "(", " " + gn + "(") + ";\n", names: gn, pkg: -1}
            ps[g.fastName(f)] = CDecl{text: g.fastHead(f) + ";\n", names: g.fastName(f), pkg: -1}
        }
    }
    if (g.split) {
        for (int k = 0; k < g.c.impls.len(); k++) {
            Impl im = g.c.impls[k]
            string vt = g.vtableOf(g.c.declType[im.decl], im.iface)
            ps[vt] = CDecl{text: "extern const " + g.vtableTypeOf(im.iface) + " " + vt + ";\n", names: vt, pkg: -1}
        }
    }
    []CDecl saved = g.decls
    g.decls = []CDecl{}
    g.addDecls(ps)
    g.gprotos = g.decls
    g.decls = saved
}

// The C symbol of a native function: sd_lib_<package>_<name>, or
// sd_lib_<package>_<Type>_<name> for a method (runtime/README.md, "Native
// functions").
fn (Gen g) nativeName(int f) string {
    FnDecl fd = g.c.ast.fns[f]
    string prefix = "sd_lib_" + g.c.ast.pkgs[g.c.fnPkg(f)].cprefix
    if (fd.isMethod && g.c.fnRecv[f] >= 0) {
        return prefix + g.c.ast.typeDecls[g.c.fnRecv[f]].name + "_" + fd.name
    }
    return prefix + fd.name
}

// A native function: a prototype of its C implementation, and a function
// with the usual calling convention that calls it. Several results come
// back as the last result (returned) and out-pointers for the others.
fn (Gen g) mut genNative(int f) {
    FnDecl fd = g.c.ast.fns[f]
    int r = g.c.fnRet[f]
    string native = g.nativeName(f)
    []string ps = []string{}
    []string args = []string{}
    if (fd.isMethod) {
        string star = ""
        if (fd.recvMut) {
            star = " *"
        }
        ps.push(g.ctype(g.c.declType[g.c.fnRecv[f]]) + star)
        args.push("l_" + fd.recvName)
    }
    for (int i = 0; i < fd.paramCount; i++) {
        Param p = g.c.ast.params[g.c.ast.at(fd.params, i)]
        ps.push(g.ctype(g.c.teType[p.typeExpr]))
        if (p.name == "_") {
            args.push("_p" + i.string())
        } else {
            args.push("l_" + p.name)
        }
    }
    string sig = g.fnSig(f)
    if (!g.c.types.isTuple(r)) {
        if (ps.len() == 0) {
            ps.push("void")
        }
        g.protos.push("SD_CRASHES " + g.ctype(r) + " " + native + "(" + ps.join(", ") + ");\n")
        string call = native + "(" + args.join(", ") + ")"
        if (r != tyVoid) {
            call = "return " + call
        }
        g.fnText.push(sig + " { " + call + "; }\n\n")
        return
    }
    int n = g.c.types.count(r)
    []string body = []string{sig + " {\n  " + g.ctype(r) + " r_;\n"}
    for (int k = 0; k < n - 1; k++) {
        int pt = g.c.types.part(r, k)
        ps.push(g.ctype(pt) + " *")
        args.push("&r_.r" + k.string())
        body.push("  r_.r" + k.string() + " = " + g.zeroOf(pt) + ";\n")
    }
    g.protos.push("SD_CRASHES " + g.ctype(g.c.types.part(r, n - 1)) + " " + native + "(" + ps.join(", ") + ");\n")
    body.push("  r_.r" + (n - 1).string() + " = " + native + "(" + args.join(", ") + ");\n  return r_;\n}\n\n")
    g.fnText.push(body.join(""))
}

// The text of the statement that leaves the cleanup frame; genFn removes
// it when the function has no frame.
const string leaveFrame = "SD_LF_LEAVE(L);"

// A function's counted locals and temporaries (see frameCounted) that own
// a value across a point where the goroutine may crash or be stopped live
// in the fields of one struct L, its *cleanup frame*, which is linked into
// the thread's chain on entry and unlinked before every return
// (runtime/README.md, section 9). When the goroutine crashes or is
// stopped, the runtime releases what the frames hold. The
// generator keeps every field null or owning: L starts zeroed, a released
// slot's field is set to null (releaseSlot), and so is a moved temporary's
// after the line that consumed it (emit). A return leaves the frame first
// and then releases without nulling.
//
// Which fields are needed is known only at the end: while the body is
// generated, frame slots have placeholder names (frameField), emit counts
// the lines that may crash (crashSeq), and slotEnd records the fields of
// slots that owned a value while such a line was emitted. The others become
// plain C locals (expandFrame), as all slots were before cleanup frames, and
// a function without needed fields has no frame.
fn (Gen g) mut genFn(int f) {
    FnDecl fd = g.c.ast.fns[f]
    g.curFn = f
    g.out = []string{}
    g.slots = []Slot{}
    g.scopes = []int{}
    g.loops = []LoopCtx{}
    g.groups = []string{}
    g.ntmp = 0
    g.frameOn = true
    g.frame = []Slot{}
    g.frameIdx = map[string]int{}
    g.varC = map[int]string{}
    g.moved = []Slot{}
    g.popped = false
    g.crashSeq = 0
    g.fieldNeeded = map[string]bool{}
    g.slotDone = map[int]bool{}
    g.frameSlots = []Slot{}
    g.analyzeInts(fd.body)
    g.analyzeBorrows(fd.body)
    g.analyzeMoves(fd.body)
    g.findOwnedParams(f)
    g.pcStart(fd.body)
    g.defers = g.blockHasDefer(fd.body)
    string sig = g.fnSig(f)
    if (g.isFast(f)) {
        // The general version; genFast makes the fast one and the function
        // that chooses (gen_fast.sd).
        sig = sig.replace(" " + g.c.fnCName[f] + "(", " " + g.generalName(f) + "(")
    }
    g.emit(sig + " {")
    g.siteStart(f)
    g.indent++
    g.emit("SD_SA_FN();")
    if (g.preemptsOnEntry(f)) {
        g.emit("SD_PREEMPT();")
    }
    if (g.defers) {
        g.emit("size_t _dm = sd_defer_mark();")
    }
    g.pushScope()
    g.ownParams(f)
    g.genBody(fd.body)
    g.popScope(!g.c.blockExits(fd.body))
    if (fd.resultCount == 0 && !g.c.blockExits(fd.body)) {
        g.emit(leaveFrame)
        if (g.defers) {
            g.emit("sd_defer_run(_dm);")
        }
    }
    // The checker proved that every path returns (perhaps through an
    // exhaustive switch); tell the C compiler too.
    Block body = g.c.ast.blocks[fd.body]
    bool endsInReturn = body.count > 0 && g.c.ast.stmts[g.c.ast.at(body.list, body.count - 1)].kind == StmtKind.Return
    if (fd.isTest) {
        // A test that reaches its end passed.
        if (!g.c.blockExits(fd.body)) {
            g.emitReturn("SD_ERR_NULL", []string{})
        }
    } else if (fd.resultCount > 0 && !endsInReturn) {
        g.emit("sd_crash(\"internal error: " + fd.name + " reached its end without returning\");")
    }
    g.siteEnd()
    g.indent--
    g.emit("}")
    g.emit("")
    g.frameOn = false
    // A slot that never ended (none should) keeps its field, to be safe.
    for (int s = 0; s < g.frameSlots.len(); s++) {
        Slot frs = g.frameSlots[s]
        if (g.slotDone[frs.id] == null) {
            g.fieldNeeded[frs.name.slice(1, frs.name.len() - 1)] = true
        }
    }
    []string fields = []string{}
    []string rels = []string{}
    for (int j = 0; j < g.frame.len(); j++) {
        Slot fld = g.frame[j]
        if (g.fieldNeeded[fld.name] != null) {
            fields.push(" " + g.ctype(fld.ty) + " " + fld.name + ";")
            rels.push("  " + g.releaseCall(fld.ty, "L->" + fld.name) + ";\n")
        }
    }
    []string text = []string{}
    string dl = ""
    if (g.debug) {
        g.lastLine = ""
        dl = "#line " + fd.pos.line.string() + " " + cString(absPath(g.c.diags.paths[fd.pos.file])) + "\n"
    }
    bool hasFrame = fields.len() > 0
    if (hasFrame) {
        string cn = g.c.fnCName[f]
        text.push("typedef struct { sd_lframe h;" + fields.join("") + " } sd_L_" + cn + ";\n")
        text.push("static void sd_lr_" + cn + "(sd_lframe *p) {\n  sd_L_" + cn + " *L = (sd_L_" + cn + " *)p;\n" + rels.join("") + "}\n")
        string enter = "  sd_L_" + cn + " L = {{0}};\n  SD_LF_ENTER(L, sd_lr_" + cn + ");\n"
        if (g.debug) {
            // On the line of the declaration, as the debugger sees it.
            enter = " sd_L_" + cn + " L = {{0}}; SD_LF_ENTER(L, sd_lr_" + cn + ");\n"
            text.push(dl + g.out[0].slice(0, g.out[0].len() - 1) + enter)
        } else {
            text.push(g.out[0] + enter)
        }
    } else {
        text.push(dl + g.out[0])
    }
    for (int k = 1; k < g.out.len(); k++) {
        string line = g.out[k]
        if (!hasFrame && line.endsWith(leaveFrame + "\n")) {
            continue
        }
        if (line.contains("\x01")) {
            line = g.expandFrame(line)
            if (line.trim() == "") {
                continue
            }
        }
        text.push(line)
    }
    text.push(g.lineReset())
    g.fnText.push(text.join(""))
}

// The parameters of f that its body assigns (as a whole: the checker
// allows nothing else), found among the mutations of the borrow analysis.
fn (Gen g) mut findOwnedParams(int f) {
    g.ownedParams = map[int]bool{}
    FnDecl fd = g.c.ast.fns[f]
    for (int i = 0; i < fd.paramCount; i++) {
        int v = g.c.paramVar[g.c.ast.at(fd.params, i)]
        if (v < 0) {
            continue
        }
        for (int j = 0; j < g.bwEvents.len(); j++) {
            if (g.bwEvents[j].root == v) {
                g.ownedParams[v] = true
                break
            }
        }
    }
}

// Whether v is a parameter that owns a copy of its value.
fn (Gen g) isOwnedParam(int v) bool {
    return g.ownedParams[v] != null
}

// Parameters are borrowed from the caller, so one that the function
// assigns gets a local of its own (o_<name>, perhaps in the frame) that
// owns a copy of the value: an assignment then releases the old value as
// for any local, and the scope around the body releases the last one.
fn (Gen g) mut ownParams(int f) {
    FnDecl fd = g.c.ast.fns[f]
    for (int i = 0; i < fd.paramCount; i++) {
        int pi = g.c.ast.at(fd.params, i)
        int v = g.c.paramVar[pi]
        if (v < 0 || !g.isOwnedParam(v)) {
            continue
        }
        int t = g.c.vars[v].ty
        string n = "o_" + g.c.vars[v].name
        string val = g.retainExpr(t, "l_" + g.c.vars[v].name)
        if (g.inFrame(t)) {
            string fld = g.frameField(n, t)
            g.varC[v] = fld
            g.emit(declText(g.ctype(t), fld) + " = " + val + ";")
        } else {
            g.varC[v] = n
            g.emit(g.ctype(t) + " " + n + " = " + val + ";")
        }
        g.pushLocal(v, t)
    }
}

// A line with the placeholders of frameField (\x01name\x01, \x01Dname\x01
// for a declaration, \x01Nname\x01 for setting it to null) replaced: L.name
// for a needed field, the C local name (declared with its type, never set
// to null) otherwise.
fn (Gen g) expandFrame(string line) string {
    []string segs = line.split("\x01")
    []string out = []string{}
    for (int i = 0; i < segs.len(); i++) {
        string seg = segs[i]
        if (i % 2 == 0) {
            out.push(seg)
            continue
        }
        string kind = ""
        string name = seg
        if (seg.startsWith("D") || seg.startsWith("N")) {
            kind = seg.slice(0, 1)
            name = seg.slice(1, seg.len())
        }
        bool needed = g.fieldNeeded[name] != null
        int? at = g.frameIdx[name]
        int t = tyInvalid
        if (at != null) {
            t = g.frame[at].ty
        }
        if (kind == "N") {
            if (needed) {
                out.push("L." + name + " = " + g.zeroOf(t) + ";")
            }
        } else if (needed) {
            out.push("L." + name)
        } else if (kind == "D") {
            out.push(g.ctype(t) + " " + name)
        } else {
            out.push(name)
        }
    }
    return out.join("")
}

// The C files of the standard library packages in the program
// (lib/<pkg>/*.c: their native functions), without their includes of the
// runtime's headers.
fn readNatives(Ast ast) (string, error) {
    []string byPkg = try readPackageNatives(ast)
    []string parts = []string{}
    for (int p = 0; p < byPkg.len(); p++) {
        if (byPkg[p] != "") {
            parts.push(byPkg[p])
        }
    }
    return parts.join("\n"), null
}

// The natives of each package of the program, by package index ("" for a
// package without any).
fn readPackageNatives(Ast ast) ([]string, error) {
    []string out = []string{}
    for (int p = 0; p < ast.pkgs.len(); p++) {
        Package pk = ast.pkgs[p]
        []string parts = []string{}
        if (pk.isLib) {
            []string names = try fs.list(pk.dir)
            for (int i = 0; i < names.len(); i++) {
                if (!names[i].endsWith(".c")) {
                    continue
                }
                string path = pk.dir + "/" + names[i]
                string text = try fs.read(path)
                parts.push(stripRuntimeIncludes(text, "lib/" + pk.path + "/" + names[i]))
            }
        }
        out.push(parts.join("\n"))
    }
    return out, null
}

// A C file without its #include "seed..." lines (the runtime is pasted
// above it), headed by a comment with its name.
fn stripRuntimeIncludes(string text, string name) string {
    []string lines = text.split("\n")
    []string kept = []string{"/* ---- " + name + " ---- */"}
    for (int j = 0; j < lines.len(); j++) {
        if (!lines[j].startsWith("#include \"seed")) {
            kept.push(lines[j])
        }
    }
    return kept.join("\n")
}

// The runtime files, in the order they are pasted (runtime/README.md,
// section 1).
const []string runtimeFiles = []string{"seed.h", "seed_internal.h", "seed_core.c", "seed_int.c", "seed_str.c", "seed_list.c", "seed_task.c", "seed_pkg.c", "seed_test.c"}

// The runtime pasted at the top of every generated program: seed.h,
// seed_internal.h and the implementation files, without their includes of
// each other (runtime/README.md, section 1).
fn readRuntime(string root) (string, error) {
    return readRuntimeFiles(root, runtimeFiles)
}

// Only the runtime's API (seed.h), for a program that is linked with a
// compiled runtime (see runtimeObject in main.sd).
fn readRuntimeHeader(string root) (string, error) {
    return readRuntimeFiles(root, []string{"seed.h"})
}

fn readRuntimeFiles(string root, []string files) (string, error) {
    []string parts = []string{}
    for (int i = 0; i < files.len(); i++) {
        string path = root + "/runtime/" + files[i]
        if (!fs.exists(path)) {
            return null, errors.new("cannot find the runtime at " + path + "; set SEED_ROOT to the directory that contains runtime/seed.h")
        }
        string text = try fs.read(path)
        []string lines = text.split("\n")
        []string kept = []string{"/* ---- runtime/" + files[i] + " ---- */"}
        for (int j = 0; j < lines.len(); j++) {
            if (!lines[j].startsWith("#include \"seed")) {
                kept.push(lines[j])
            }
        }
        parts.push(kept.join("\n"))
    }
    return parts.join("\n"), null
}
