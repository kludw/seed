== format proj/main.sd
{"jsonrpc":"2.0","id":8,"result":[{"range":{"start":{"line":0,"character":0},"end":{"line":24,"character":0}},"newText":"package main\n\nimport \"fmt\"\nimport \"shop\"\n\n// The greeting, with a non-ASCII prefix: \"héllo 😀\".\nconst string greeting = \"héllo 😀\"\n\nfn describe(shop.Size s) string {\n    switch (s) {\n    case shop.Size.Small:\n        return \"small\"\n    case shop.Size.Large(int extra):\n        return \"large +\" + extra.string()\n    }\n}\n\nfn main([]string args) error {\n    shop.Cart cart = shop.newCart(\"ann\")\n    try cart.add(shop.Item{name: \"tea\", price: 250, size: shop.Size.Small})\n    string label = \"😀 é \" + cart.owner\n    fmt.println(greeting + \" \" + label + \" \" + cart.total().string() + \" \" + describe(shop.Size.Large(2)))\n    return null\n}\n"}]}
