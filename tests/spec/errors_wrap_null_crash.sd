// builtins "errors": errors.wrap crashes if err is null.
package main

import "errors"
import "fmt"

fn main([]string args) error {
    error inner = errors.new("disk full")
    error outer = errors.wrap(inner, "saving")
    if (outer != null) {
        fmt.println(outer.message())
    }
    error none = null
    error wrapped = errors.wrap(none, "saving")
    fmt.println("not reached " + (wrapped == null).string())
    return null
}
