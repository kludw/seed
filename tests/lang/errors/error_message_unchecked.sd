// expect-error: error_message_unchecked.sd:19:17: error: err may be null (an error is null when there is no error)
// An error is null when there is no error, so message() needs a check
// first, like any T?.
package main

import "errors"
import "fmt"

fn maybeFail(bool fail) error {
    if (fail) {
        return errors.new("failed")
    }
    return null
}

fn main([]string args) error {
    error err = maybeFail(false)
    fmt.println("before")
    fmt.println(err.message())
    return null
}
