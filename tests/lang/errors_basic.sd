// Functions that can fail return (..., error); a null error means success.
package main

import "errors"
import "fmt"

fn divide(int a, int b) (int, error) {
    if (b == 0) {
        return null, errors.new("divide by zero")
    }
    return a / b, null
}

fn check(int age) error {
    if (age < 0) {
        return errors.new("negative age: " + age.string())
    }
    return null
}

fn describe(int a, int b) string {
    int q, error err = divide(a, b)
    if (err != null) {
        return "failed: " + err.message()
    }
    return a.string() + " / " + b.string() + " = " + q.string()
}

fn main([]string args) error {
    fmt.println(describe(10, 3))
    fmt.println(describe(1, 0))
    int q, error err = divide(-9, 2)
    if (err == null) {
        fmt.println("q = " + q.string())
    }
    q, err = divide(5, 0)
    if (err != null) {
        fmt.println("again: " + err.message())
    }
    error e1 = check(5)
    fmt.println((e1 == null).string())
    error e2 = check(-3)
    if (e2 != null) {
        fmt.println(e2.message())
    }
    fmt.println(errors.new("boom").message())
    error none = null
    fmt.println((none == null).string())
    none = errors.new("now set")
    fmt.println((none != null).string())
    return null
}
