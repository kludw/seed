// Lists behave like independent copies after assignment, when nested, and
// when stored in other lists or maps.
package main

import "fmt"

fn show([]int xs) string {
    string out = "["
    for (int i = 0; i < xs.len(); i++) {
        if (i > 0) {
            out = out + " "
        }
        out = out + xs[i].string()
    }
    return out + "]"
}

fn main([]string args) error {
    []int a = []int{1, 2, 3}
    []int b = a
    b.push(4)
    fmt.println(show(a) + " " + show(b))
    a[0] = 100
    fmt.println(show(a) + " " + show(b))
    []int c = a
    a.push(5)
    fmt.println(show(a) + " " + show(c))
    [][]int grid = [][]int{[]int{1}, []int{2}}
    []int row = grid[0]
    row.push(9)
    fmt.println(show(grid[0]) + " " + show(row))
    grid[1].push(7)
    fmt.println(show(grid[1]))
    [][]int other = grid
    other[0].push(8)
    fmt.println(show(grid[0]) + " " + show(other[0]))
    []int item = []int{5}
    grid.push(item)
    item.push(6)
    fmt.println(show(grid[2]) + " " + show(item))
    map[string][]int m = map[string][]int{}
    m["k"] = item
    item.push(7)
    []int? stored = m["k"]
    if (stored != null) {
        fmt.println(show(stored) + " " + show(item))
    }
    []int same = item
    same[0] = 50
    fmt.println(show(item) + " " + show(same))
    return null
}
