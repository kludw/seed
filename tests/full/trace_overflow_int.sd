// A stack overflow in a recursion of ints only: such a function runs as a
// fast version without positions (compiler/README.md, "Crash sites"), so
// the trace counts its calls and names the function where it was entered.
// Some C compilers (Apple clang) keep the positions instead, so the
// expected output only asks for the crash and a frame of depth.
package main

import "fmt"

fn depth(int n) int {
    if (n == 0) {
        return 0
    }
    return depth(n - 1) + 1
}

fn main([]string args) error {
    fmt.println(depth(10).string())
    fmt.println(depth(100000000 + args.len()).string())
    return null
}
