// true, false and null as operands that are passed by address: ch.send(true),
// xs.contains(false), a chan error sending null (used to generate &true).
package main

import "errors"
import "fmt"

const bool yes = true

fn main([]string args) error {
    []bool bs = []bool{false, true}
    fmt.println(bs.contains(true).string() + " " + bs.contains(yes).string())
    int? i = bs.index(false)
    if (i != null) {
        fmt.println(i.string())
    }
    chan bool cb = chan bool(2)
    cb.send(true)
    cb.send(false)
    chan error ce = chan error(2)
    ce.send(null)
    ce.send(errors.new("e"))
    error e1 = ce.receive()
    error e2 = ce.receive()
    fmt.println((e1 == null).string() + " " + e2.message())
    []error es = []error{null}
    fmt.println(es.contains(null).string())
    map[bool]int mb = map[bool]int{true: 1}
    mb.delete(true)
    fmt.println(mb.len().string())
    return null
}
