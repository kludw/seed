// Ints grow instead of overflowing: the programs that crashed with seed0's
// 64-bit ints (the retired tests/seed0/only/crash_overflow_*) print the exact results.
package main

import "fmt"

fn main([]string args) error {
    int x = 9223372036854775800
    for (int i = 0; i < 10; i++) {
        x = x + 1
    }
    fmt.println(x.string())
    int m = -9223372036854775807 - 1
    int d = -1
    fmt.println((m % d).string())
    fmt.println((m / d).string())
    int p = 3
    for (int j = 0; j < 100; j++) {
        p = p * 3
    }
    fmt.println(p.string())
    int n = -9223372036854775808
    fmt.println(n.string())
    fmt.println((n + 1).string())
    int y = -n
    fmt.println(y.string())
    int big = 9223372036854775808
    fmt.println((big - 1).string())
    int hex = 0xffffffffffffffffffff
    fmt.println(hex.string())
    fmt.println((-hex).string())
    fmt.println((x > 9223372036854775807).string())
    return null
}
