// expect-error: Shape.Circle carries data, so its pattern must bind every field
package main

import "fmt"

type Shape enum {
    Circle(float r)
    Point
}

fn main([]string args) error {
    Shape s = Shape.Circle(1.0)
    switch (s) {
    case Shape.Circle:
        fmt.println("circle")
    case Shape.Point:
        fmt.println("point")
    }
    return null
}
