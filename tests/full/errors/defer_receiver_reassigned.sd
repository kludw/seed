// expect-error: defer_receiver_reassigned.sd:16:5: error: log is assigned after the defer of log.close() on line 14, but the deferred call uses the value log had when the defer ran
// expect-errors: 1
// A deferred method call keeps the receiver it had when the defer ran, so
// replacing the variable later leaves the new value to nobody: the file
// opened second would never be closed (docs/dogfood.md, item 7).
package main

import "fs"

fn compact(string path) error {
    fs.File log = try fs.openAppend(path)
    // Only the first assignment after the defer is reported.
    log = try fs.openAppend(path)
    defer _ = log.close()
    try log.write("record\n")
    log = try fs.create(path + ".new")
    try log.write("compacted\n")
    log = try fs.create(path + ".new2")
    return null
}

fn main([]string args) error {
    return compact("kv.log")
}
