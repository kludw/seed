// expect-error: builtin_type_name.sd:10:12: error: float is the name of a built-in type
// expect-errors: 1
// A variable named like a built-in type would hide the conversion float(x);
// the call is not reported again.
package main

import "fmt"

fn main([]string args) error {
    string float = "x"
    fmt.println(float + float(2).string())
    return null
}
