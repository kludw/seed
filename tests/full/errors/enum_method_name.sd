// expect-errors: 1
// An enum has a built-in name(), so it cannot declare its own.
package main

import "fmt"

type Light enum {
    Red
    Green
}

fn (Light l) name() string {
    return "light"
}

fn main([]string args) error {
    fmt.println(Light.Red.name())
    return null
}
