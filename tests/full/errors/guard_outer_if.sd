// expect-error: guard_outer_if.sd:21:17: error: s is read before err is checked; when err
// A value assigned beside an error inside an if stays unchecked after it.
package main

import "errors"
import "fmt"

fn fs(bool ok) (string, error) {
    if (!ok) {
        return null, errors.new("bad")
    }
    return "yes", null
}

fn main([]string args) error {
    string s = "init"
    error err = null
    if (args.len() >= 0) {
        s, err = fs(false)
    }
    fmt.println(s)
    return err
}
