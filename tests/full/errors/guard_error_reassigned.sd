// expect-error: guard_error_reassigned.sd:22:17: error: s may be null: it was returned beside err
// Checking an error variable that was assigned again says nothing about the
// value returned beside its old error.
package main

import "errors"
import "fmt"

fn fs(bool ok) (string, error) {
    if (!ok) {
        return null, errors.new("bad")
    }
    return "yes", null
}

fn main([]string args) error {
    string s, error err = fs(false)
    string t, err = fs(true)
    if (err != null) {
        return err
    }
    fmt.println(s + t)
    return null
}
