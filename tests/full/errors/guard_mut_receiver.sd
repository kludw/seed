// expect-error: guard_mut_receiver.sd:24:5: error: b cannot be assigned beside an error:
// A mut method cannot leave its receiver null after an error.
package main

import "errors"
import "fmt"

fn fs(bool ok) (string, error) {
    if (!ok) {
        return null, errors.new("bad")
    }
    return "yes", null
}

type Box struct {
    string s
}

fn (Box b) mut load() string {
    string s, error err = fs(false)
    if (err != null) {
        return err.message()
    }
    b, err = fb(s)
    if (err != null) {
        return err.message()
    }
    return ""
}

fn fb(string s) (Box, error) {
    if (s == "") {
        return null, errors.new("empty")
    }
    return Box{s: s}, null
}

fn main([]string args) error {
    Box b = Box{s: "a"}
    fmt.println(b.load())
    return null
}
