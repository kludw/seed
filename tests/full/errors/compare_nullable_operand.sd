// expect-error: compare_nullable_operand.sd:11:24: error: nullable values (int?) can only be compared with null
// Two nullable values do not compare (a T? compares with a T, or with null).
package main

import "fmt"

fn main([]string args) error {
    map[string]int m = map[string]int{"a": 1}
    int? count = m["a"]
    int? other = m["b"]
    fmt.println((count == other).string())
    return null
}
