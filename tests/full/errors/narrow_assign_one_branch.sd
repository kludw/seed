package main

import "fmt"

fn find(map[string]string m) string? {
    return m["k"]
}

fn main([]string args) error {
    string? kind = find(map[string]string{})
    if (args.len() > 1) {
        kind = "many"
    }
    fmt.println("checked")
    fmt.println(kind)
    return null
}
