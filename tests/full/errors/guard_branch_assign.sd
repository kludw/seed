// expect-error: guard_branch_assign.sd:20:17: error: s is read before err is checked; when
// Assigning the value in one branch does not check it on the other path.
package main

import "errors"
import "fmt"

fn fs(bool ok) (string, error) {
    if (!ok) {
        return null, errors.new("bad")
    }
    return "yes", null
}

fn main([]string args) error {
    string s, error err = fs(false)
    if (args.len() == 5) {
        s = "x"
    }
    fmt.println(s)
    return err
}
