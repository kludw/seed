// Package util is imported as "geo/util" and called util.
package util

pub const float pi = 3.0
pub const string unit = "cm"

pub fn apply(int x) int {
    return x + 1
}

pub fn twiceThen(fn(int) int f, int x) int {
    return f(f(x))
}

pub fn clamp(int x) int {
    return limit(x, 100)
}

fn limit(int x, int hi) int {
    if (x > hi) {
        return hi
    }
    return x
}
