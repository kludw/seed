package shapes

pub type Named interface {
    name() string
}

// A counter: name can be read and written by other packages, count only
// through the methods.
pub type Counter struct implements Named {
    pub string name
    int count
}

pub fn newCounter(string name) Counter {
    return Counter{name: name, count: 0}
}

pub fn (Counter c) mut add(int n) {
    c.count = c.count + n
}

pub fn (Counter c) total() int {
    return c.count
}

fn (Counter c) name() string {
    return c.name + "!"
}
