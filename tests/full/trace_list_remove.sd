// list.remove out of range reports the call's position.
package main

import "fmt"

fn drop([]int xs, int i) []int {
    []int ys = xs
    ys.remove(i)
    return ys
}

fn main([]string args) error {
    []int xs = []int{1, 2, 3}
    fmt.println(drop(xs, 0).len().string())
    fmt.println(drop(xs, args.len() + 6).len().string())
    return null
}
