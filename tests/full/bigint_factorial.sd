// int grows as needed: factorials beyond 64 bits.
package main

import "fmt"

fn factorial(int n) int {
    int result = 1
    for (int i = 2; i <= n; i++) {
        result = result * i
    }
    return result
}

fn main([]string args) error {
    fmt.println(factorial(20).string())
    fmt.println(factorial(25).string())
    fmt.println(factorial(30).string())
    fmt.println((factorial(30) / factorial(28)).string())
    return null
}
