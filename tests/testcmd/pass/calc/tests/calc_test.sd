package calc

test "sum adds every element" {
    assert(sum([]int{}) == 0)
    assert(sum([]int{4, 5}) == 9)
}

test "private names are visible to tests" {
    int h = try half(10)
    assert(h == 5)
    _, error err = half(3)
    assert(err != null)
    assert(err.message() == "calc.half: 3 is odd")
}

test "assert narrows" {
    int? n = helperFind(2)
    assert(n != null)
    assert(n + 1 == 3)
}

// A helper in a test file belongs to the package too.
fn helperFind(int x) int? {
    if (x > 0) {
        return x
    }
    return null
}
