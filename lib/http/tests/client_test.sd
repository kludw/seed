package http

// getWithin and sendWithin: a time limit for the whole exchange.

import "errors"
import "net"
import "time"

fn httpWithinBasics(string base, chan string out) error {
    []string lines = []string{}
    Response? ok, error err = getWithin(base + "/", 5 * time.second)
    lines.push(httpTestShow(ok, err))
    Response? echoed, error err2 = sendWithin(Request{method: "POST", url: base + "/echo", headers: map[string]string{}, body: "data"}, 5 * time.second)
    lines.push(httpTestShow(echoed, err2))
    int start = time.monotonic()
    Response? slow, error err3 = getWithin(base + "/slow", 200 * time.millisecond)
    int took = time.monotonic() - start
    lines.push(httpTestShow(slow, err3).replace(base, "BASE"))
    if (took > 5 * time.second) {
        lines.push("took " + (took / time.millisecond).string() + " ms")
    }
    out.send(lines.join("\n"))
    return null
}

test "getWithin and sendWithin answer, or time out against a slow handler" {
    string got = try httpTestRun(httpWithinBasics)
    assert(got == "200 hello\n200 data\nerror: http.getWithin: BASE/slow: timeout after 200 ms")
}

// A server that answers one byte every 50 ms: every read makes progress,
// so only a limit on the whole exchange stops the client.
fn httpWithinTrickle(net.Listener ln) error {
    net.Conn c = try ln.accept()
    defer c.close()
    _ = try c.read(65536)
    string head = "HTTP/1.1 200 OK\r\ncontent-length: 1000\r\n\r\n"
    for (int i = 0; i < 200; i++) {
        time.sleep(50 * time.millisecond)
        error werr = c.write(head.slice(i % head.len(), i % head.len() + 1))
        if (werr != null) {
            return null
        }
    }
    return null
}

fn httpWithinTrickleClient(string addr, chan string out) error {
    int start = time.monotonic()
    Response? resp, error err = getWithin("http://" + addr + "/", 300 * time.millisecond)
    int took = time.monotonic() - start
    string shown = httpTestShow(resp, err).replace(addr, "ADDR")
    if (took > 3 * time.second) {
        shown = shown + " (took " + (took / time.millisecond).string() + " ms)"
    }
    out.send(shown)
    return errors.new("done")
}

test "the limit is on the whole exchange, not on each read" {
    net.Listener ln = try net.listen("127.0.0.1:0")
    defer ln.close()
    chan string out = chan string(1)
    error err = group {
        spawn httpWithinTrickle(ln)
        spawn httpWithinTrickleClient(ln.addr(), out)
    }
    assert(err != null && err.message() == "done")
    string? got = out.receive()
    assert(got != null && got == "error: http.getWithin: http://ADDR/: timeout after 300 ms")
}

test "getWithin reports the same errors as get" {
    net.Listener ln = try net.listen("127.0.0.1:0")
    string addr = ln.addr()
    ln.close()
    Response? resp, error err = getWithin("http://" + addr + "/", time.second)
    assert(httpTestShow(resp, err) == "error: http.getWithin: http://" + addr + "/: connection refused")
    Response? resp2, error err2 = sendWithin(Request{method: "GET", url: "https://example.com/", headers: map[string]string{}, body: ""}, time.second)
    assert(httpTestShow(resp2, err2) == "error: http.sendWithin: https://example.com/: https is not supported")
}

fn httpWithinZero() error {
    _ = try sendWithin(Request{method: "GET", url: "http://127.0.0.1:1/", headers: map[string]string{}, body: ""}, 0)
    return null
}

test "a timeout that is not positive crashes" {
    error err = group {
        spawn httpWithinZero()
    }
    assert(err != null && err.message() == "crash: http.sendWithin: timeout (0) must be positive")
}

test "durations in timeout messages" {
    assert(httpDuration(250 * time.millisecond) == "250 ms")
    assert(httpDuration(2 * time.second) == "2 s")
    assert(httpDuration(1500 * time.millisecond) == "1.5 s")
    assert(httpDuration(500) == "500 ns")
}
