package encoding

fn allBytes() string {
    []byte b = []byte{}
    for (int i = 0; i < 256; i++) {
        b.push(byte(i))
    }
    return string(b)
}

test "hex encode" {
    assert(hexEncode("") == "")
    assert(hexEncode("foobar") == "666f6f626172")
    assert(hexEncode("\x00\x01\x7f\x80\xfe\xff") == "00017f80feff")
    assert(hexEncode(allBytes()).len() == 512)
}

test "hex decode" {
    string s, error err = hexDecode("666f6f626172")
    assert(err == null)
    if (err == null) {
        assert(s == "foobar")
    }
    s, err = hexDecode("DEADbeef")
    assert(err == null)
    if (err == null) {
        assert(s == "\xde\xad\xbe\xef")
    }
    s, err = hexDecode("")
    assert(err == null)
    if (err == null) {
        assert(s == "")
    }
    s, err = hexDecode(hexEncode(allBytes()))
    assert(err == null)
    if (err == null) {
        assert(s == allBytes())
    }
}

test "hex decode errors" {
    _, error err = hexDecode("abcg")
    assert(err != null)
    assert(err.message() == "encoding.hexDecode: offset 3: invalid hex digit 'g'")
    _, err = hexDecode("abc")
    assert(err != null)
    assert(err.message() == "encoding.hexDecode: offset 2: odd number of hex digits")
    _, err = hexDecode("a b")
    assert(err != null)
    assert(err.message() == "encoding.hexDecode: offset 1: invalid hex digit ' '")
    _, err = hexDecode("0\xff")
    assert(err != null)
    assert(err.message() == "encoding.hexDecode: offset 1: invalid hex digit byte 0xff")
    _, err = hexDecode("0x00")
    assert(err != null)
    assert(err.message() == "encoding.hexDecode: offset 1: invalid hex digit 'x'")
}

test "base64 rfc 4648 vectors" {
    []string plain = []string{"", "f", "fo", "foo", "foob", "fooba", "foobar"}
    []string std = []string{"", "Zg==", "Zm8=", "Zm9v", "Zm9vYg==", "Zm9vYmE=", "Zm9vYmFy"}
    []string url = []string{"", "Zg", "Zm8", "Zm9v", "Zm9vYg", "Zm9vYmE", "Zm9vYmFy"}
    for (int i = 0; i < plain.len(); i++) {
        assert(base64Encode(plain[i]) == std[i])
        assert(base64UrlEncode(plain[i]) == url[i])
        string s, error err = base64Decode(std[i])
        assert(err == null)
        if (err == null) {
            assert(s == plain[i])
        }
        s, err = base64Decode(url[i])
        assert(err == null)
        if (err == null) {
            assert(s == plain[i])
        }
        s, err = base64UrlDecode(url[i])
        assert(err == null)
        if (err == null) {
            assert(s == plain[i])
        }
        s, err = base64UrlDecode(std[i])
        assert(err == null)
        if (err == null) {
            assert(s == plain[i])
        }
    }
}

test "base64 alphabets" {
    assert(base64Encode("\xfb\xff") == "+/8=")
    assert(base64UrlEncode("\xfb\xff") == "-_8")
    assert(base64Encode("\xfb\xef\xbe") == "++++")
    assert(base64UrlEncode("\xff\xff\xff") == "____")
    _, error err = base64Decode("-_8")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 0: invalid base64 character '-'")
    _, err = base64UrlDecode("+/8=")
    assert(err != null)
    assert(err.message() == "encoding.base64UrlDecode: offset 0: invalid base64 character '+'")
    string s2, error err2 = base64Decode("+/8=")
    assert(err2 == null && s2 == "\xfb\xff")
}

test "base64 round trip" {
    string data = allBytes()
    for (int n = 0; n < 8; n++) {
        string part = data.slice(250 - n * 30, 256)
        string s, error err = base64Decode(base64Encode(part))
        assert(err == null && s == part)
        s, err = base64UrlDecode(base64UrlEncode(part))
        assert(err == null && s == part)
    }
}

test "base64 ignores unused bits" {
    string s, error err = base64Decode("Zh==")
    assert(err == null && s == "f")
    s, err = base64UrlDecode("Zm9")
    assert(err == null && s == "fo")
}

test "base64 decode errors" {
    _, error err = base64Decode("Zm9v YmFy")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 4: invalid base64 character ' '")
    _, err = base64Decode("Zm9v\n")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 4: invalid base64 character byte 0x0a")
    _, err = base64Decode("Z")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 1: input ends in the middle of a byte")
    _, err = base64Decode("Zm9vY")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 5: input ends in the middle of a byte")
    _, err = base64Decode("Zg=")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 2: incorrect padding")
    _, err = base64Decode("Zg===")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 2: incorrect padding")
    _, err = base64Decode("Zm9v=")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 4: incorrect padding")
    _, err = base64Decode("Zm8==")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 3: incorrect padding")
    _, err = base64Decode("Zg==Zg==")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 2: invalid base64 character '='")
    _, err = base64Decode("====")
    assert(err != null)
    assert(err.message() == "encoding.base64Decode: offset 0: incorrect padding")
}

test "url encode" {
    assert(urlEncode("") == "")
    assert(urlEncode("AZaz09-_.~") == "AZaz09-_.~")
    assert(urlEncode("a b") == "a%20b")
    assert(urlEncode("a+b&c=d/e?f#g%") == "a%2Bb%26c%3Dd%2Fe%3Ff%23g%25")
    assert(urlEncode("\xc3\xa9\x00\xff") == "%C3%A9%00%FF")
}

test "url decode" {
    string s, error err = urlDecode("a%20b+c")
    assert(err == null && s == "a b c")
    s, err = urlDecode("%c3%A9")
    assert(err == null && s == "\xc3\xa9")
    s, err = urlDecode("plain")
    assert(err == null && s == "plain")
    s, err = urlDecode("")
    assert(err == null && s == "")
    s, err = urlDecode(urlEncode(allBytes()))
    assert(err == null && s == allBytes())
    s, err = urlDecode("100%25")
    assert(err == null && s == "100%")
}

test "url decode errors" {
    _, error err = urlDecode("100%")
    assert(err != null)
    assert(err.message() == "encoding.urlDecode: offset 3: '%' must be followed by two hex digits")
    _, err = urlDecode("a%2")
    assert(err != null)
    assert(err.message() == "encoding.urlDecode: offset 1: '%' must be followed by two hex digits")
    _, err = urlDecode("a%zz")
    assert(err != null)
    assert(err.message() == "encoding.urlDecode: offset 1: '%' must be followed by two hex digits")
    _, err = urlDecode("%%41")
    assert(err != null)
    assert(err.message() == "encoding.urlDecode: offset 0: '%' must be followed by two hex digits")
}
