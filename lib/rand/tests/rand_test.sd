package rand

import "fmt"

test "splitmix64 vectors" {
    // The reference outputs of splitmix64.c for seeds 0 and 1234567.
    Source s = seeded(0)
    assert(s.next() == 0xe220a8397b1dcdaf)
    assert(s.next() == 0x6e789e6aa1b965f4)
    assert(s.next() == 0x06c45d188009454f)
    assert(s.next() == 0xf88bb8a8724c81ec)
    s = seeded(1234567)
    assert(s.next() == 6457827717110365317)
    assert(s.next() == 3203168211198807973)
    assert(s.next() == 9817491932198370423)
}

test "seed is reduced modulo 2 to the 64" {
    Source a = seeded(-1)
    Source b = seeded(0xffffffffffffffff)
    Source c = seeded(0x1ffffffffffffffff)
    int x = a.next()
    assert(x == 16490336266968443936)
    assert(b.next() == x)
    assert(c.next() == x)
    assert(a.next() == 16834447057089888969)
}

test "copy replays" {
    Source a = seeded(5)
    int first = a.range(0, 1000)
    Source b = a
    int x = a.range(0, 1000000)
    assert(b.range(0, 1000000) == x)
    assert(first >= 0 && first < 1000)
}

test "range sequence" {
    Source s = seeded(42)
    []int got = []int{}
    for (int i = 0; i < 10; i++) {
        got.push(s.range(1, 7))
    }
    assert(got == []int{2, 2, 1, 1, 5, 1, 2, 3, 2, 3})
    s = seeded(7)
    got = []int{}
    for (int i = 0; i < 12; i++) {
        got.push(s.range(0, 3))
    }
    assert(got == []int{0, 0, 0, 0, 1, 0, 1, 0, 2, 2, 1, 1})
}

test "range large" {
    Source s = seeded(7)
    assert(s.range(-1000000000000000000000000000000, 1000000000000000000000000000000) == 478775793826387334282922976796)
    assert(s.range(-1000000000000000000000000000000, 1000000000000000000000000000000) == -573774229815964489348219524661)
    assert(s.range(-1000000000000000000000000000000, 1000000000000000000000000000000) == -71302795403188447530478294511)
    s = seeded(99)
    assert(s.range(0, 0x10000000000000000) == 4824385676517010403)
    assert(s.range(0, 0x10000000000000001) == 14814616385017375063)
}

test "range bounds" {
    Source s = seeded(2026)
    bool inside = true
    []int counts = []int{0, 0, 0, 0, 0}
    for (int i = 0; i < 5000; i++) {
        int x = s.range(-2, 3)
        if (x < -2 || x >= 3) {
            inside = false
        } else {
            counts[x + 2] = counts[x + 2] + 1
        }
    }
    assert(inside)
    for (int i = 0; i < 5; i++) {
        assert(counts[i] > 850 && counts[i] < 1150)
    }
    assert(s.range(5, 6) == 5)
}

test "fraction" {
    Source s = seeded(42)
    assert(s.fraction().string() == "0.7415648787718233")
    assert(s.fraction().string() == "0.1599103928769201")
    assert(s.fraction().string() == "0.27860113025513866")
    bool inside = true
    float sum = 0.0
    for (int i = 0; i < 2000; i++) {
        float f = s.fraction()
        if (f < 0.0 || f >= 1.0) {
            inside = false
        }
        sum = sum + f
    }
    assert(inside)
    assert(sum > 950.0 && sum < 1050.0)
}

test "permutation" {
    Source s = seeded(42)
    assert(s.permutation(10) == []int{0, 9, 5, 8, 6, 4, 7, 2, 1, 3})
    assert(s.permutation(0) == []int{})
    assert(s.permutation(1) == []int{0})
    []int p = s.permutation(100)
    p.sort()
    []int want = []int{}
    for (int i = 0; i < 100; i++) {
        want.push(i)
    }
    assert(p == want)
}

fn crashRangeEmpty() {
    Source s = seeded(1)
    fmt.println(s.range(5, 5).string())
}

fn crashPermutationNegative() {
    Source s = seeded(1)
    fmt.println(s.permutation(-1).len().string())
}

test "range empty crashes" {
    error err = group {
        spawn crashRangeEmpty()
    }
    assert(err != null)
    assert(err.message() == "crash: rand.Source.range: lo (5) must be less than hi (5)")
}

test "permutation negative crashes" {
    error err = group {
        spawn crashPermutationNegative()
    }
    assert(err != null)
    assert(err.message() == "crash: rand.Source.permutation: n (-1) must not be negative")
}

test "os generator range" {
    for (int i = 0; i < 1000; i++) {
        int x = range(-3, 4)
        assert(x >= -3 && x < 4)
    }
    assert(range(7, 8) == 7)
    // Every value of a small range turns up.
    []int counts = []int{0, 0, 0, 0}
    for (int i = 0; i < 400; i++) {
        counts[range(0, 4)]++
    }
    for (int i = 0; i < 4; i++) {
        assert(counts[i] > 40)
    }
    // Ranges wider than 64 bits.
    int big = 1 << 100
    for (int i = 0; i < 20; i++) {
        int x = range(-big, big)
        assert(x >= -big && x < big)
    }
}

test "os generator outputs 64 bits" {
    bool high = false
    for (int i = 0; i < 64; i++) {
        int x = nextOs()
        assert(x >= 0 && x <= 0xffffffffffffffff)
        if (x >= 1 << 63) {
            high = true
        }
    }
    assert(high)
}

test "os generator fraction" {
    float sum = 0.0
    for (int i = 0; i < 1000; i++) {
        float f = fraction()
        assert(f >= 0.0 && f < 1.0)
        sum = sum + f
    }
    assert(sum > 400.0 && sum < 600.0)
}

test "os generator permutation" {
    assert(permutation(0) == []int{})
    assert(permutation(1) == []int{0})
    []int p = permutation(50)
    []int sorted = p
    sorted.sort()
    []int want = []int{}
    for (int i = 0; i < 50; i++) {
        want.push(i)
    }
    assert(sorted == want)
    assert(p != want || permutation(50) != want)
}

fn randTestDraw(chan int out) {
    out.send(nextOs())
}

test "each goroutine has its own generator" {
    chan int out = chan int(2)
    error err = group {
        spawn randTestDraw(out)
        spawn randTestDraw(out)
    }
    assert(err == null)
    int? a = out.receive()
    int? b = out.receive()
    assert(a != null && b != null)
    assert(a != b)
}

fn crashOsRangeEmpty() {
    fmt.println(range(5, 5).string())
}

fn crashOsPermutationNegative() {
    fmt.println(permutation(-2).len().string())
}

test "package functions crash with their own names" {
    error err = group {
        spawn crashOsRangeEmpty()
    }
    assert(err != null)
    assert(err.message() == "crash: rand.range: lo (5) must be less than hi (5)")
    error err2 = group {
        spawn crashOsPermutationNegative()
    }
    assert(err2 != null)
    assert(err2.message() == "crash: rand.permutation: n (-2) must not be negative")
}
