package math

import "fmt"

test "constants" {
    assert(pi.string() == "3.141592653589793")
    assert(e.string() == "2.718281828459045")
}

test "abs min max int" {
    assert(absInt(-5) == 5)
    assert(absInt(5) == 5)
    assert(absInt(0) == 0)
    assert(absInt(-9223372036854775808) == 9223372036854775808)
    assert(absInt(-100000000000000000000000) == 100000000000000000000000)
    assert(minInt(3, -2) == -2)
    assert(minInt(-2, 3) == -2)
    assert(minInt(4, 4) == 4)
    assert(maxInt(3, -2) == 3)
    assert(maxInt(-2, 3) == 3)
    assert(maxInt(10000000000000000000000, 1) == 10000000000000000000000)
}

test "pow int" {
    assert(powInt(0, 0) == 1)
    assert(powInt(5, 0) == 1)
    assert(powInt(0, 5) == 0)
    assert(powInt(2, 10) == 1024)
    assert(powInt(-2, 3) == -8)
    assert(powInt(-2, 4) == 16)
    assert(powInt(10, 18) == 1000000000000000000)
    assert(powInt(2, 100).string() == "1267650600228229401496703205376")
    assert(powInt(3, 41).string() == "36472996377170786403")
    assert(powInt(1, 1000000) == 1)
}

test "abs float" {
    assert(absFloat(-2.5) == 2.5)
    assert(absFloat(2.5) == 2.5)
    assert(absFloat(-0.0).string() == "0.0")
    assert(isNan(absFloat(nanValue())))
    assert(absFloat(-inf()) == inf())
}

test "min max float" {
    assert(minFloat(1.5, -2.0) == -2.0)
    assert(maxFloat(1.5, -2.0) == 1.5)
    assert(isNan(minFloat(nanValue(), 1.0)))
    assert(isNan(minFloat(1.0, nanValue())))
    assert(isNan(maxFloat(nanValue(), 1.0)))
    assert(isNan(maxFloat(1.0, nanValue())))
    assert(minFloat(0.0, -0.0).string() == "-0.0")
    assert(minFloat(-0.0, 0.0).string() == "-0.0")
    assert(maxFloat(0.0, -0.0).string() == "0.0")
    assert(maxFloat(-0.0, 0.0).string() == "0.0")
    assert(minFloat(-inf(), 0.0) == -inf())
    assert(maxFloat(inf(), 0.0) == inf())
}

test "nan inf" {
    assert(isNan(nanValue()))
    assert(!isNan(1.0) && !isNan(inf()))
    assert(isInf(inf()) && isInf(-inf()))
    assert(!isInf(1.0e308) && !isInf(nanValue()))
    assert(inf().string() == "inf")
    assert((-inf()).string() == "-inf")
    assert(inf() > 1.0e308)
}

fn crashPowIntNegative() {
    fmt.println(powInt(2, -1).string())
}

test "pow int negative crashes" {
    error err = group {
        spawn crashPowIntNegative()
    }
    assert(err != null)
    assert(err.message() == "crash: math.powInt: exp (-1) must not be negative")
}
