package math

import "fmt"

test "constants" {
    assert(pi.string() == "3.141592653589793")
    assert(e.string() == "2.718281828459045")
}

test "abs min max int" {
    assert(absInt(-5) == 5)
    assert(absInt(5) == 5)
    assert(absInt(0) == 0)
    assert(absInt(-9223372036854775808) == 9223372036854775808)
    assert(absInt(-100000000000000000000000) == 100000000000000000000000)
    assert(minInt(3, -2) == -2)
    assert(minInt(-2, 3) == -2)
    assert(minInt(4, 4) == 4)
    assert(maxInt(3, -2) == 3)
    assert(maxInt(-2, 3) == 3)
    assert(maxInt(10000000000000000000000, 1) == 10000000000000000000000)
}

test "pow int" {
    assert(powInt(0, 0) == 1)
    assert(powInt(5, 0) == 1)
    assert(powInt(0, 5) == 0)
    assert(powInt(2, 10) == 1024)
    assert(powInt(-2, 3) == -8)
    assert(powInt(-2, 4) == 16)
    assert(powInt(10, 18) == 1000000000000000000)
    assert(powInt(2, 100).string() == "1267650600228229401496703205376")
    assert(powInt(3, 41).string() == "36472996377170786403")
    assert(powInt(1, 1000000) == 1)
}

test "abs float" {
    assert(absFloat(-2.5) == 2.5)
    assert(absFloat(2.5) == 2.5)
    assert(absFloat(-0.0).string() == "0.0")
    assert(isNan(absFloat(nanValue())))
    assert(absFloat(-inf()) == inf())
}

test "min max float" {
    assert(minFloat(1.5, -2.0) == -2.0)
    assert(maxFloat(1.5, -2.0) == 1.5)
    assert(isNan(minFloat(nanValue(), 1.0)))
    assert(isNan(minFloat(1.0, nanValue())))
    assert(isNan(maxFloat(nanValue(), 1.0)))
    assert(isNan(maxFloat(1.0, nanValue())))
    assert(minFloat(0.0, -0.0).string() == "-0.0")
    assert(minFloat(-0.0, 0.0).string() == "-0.0")
    assert(maxFloat(0.0, -0.0).string() == "0.0")
    assert(maxFloat(-0.0, 0.0).string() == "0.0")
    assert(minFloat(-inf(), 0.0) == -inf())
    assert(maxFloat(inf(), 0.0) == inf())
}

test "nan inf" {
    assert(isNan(nanValue()))
    assert(!isNan(1.0) && !isNan(inf()))
    assert(isInf(inf()) && isInf(-inf()))
    assert(!isInf(1.0e308) && !isInf(nanValue()))
    assert(inf().string() == "inf")
    assert((-inf()).string() == "-inf")
    assert(inf() > 1.0e308)
}

fn crashPowIntNegative() {
    fmt.println(powInt(2, -1).string())
}

test "pow int negative crashes" {
    error err = group {
        spawn crashPowIntNegative()
    }
    assert(err != null)
    assert(err.message() == "crash: math.powInt: exponent (-1) must not be negative")
}

test "pow float and sqrt" {
    assert(powFloat(2.0, 10.0) == 1024.0)
    assert(powFloat(2.0, -1.0) == 0.5)
    assert(powFloat(0.0, 0.0) == 1.0)
    assert(powFloat(nanValue(), 0.0) == 1.0)
    assert(isNan(powFloat(-8.0, 1.0 / 3.0)))
    assert(powFloat(0.0, -1.0) == inf())
    assert(sqrt(16.0) == 4.0)
    assert(sqrt(2.0).string() == "1.4142135623730951")
    assert(isNan(sqrt(-1.0)))
    assert(sqrt(-0.0).string() == "-0.0")
    assert(sqrt(inf()) == inf())
}

test "rounding" {
    assert(floor(2.7) == 2.0)
    assert(floor(-2.2) == -3.0)
    assert(ceil(2.2) == 3.0)
    assert(ceil(-2.7) == -2.0)
    assert(ceil(-0.5).string() == "-0.0")
    assert(round(2.5) == 3.0)
    assert(round(-2.5) == -3.0)
    assert(round(2.4999) == 2.0)
    assert(round(0.5) == 1.0)
    assert(round(-0.4).string() == "-0.0")
    assert(trunc(2.7) == 2.0)
    assert(trunc(-2.7) == -2.0)
    assert(floor(1.0e300) == 1.0e300)
    assert(floor(inf()) == inf())
    assert(round(-inf()) == -inf())
    assert(isNan(trunc(nanValue())))
    assert(int(round(1.0e20)) == 100000000000000000000)
}

test "trigonometry" {
    assert(sin(0.0) == 0.0)
    assert(absFloat(sin(pi / 2.0) - 1.0) < 1.0e-15)
    assert(cos(0.0) == 1.0)
    assert(absFloat(cos(pi) + 1.0) < 1.0e-15)
    assert(absFloat(tan(pi / 4.0) - 1.0) < 1.0e-15)
    assert(absFloat(asin(1.0) - pi / 2.0) < 1.0e-15)
    assert(absFloat(acos(-1.0) - pi) < 1.0e-15)
    assert(absFloat(atan(1.0) - pi / 4.0) < 1.0e-15)
    assert(isNan(asin(2.0)))
    assert(isNan(acos(-1.5)))
    assert(isNan(sin(inf())))
    assert(atan(inf()) == pi / 2.0)
}

test "atan2 quadrants" {
    assert(atan2(0.0, 1.0) == 0.0)
    assert(atan2(1.0, 0.0) == pi / 2.0)
    assert(atan2(0.0, -1.0) == pi)
    assert(atan2(-0.0, -1.0) == -pi)
    assert(atan2(-1.0, 0.0) == -pi / 2.0)
    assert(absFloat(atan2(1.0, 1.0) - pi / 4.0) < 1.0e-15)
    assert(absFloat(atan2(-1.0, -1.0) + 3.0 * pi / 4.0) < 1.0e-15)
}

test "exp and logarithms" {
    assert(exp(0.0) == 1.0)
    assert(exp(1.0) == e)
    assert(exp(-inf()) == 0.0)
    assert(exp(1000.0) == inf())
    assert(log(1.0) == 0.0)
    assert(log(e) == 1.0)
    assert(log(0.0) == -inf())
    assert(isNan(log(-1.0)))
    assert(log2(1024.0) == 10.0)
    assert(log2(0.5) == -1.0)
    assert(log10(1000.0) == 3.0)
    assert(log10(0.001) == -3.0)
    assert(log10(0.0) == -inf())
    assert(isNan(log10(-1.0)))
}
