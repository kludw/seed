// Package math has the numeric functions and constants: integer helpers
// with Int and Float variants, square roots and powers, rounding,
// trigonometry, exponentials and logarithms. The float functions follow
// IEEE 754: they return nan or an infinity instead of crashing.
package math

// Numeric functions and constants (docs/stdlib.md, "math"). The float
// functions that need the C library (powFloat, sqrt, the rounding
// functions, trigonometry, exp and the logarithms) are native, in math.c,
// and follow IEEE 754 and C99: they return nan or an infinity instead of
// crashing (sqrt(-1.0) is nan, log(0.0) is -inf).

import "os"

// The constants π and e, as the nearest floats.
pub const float pi = 3.141592653589793
pub const float e = 2.718281828459045

// The absolute value.
pub fn absInt(int x) int {
    if (x < 0) {
        return -x
    }
    return x
}

// The smaller of the two.
pub fn minInt(int a, int b) int {
    if (b < a) {
        return b
    }
    return a
}

// The larger of the two.
pub fn maxInt(int a, int b) int {
    if (b > a) {
        return b
    }
    return a
}

// `base` to the power `exponent`, exactly (integers grow). powInt(0, 0) is 1.
// Crashes if `exponent` is negative.
pub fn powInt(int base, int exponent) int {
    if (exponent < 0) {
        os.crash("math.powInt: exponent (" + exponent.string() + ") must not be negative")
    }
    int result = 1
    int b = base
    int n = exponent
    for (; n > 0; ) {
        if ((n & 1) == 1) {
            result = result * b
        }
        n = n >> 1
        if (n > 0) {
            b = b * b
        }
    }
    return result
}

// The absolute value. absFloat(-0.0) is 0.0 and absFloat of nan is nan.
pub fn absFloat(float x) float {
    if (x < 0.0 || isNegZero(x)) {
        return -x
    }
    return x
}

// The smaller of the two; nan if either is nan. -0.0 is smaller than 0.0.
pub fn minFloat(float a, float b) float {
    if (isNan(a) || isNan(b)) {
        return nanValue()
    }
    if (a == 0.0 && b == 0.0) {
        if (isNegZero(a)) {
            return a
        }
        return b
    }
    if (b < a) {
        return b
    }
    return a
}

// The larger of the two; nan if either is nan. 0.0 is larger than -0.0.
pub fn maxFloat(float a, float b) float {
    if (isNan(a) || isNan(b)) {
        return nanValue()
    }
    if (a == 0.0 && b == 0.0) {
        if (isNegZero(a)) {
            return b
        }
        return a
    }
    if (b > a) {
        return b
    }
    return a
}

// Whether `x` is nan.
pub fn isNan(float x) bool {
    return x != x
}

// Whether `x` is inf or -inf.
pub fn isInf(float x) bool {
    return x == inf() || x == -inf()
}

// Positive infinity. (docs/stdlib.md lists this as native; IEEE division
// gives it in pure Seed.)
pub fn inf() float {
    float zero = 0.0
    return 1.0 / zero
}

fn isNegZero(float x) bool {
    return x == 0.0 && 1.0 / x < 0.0
}

fn nanValue() float {
    float zero = 0.0
    return zero / zero
}

// C pow: base to the power exponent.
pub fn powFloat(float base, float exponent) float

// Square root.
pub fn sqrt(float x) float

// Rounds down.
pub fn floor(float x) float

// Rounds up.
pub fn ceil(float x) float

// Rounds to the nearest whole number, halves away from zero: 2.5 gives 3.0,
// -2.5 gives -3.0.
pub fn round(float x) float

// Rounds toward zero.
pub fn trunc(float x) float

// Sine, in radians.
pub fn sin(float x) float

// Cosine, in radians.
pub fn cos(float x) float

// Tangent, in radians.
pub fn tan(float x) float

// Arcsine, in radians.
pub fn asin(float x) float

// Arccosine, in radians.
pub fn acos(float x) float

// Arctangent, in radians.
pub fn atan(float x) float

// The angle of the point (x, y), in -pi..pi.
pub fn atan2(float y, float x) float

// e to the power x.
pub fn exp(float x) float

// Natural logarithm.
pub fn log(float x) float

// Base-2 logarithm.
pub fn log2(float x) float

// Base-10 logarithm.
pub fn log10(float x) float
