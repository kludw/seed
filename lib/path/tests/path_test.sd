package path

test "clean go cases" {
    // The test table of Go's path.Clean.
    assert(clean("") == ".")
    assert(clean("abc") == "abc")
    assert(clean("abc/def") == "abc/def")
    assert(clean("a/b/c") == "a/b/c")
    assert(clean(".") == ".")
    assert(clean("..") == "..")
    assert(clean("../..") == "../..")
    assert(clean("../../abc") == "../../abc")
    assert(clean("/abc") == "/abc")
    assert(clean("/") == "/")
    assert(clean("abc/") == "abc")
    assert(clean("abc/def/") == "abc/def")
    assert(clean("a/b/c/") == "a/b/c")
    assert(clean("./") == ".")
    assert(clean("../") == "..")
    assert(clean("../../") == "../..")
    assert(clean("/abc/") == "/abc")
    assert(clean("abc//def//ghi") == "abc/def/ghi")
    assert(clean("//abc") == "/abc")
    assert(clean("///abc") == "/abc")
    assert(clean("//abc//") == "/abc")
    assert(clean("abc//") == "abc")
    assert(clean("abc/./def") == "abc/def")
    assert(clean("/./abc/def") == "/abc/def")
    assert(clean("abc/.") == "abc")
    assert(clean("abc/def/ghi/../jkl") == "abc/def/jkl")
    assert(clean("abc/def/../ghi/../jkl") == "abc/jkl")
    assert(clean("abc/def/..") == "abc")
    assert(clean("abc/def/../..") == ".")
    assert(clean("/abc/def/../..") == "/")
    assert(clean("abc/def/../../..") == "..")
    assert(clean("/abc/def/../../..") == "/")
    assert(clean("abc/def/../../../ghi/jkl/../../../mno") == "../../mno")
    assert(clean("abc/./../def") == "def")
    assert(clean("abc//./../def") == "def")
    assert(clean("abc/../../././../def") == "../../def")
}

test "clean is idempotent" {
    []string cases = []string{"", "a//b", "/../x/./y/..", "../a/../..", "///", "a/b/c/../../.."}
    for (int i = 0; i < cases.len(); i++) {
        string once = clean(cases[i])
        assert(clean(once) == once)
    }
}

test "join" {
    assert(join([]string{"a", "b/", "../c"}) == "a/c")
    assert(join([]string{}) == "")
    assert(join([]string{"", ""}) == "")
    assert(join([]string{"a", "b"}) == "a/b")
    assert(join([]string{"a", ""}) == "a")
    assert(join([]string{"", "b"}) == "b")
    assert(join([]string{"/", "a"}) == "/a")
    assert(join([]string{"/", ""}) == "/")
    assert(join([]string{"a/", "b"}) == "a/b")
    assert(join([]string{"a/", ""}) == "a")
    assert(join([]string{"", "/b"}) == "/b")
    assert(join([]string{"a", "/b"}) == "a/b")
    assert(join([]string{".", ".."}) == "..")
    assert(join([]string{"out", "page.html"}) == "out/page.html")
}

test "base" {
    assert(base("") == ".")
    assert(base(".") == ".")
    assert(base("/.") == ".")
    assert(base("/") == "/")
    assert(base("////") == "/")
    assert(base("x/") == "x")
    assert(base("abc") == "abc")
    assert(base("abc/def") == "def")
    assert(base("a/b/.x") == ".x")
    assert(base("a/b/c.") == "c.")
    assert(base("a/b/c.x") == "c.x")
    assert(base("a/b.txt") == "b.txt")
    assert(base("a/b//") == "b")
}

test "dir" {
    assert(dir("") == ".")
    assert(dir(".") == ".")
    assert(dir("/.") == "/")
    assert(dir("/") == "/")
    assert(dir("////") == "/")
    assert(dir("/foo") == "/")
    assert(dir("x/") == "x")
    assert(dir("abc") == ".")
    assert(dir("abc/def") == "abc")
    assert(dir("abc////def") == "abc")
    assert(dir("a/b/.x") == "a/b")
    assert(dir("a/b/c.") == "a/b")
    assert(dir("a/b/c.x") == "a/b")
    assert(dir("a/b.txt") == "a")
    assert(dir("b.txt") == ".")
    assert(dir("/b") == "/")
    assert(dir("a/b/") == "a/b")
    assert(dir("../x") == "..")
}

test "ext" {
    assert(ext("path.go") == ".go")
    assert(ext("path.pb.go") == ".go")
    assert(ext("a.dir/b") == "")
    assert(ext("a.dir/b.go") == ".go")
    assert(ext("a.dir/") == ".dir")
    assert(ext("a.tar.gz") == ".gz")
    assert(ext(".bashrc") == "")
    assert(ext("dir/.bashrc") == "")
    assert(ext(".config.json") == ".json")
    assert(ext("noext") == "")
    assert(ext("a.") == ".")
    assert(ext("") == "")
    assert(ext(".") == "")
    assert(ext("..") == "")
    assert(ext("x/..") == "")
    assert(ext("/") == "")
}

test "doc example" {
    string src = "posts/2026/hello.md"
    string name = base(src)
    string stem = name.slice(0, name.len() - ext(name).len())
    assert(join([]string{"out/", stem + ".html"}) == "out/hello.html")
}
