package path

fn testCleanGoCases() TestLog {
    TestLog t = newTestLog()
    // The test table of Go's path.Clean.
    t.eqStr(clean(""), ".")
    t.eqStr(clean("abc"), "abc")
    t.eqStr(clean("abc/def"), "abc/def")
    t.eqStr(clean("a/b/c"), "a/b/c")
    t.eqStr(clean("."), ".")
    t.eqStr(clean(".."), "..")
    t.eqStr(clean("../.."), "../..")
    t.eqStr(clean("../../abc"), "../../abc")
    t.eqStr(clean("/abc"), "/abc")
    t.eqStr(clean("/"), "/")
    t.eqStr(clean("abc/"), "abc")
    t.eqStr(clean("abc/def/"), "abc/def")
    t.eqStr(clean("a/b/c/"), "a/b/c")
    t.eqStr(clean("./"), ".")
    t.eqStr(clean("../"), "..")
    t.eqStr(clean("../../"), "../..")
    t.eqStr(clean("/abc/"), "/abc")
    t.eqStr(clean("abc//def//ghi"), "abc/def/ghi")
    t.eqStr(clean("//abc"), "/abc")
    t.eqStr(clean("///abc"), "/abc")
    t.eqStr(clean("//abc//"), "/abc")
    t.eqStr(clean("abc//"), "abc")
    t.eqStr(clean("abc/./def"), "abc/def")
    t.eqStr(clean("/./abc/def"), "/abc/def")
    t.eqStr(clean("abc/."), "abc")
    t.eqStr(clean("abc/def/ghi/../jkl"), "abc/def/jkl")
    t.eqStr(clean("abc/def/../ghi/../jkl"), "abc/jkl")
    t.eqStr(clean("abc/def/.."), "abc")
    t.eqStr(clean("abc/def/../.."), ".")
    t.eqStr(clean("/abc/def/../.."), "/")
    t.eqStr(clean("abc/def/../../.."), "..")
    t.eqStr(clean("/abc/def/../../.."), "/")
    t.eqStr(clean("abc/def/../../../ghi/jkl/../../../mno"), "../../mno")
    t.eqStr(clean("abc/./../def"), "def")
    t.eqStr(clean("abc//./../def"), "def")
    t.eqStr(clean("abc/../../././../def"), "../../def")
    return t
}

fn testCleanIsIdempotent() TestLog {
    TestLog t = newTestLog()
    []string cases = []string{"", "a//b", "/../x/./y/..", "../a/../..", "///", "a/b/c/../../.."}
    for (int i = 0; i < cases.len(); i++) {
        string once = clean(cases[i])
        t.eqStr(clean(once), once)
    }
    return t
}

fn testJoin() TestLog {
    TestLog t = newTestLog()
    t.eqStr(join([]string{"a", "b/", "../c"}), "a/c")
    t.eqStr(join([]string{}), "")
    t.eqStr(join([]string{"", ""}), "")
    t.eqStr(join([]string{"a", "b"}), "a/b")
    t.eqStr(join([]string{"a", ""}), "a")
    t.eqStr(join([]string{"", "b"}), "b")
    t.eqStr(join([]string{"/", "a"}), "/a")
    t.eqStr(join([]string{"/", ""}), "/")
    t.eqStr(join([]string{"a/", "b"}), "a/b")
    t.eqStr(join([]string{"a/", ""}), "a")
    t.eqStr(join([]string{"", "/b"}), "/b")
    t.eqStr(join([]string{"a", "/b"}), "a/b")
    t.eqStr(join([]string{".", ".."}), "..")
    t.eqStr(join([]string{"out", "page.html"}), "out/page.html")
    return t
}

fn testBase() TestLog {
    TestLog t = newTestLog()
    t.eqStr(base(""), ".")
    t.eqStr(base("."), ".")
    t.eqStr(base("/."), ".")
    t.eqStr(base("/"), "/")
    t.eqStr(base("////"), "/")
    t.eqStr(base("x/"), "x")
    t.eqStr(base("abc"), "abc")
    t.eqStr(base("abc/def"), "def")
    t.eqStr(base("a/b/.x"), ".x")
    t.eqStr(base("a/b/c."), "c.")
    t.eqStr(base("a/b/c.x"), "c.x")
    t.eqStr(base("a/b.txt"), "b.txt")
    t.eqStr(base("a/b//"), "b")
    return t
}

fn testDir() TestLog {
    TestLog t = newTestLog()
    t.eqStr(dir(""), ".")
    t.eqStr(dir("."), ".")
    t.eqStr(dir("/."), "/")
    t.eqStr(dir("/"), "/")
    t.eqStr(dir("////"), "/")
    t.eqStr(dir("/foo"), "/")
    t.eqStr(dir("x/"), "x")
    t.eqStr(dir("abc"), ".")
    t.eqStr(dir("abc/def"), "abc")
    t.eqStr(dir("abc////def"), "abc")
    t.eqStr(dir("a/b/.x"), "a/b")
    t.eqStr(dir("a/b/c."), "a/b")
    t.eqStr(dir("a/b/c.x"), "a/b")
    t.eqStr(dir("a/b.txt"), "a")
    t.eqStr(dir("b.txt"), ".")
    t.eqStr(dir("/b"), "/")
    t.eqStr(dir("a/b/"), "a/b")
    t.eqStr(dir("../x"), "..")
    return t
}

fn testExt() TestLog {
    TestLog t = newTestLog()
    t.eqStr(ext("path.go"), ".go")
    t.eqStr(ext("path.pb.go"), ".go")
    t.eqStr(ext("a.dir/b"), "")
    t.eqStr(ext("a.dir/b.go"), ".go")
    t.eqStr(ext("a.dir/"), ".dir")
    t.eqStr(ext("a.tar.gz"), ".gz")
    t.eqStr(ext(".bashrc"), "")
    t.eqStr(ext("dir/.bashrc"), "")
    t.eqStr(ext(".config.json"), ".json")
    t.eqStr(ext("noext"), "")
    t.eqStr(ext("a."), ".")
    t.eqStr(ext(""), "")
    t.eqStr(ext("."), "")
    t.eqStr(ext(".."), "")
    t.eqStr(ext("x/.."), "")
    t.eqStr(ext("/"), "")
    return t
}

fn testDocExample() TestLog {
    TestLog t = newTestLog()
    string src = "posts/2026/hello.md"
    string name = base(src)
    string stem = name.slice(0, name.len() - ext(name).len())
    t.eqStr(join([]string{"out/", stem + ".html"}), "out/hello.html")
    return t
}
