// Package path handles slash-separated paths as text, without touching
// the file system: joining, cleaning, and splitting into directory, base
// name and extension, with the rules of Go's path package.
package path

// Slash-separated paths as text (docs/stdlib.md, "path"). These functions
// never touch the file system, and only '/' is a separator (POSIX). The
// rules are those of Go's path package, except `ext` (see below):
//
//   clean("")            "."        clean("a//b/./c/..")  "a/b"
//   clean("/../a")       "/a"       clean("../../a")      "../../a"
//   join(["a", "b/", "../c"])  "a/c"     join([]) and join(["", ""])  ""
//   base("a/b.txt")      "b.txt"    base("a/b/")  "b"    base("/")  "/"    base("")  "."
//   dir("a/b.txt")       "a"        dir("b.txt")  "."    dir("/b")  "/"    dir("a/b/")  "a/b"
//   ext("a.tar.gz")      ".gz"      ext(".bashrc")  ""   ext("a/b.c/")  ".c"

// The parts joined with '/' and then cleaned. Empty parts are skipped; an
// empty list, or only empty parts, gives "".
pub fn join([]string parts) string {
    []string kept = []string{}
    for (int i = 0; i < parts.len(); i++) {
        if (parts[i] != "") {
            kept.push(parts[i])
        }
    }
    if (kept.len() == 0) {
        return ""
    }
    return clean(kept.join("/"))
}

// The shortest path equivalent to `p`, by purely lexical processing:
//
//   1. repeated slashes become one;
//   2. each `.` element is removed;
//   3. each `..` element is removed together with the element before it,
//      when that element is not itself `..`;
//   4. `..` elements at the start of an absolute path are removed
//      ("/.." is "/");
//   5. a trailing slash is removed, except in "/".
//
// The result is "." when nothing is left.
pub fn clean(string p) string {
    if (p == "") {
        return "."
    }
    bool rooted = p[0] == '/'
    []string parts = p.split("/")
    []string out = []string{}
    // The number of leading ".." elements in `out`, which `..` cannot remove.
    int fixed = 0
    for (int i = 0; i < parts.len(); i++) {
        string elem = parts[i]
        if (elem == "" || elem == ".") {
            continue
        }
        if (elem == "..") {
            if (out.len() > fixed) {
                out.remove(out.len() - 1)
            } else if (!rooted) {
                out.push("..")
                fixed++
            }
            continue
        }
        out.push(elem)
    }
    string joined = out.join("/")
    if (rooted) {
        return "/" + joined
    }
    if (joined == "") {
        return "."
    }
    return joined
}

// The last element of `p`, after removing trailing slashes. "" gives ".",
// and a path of only slashes gives "/".
pub fn base(string p) string {
    if (p == "") {
        return "."
    }
    int end = p.len()
    for (; end > 0 && p[end - 1] == '/'; ) {
        end--
    }
    if (end == 0) {
        return "/"
    }
    int start = end
    for (; start > 0 && p[start - 1] != '/'; ) {
        start--
    }
    return p.slice(start, end)
}

// Everything but the last element of `p`, cleaned: the part up to and
// including the last '/', passed to `clean`. A path with no '/' gives ".".
// As in Go, a trailing slash means the last element is empty, so
// dir("a/b/") is "a/b".
pub fn dir(string p) string {
    int i = p.len()
    for (; i > 0 && p[i - 1] != '/'; ) {
        i--
    }
    return clean(p.slice(0, i))
}

// The extension of base(p), from its last '.' to the end: ".txt". "" when
// the base has no dot, when its only dot is its first character (".bashrc"),
// and for the bases "." and "..". "a." gives ".".
pub fn ext(string p) string {
    string b = base(p)
    if (b == "." || b == "..") {
        return ""
    }
    for (int i = b.len() - 1; i > 0; i--) {
        if (b[i] == '.') {
            return b.slice(i, b.len())
        }
    }
    return ""
}
