package strings

import "fmt"

test "repeat" {
    assert(repeat("ab", 3) == "ababab")
    assert(repeat("ab", 0) == "")
    assert(repeat("", 5) == "")
    assert(repeat("x", 1) == "x")
    assert(repeat("abc", 1000).len() == 3000)
    assert(repeat("xy", 7) == "xyxyxyxyxyxyxy")
}

test "pad left" {
    assert(padLeft("7", 3, '0') == "007")
    assert(padLeft("1234", 3, '0') == "1234")
    assert(padLeft("abc", 3, ' ') == "abc")
    assert(padLeft("", 2, '-') == "--")
    assert(padLeft("x", -1, '-') == "x")
}

test "pad counts utf-8 characters" {
    // "é" is two bytes but one character.
    assert(padLeft("\xc3\xa9", 3, '.') == "..\xc3\xa9")
    assert(padRight("\xc3\xa9t\xc3\xa9", 5, '.') == "\xc3\xa9t\xc3\xa9..")
}

test "pad right" {
    assert(padRight("ab", 5, ' ') == "ab   ")
    assert(padRight("abcdef", 5, ' ') == "abcdef")
    assert(padRight("", 0, ' ') == "")
}

test "last index" {
    int? i = lastIndex("go gopher", "go")
    assert(i != null && i == 3)
    i = lastIndex("abc", "")
    assert(i != null && i == 3)
    assert(lastIndex("abc", "d") == null)
    assert(lastIndex("ab", "abc") == null)
    i = lastIndex("aaaa", "aa")
    assert(i != null && i == 2)
    i = lastIndex("abc", "abc")
    assert(i != null && i == 0)
    assert(lastIndex("", "a") == null)
    i = lastIndex("", "")
    assert(i != null && i == 0)
}

test "fields" {
    assert(fields("  a b\n") == []string{"a", "b"})
    assert(fields("") == []string{})
    assert(fields(" \t\n\r\x0b\x0c") == []string{})
    assert(fields("one") == []string{"one"})
    assert(fields("a\x0bb\x0cc\rd") == []string{"a", "b", "c", "d"})
    assert(fields("x  y   z") == []string{"x", "y", "z"})
}

test "byte classes" {
    assert(isDigit('0') && isDigit('9') && !isDigit('a') && !isDigit('/') && !isDigit(':'))
    assert(isLetter('a') && isLetter('z') && isLetter('A') && isLetter('Z'))
    assert(!isLetter('@') && !isLetter('[') && !isLetter('`') && !isLetter('{') && !isLetter('\xc3'))
    assert(isSpace(' ') && isSpace('\t') && isSpace('\n') && isSpace('\r') && isSpace('\x0b') && isSpace('\x0c'))
    assert(!isSpace('a') && !isSpace('\x00') && !isSpace('\xa0'))
}

fn crashRepeatNegative() {
    fmt.println(repeat("x", -1))
}

test "repeat negative crashes" {
    error err = group {
        spawn crashRepeatNegative()
    }
    assert(err != null)
    assert(err.message() == "crash: strings.repeat: count (-1) must not be negative")
}
