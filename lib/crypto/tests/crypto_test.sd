package crypto

// Lowercase hex, so that digests can be compared with published vectors
// (crypto does not import encoding).
fn cryptoTestHex(string data) string {
    string digits = "0123456789abcdef"
    []byte out = []byte{}
    for (int i = 0; i < data.len(); i++) {
        out.push(digits[int(data[i]) >> 4])
        out.push(digits[int(data[i]) & 15])
    }
    return string(out)
}

fn cryptoTestBytes(int n, int b) string {
    []byte out = []byte{}
    for (int i = 0; i < n; i++) {
        out.push(byte(b))
    }
    return string(out)
}

// Bytes (i * 7 + 3) mod 256 for i < n, the pattern of the length vectors.
fn cryptoTestPattern(int n) string {
    []byte out = []byte{}
    for (int i = 0; i < n; i++) {
        out.push(byte((i * 7 + 3) & 255))
    }
    return string(out)
}

fn testSha256FipsVectors() TestLog {
    TestLog t = newTestLog()
    t.eqStr(cryptoTestHex(sha256("")), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    t.eqStr(cryptoTestHex(sha256("abc")), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    t.eqStr(cryptoTestHex(sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    t.eqStr(cryptoTestHex(sha256("abcdefghbcdefghicdefghijdefghijkefghijklfghijklmghijklmnhijklmnoijklmnopjklmnopqklmnopqrlmnopqrsmnopqrstnopqrstu")), "cf5b16a778af8380036ce59e7b0492370b249b11e8f07a51afac45037afee9d1")
    t.eqInt(sha256("abc").len(), 32)
    return t
}

fn testSha256PaddingBoundaries() TestLog {
    TestLog t = newTestLog()
    // Lengths around the 55/56-byte padding boundary and the block size.
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(55))), "e7313d333c272e639f790978283f9eb392e843d0f29b7016828bb1daa4aac70b")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(56))), "4324d65f3c103567f5589c710bc08f8523f929a9272e3af36fc968e52abc6c27")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(63))), "81c80242132f230c3bd41b3e63bbcff16107339549214a99614ff26664625055")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(64))), "39e3d7b6b5d075d37d053ad89b24b41bef4f3c29760c84447cab3f3be1882241")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(65))), "aacca6ff74fdbb296d165a45cecfa04e5127bc008770fbbdd48006f2d2fae95e")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(119))), "9ce7368e4daf32341631b492e80359dc9f594b48453cd0dd5bf0b19279cc177e")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(120))), "7836b787757e95e58b3ca5aec90b1b004e8deba1e50e9675af9cabf1a13a04b5")
    t.eqStr(cryptoTestHex(sha256(cryptoTestPattern(1000))), "1e9bc38cbf860b9ec31918b065f9b52476c549a782e0e7990bed8ce3868d2371")
    return t
}

fn testSha256MillionA() TestLog {
    TestLog t = newTestLog()
    t.eqStr(cryptoTestHex(sha256(cryptoTestBytes(1000000, 97))), "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0")
    return t
}

fn testHmacSha256Rfc4231() TestLog {
    TestLog t = newTestLog()
    // RFC 4231 test cases 1, 2, 3, 4, 6 and 7.
    t.eqStr(cryptoTestHex(hmacSha256(cryptoTestBytes(20, 0x0b), "Hi There")), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    t.eqStr(cryptoTestHex(hmacSha256("Jefe", "what do ya want for nothing?")), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    t.eqStr(cryptoTestHex(hmacSha256(cryptoTestBytes(20, 0xaa), cryptoTestBytes(50, 0xdd))), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    []byte key4 = []byte{}
    for (int i = 1; i <= 25; i++) {
        key4.push(byte(i))
    }
    t.eqStr(cryptoTestHex(hmacSha256(string(key4), cryptoTestBytes(50, 0xcd))), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
    string bigKey = cryptoTestBytes(131, 0xaa)
    t.eqStr(cryptoTestHex(hmacSha256(bigKey, "Test Using Larger Than Block-Size Key - Hash Key First")), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    t.eqStr(cryptoTestHex(hmacSha256(bigKey, "This is a test using a larger than block-size key and a larger than block-size data. The key needs to be hashed before being used by the HMAC algorithm.")), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
    return t
}

fn testHmacSha256EdgeKeys() TestLog {
    TestLog t = newTestLog()
    t.eqStr(cryptoTestHex(hmacSha256("", "")), "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad")
    // A key of exactly one block is used as it is, not hashed.
    t.eqStr(cryptoTestHex(hmacSha256(cryptoTestBytes(64, 107), "exact block key")), "b563f92fb1a114877408fa27ee56cdc4a0b2dd30807de9559d4bff27f5a2c1fb")
    return t
}
