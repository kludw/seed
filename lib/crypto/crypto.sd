// Package crypto has the few cryptographic building blocks most programs
// need: SHA-256, HMAC-SHA-256, secure random bytes and a constant-time
// comparison. Digests and keys are raw bytes in a string; turn them into
// text with encoding.hexEncode or encoding.base64UrlEncode.
package crypto

// The few cryptographic building blocks most programs need (docs/stdlib.md,
// "crypto"). Digests and keys are raw bytes in a string; turn them into text
// with encoding.hexEncode or encoding.base64UrlEncode.
//
// Everything is native (crypto.c): SHA-256 and HMAC need 32-bit wrapping
// arithmetic, randomBytes needs the OS, and equal must take a time that no
// optimiser can shorten. tests/crypto_test.sd has the FIPS 180-2 and RFC
// 4231 vectors.

// The 32-byte SHA-256 digest (FIPS 180-4) of data.
pub fn sha256(string data) string

// The 32-byte HMAC-SHA-256 (RFC 2104) of data with key. A key longer than
// the 64-byte block is hashed first.
pub fn hmacSha256(string key, string data) string

// n bytes from the operating system's secure random source (getentropy, or
// /dev/urandom as a fallback). Crashes if n is negative, or if the OS cannot
// provide randomness.
pub fn randomBytes(int n) string

// Whether a and b are equal, taking time that depends only on their
// lengths, not their contents. Use it to compare MACs and tokens.
pub fn equal(string a, string b) bool
