package crypto

// SHA-256 (FIPS 180-4) and HMAC-SHA-256 (RFC 2104) in pure Seed.
//
// docs/stdlib.md makes `sha256` and `hmacSha256` native, because 32-bit
// wrapping arithmetic is slow with growing ints. These pure-Seed versions
// are the reference until the natives exist, and the tests in
// tests/crypto_test.sd are the vectors the natives must pass. All the
// arithmetic stays below 2^62, so no step allocates a big integer: a
// rotation masks before shifting left, and sums of up to five 32-bit words
// are masked once. lib/README.md has the measured speed.
//
// `randomBytes` and `equal` stay native (the OS random source; a comparison
// that no optimiser can make exit early).

const int mask32 = 0xffffffff

// The 32-byte SHA-256 digest of `data`.
pub fn sha256(string data) string {
    []int h = []int{0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19}
    []int k = sha256Constants()
    []int w = []int{}
    for (int i = 0; i < 64; i++) {
        w.push(0)
    }
    string padded = sha256Pad(data)
    for (int block = 0; block < padded.len(); block = block + 64) {
        for (int i = 0; i < 16; i++) {
            int p = block + i * 4
            w[i] = (int(padded[p]) << 24) | (int(padded[p + 1]) << 16) | (int(padded[p + 2]) << 8) | int(padded[p + 3])
        }
        for (int i = 16; i < 64; i++) {
            int x = w[i - 15]
            int y = w[i - 2]
            int s0 = rotr32(x, 7) ^ rotr32(x, 18) ^ (x >> 3)
            int s1 = rotr32(y, 17) ^ rotr32(y, 19) ^ (y >> 10)
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & mask32
        }
        int a = h[0]
        int b = h[1]
        int c = h[2]
        int d = h[3]
        int e = h[4]
        int f = h[5]
        int g = h[6]
        int hh = h[7]
        for (int i = 0; i < 64; i++) {
            int bigS1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            int ch = (e & f) ^ ((e ^ mask32) & g)
            int t1 = (hh + bigS1 + ch + k[i] + w[i]) & mask32
            int bigS0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            int maj = (a & b) ^ (a & c) ^ (b & c)
            int t2 = bigS0 + maj
            hh = g
            g = f
            f = e
            e = (d + t1) & mask32
            d = c
            c = b
            b = a
            a = (t1 + t2) & mask32
        }
        h[0] = (h[0] + a) & mask32
        h[1] = (h[1] + b) & mask32
        h[2] = (h[2] + c) & mask32
        h[3] = (h[3] + d) & mask32
        h[4] = (h[4] + e) & mask32
        h[5] = (h[5] + f) & mask32
        h[6] = (h[6] + g) & mask32
        h[7] = (h[7] + hh) & mask32
    }
    []byte out = []byte{}
    for (int i = 0; i < 8; i++) {
        out.push(byte(h[i] >> 24))
        out.push(byte((h[i] >> 16) & 255))
        out.push(byte((h[i] >> 8) & 255))
        out.push(byte(h[i] & 255))
    }
    return string(out)
}

// The 32-byte HMAC-SHA-256 (RFC 2104) of `data` with `key`. A key longer
// than the 64-byte block is hashed first.
pub fn hmacSha256(string key, string data) string {
    string k = key
    if (k.len() > 64) {
        k = sha256(k)
    }
    []byte inner = []byte{}
    []byte outer = []byte{}
    for (int i = 0; i < 64; i++) {
        int b = 0
        if (i < k.len()) {
            b = int(k[i])
        }
        inner.push(byte(b ^ 0x36))
        outer.push(byte(b ^ 0x5c))
    }
    string innerHash = sha256(string(inner) + data)
    return sha256(string(outer) + innerHash)
}

// `x` rotated right by `n` bits, as a 32-bit word (0 < n < 32). The low
// bits are masked before shifting left, so nothing exceeds 32 bits.
fn rotr32(int x, int n) int {
    return (x >> n) | ((x & ((1 << n) - 1)) << (32 - n))
}

// `data` followed by 0x80, zeros and the 64-bit big-endian bit length, a
// whole number of 64-byte blocks.
fn sha256Pad(string data) string {
    int n = data.len()
    []byte tail = []byte{'\x80'}
    int zeros = (55 - n % 64 + 64) % 64
    for (int i = 0; i < zeros; i++) {
        tail.push('\x00')
    }
    int bits = n * 8
    for (int i = 7; i >= 0; i--) {
        tail.push(byte((bits >> (i * 8)) & 255))
    }
    return data + string(tail)
}

